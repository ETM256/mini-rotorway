			{ type = "ellipse", x = 0.300, y = 0.840, rx = 0.090, ry = 0.050, rotation = 0 },
		},
	},
}

-- Terrain uniforme sur toutes les cartes : seuls l'en-tête et l'accent
-- (couleurs d'interface du menu) changent d'une ville à l'autre.
for _, map in ipairs(list) do
	map.land = C.Land
	map.water = C.Water
	map.waterEdge = C.WaterEdge
	map.waterDeep = C.WaterDeep
	map.grass = C.Park
	map.dryShapes = map.dryShapes or {}
	map.grassShapes = map.grassShapes or {}
end

function Maps.all()
	return list
end

function Maps.getById(id)
	for _, map in ipairs(list) do
		if map.id == id then
			return map
		end
	end
	return nil
end

-- Teste un point normalisé contre une forme (rect, cercle, ellipse, bar).
local function pointInShape(shape, nx, ny)
	if shape.type == "rect" then
		return nx >= shape.x
			and nx <= shape.x + shape.w
			and ny >= shape.y
			and ny <= shape.y + shape.h
	end

	if shape.type == "circle" or shape.type == "ellipse" then
		local rx = shape.rx or shape.r or 0.05
		local ry = shape.ry or shape.r or rx
		local dx = nx - shape.x
		local dy = ny - shape.y
		local angle = math.rad(shape.rotation or 0)
		local cosA = math.cos(angle)
		local sinA = math.sin(angle)
		local localX = dx * cosA + dy * sinA
		local localY = -dx * sinA + dy * cosA
		return (localX / rx) * (localX / rx) + (localY / ry) * (localY / ry) <= 1
	end

	if shape.type == "bar" then
		local x1 = shape.x1
		local y1 = shape.y1
		local x2 = shape.x2
		local y2 = shape.y2
		local dx = x2 - x1
		local dy = y2 - y1
		local lengthSquared = dx * dx + dy * dy
		local t = 0
		if lengthSquared > 0 then
			t = ((nx - x1) * dx + (ny - y1) * dy) / lengthSquared
			-- Même règle que le rendu : avec flatStart, le bout x1 est coupé
			-- droit, sans capuchon rond au-delà.
			if shape.flatStart and t < 0 then
				return false
			end
			t = math.clamp(t, 0, 1)
		end
		local px = x1 + dx * t
		local py = y1 + dy * t
		local ddx = nx - px
		local ddy = ny - py
		local radius = (shape.thickness or 0.04) * 0.5
		return ddx * ddx + ddy * ddy <= radius * radius
	end

	return false
end

local function anyShape(shapes, nx, ny)
	for _, shape in ipairs(shapes) do
		if pointInShape(shape, nx, ny) then
			return true
		end
	end
	return false
end

-- Règle unique de l'eau : un point est de l'eau s'il tombe dans une forme
-- d'eau et hors de toute forme sèche (presqu'île).
-- Une cellule est classée par son centre : une cellule dont le centre est
-- sur la terre reste construisible, même si un de ses bords touche le rivage.
function Maps.isWaterAt(map, nx, ny)
	if anyShape(map.dryShapes, nx, ny) then
		return false
	end
	return anyShape(map.waterShapes, nx, ny)
end

-- Cache par carte : chaque cellule n'est évaluée qu'une fois, au lieu de
-- recalculer les ellipses tournées à chaque test de construction.
local waterCells = setmetatable({}, { __mode = "k" })

local function cellWaterRows(map)
	local size = Config.Grid.Size
	local cached = waterCells[map]
	if cached and cached.size == size then
		return cached.rows
	end
	local rows = {}
	for y = 0, size - 1 do
		local row = {}
		for x = 0, size - 1 do
			row[x] = Maps.isWaterAt(map, (x + 0.5) / size, (y + 0.5) / size)
		end
		rows[y] = row
	end
	waterCells[map] = { size = size, rows = rows }
	return rows
end

function Maps.isWater(map, x, y)
	local row = cellWaterRows(map)[y]
	local cached = row and row[x]
	if cached ~= nil then
		return cached
	end
	-- Hors de la grille : même règle, sans cache.
	local size = Config.Grid.Size
	return Maps.isWaterAt(map, (x + 0.5) / size, (y + 0.5) / size)
end

function Maps.isGrass(map, x, y)
	local size = Config.Grid.Size
	return anyShape(map.grassShapes, (x + 0.5) / size, (y + 0.5) / size)
end

return Maps
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Pathfinding</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Pathfinding.luau
	A* sur la grille de routes.

	Par défaut le réseau est orthogonal : seuls les voisins haut / bas /
	gauche / droite sont parcourus, avec une heuristique de Manhattan.
	Le mode 8 directions reste disponible pour les anciens réseaux (heuristique
	de Chebyshev, un déplacement diagonal coûte une case).

	Performance : chaque case reçoit un identifiant entier (y * size + x + 1)
	pour éviter de reparser des clés à chaque expansion, la liste ouverte est
	un tas binaire (O(log n) par insertion ou extraction), et la route d'une
	case est lue une seule fois. L'heuristique est la distance au but le plus
	proche : elle reste admissible et cohérente, donc la première arrivée au
	but est un plus court chemin.
]]

local Grid = require(script.Parent.Grid)

local Pathfinding = {}

-- Les 8 voisins, construits une fois : la recherche ne reconstruit pas la liste.
local EIGHT_OFFSETS = {}
for _, offset in ipairs(Grid.ORTHOGONAL_OFFSETS) do
	table.insert(EIGHT_OFFSETS, offset)
end
for _, offset in ipairs(Grid.DIAGONAL_OFFSETS) do
	table.insert(EIGHT_OFFSETS, offset)
end

local function isPositiveSize(size)
	return type(size) == "number" and size >= 1 and size == math.floor(size)
end

-- Recherche commune : le chemin le plus court part de l'une des clés de
-- starts. maxExpansions borne le nombre de cases dépilées (nil = sans limite).
local function search(roads, size, starts, goalSet, allowDiagonals, maxExpansions)
	if type(roads) ~= "table" or type(goalSet) ~= "table" or type(starts) ~= "table" then
		return nil
	end
	if not isPositiveSize(size) then
		return nil
	end

	local budget = type(maxExpansions) == "number" and maxExpansions or math.huge

	local function idOf(x, y)
		return y * size + x + 1
	end

	local function coordsOf(id)
		local x = (id - 1) % size
		return x, (id - 1 - x) / size
	end

	-- Route présente ou non, lue une fois par case et mise en cache.
	local walkable = {}
	local function isRoad(x, y)
		local id = idOf(x, y)
		local known = walkable[id]
		if known == nil then
			known = roads[Grid.key(x, y)] and true or false
			walkable[id] = known
		end
		return known
	end

	-- Seules les cases de route dans la grille peuvent être atteintes : un but
	-- hors route ou hors grille ne sert donc ni à la recherche ni à l'heuristique.
	local goalIds = {}
	local goalX, goalY = {}, {}
	for key, flag in pairs(goalSet) do
		local gx, gy = Grid.parse(key)
		if flag and gx and Grid.inRange(gx, gy, size) and isRoad(gx, gy) then
			local id = idOf(gx, gy)
			if not goalIds[id] then
				goalIds[id] = true
				goalX[#goalX + 1] = gx
				goalY[#goalY + 1] = gy
			end
		end
	end
	if #goalX == 0 then
		return nil
	end

	-- Min sur les buts : minorer la distance du but le plus proche reste admissible
	-- avec plusieurs buts, et la fonction reste cohérente.
	local function estimate(x, y)
		local best = math.huge
		for i = 1, #goalX do
			local dx = math.abs(x - goalX[i])
			local dy = math.abs(y - goalY[i])
			local d
			if allowDiagonals then
				d = math.max(dx, dy)
			else
				d = dx + dy
			end
			if d < best then
				best = d
			end
		end
		return best
	end

	-- Tas binaire parallèle : priorité (f, puis h, puis id). Les égalités sont
	-- départagées de façon déterministe : un même réseau donne toujours le même tracé.
	local heapF, heapH, heapId = {}, {}, {}
	local heapSize = 0

	local function before(i, j)
		if heapF[i] ~= heapF[j] then
			return heapF[i] < heapF[j]
		end
		if heapH[i] ~= heapH[j] then
			return heapH[i] < heapH[j]
		end
		return heapId[i] < heapId[j]
	end

	local function swap(i, j)
		heapF[i], heapF[j] = heapF[j], heapF[i]
		heapH[i], heapH[j] = heapH[j], heapH[i]
		heapId[i], heapId[j] = heapId[j], heapId[i]
	end

	local function push(f, h, id)
		heapSize += 1
		local i = heapSize
		heapF[i], heapH[i], heapId[i] = f, h, id
		while i > 1 do
			local parentIndex = math.floor(i / 2)
			if not before(i, parentIndex) then
				break
			end
			swap(i, parentIndex)
			i = parentIndex
		end
	end

	local function pop()
		local topId = heapId[1]
		heapF[1], heapH[1], heapId[1] = heapF[heapSize], heapH[heapSize], heapId[heapSize]
		heapF[heapSize], heapH[heapSize], heapId[heapSize] = nil, nil, nil
		heapSize -= 1
		local i = 1
		while true do
			local smallest = i
			local left, right = 2 * i, 2 * i + 1
			if left <= heapSize and before(left, smallest) then
				smallest = left
			end
			if right <= heapSize and before(right, smallest) then
				smallest = right
			end
			if smallest == i then
				break
			end
			swap(i, smallest)
			i = smallest
		end
		return topId
	end

	local gScore, hScore, parent, closed = {}, {}, {}, {}

	-- Départs : chaque case de départ valide est ouverte à coût 0. Si l'une
	-- d'elles est déjà un but, c'est le chemin d'une seule case.
	local started = false
	for _, startKey in ipairs(starts) do
		local sx, sy = Grid.parse(startKey)
		if sx and Grid.inRange(sx, sy, size) and isRoad(sx, sy) then
			local id = idOf(sx, sy)
			if goalIds[id] then
				return { Grid.key(sx, sy) }
			end
			if gScore[id] == nil then
				started = true
				gScore[id] = 0
				local h = estimate(sx, sy)
				hScore[id] = h
				push(h, h, id)
			end
		end
	end
	if not started then
		return nil
	end

	local function rebuild(goalId)
		local ids = {}
		local node = goalId
		while node ~= nil do
			ids[#ids + 1] = node
			node = parent[node]
		end
		local path = {}
		for i = #ids, 1, -1 do
			local x, y = coordsOf(ids[i])
			path[#path + 1] = Grid.key(x, y)
		end
		return path
	end

	local offsets = allowDiagonals and EIGHT_OFFSETS or Grid.ORTHOGONAL_OFFSETS
	local expansions = 0
	while heapSize > 0 do
		local id = pop()
		if not closed[id] then
			if goalIds[id] then
				return rebuild(id)
			end

			expansions += 1
			if expansions > budget then
				return nil
			end
			closed[id] = true

			local x, y = coordsOf(id)
			local cost = gScore[id] + 1
			for _, offset in ipairs(offsets) do
				local nx, ny = x + offset[1], y + offset[2]
				if Grid.inRange(nx, ny, size) and isRoad(nx, ny) then
					local nid = idOf(nx, ny)
					if not closed[nid] and (gScore[nid] == nil or cost < gScore[nid]) then
						gScore[nid] = cost
						parent[nid] = id
						local h = hScore[nid]
						if h == nil then
							h = estimate(nx, ny)
							hScore[nid] = h
						end
						push(cost + h, h, nid)
					end
				end
			end
		end
	end

	return nil
end

--[[
	Plus court chemin de startKey à un but de goalSet, sous forme de liste de
	clés (départ inclus), ou nil. Les cases doivent être des routes de la
	grille size x size. allowDiagonals autorise les 8 voisins. maxExpansions
	optionnel borne le travail : au-delà, la recherche renvoie nil.
]]
function Pathfinding.find(roads, size, startKey, goalSet, allowDiagonals, maxExpansions)
	return search(roads, size, { startKey }, goalSet, allowDiagonals == true, maxExpansions)
end

-- Variante à plusieurs départs (par exemple les connecteurs d'une maison) :
-- une seule recherche qui renvoie le plus court des chemins, au lieu d'une
-- recherche par départ.
function Pathfinding.findFromAny(roads, size, startKeys, goalSet, allowDiagonals, maxExpansions)
	return search(roads, size, startKeys, goalSet, allowDiagonals == true, maxExpansions)
end

return Pathfinding
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Remotes</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Remotes.luau
	Crée les RemoteEvents partagés côté serveur et les récupère côté client.
	Le serveur crée chaque remote une seule fois : il n'y a aucun yield entre
	la recherche et la création, donc pas de doublon. Le client attend que le
	serveur ait répliqué le dossier et ne crée jamais de remote local, qui ne
	communiquerait avec personne.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local FOLDER_NAME = "MMRemotes"
-- Délai côté client avant de signaler un remote absent (serveur mal démarré).
local WAIT_SECONDS = 10

local NAMES = {
	"StartGame",
	"DrawRoad",
	"EraseRoad",
	"EraseRoads",
	"SetPaused",
	"SetSpeed",
	"PlaceRoundabout",
	"WeekChoice",
	"ChooseReward",
	"ReturnToLobby",
	"RequestProfile",
	"ResetRecords",
	"GameStarted",
	"State",
	"StoreState",
	"RoadState",
	"GameOver",
	"Toast",
	"Profile",
}

function Remotes.folder()
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		return folder
	end

	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME, WAIT_SECONDS)
	if not folder then
		error("[MiniMotorways] Dossier de remotes introuvable : " .. FOLDER_NAME, 2)
	end
	return folder
end

function Remotes.get(name)
	local folder = Remotes.folder()
	local event = folder:FindFirstChild(name)
	if event then
		return event
	end

	if RunService:IsServer() then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = folder
		return event
	end

	event = folder:WaitForChild(name, WAIT_SECONDS)
	if not event then
		error("[MiniMotorways] Remote introuvable : " .. name, 2)
	end
	return event
end

-- Idempotent : relancer le serveur ou rappeler setup ne duplique rien.
function Remotes.setup()
	if not RunService:IsServer() then
		return
	end
	for _, name in ipairs(NAMES) do
		Remotes.get(name)
	end
end

return Remotes
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">RoadConfig</string>
          <ProtectedString name="Source"><![CDATA[--[[
	RoadConfig.luau
	Réglages centralisés du système de routes.

	Les routes sont orthogonales par défaut : chaque déplacement va d'une case
	vers une case voisine en haut, en bas, à gauche ou à droite. Un geste en
	biais est transformé en chemin horizontal puis vertical (ou l'inverse).
	Les diagonales restent disponibles en option pour les anciens réseaux.
]]

local Config = require(script.Parent.Config)

local RoadConfig = {}

RoadConfig.Version = "1.1.0"

-- true : autorise les cases reliées par un coin (comportement historique).
-- false : réseau orthogonal uniquement, virages à 90° et intersections
--         en T / en croix générées automatiquement.
RoadConfig.AllowDiagonals = false

-- "orthogonal" : une route doit toucher un côté du bâtiment pour le desservir.
-- "all"        : accepte aussi une route posée en diagonale du bâtiment.
RoadConfig.BuildingConnection = "orthogonal"

RoadConfig.Visual = {
	-- Largeurs en fraction d'une case, issues de Config.Dimensions.Road : une
	-- route reste plus étroite qu'une maison, sans trou ni chevauchement.
	RoadWidth = Config.Dimensions.Road.Width,
	EdgeWidth = Config.Dimensions.Road.Edge,
	-- Rayon des virages, en fraction de la largeur de route.
	CornerRadius = 0.42,

	-- Aperçu local avant construction : même emprise que le liseré de route.
	PreviewScale = Config.Dimensions.Road.Edge,
	PreviewHeight = 0.045,
	PreviewY = 0.84,
	PreviewTransparency = 0.34,
	PreviewHoverTransparency = 0.48,
	PreviewValidColor = Config.Colors.Teal,
	PreviewInvalidColor = Config.Colors.Danger,
}

-- Couches du renderer de routes (RoadRenderer), en studs au-dessus du plateau.
-- Top : hauteur du dessus ; Thickness : épaisseur de la dalle. Une couche a une
-- seule hauteur : deux couches ne sont jamais coplanaires (pas de scintillement),
-- et le liseré passe toujours sous la surface graphite. Le pont est plus haut
-- que la route pour passer au-dessus de l'eau. Le rond-point (anneau, île) est
-- posé juste au-dessus de la route.
RoadConfig.Layers = {
	Edge = { Top = 0.29, Thickness = 0.12 },
	Body = { Top = 0.31, Thickness = 0.12 },
	BridgeEdge = { Top = 0.37, Thickness = 0.16 },
	Bridge = { Top = 0.40, Thickness = 0.16 },
	RoundaboutEdge = { Top = 0.325, Thickness = 0.03 },
	RoundaboutBody = { Top = 0.335, Thickness = 0.03 },
	RoundaboutIsland = { Top = 0.355, Thickness = 0.05 },
	-- Diamètres du rond-point, en fraction de case : l'anneau reste plus large
	-- qu'une route, l'île centrale laisse une chaussée circulaire.
	RoundaboutDiameter = 0.9,
	RoundaboutIslandDiameter = 0.4,
}

RoadConfig.Input = {
	-- La construction est validée au relâchement (InputController). L'aperçu
	-- reste local : Échap peut donc annuler sans avoir consommé de route.
	MaxCellsPerRequest = 512,
	-- Garde-fou d'un seul tracé orthogonal (RoadNetwork.manhattanPath) :
	-- distinct de la taille d'un lot, qui découpe un long geste en requêtes.
	MaxPathSteps = 512,
	-- Hystérésis : en dessous de ce seuil, on conserve le dernier axe.
	DragAxisThreshold = 0.35,
	-- Mouvement minimal (pixels écran) avant de décider d'un axe dominant.
	AxisMinPixels = 4,
	-- Rafraîchissement de l'aperçu survolé (secondes), pour suivre la caméra.
	HoverRefresh = 0.12,
	-- Zoom par pincement : variation de zoom pour un doublement de l'écart.
	PinchZoomGain = 1.5,
}

-- Apparition échelonnée des cases d'un même tracé (en secondes).
RoadConfig.Construction = {
	RevealStagger = 0.022,
	RevealStaggerMax = 0.28,
	-- Au-delà de ce nombre de cases neuves dans un même lot, elles apparaissent
	-- sans animation (une case animée = 2 à 6 pièces tweenées par le serveur).
	MaxAnimatedCells = 40,
}

RoadConfig.Traffic = {
	-- Ralentissement visuel dans les virages et les intersections.
	TurnSpeedFactor = 0.62,
	IntersectionApproachSlow = 0.76,
	-- La direction visuelle rejoint la direction réelle sans rotation sèche.
	HeadingLerp = 9,
	-- Redémarrage progressif après un arrêt.
	Acceleration = 2.2,
	Braking = 6,
	-- Une intersection (3 ou 4 voisins) est réservée à une voiture à la fois.
	IntersectionReservation = true,
}

-- Autoroutes : volontairement désactivées tant que leur logique de trajet
-- dédiée n'est pas branchée. Les ponts et les ronds-points sont des cartes de
-- Config.Rewards, pas un réglage ici.
RoadConfig.Infrastructure = {
	Highways = {
		Enabled = false,
	},
}

-- Voitures : tailles et trajectoires, en fraction d'une case sauf mention.
RoadConfig.Vehicle = {
	LengthTiles = Config.Dimensions.Car.Length,
	WidthTiles = Config.Dimensions.Car.Width,
	-- Hauteur de carrosserie, en studs (et non en fraction de case).
	Height = 0.4,
	-- Voie de droite : décalage latéral par rapport à l'axe de la route. Deux
	-- voies opposées restent séparées d'une voiture entière (2 x décalage) et
	-- la voiture reste dans la chaussée (demi-route - demi-voiture = 0.145).
	LaneOffsetTiles = 0.14,
	-- Virage : l'arc commence à cette distance du centre de la case.
	CornerCutTiles = 0.45,
	-- Produit scalaire au-dessous duquel l'enchaînement est un virage.
	TurnDot = 0.98,
	-- Vitesse de rotation maximale du cap (radians par seconde).
	TurnRate = 5,
	-- Freinage pour s'arrêter avant une intersection occupée, en fraction de
	-- Traffic.Braking : plus doux qu'un arrêt net, donc sans à-coup visible.
	StopBrakeFactor = 0.5,
	CurveSamples = 8,
	-- Distance d'observation des voitures qui précèdent sur le trajet.
	LookaheadTiles = 2.5,
	-- Zone de ralentissement progressif avant la distance de sécurité (studs).
	FollowBand = 2.4,
	-- Pas de simulation maximal (secondes) : un dt de 0.3 s est découpé.
	MaxStep = 0.1,
	-- Une voiture qui attend une case depuis ce délai (secondes) cherche si
	-- l'attente forme une boucle : si oui, une seule voiture de la boucle passe.
	DeadlockCheckTime = 1,
	-- Écart de cap (radians) au-delà duquel la voiture n'avance plus : elle
	-- pivote d'abord sur sa place après un demi-tour, au lieu de balayer la route.
	AlignAngle = 0.8,
	-- Dans un virage la voiture se rapproche de l'axe de la route (fraction du
	-- décalage de voie, au milieu de l'arc) : sa queue ne déborde pas du bord.
	CurveLanePull = 0.2,
}

return RoadConfig
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">RoadGeometry</string>
          <ProtectedString name="Source"><![CDATA[--[[
	RoadGeometry.luau
	Géométrie pure de la surface des routes. Ce module ne crée aucune instance :
	il décrit des formes que le renderer transforme en parts, et qui restent
	testables sans Roblox.

	Repère de la case : 0..1 sur chaque axe, origine en haut à gauche, +x vers
	la droite, +y vers le bas, centre (0.5, 0.5). Les directions suivent Grid :
	N = y-1, E = x+1, S = y+1, W = x-1.

	Pièces : { kind, layer, cx, cy, w, h, r, rotation }
	  kind      "rect" (w le long de x local, h le long de y local) ou "disk" (r).
	  layer     "edge"   : liseré (RoadConfig.Visual.EdgeWidth), dessous.
	            "body"   : surface graphite (RoadWidth).
	            "bridge" : surface d'une case de pont, à la place de "body".
	            Une couche a une seule hauteur et une seule couleur : les
	            chevauchements entre pièces d'une même couche sont invisibles.
	  rotation  0, 90, 180 ou 270 degrés. Les pièces produites ici valent 0.

	Formes (demi-largeur h, rayon d'angle r = CornerRadius * RoadWidth) :
	  - aucun bras : disque de rayon h (bloc rond) ;
	  - un bras    : bras du bord jusqu'au centre + disque de rayon h (capuchon) ;
	  - droite     : un rectangle plein ;
	  - T et croix : les rectangles des bras, qui se recouvrent au centre ;
	  - virage     : deux rectangles + un disque de rayon r dans le coin
	                 extérieur. Le coin intérieur reste vif : un congé concave
	                 est un carré moins un disque, impossible avec des unions
	                 de rectangles et de disques, et l'approcher par des parts
	                 coûterait plusieurs parts par virage. Il se lit comme
	                 l'angle rentrant d'un T : largeur constante, sans
	                 triangle ni trou.
	Un bras relié à un bâtiment (raccord) s'arrête exactement au bord de la case.
	Les pièces restent dans le carré central et dans les bras.

	API :
	  RoadGeometry.Dir                            bits N=1 E=2 S=4 W=8
	  RoadGeometry.connectorKey(x, y, dir)        "x:y>dir" ; dir = "N"|"E"|"S"|"W" (lettre, pas un bit)
	  RoadGeometry.neighborMask(roads, x, y, bridges?, connectors?) -> bits
	  RoadGeometry.classify(mask) -> kind, orientation
	      kind : "isolated" | "end" | "straight" | "corner" | "tee" | "cross"
	      orientation : "" | direction du bras | "NS"/"EW" | "NE"/"ES"/"SW"/"NW"
	                    | direction du bras-tige d'un T | "NESW"
	  RoadGeometry.cellPieces(roads, bridges, connectors, x, y, options?) -> pièces
	  RoadGeometry.affectedCells(key) -> { key, voisins N, E, S, W }
	options (facultatif) : RoadWidth, EdgeWidth, CornerRadius (fraction de
	RoadWidth). Par défaut RoadConfig.Visual.

	Les clés sont au format Grid ("x:y"). roads, bridges (ponts, sous-ensemble
	ou non de roads) et connectors sont des ensembles ; une case compte comme
	route si elle est dans roads ou bridges.
]]

local Grid = require(script.Parent.Grid)
local RoadConfig = require(script.Parent.RoadConfig)

local RoadGeometry = {}

local CENTER = 0.5
local EMPTY = {}

RoadGeometry.Dir = { N = 1, E = 2, S = 4, W = 8 }

-- Ordre fixe N, E, S, W : les noms de classification en découlent.
local ARMS = {
	{ name = "N", bit = RoadGeometry.Dir.N, dx = 0, dy = -1, opposite = "S" },
	{ name = "E", bit = RoadGeometry.Dir.E, dx = 1, dy = 0, opposite = "W" },
	{ name = "S", bit = RoadGeometry.Dir.S, dx = 0, dy = 1, opposite = "N" },
	{ name = "W", bit = RoadGeometry.Dir.W, dx = -1, dy = 0, opposite = "E" },
}

local function clamp(value, low, high)
	return math.max(low, math.min(value, high))
end

local function optionOr(options, name, fallback)
	if options and options[name] ~= nil then
		return options[name]
	end
	return fallback
end

-- Bras présents dans un masque, sous la forme name -> true.
local function armsOf(mask)
	local arms = {}
	for _, arm in ipairs(ARMS) do
		if math.floor(mask / arm.bit) % 2 == 1 then
			arms[arm.name] = true
		end
	end
	return arms
end

-- Noms des bras présents, dans l'ordre N, E, S, W.
local function namesOf(arms)
	local names = ""
	for _, arm in ipairs(ARMS) do
		if arms[arm.name] then
			names = names .. arm.name
		end
	end
	return names
end

function RoadGeometry.connectorKey(x, y, dir)
	return Grid.key(x, y) .. ">" .. dir
end

function RoadGeometry.neighborMask(roads, x, y, bridges, connectors)
	roads = roads or EMPTY
	bridges = bridges or EMPTY
	connectors = connectors or EMPTY
	local mask = 0
	for _, arm in ipairs(ARMS) do
		local neighborKey = Grid.key(x + arm.dx, y + arm.dy)
		if roads[neighborKey]
			or bridges[neighborKey]
			or connectors[RoadGeometry.connectorKey(x, y, arm.name)]
		then
			mask += arm.bit
		end
	end
	return mask
end

function RoadGeometry.classify(mask)
	local arms = armsOf(mask)
	local count = 0
	for _, arm in ipairs(ARMS) do
		if arms[arm.name] then
			count += 1
		end
	end

	if count == 0 then
		return "isolated", ""
	end
	if count == 1 then
		return "end", namesOf(arms)
	end
	if count == 2 then
		if (arms.N and arms.S) or (arms.E and arms.W) then
			return "straight", namesOf(arms)
		end
		return "corner", namesOf(arms)
	end
	if count == 3 then
		-- La tige d'un T est le seul bras dont l'opposé est absent.
		local stem = ""
		for _, arm in ipairs(ARMS) do
			if arms[arm.name] and not arms[arm.opposite] then
				stem = arm.name
			end
		end
		return "tee", stem
	end
	return "cross", namesOf(arms)
end

local function addRect(out, layer, x0, x1, y0, y1)
	local w, h = x1 - x0, y1 - y0
	if w <= 0 or h <= 0 then
		return
	end
	table.insert(out, {
		kind = "rect",
		layer = layer,
		cx = (x0 + x1) * 0.5,
		cy = (y0 + y1) * 0.5,
		w = w,
		h = h,
		r = 0,
		rotation = 0,
	})
end

local function addDisk(out, layer, cx, cy, r)
	if r <= 0 then
		return
	end
	table.insert(out, {
		kind = "disk",
		layer = layer,
		cx = cx,
		cy = cy,
		w = 2 * r,
		h = 2 * r,
		r = r,
		rotation = 0,
	})
end

-- Bras d'un côté, du bord de la case jusqu'au centre.
local function addStub(out, layer, name, low, high)
	if name == "N" then
		addRect(out, layer, low, high, 0, CENTER)
	elseif name == "S" then
		addRect(out, layer, low, high, CENTER, 1)
	elseif name == "E" then
		addRect(out, layer, CENTER, 1, low, high)
	else
		addRect(out, layer, 0, CENTER, low, high)
	end
end

-- Construit une couche complète (toutes les formes d'une case).
-- Les virages utilisent un arrondi dont le centre ne dépend pas de la largeur :
-- le liseré et la surface sont donc deux arcs concentriques.
local function buildLayer(out, layer, mask, width, radius)
	local half = width * 0.5
	local r = clamp(radius, 0, half)
	local low, high = CENTER - half, CENTER + half
	local arms = armsOf(mask)

	local count = 0
	for _, arm in ipairs(ARMS) do
		if arms[arm.name] then
			count += 1
		end
	end

	if count == 0 then
		addDisk(out, layer, CENTER, CENTER, half)
		return
	end
	if count == 1 then
		addStub(out, layer, namesOf(arms), low, high)
		addDisk(out, layer, CENTER, CENTER, half)
		return
	end

	local vertical = (arms.N and "N") or (arms.S and "S") or nil
	local horizontal = (arms.E and "E") or (arms.W and "W") or nil
	if count == 2 and vertical and horizontal then
		-- Coin extérieur : opposé aux deux bras. Le centre de l'arrondi est
		-- à distance (half - r) des deux côtés extérieurs.
		local vy = vertical == "N" and -1 or 1
		local hx = horizontal == "E" and 1 or -1
		local roundX = CENTER - hx * (half - r)
		local roundY = CENTER - vy * (half - r)
		local verticalEnd = CENTER + vy * CENTER
		local horizontalEnd = CENTER + hx * CENTER
		addRect(out, layer, low, high, math.min(verticalEnd, roundY), math.max(verticalEnd, roundY))
		addRect(out, layer, math.min(horizontalEnd, roundX), math.max(horizontalEnd, roundX), low, high)
		addDisk(out, layer, roundX, roundY, r)
		return
	end

	-- Droite, T et croix : les bras opposés forment une bande pleine.
	if arms.N and arms.S then
		addRect(out, layer, low, high, 0, 1)
	else
		if arms.N then
			addStub(out, layer, "N", low, high)
		end
		if arms.S then
			addStub(out, layer, "S", low, high)
		end
	end
	if arms.E and arms.W then
		addRect(out, layer, 0, 1, low, high)
	else
		if arms.E then
			addStub(out, layer, "E", low, high)
		end
		if arms.W then
			addStub(out, layer, "W", low, high)
		end
	end
end

function RoadGeometry.cellPieces(roads, bridges, connectors, x, y, options)
	roads = roads or EMPTY
	bridges = bridges or EMPTY
	local key = Grid.key(x, y)
	if not (roads[key] or bridges[key]) then
		return {}
	end

	local visual = RoadConfig.Visual
	local roadWidth = optionOr(options, "RoadWidth", visual.RoadWidth)
	local edgeWidth = optionOr(options, "EdgeWidth", visual.EdgeWidth)
	local cornerFraction = optionOr(options, "CornerRadius", visual.CornerRadius)
	local bodyRadius = cornerFraction * roadWidth

	local mask = RoadGeometry.neighborMask(roads, x, y, bridges, connectors)
	local pieces = {}
	-- Le liseré garde le même centre d'arrondi : son rayon augmente de la moitié
	-- de l'écart entre les deux largeurs.
	buildLayer(pieces, "edge", mask, edgeWidth, bodyRadius + (edgeWidth - roadWidth) * 0.5)
	buildLayer(pieces, bridges[key] and "bridge" or "body", mask, roadWidth, bodyRadius)
	return pieces
end

-- La case et ses quatre voisins : ce sont les seules dont les pièces changent
-- quand une route apparaît, disparaît ou devient un pont.
function RoadGeometry.affectedCells(key)
	local x, y = Grid.parse(key)
	if not x then
		return {}
	end
	local cells = { key }
	for _, arm in ipairs(ARMS) do
		table.insert(cells, Grid.key(x + arm.dx, y + arm.dy))
	end
	return cells
end

return RoadGeometry
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">RoadNetwork</string>
          <ProtectedString name="Source"><![CDATA[--[[
	RoadNetwork.luau
	Petites opérations partagées par le client et le serveur :
	  - voisinage orthogonal (ou 8 directions en mode historique) ;
	  - comptage des connexions d'une case (virage, T, croix) ;
	  - résolution d'un geste en chemin horizontal / vertical sans diagonale.

	La simulation reste dans Session : ce module ne possède aucune route et
	ne crée aucun objet.
]]

local Grid = require(script.Parent.Grid)
local RoadConfig = require(script.Parent.RoadConfig)

local RoadNetwork = {}

-- Décalages partagés avec Grid (ordre haut, droite, bas, gauche).
local ORTHOGONAL = Grid.ORTHOGONAL_OFFSETS
local DIAGONAL = Grid.DIAGONAL_OFFSETS

RoadNetwork.ORTHOGONAL = ORTHOGONAL
RoadNetwork.DIAGONAL = DIAGONAL

-- Nombre maximal de cases ajoutées par un seul tracé. Au-delà, le tracé
-- serait tronqué sans que l'appelant le sache : on le refuse en bloc.
local MAX_PATH_STEPS = RoadConfig.Input.MaxPathSteps

-- Vrai pour un nombre entier fini. NaN et l'infini échouent à ces deux tests.
local function isCell(value)
	return type(value) == "number" and value == math.floor(value) and math.abs(value) < math.huge
end

local function isFinite(value)
	return type(value) == "number" and math.abs(value) < math.huge
end

local function countAt(roads, x, y, offsets)
	local count = 0
	for _, offset in ipairs(offsets) do
		if roads[Grid.key(x + offset[1], y + offset[2])] then
			count += 1
		end
	end
	return count
end

function RoadNetwork.neighbors(x, y, allowDiagonals)
	local list = {}
	for _, direction in ipairs(ORTHOGONAL) do
		list[#list + 1] = { x + direction[1], y + direction[2] }
	end
	if allowDiagonals then
		for _, direction in ipairs(DIAGONAL) do
			list[#list + 1] = { x + direction[1], y + direction[2] }
		end
	end
	return list
end

function RoadNetwork.isAdjacent(ax, ay, bx, by, allowDiagonals)
	local dx = math.abs(bx - ax)
	local dy = math.abs(by - ay)
	if dx == 0 and dy == 0 then
		return false
	end
	if dy == 0 and dx == 1 then
		return true
	end
	if dx == 0 and dy == 1 then
		return true
	end
	return allowDiagonals == true and dx == 1 and dy == 1
end

-- Nombre de cases de route voisines. Les diagonales ne comptent que si
-- allowDiagonals : elles ne relient une case que dans ce mode.
function RoadNetwork.countRoadNeighbors(roads, x, y, allowDiagonals)
	local count = countAt(roads, x, y, ORTHOGONAL)
	if allowDiagonals then
		count += countAt(roads, x, y, DIAGONAL)
	end
	return count
end

function RoadNetwork.countRoadNeighborsAtKey(roads, key, allowDiagonals)
	local x, y = Grid.parse(key)
	if not x then
		return 0
	end
	return RoadNetwork.countRoadNeighbors(roads, x, y, allowDiagonals)
end

-- Seuil : 3 connexions ou plus = T ou croix, qui ont besoin d'un raccord.
function RoadNetwork.isIntersection(roads, x, y, allowDiagonals)
	return RoadNetwork.countRoadNeighbors(roads, x, y, allowDiagonals) >= 3
end

function RoadNetwork.isIntersectionKey(roads, key, allowDiagonals)
	return RoadNetwork.countRoadNeighborsAtKey(roads, key, allowDiagonals) >= 3
end

--[[
	Construit un chemin orthogonal entre deux cases, sans inclure la case de
	départ. Renvoie (cellules, complet) :
	  - complet vaut false si les coordonnées ne sont pas des entiers finis ou
	    si le trajet dépasse MAX_PATH_STEPS ; la liste est alors vide ;
	  - sinon la liste mène exactement à (toX, toY).
	preferredAxis vaut "x" (horizontal d'abord) ou "y" (vertical d'abord) ; sans
	préférence, l'axe dominant passe en premier, et à égalité c'est l'horizontal.
	Quand le trajet est droit, l'axe n'a pas d'effet.
]]
function RoadNetwork.manhattanPath(fromX, fromY, toX, toY, preferredAxis)
	local cells = {}
	if not (isCell(fromX) and isCell(fromY) and isCell(toX) and isCell(toY)) then
		return cells, false
	end

	local dx = toX - fromX
	local dy = toY - fromY
	local absX = math.abs(dx)
	local absY = math.abs(dy)
	if absX + absY > MAX_PATH_STEPS then
		return cells, false
	end

	local horizontalFirst
	if preferredAxis == "x" then
		horizontalFirst = true
	elseif preferredAxis == "y" then
		horizontalFirst = false
	else
		horizontalFirst = absX >= absY
	end

	local stepX = dx > 0 and 1 or -1
	local stepY = dy > 0 and 1 or -1
	local x, y = fromX, fromY
	if horizontalFirst then
		for _ = 1, absX do
			x += stepX
			cells[#cells + 1] = { x, y }
		end
		for _ = 1, absY do
			y += stepY
			cells[#cells + 1] = { x, y }
		end
	else
		for _ = 1, absY do
			y += stepY
			cells[#cells + 1] = { x, y }
		end
		for _ = 1, absX do
			x += stepX
			cells[#cells + 1] = { x, y }
		end
	end
	return cells, true
end

--[[
	Enchaîne une liste de cases cibles en tracé orthogonal depuis
	(startX, startY). Les coordonnées non entières sont ramenées à leur case
	(floor) ; une cible NaN, infinie ou absente est ignorée sans faire avancer
	le tracé. Chaque case n'apparaît qu'une fois et la case de départ n'est
	jamais renvoyée : si le tracé revient sur ses pas, une case déjà présente
	est omise, donc deux cases consécutives peuvent ne pas être voisines. La
	liste sert à poser des routes (un ensemble de cases), pas à être parcourue.
]]
function RoadNetwork.flattenPath(startX, startY, cells, preferredAxis)
	local result = {}
	if not (isFinite(startX) and isFinite(startY)) then
		return result
	end

	local x, y = math.floor(startX), math.floor(startY)
	local seen = { [Grid.key(x, y)] = true }
	for _, cell in ipairs(cells or {}) do
		if type(cell) == "table" and isFinite(cell[1]) and isFinite(cell[2]) then
			local tx, ty = math.floor(cell[1]), math.floor(cell[2])
			local steps, complete = RoadNetwork.manhattanPath(x, y, tx, ty, preferredAxis)
			if complete then
				for _, step in ipairs(steps) do
					local key = Grid.key(step[1], step[2])
					if not seen[key] then
						seen[key] = true
						result[#result + 1] = step
					end
				end
				x, y = tx, ty
			end
		end
	end
	return result
end

return RoadNetwork
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">StoreConfig</string>
          <ProtectedString name="Source"><![CDATA[--[[
	StoreConfig.luau
	Tous les réglages du système de magasins / destinations.
	Modifie ce fichier puis reconstruis avec tools\build.ps1.

	Les intervalles sont exprimés en secondes SIMULÉES. Session:update
	multiplie déjà dt par la vitesse choisie par le joueur : les magasins
	apparaissent donc plus vite en temps réel quand la simulation accélère,
	sans changer le rythme de la partie.
]]

local Config = require(script.Parent.Config)

local StoreConfig = {}

-- La palette est centralisée dans Config.HouseColors. Un magasin reçoit une
-- couleur unique ; les maisons de cette couleur ne desservent que ce magasin.
-- Pour ajouter une couleur, ajoute une entrée dans Config.HouseColors puis
-- augmente Spawn.MaxStores si nécessaire.
StoreConfig.Colors = Config.HouseColors

StoreConfig.Spawn = {
	MaxStores = 8,
	StartStores = 1,

	-- Si aucun emplacement valide n'est trouvé, on réessaie après ce délai.
	RetryDelay = 6,

	-- Distances exprimées en cases (distance euclidienne).
	MinStoreDistance = 4.4,
	MinBuildingDistance = 2.6,
	MinBuildableNeighbors = 3,
	MaxAttempts = 700,

	-- Paliers de difficulté. untilTime = temps simulé de fin du palier.
	-- Les valeurs d'un palier sont atteintes à son début ; entre deux
	-- paliers, l'intervalle glisse linéairement vers le palier suivant.
	-- Le dernier palier reste constant. Ordre croissant obligatoire.
	Tiers = {
		{ untilTime = 180, minInterval = 100, maxInterval = 120 },
		{ untilTime = 360, minInterval = 75, maxInterval = 100 },
		{ untilTime = 600, minInterval = 55, maxInterval = 75 },
		{ untilTime = 900, minInterval = 35, maxInterval = 55 },
		{ untilTime = 1200, minInterval = 25, maxInterval = 40 },
		{ untilTime = math.huge, minInterval = 15, maxInterval = 30 },
	},

	-- Zones de génération pondérées autour du centre de la carte.
	-- minRadius/maxRadius sont normalisés : 1 = demi-taille de la carte.
	Zones = {
		{ weight = 0.35, minRadius = 0.10, maxRadius = 0.35 },
		{ weight = 0.40, minRadius = 0.30, maxRadius = 0.65 },
		{ weight = 0.25, minRadius = 0.58, maxRadius = 0.84 },
	},
}

-- Diffusion vers le client (secondes réelles) : rafraîchissement rapide quand
-- l'état change (compte à rebours), sinon une mise à jour lente suffit.
StoreConfig.Sync = {
	DirtyDelay = 0.2,
	IdleDelay = 1.5,
}

StoreConfig.Demand = {
	-- Capacités demandées : petit magasin 6, grand magasin 8.
	SmallCapacity = 6,
	LargeCapacity = 8,

	-- Base de génération des demandes (secondes simulées).
	SmallInterval = 11.5,
	LargeInterval = 7.5,
	FirstDelayMin = 5,
	FirstDelayMax = 9,
	-- Variation relative aléatoire appliquée à chaque intervalle (±10 %).
	Jitter = 0.10,

	-- La difficulté augmente avec le temps : les demandes arrivent plus vite.
	RampDuration = 600,
	RampMinMultiplier = 0.70,
	MinInterval = 4,

	-- Surcharge : quand le magasin reste plein, le compte à rebours descend.
	-- À zéro, le magasin devient critique et draine la jauge de satisfaction.
	OverloadGrace = 12,
	OverloadDrainPerSecond = 1.25,

	-- Une demande réservée par une voiture ne peut pas être prise par une
	-- autre voiture. Si la voiture ne trouve aucun chemin après ce délai,
	-- elle libère sa réservation et rentre.
	ClaimTimeout = 18,
	NoDemandRetry = 2,
}

StoreConfig.Evolution = {
	MinAge = 95,
	CheckInterval = 14,
	Chance = 0.42,
	MinDeliveries = 3,
	MaxLargeStores = 6,
	AnimationDuration = Config.Style.Motion.Evolution,
	-- Variation relative de l'intervalle entre deux contrôles d'évolution.
	CheckJitter = 0.30,
}

StoreConfig.Houses = {
	StartHouses = 3,
	HousesPerStore = 2,
	MaxHousesPerStore = 3,
	MaxHouses = 16,
	SpawnInterval = 18,
	FirstSpawnDelay = 26,
	-- Aléa ajouté au délai de la première sortie d'une nouvelle maison.
	FirstTripJitter = 4,

	MinDistanceFromStore = 4,
	MaxDistanceFromStore = 9,
	-- Groupes : une nouvelle maison se pose près d'une maison déjà présente
	-- (même magasin) avec cette probabilité, sinon autour du magasin.
	ClusterChance = 0.6,
	ClusterMinDistance = 2.6,
	ClusterMaxDistance = 3.6,
	MaxAttempts = 500,
	MinDistanceFromBuilding = 2.6,
	MinBuildableNeighbors = 2,
}

StoreConfig.Visual = {
	-- Emprise dessinée des magasins (BuildingModels), en studs : même source que
	-- les bâtiments, pour que le décalage des pins colle au bâtiment.
	SmallSize = Config.Dimensions.Building.SmallStore * Config.Grid.TileSize,
	LargeSize = Config.Dimensions.Building.LargeStore * Config.Grid.TileSize,
	SpawnAnimationDuration = Config.Style.Motion.Spawn,
	EvolutionStartScale = 0.62,
	EvolutionDuration = Config.Style.Motion.Evolution,

	-- Pins de demande côté client (BillboardGui). Les tailles sont en pixels
	-- écran : elles restent lisibles au dézoom sans grossir au zoom avant.
	PinRowWidth = 64,
	PinRowHeight = 96,
	PinSize = Config.Dimensions.Pin.Size,
	PinGap = 4,
	PinsPerRow = 4,
	-- Décalage entre deux pins d'une même vague d'apparition (secondes).
	PinStagger = 0.05,
	PinAppearDuration = 0.24,
	PinRemoveDuration = 0.16,
	PinStrokeTransparency = 0.4,
	-- Écart en studs entre le bord du magasin et le bas des pins ; le décalage
	-- de caméra vers le haut de l'écran (world -Z) est calculé à partir de la
	-- taille du magasin, pour rester collé au bâtiment quand il évolue.
	PinLift = 1.4,
	PinEvolutionPop = 1.16,
	-- Les pins ne sont jamais masqués par la distance : la caméra reste proche.
	PinMaxDistance = 2000,
	PinWarningWidth = 28,
	PinWarningHeight = 12,
	PinWarningGap = 3,
	PinWarningTextSize = 10,
}

return StoreConfig
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">MiniMotorways</string>
      </Properties>
      <Item class="Script" referent="15">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <ProtectedString name="Source"><![CDATA[--[[
	Bootstrap.server.luau
	Point d'entrée serveur : prépare le monde, les remotes, les profils,
	puis fait tourner une Session par joueur.

	Chaque donnée venant d'un client est non fiable : débit limité par joueur
	et par remote, forme du payload vérifiée avant la Session, et aucune erreur
	d'une partie ne doit arrêter le serveur ni les autres parties.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Maps = require(Shared.Maps)
local Remotes = require(Shared.Remotes)
local SharedRoadConfig = require(Shared.RoadConfig)

local Session = require(script.Parent.Session)
local Profile = require(script.Parent.Profile)

local MAX_CELLS = SharedRoadConfig.Input.MaxCellsPerRequest

-- Limites d'entrée. Chaque remote a un seau à jetons par joueur : `burst`
-- actions d'un coup, puis `perSecond` actions par seconde en régime établi.
local NET = {
	MaxIdLength = 64,
	MaxKeyLength = 16,
	Limits = {
		StartGame = { burst = 3, perSecond = 0.5 },
		DrawRoad = { burst = 20, perSecond = 8 },
		EraseRoad = { burst = 30, perSecond = 15 },
		EraseRoads = { burst = 10, perSecond = 4 },
		PlaceRoundabout = { burst = 10, perSecond = 3 },
		SetSpeed = { burst = 10, perSecond = 4 },
		SetPaused = { burst = 10, perSecond = 4 },
		ChooseReward = { burst = 5, perSecond = 1 },
		RequestProfile = { burst = 5, perSecond = 1 },
		ResetRecords = { burst = 2, perSecond = 0.2 },
	},
}

-- Éclairage plat et pastel : ombres douces ou absentes, ambiance légère.
local LIGHTING = {
	Brightness = 0.8,
	ClockTime = 12,
	GeographicLatitude = 0,
	Ambient = Color3.fromHex("D8D2C5"),
	OutdoorAmbient = Color3.fromHex("E0D8C9"),
	GlobalShadows = false,
	ShadowSoftness = 0,
	EnvironmentDiffuseScale = 0.45,
	EnvironmentSpecularScale = 0,
	ExposureCompensation = -0.35,
}

-- Effets qui délavent, colorent ou floutent l'image : retirés s'ils existent.
local POST_EFFECT_CLASSES = {
	"BloomEffect",
	"BlurEffect",
	"ColorCorrectionEffect",
	"ColorGradingEffect",
	"DepthOfFieldEffect",
	"SunRaysEffect",
	"Atmosphere",
}

Players.CharacterAutoLoads = false

-- Une propriété refusée par le moteur ne doit pas arrêter tout le serveur :
-- le réglage est journalisé et le reste s'applique.
for property, value in pairs(LIGHTING) do
	local ok, err = pcall(function()
		Lighting[property] = value
	end)
	if not ok then
		warn("[MiniMotorways] Lighting." .. property .. " refusé : " .. tostring(err))
	end
end
for _, child in ipairs(Lighting:GetChildren()) do
	for _, className in ipairs(POST_EFFECT_CLASSES) do
		if child:IsA(className) then
			child:Destroy()
			break
		end
	end
end

local oldWorlds = Workspace:FindFirstChild("MMWorlds")
if oldWorlds then
	oldWorlds:Destroy()
end
local worlds = Instance.new("Folder")
worlds.Name = "MMWorlds"
worlds.Parent = Workspace

Remotes.setup()

local sessions = {} -- [player] = Session en cours
-- Joueurs en cours de sortie. Une lecture de profil encore en vol ne doit pas
-- lancer une partie pour eux : pendant la sortie, Player.Parent est encore
-- défini. Clés faibles : rien à nettoyer.
local departing = setmetatable({}, { __mode = "k" })
local buckets = {} -- [player] = { [remote] = { tokens, stamp } }
local warned = {} -- erreurs déjà journalisées (une fois par type)

-- Journalise une erreur une seule fois par type : les numéros de ligne ne
-- comptent pas, sinon chaque erreur paraîtrait nouvelle.
local function reportOnce(kind, err)
	local text = tostring(err)
	local signature = kind .. "|" .. (string.gsub(text, ":%d+:", ":"))
	if warned[signature] then
		return
	end
	warned[signature] = true
	warn("[MiniMotorways] " .. kind .. " : " .. text)
end

-- Exécute fn sans jamais propager l'erreur au moteur.
local function guard(kind, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		reportOnce(kind, err)
	end
	return ok
end

-- Seau à jetons : retourne false si le joueur a épuisé le débit de ce remote.
local function takeToken(player, name)
	local limit = NET.Limits[name]
	if not limit then
		return true
	end
	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local now = tick()
	local bucket = perPlayer[name]
	if not bucket then
		bucket = { tokens = limit.burst, stamp = now }
		perPlayer[name] = bucket
	end
	-- tick() suit l'horloge murale : un recalage en arrière ne doit pas
	-- retirer de jetons.
	bucket.tokens = math.min(limit.burst, bucket.tokens + math.max(0, now - bucket.stamp) * limit.perSecond)
	bucket.stamp = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and math.abs(value) ~= math.huge
end

local function isId(value)
	return type(value) == "string" and #value <= NET.MaxIdLength
end

local function isCellKey(value)
	return type(value) == "string" and #value <= NET.MaxKeyLength
end

local function isCell(cell)
	return type(cell) == "table" and #cell == 2 and isFiniteNumber(cell[1]) and isFiniteNumber(cell[2])
end

-- Liste bornée en nombre d'entrées, sans trou ni clé autre qu'un indice
-- entier. Le parcours s'arrête dès le premier dépassement : une table hostile
-- ne coûte jamais plus de maxCount + 1 tours.
local function isBoundedList(list, maxCount, check)
	if type(list) ~= "table" then
		return false
	end
	local count = 0
	for key, entry in pairs(list) do
		count += 1
		if count > maxCount or type(key) ~= "number" or not check(entry) then
			return false
		end
	end
	return #list == count
end

-- Emplacement de chaque joueur, qui fixe l'origine de sa ville. Un joueur
-- garde le sien tant qu'il est sur le serveur ; il est recyclé à sa sortie.
-- Ainsi une partie relancée retrouve son origine et les coordonnées ne
-- s'éloignent plus à chaque relance.
local slotOwners = {} -- [index] = player
local playerSlots = {} -- [player] = index

local function slotFor(player)
	local index = playerSlots[player]
	if index then
		return index
	end
	index = 1
	while slotOwners[index] do
		index += 1
	end
	slotOwners[index] = player
	playerSlots[player] = index
	return index
end

local function releaseSlot(player)
	local index = playerSlots[player]
	if index then
		slotOwners[index] = nil
		playerSlots[player] = nil
	end
end

local function activeSession(player)
	local session = sessions[player]
	if session and not session.destroyed then
		return session
	end
	return nil
end

local function destroySession(player)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	guard("destroy", session.destroy, session)
end

-- Une Session en erreur est arrêtée seule ; le joueur en est prévenu par Toast.
local function abortSession(player, err)
	reportOnce("session", err)
	destroySession(player)
	if player.Parent then
		Remotes.get("Toast"):FireClient(player, "La partie a été interrompue. Relancez-la depuis le menu.")
	end
end

-- Lit le profil. Si le joueur est parti pendant la lecture, l'entrée qui vient
-- d'être mise en cache n'aurait plus personne pour la libérer : on la rend ici
-- (Profile.forget garde seulement ce qui reste à écrire).
local function loadProfile(player)
	local records = Profile.load(player)
	if departing[player] then
		Profile.forget(player)
	end
	return records
end

local function sendProfile(player)
	local records = loadProfile(player)
	if player.Parent and not departing[player] then
		Remotes.get("Profile"):FireClient(player, records)
	end
end

local function startGame(player, mapId)
	-- Carte inconnue ou invalide : première carte, comme avant.
	local map = nil
	if isId(mapId) then
		map = Maps.getById(mapId)
	end
	map = map or Maps.all()[1]

	-- Le profil doit être en cache avant la partie : la fin de partie y
	-- enregistre le score sans attendre le DataStore (Heartbeat).
	loadProfile(player)
	if not player.Parent or departing[player] then
		return
	end

	-- Partie précédente détruite après le yield, sinon elle resterait active.
	destroySession(player)
	local created, session = pcall(Session.new, player, map.id, slotFor(player))
	if not created then
		abortSession(player, session)
		return
	end
	sessions[player] = session
	local started, err = pcall(session.start, session)
	if not started then
		abortSession(player, err)
	end
end

local function withSession(action)
	return function(player, ...)
		local session = activeSession(player)
		if session then
			action(session, ...)
		end
	end
end

-- Relie un RemoteEvent : débit, puis forme du payload, puis action. Toute
-- erreur est journalisée une fois et ne remonte jamais au moteur.
local function runBound(validate, action, player, ...)
	if validate and not validate(...) then
		return
	end
	action(player, ...)
end

local function bind(name, validate, action)
	Remotes.get(name).OnServerEvent:Connect(function(player, ...)
		if not takeToken(player, name) then
			return
		end
		guard(name, runBound, validate, action, player, ...)
	end)
end

bind("StartGame", nil, startGame)

bind("DrawRoad", function(cells)
	return isBoundedList(cells, MAX_CELLS, isCell)
end, withSession(function(session, cells)
	session:drawRoad(cells)
end))

bind("EraseRoad", isCellKey, withSession(function(session, key)
	session:eraseRoad(key)
end))

bind("EraseRoads", function(keys)
	return isBoundedList(keys, MAX_CELLS, isCellKey)
end, withSession(function(session, keys)
	session:eraseRoads(keys)
end))

bind("SetPaused", function(paused)
	return type(paused) == "boolean"
end, withSession(function(session, paused)
	session:setPaused(paused)
end))

bind("SetSpeed", isFiniteNumber, withSession(function(session, speed)
	session:setSpeed(speed)
end))

bind("PlaceRoundabout", function(x, y)
	return isFiniteNumber(x) and isFiniteNumber(y)
end, withSession(function(session, x, y)
	session:placeRoundabout(x, y)
end))

bind("ChooseReward", isId, withSession(function(session, optionId)
	session:chooseReward(optionId)
end))

bind("ReturnToLobby", nil, function(player)
	destroySession(player)
end)

bind("RequestProfile", nil, function(player)
	sendProfile(player)
end)

bind("ResetRecords", nil, function(player)
	Profile.reset(player)
	sendProfile(player)
end)

local function onPlayerAdded(player)
	task.spawn(guard, "profile", sendProfile, player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	onPlayerAdded(player)
end

-- Sortie : la partie est détruite, le profil écrit une seule fois (il est
-- propre ensuite), puis le cache libéré si rien n'attend d'être écrit.
Players.PlayerRemoving:Connect(function(player)
	departing[player] = true
	destroySession(player)
	guard("save", Profile.save, player)
	Profile.forget(player)
	buckets[player] = nil
	releaseSlot(player)
end)

-- Une partie qui échoue est arrêtée seule : les autres continuent. Les
-- erreurs sont collectées pendant le parcours et traitées après, pour ne
-- jamais modifier `sessions` pendant qu'on le parcourt.
RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, Config.Time.MaxFrameDt)
	local failed = nil
	for player, session in pairs(sessions) do
		local ok, err = pcall(session.update, session, dt)
		if not ok then
			failed = failed or {}
			table.insert(failed, { player = player, err = err })
		end
	end
	if failed then
		for _, item in ipairs(failed) do
			abortSession(item.player, item.err)
		end
	end
end)

-- Sauvegarde périodique : les scores modifiés ne restent pas seulement en mémoire.
task.spawn(function()
	while true do
		task.wait(Profile.AUTOSAVE_SECONDS)
		guard("autosave", Profile.flushAll)
	end
end)

game:BindToClose(function()
	guard("shutdown", Profile.flushAll)
end)

warn("[MiniMotorways] Server ready — " .. Config.GameName .. " v" .. Config.Version)
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">BuildingModels</string>
          <ProtectedString name="Source"><![CDATA[--[[
	BuildingModels.luau
	Construction visuelle pure des maisons et des magasins. Aucune logique de
	partie : SessionBuildings décide où et quand un bâtiment existe, ce module
	fabrique son Model.

	Tout reste dans la case : une maison occupe au plus 0.62 de la case, un
	magasin au plus 0.9, ombre comprise. Une route posée dans la case voisine
	touche la limite de la case sans jamais traverser le bâtiment.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local BuildingShapes = require(script.Parent.BuildingShapes)
local SessionUtil = require(script.Parent.SessionUtil)

local BuildingModels = {}

local PALETTE = Config.HouseColors
local CELL = Config.Grid.TileSize
local HALF_CELL = CELL * 0.5
local WHITE = Config.Colors.White
local SHADOW_COLOR = Config.Colors.BuildingShadow

-- Tailles en fraction de la case, rayon des coins et ombre : tout vient de
-- Config, pour que les pins et les voitures lisent les mêmes valeurs.
local SIZE = Config.Dimensions.Building
local CORNER_RATIO = Config.Style.BuildingCornerRatio
local SHADOW = Config.Style.Shadow

-- Hauteurs (bas de chaque couche). Les routes montent jusqu'à 0.40 (tablier
-- d'un pont, RoadConfig.Layers) : tous les bâtiments sont posés au-dessus, sans
-- faces coplanaires entre couches.
local LAYER = {
	Shadow = { bottom = 0.38, height = 0.04 },
	Halo = { bottom = 0.40, height = 0.10 },
	Body = { bottom = 0.42, height = 0.14 },
	Pad = { bottom = 0.42, height = 0.08 },
	Detail = { bottom = 0.56, height = 0.05 },
}

local ENTRANCE_PAD_WIDTH = 0.5
local ENTRANCE_PAD_MIN_DEPTH = 0.2
local HALO_WIDTH = 0.06
local LARGE_LOGO_RATIO = 0.36
local SMALL_LOGO_RATIO = 0.28
local DOT_DIAMETER = 0.36
local RIDGE_LENGTH_RATIO = 0.56
local RIDGE_THICKNESS = 0.2

-- Quatre variantes discrètes par couleur : proportions du socle (fraction de
-- la taille de base) et petit détail de toit. Le détail garde la couleur du
-- groupe. L'orientation est choisie à part, par quart de tour.
local HOUSE_VARIANTS = {
	{ width = 1.00, depth = 0.90, detail = nil },
	{ width = 0.90, depth = 1.00, detail = "Chimney" },
	{ width = 0.94, depth = 0.84, detail = "Garden" },
	{ width = 1.00, depth = 0.96, detail = "Chimney" },
}

local function paletteFor(colorIndex)
	local palette = PALETTE[colorIndex] or PALETTE[1]
	local color = palette.color
	local base = palette.base or color:Lerp(Config.Colors.Ink, 0.22)
	return color, base
end

-- Point situé dans le repère local d'un bâtiment tourné de `angle`, ramené
-- au monde. Sert à placer le toit, le détail et l'entrée.
local function pointAt(center, angle, localX, localZ)
	local frame = CFrame.new(center) * CFrame.Angles(0, angle, 0)
	return frame:PointToWorldSpace(Vector3.new(localX, 0, localZ))
end

local function shadowCenter(center)
	return center + Vector3.new(SHADOW.Offset, 0, SHADOW.Offset)
end

-- Entrée : une petite dalle blanche qui relie le bord du bâtiment à la limite
-- de la case, du côté de la route. `extent` est la demi-taille du bâtiment
-- dans la direction de l'entrée.
local function addEntrance(model, center, entranceAngle, extent)
	local depth = math.max(ENTRANCE_PAD_MIN_DEPTH, HALF_CELL - extent - 0.02)
	local normal = Vector3.new(math.sin(entranceAngle), 0, math.cos(entranceAngle))
	BuildingShapes.rect(
		model,
		"Entrance",
		center + normal * (extent + depth * 0.5),
		ENTRANCE_PAD_WIDTH,
		depth,
		LAYER.Pad.bottom,
		LAYER.Pad.height,
		WHITE,
		entranceAngle
	)
end

-- Variante, orientation et dimensions d'une maison, déduites de son identifiant :
-- le même résultat sert à la construction et au recalcul de l'entrée.
local function houseFootprint(id)
	local variant = HOUSE_VARIANTS[id % #HOUSE_VARIANTS + 1]
	local turn = (math.floor(id / #HOUSE_VARIANTS) % 4) * math.pi * 0.5
	local side = SIZE.House * CELL
	return variant, turn, side * variant.width, side * variant.depth
end

-- Demi-taille du bâtiment dans la direction de l'entrée : la dalle part du bord
-- réel, que l'orientation soit horizontale ou verticale.
local function entranceExtent(kind, id, storeType, entranceAngle)
	if kind ~= "house" then
		local size = (storeType == "large" and SIZE.LargeStore or SIZE.SmallStore) * CELL
		return size * 0.5
	end
	local _, turn, width, depth = houseFootprint(id)
	local facesDepth = math.abs(math.cos(entranceAngle - turn)) > 0.5
	return facesDepth and depth * 0.5 or width * 0.5
end

local function buildHouse(model, center, id, color, base, entranceAngle)
	local variant, turn, width, depth = houseFootprint(id)
	local radius = math.min(width, depth) * CORNER_RATIO

	BuildingShapes.ellipse(
		model,
		"Shadow",
		shadowCenter(center),
		width + SHADOW.Grow,
		depth + SHADOW.Grow,
		LAYER.Shadow.bottom,
		LAYER.Shadow.height,
		SHADOW_COLOR,
		turn,
		SHADOW.Transparency
	)
	local body = BuildingShapes.roundedRect(
		model,
		"Body",
		center,
		width,
		depth,
		radius,
		LAYER.Body.bottom,
		LAYER.Body.height,
		color,
		turn
	)

	-- Toit bi-ton : une arête plus foncée posée sur la moitié arrière.
	BuildingShapes.rect(
		model,
		"Ridge",
		pointAt(center, turn, 0, -depth * 0.12),
		width * RIDGE_LENGTH_RATIO,
		RIDGE_THICKNESS,
		LAYER.Detail.bottom,
		LAYER.Detail.height,
		base,
		turn
	)

	if variant.detail == "Chimney" then
		BuildingShapes.circle(
			model,
			"Chimney",
			pointAt(center, turn, -width * 0.26, depth * 0.24),
			DOT_DIAMETER,
			LAYER.Detail.bottom,
			LAYER.Detail.height,
			base
		)
	elseif variant.detail == "Garden" then
		BuildingShapes.circle(
			model,
			"Garden",
			pointAt(center, turn, width * 0.26, depth * 0.24),
			DOT_DIAMETER,
			LAYER.Detail.bottom,
			LAYER.Detail.height,
			base
		)
	end

	addEntrance(model, center, entranceAngle, entranceExtent("house", id, nil, entranceAngle))
	return body
end

local function buildSmallStore(model, center, color, entranceAngle)
	local side = SIZE.SmallStore * CELL
	local radius = side * CORNER_RATIO

	local body = BuildingShapes.roundedRect(
		model,
		"Body",
		center,
		side,
		side,
		radius,
		LAYER.Body.bottom,
		LAYER.Body.height,
		color,
		0
	)
	BuildingShapes.roundedRect(
		model,
		"Shadow",
		shadowCenter(center),
		side + SHADOW.Grow,
		side + SHADOW.Grow,
		radius + SHADOW.Grow * 0.5,
		LAYER.Shadow.bottom,
		LAYER.Shadow.height,
		SHADOW_COLOR,
		0,
		SHADOW.Transparency
	)
	BuildingShapes.circle(
		model,
		"Logo",
		center,
		side * SMALL_LOGO_RATIO,
		LAYER.Detail.bottom,
		LAYER.Detail.height,
		WHITE
	)
	addEntrance(model, center, entranceAngle, side * 0.5)
	return body
end

local function buildLargeStore(model, center, color, entranceAngle)
	local diameter = SIZE.LargeStore * CELL

	BuildingShapes.circle(
		model,
		"Shadow",
		shadowCenter(center),
		diameter + SHADOW.Grow,
		LAYER.Shadow.bottom,
		LAYER.Shadow.height,
		SHADOW_COLOR,
		SHADOW.Transparency
	)
	-- Liseré blanc fin : sépare le disque du sol sans contour noir.
	BuildingShapes.circle(
		model,
		"Halo",
		center,
		diameter + HALO_WIDTH * 2,
		LAYER.Halo.bottom,
		LAYER.Halo.height,
		WHITE
	)
	local body = BuildingShapes.circle(
		model,
		"Body",
		center,
		diameter,
		LAYER.Body.bottom,
		LAYER.Body.height,
		color
	)
	BuildingShapes.circle(
		model,
		"Logo",
		center,
		diameter * LARGE_LOGO_RATIO,
		LAYER.Detail.bottom,
		LAYER.Detail.height,
		WHITE
	)
	addEntrance(model, center, entranceAngle, diameter * 0.5)
	return body
end

-- Construit le Model d'une maison ou d'un magasin, posé sur la case dont le
-- centre au sol est `cellCenter`. options :
--   parent         dossier où ranger le Model (optionnel)
--   entranceAngle  angle de lacet de l'entrée (0, pi/2, pi ou -pi/2 ; défaut 0)
-- Renvoie le Model ; la partie logique (taille de la case, animations) reste
-- au Session appelant.
function BuildingModels.build(kind, id, cellCenter, colorIndex, storeType, options)
	options = options or {}
	local isStore = kind == "store"
	local isLarge = isStore and storeType == "large"
	local color, base = paletteFor(colorIndex)
	local center = Vector3.new(cellCenter.X, 0, cellCenter.Z)
	local entranceAngle = options.entranceAngle or 0

	local model = Instance.new("Model")
	model.Name = kind .. "_" .. tostring(id) .. (isStore and ("_" .. (storeType or "small")) or "")

	local body
	if not isStore then
		body = buildHouse(model, center, id, color, base, entranceAngle)
	elseif isLarge then
		body = buildLargeStore(model, center, color, entranceAngle)
	else
		body = buildSmallStore(model, center, color, entranceAngle)
	end
	model.PrimaryPart = body

	model:SetAttribute("BuildingKind", kind)
	model:SetAttribute("BuildingId", id)
	model:SetAttribute("ColorIndex", colorIndex)
	if isStore then
		model:SetAttribute("StoreType", storeType or "small")
	end
	if options.parent then
		model.Parent = options.parent
	end
	return model
end

local function forEachPart(model, callback)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			callback(descendant)
		end
	end
end

-- Remet l'entrée d'un bâtiment déjà construit vers un autre côté. Seule la
-- dalle est refaite (une part) : le reste du Model ne bouge pas.
function BuildingModels.aimEntrance(model, cellCenter, kind, id, storeType, entranceAngle)
	local old = model:FindFirstChild("Entrance")
	if old then
		old:Destroy()
	end
	local center = Vector3.new(cellCenter.X, 0, cellCenter.Z)
	addEntrance(model, center, entranceAngle, entranceExtent(kind, id, storeType, entranceAngle))
end

-- Fondu sortant : toutes les parts deviennent transparentes. Le Model doit
-- être détruit par l'appelant après la durée. `tweens` (table de Session)
-- permet d'arrêter les tweens à la fin de la partie.
function BuildingModels.fadeOut(model, duration, tweens)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	forEachPart(model, function(part)
		SessionUtil.trackTween(tweens, TweenService:Create(part, info, { Transparency = 1 })):Play()
	end)
end

-- Fondu entrant : chaque part repart de l'opacité nulle puis rejoint sa
-- transparence de construction (l'ombre reste discrète).
function BuildingModels.fadeIn(model, duration, tweens)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	forEachPart(model, function(part)
		local target = part.Transparency
		part.Transparency = 1
		SessionUtil.trackTween(tweens, TweenService:Create(part, info, { Transparency = target })):Play()
	end)
end

return BuildingModels
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">BuildingShapes</string>
          <ProtectedString name="Source"><![CDATA[--[[
	BuildingShapes.luau
	Formes plates des bâtiments, vues du dessus : rectangle, ellipse, cercle et
	rectangle à coins arrondis. Chaque forme est faite de Parts ancrées, sans
	collision ni ombre portée, posées entre bottomY et bottomY + height.
	Aucune logique de partie ici : seulement de la géométrie.
]]

local SessionUtil = require(script.Parent.SessionUtil)
local makePart = SessionUtil.makePart

local BuildingShapes = {}

-- Un Cylinder a son axe selon X : la rotation le couche debout, son disque
-- est alors dans le plan XZ, comme les cases vues d'en haut.
local CYLINDER_UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

-- Pour un angle de lacet donné, le local Z pointe vers (sin, 0, cos) : c'est
-- la convention de l'entrée des bâtiments.
local function plate(center, bottomY, height, angle)
	return CFrame.new(center.X, bottomY + height * 0.5, center.Z) * CFrame.Angles(0, angle or 0, 0)
end

function BuildingShapes.rect(parent, name, center, width, depth, bottomY, height, color, angle, transparency)
	return makePart({
		Name = name,
		Parent = parent,
		Size = Vector3.new(width, height, depth),
		CFrame = plate(center, bottomY, height, angle),
		Color = color,
		Transparency = transparency or 0,
		CastShadow = false,
	})
end

function BuildingShapes.ellipse(parent, name, center, width, depth, bottomY, height, color, angle, transparency)
	return makePart({
		Name = name,
		Parent = parent,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, width, depth),
		CFrame = plate(center, bottomY, height, angle) * CYLINDER_UPRIGHT,
		Color = color,
		Transparency = transparency or 0,
		CastShadow = false,
	})
end

function BuildingShapes.circle(parent, name, center, diameter, bottomY, height, color, transparency)
	return BuildingShapes.ellipse(parent, name, center, diameter, diameter, bottomY, height, color, 0, transparency)
end

-- Rectangle à coins arrondis : deux traverses qui se croisent et quatre
-- disques aux coins, soit six parts. Renvoie la traverse horizontale, qui
-- sert de PrimaryPart au modèle.
-- Ces parts se chevauchent : en translucide, chaque recouvrement serait
-- mélangé deux ou trois fois et dessinerait une croix plus foncée. Une forme
-- translucide (une ombre) reste donc une seule part, à coins droits.
function BuildingShapes.roundedRect(parent, name, center, width, depth, radius, bottomY, height, color, angle, transparency)
	local alpha = transparency or 0
	if alpha > 0 then
		return BuildingShapes.rect(parent, name, center, width, depth, bottomY, height, color, angle, alpha)
	end

	local r = math.min(radius, width * 0.45, depth * 0.45)
	local frame = plate(center, bottomY, height, angle)

	local first = makePart({
		Name = name,
		Parent = parent,
		Size = Vector3.new(width, height, depth - 2 * r),
		CFrame = frame,
		Color = color,
		Transparency = alpha,
		CastShadow = false,
	})
	makePart({
		Name = name,
		Parent = parent,
		Size = Vector3.new(width - 2 * r, height, depth),
		CFrame = frame,
		Color = color,
		Transparency = alpha,
		CastShadow = false,
	})
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			makePart({
				Name = name,
				Parent = parent,
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(height, 2 * r, 2 * r),
				CFrame = frame * CFrame.new(sx * (width * 0.5 - r), 0, sz * (depth * 0.5 - r)) * CYLINDER_UPRIGHT,
				Color = color,
				Transparency = alpha,
				CastShadow = false,
			})
		end
	end
	return first
end

return BuildingShapes
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">CarModel</string>
          <ProtectedString name="Source"><![CDATA[--[[
	CarModel.luau
	Voiture vue du dessus : une carrosserie en capsule (un bloc et deux disques
	d'extrémité), une petite vitre claire à l'avant et une ombre très douce.
	Cinq pièces au maximum par voiture, sans contour.
	Le modèle est construit à l'origine et la pièce Body lui sert de pivot :
	Session le place et l'oriente avec PivotTo.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local RoadConfig = require(Shared.RoadConfig)
local SessionUtil = require(script.Parent.SessionUtil)
local makePart = SessionUtil.makePart

local CarModel = {}

-- Hauteur (studs) du centre de la voiture : le bas de la carrosserie touche le
-- dessus de la route. Session s'en sert pour poser et déplacer la voiture.
CarModel.CenterY = 0.5

local SHADOW = Config.Style.Shadow
-- Dessus le plus haut d'une chaussée au sol : la route ou l'anneau d'un
-- rond-point (sur un pont, l'ombre reste cachée sous le tablier).
local ROAD_TOP = math.max(RoadConfig.Layers.Body.Top, RoadConfig.Layers.RoundaboutBody.Top)

-- Un cylindre a son axe sur X ; cette rotation le couche sur l'axe Y pour
-- en faire un disque vu du dessus.
local DISK_ROTATION = CFrame.Angles(0, 0, math.rad(90))

-- L'avant de la voiture est sur -Z, comme pour CFrame.lookAt.
function CarModel.create(color, tile)
	local vehicle = RoadConfig.Vehicle
	local length = tile * vehicle.LengthTiles
	local width = tile * vehicle.WidthTiles
	local height = vehicle.Height
	-- Les deux disques d'extrémité complètent la longueur du bloc central.
	local bodyLength = length - width

	local model = Instance.new("Model")
	model.Name = "Car"

	local body = makePart({
		Name = "Body",
		Parent = model,
		Size = Vector3.new(width, height, bodyLength),
		Color = color,
		CastShadow = false,
	})
	model.PrimaryPart = body

	for _, side in ipairs({ -1, 1 }) do
		makePart({
			Name = "Cap",
			Parent = model,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(height, width, width),
			CFrame = CFrame.new(0, 0, side * bodyLength * 0.5) * DISK_ROTATION,
			Color = color,
			CastShadow = false,
		})
	end

	-- Vitre claire à l'avant : elle montre le sens de la voiture.
	makePart({
		Name = "Window",
		Parent = model,
		Size = Vector3.new(width * 0.6, 0.02, length * 0.24),
		CFrame = CFrame.new(0, height * 0.5 + 0.01, -length * 0.2),
		Color = Config.Colors.White,
		CastShadow = false,
	})

	-- Ombre douce (Config.Style.Shadow), décalée vers le bas-droit, posée juste
	-- au-dessus de la route et de l'anneau des ronds-points : en dessous elle
	-- serait invisible.
	makePart({
		Name = "Shadow",
		Parent = model,
		Size = Vector3.new(width + SHADOW.Grow, 0.02, length + SHADOW.Grow),
		CFrame = CFrame.new(SHADOW.Offset, ROAD_TOP + 0.015 - CarModel.CenterY, SHADOW.Offset),
		Color = Config.Colors.BuildingShadow,
		Transparency = SHADOW.Transparency,
		CastShadow = false,
	})

	return model
end

return CarModel
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Profile</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Profile.luau
	Meilleurs scores par carte, sauvegardés dans un DataStore.

	Règles de sûreté des données :
	  - le cache mémoire n'est jamais jeté tant qu'une écriture n'a pas réussi ;
	  - un profil dont la lecture a échoué n'est jamais écrit : une table vide
	    écrite par-dessus les vrais scores les effacerait. Il est relu plus tard
	    et les deux copies sont fusionnées (meilleur score par carte) ;
	  - submit ne bloque jamais : il est appelé à la fin d'une partie, dans le
	    Heartbeat. La sauvegarde a lieu à intervalle régulier, à la sortie du
	    joueur et à la fermeture du serveur.
	En Studio sans API Services, tout fonctionne quand même : les scores restent
	en mémoire pour la session.
]]

local DataStoreService = game:GetService("DataStoreService")

local Profile = {}

-- Nom historique conservé : les scores déjà enregistrés restent lisibles.
local STORE_NAME = "MiniMotorwaysV1"
-- Schéma 2 : { schema = 2, records = { [mapId] = meilleur score } }.
-- Le schéma 1 (table plate mapId -> score) est lu puis réécrit en schéma 2.
local SCHEMA_VERSION = 2
local MAX_SCORE = 1e9
local MAX_MAP_ID_LENGTH = 64
local LOAD_ATTEMPTS = 3
local SAVE_ATTEMPTS = 4
local RETRY_BASE_SECONDS = 1
local RELOAD_SECONDS = 15
local FLUSH_TIMEOUT_SECONDS = 25
local SAVE_POLL_SECONDS = 0.1

-- Intervalle des sauvegardes régulières (utilisé par Bootstrap).
Profile.AUTOSAVE_SECONDS = 60

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[MiniMotorways] DataStore unavailable: " .. tostring(result))
	end
end

-- cache[userId] = { userId, key, records, loaded, dirty, saving, departed }
local cache = {}
-- Lectures en cours (userId -> true). Le profil est demandé à l'arrivée du
-- joueur et au lancement de sa première partie : sans cela, deux lectures
-- simultanées doubleraient les appels GetAsync (quota) et les tentatives.
local loading = {}

local function keyFor(userId)
	return "player_" .. tostring(userId)
end

-- Un score est un nombre fini, positif, entier et borné. Tout le reste est rejeté.
local function cleanScore(value)
	local n = tonumber(value)
	if not n or n ~= n or math.abs(n) == math.huge or n < 0 then
		return nil
	end
	return math.min(math.floor(n), MAX_SCORE)
end

local function bestOf(records, mapId)
	return cleanScore(records[mapId]) or 0
end

-- Lit une valeur stockée (schéma 2 ou ancien schéma plat) et ne garde que des
-- entrées valides. Une valeur inconnue donne un profil vide.
local function decode(value)
	local records = {}
	if type(value) ~= "table" then
		return records
	end
	local source = value
	if value.schema == SCHEMA_VERSION and type(value.records) == "table" then
		source = value.records
	end
	for mapId, raw in pairs(source) do
		local score = cleanScore(raw)
		if
			type(mapId) == "string"
			and #mapId > 0
			and #mapId <= MAX_MAP_ID_LENGTH
			and mapId ~= "schema"
			and mapId ~= "records"
			and score
		then
			records[mapId] = score
		end
	end
	return records
end

-- Lecture avec nouvelles tentatives espacées. Retourne (true, valeur), ou
-- (false) si le magasin reste injoignable : le profil est alors non chargé.
local function fetch(key)
	if not store then
		return true, nil
	end
	for attempt = 1, LOAD_ATTEMPTS do
		local ok, value = pcall(function()
			return store:GetAsync(key)
		end)
		if ok then
			return true, value
		end
		warn("[MiniMotorways] Could not load profile (essai " .. attempt .. "/" .. LOAD_ATTEMPTS .. "): " .. tostring(value))
		if attempt < LOAD_ATTEMPTS then
			task.wait(RETRY_BASE_SECONDS * 2 ^ (attempt - 1))
		end
	end
	return false, nil
end

-- Fusion sans perte : pour chaque carte, le meilleur score gagne. Le résultat
-- est réécrit au prochain passage de sauvegarde.
local function mergeStored(entry, stored)
	for mapId, score in pairs(stored) do
		if bestOf(entry.records, mapId) < score then
			entry.records[mapId] = score
		end
	end
	entry.dirty = true
end

local reloadUntilLoaded

-- Relance la lecture d'un profil resté non chargé, jusqu'à réussite ou jusqu'à
-- ce que l'entrée ne soit plus en cache (joueur parti sans rien à sauver).
reloadUntilLoaded = function(entry)
	while cache[entry.userId] == entry and not entry.loaded do
		task.wait(RELOAD_SECONDS)
		if cache[entry.userId] == entry and not entry.loaded then
			local ok, value = fetch(entry.key)
			if ok then
				mergeStored(entry, decode(value))
				entry.loaded = true
			end
		end
	end
end

-- Écrit une entrée modifiée, avec nouvelles tentatives espacées. Une entrée
-- non chargée n'est jamais écrite (voir l'en-tête). Ne doit pas être appelée
-- dans le Heartbeat : elle attend entre les essais.
local function saveEntry(entry)
	if not store then
		entry.dirty = false
		return true
	end
	-- Une écriture déjà en cours : on attend son résultat, même si `dirty` est
	-- déjà repassé à faux (il l'est pendant l'écriture), sinon la sortie du
	-- joueur libérerait une entrée dont l'écriture peut encore échouer.
	if entry.saving then
		while entry.saving do
			task.wait(SAVE_POLL_SECONDS)
		end
		return not entry.dirty
	end
	if not entry.dirty then
		return true
	end
	if not entry.loaded then
		return false
	end

	entry.saving = true
	local written = false
	for attempt = 1, SAVE_ATTEMPTS do
		-- Une modification pendant l'écriture rouvre l'entrée : elle sera réécrite.
		entry.dirty = false
		local ok, err = pcall(function()
			store:SetAsync(entry.key, { schema = SCHEMA_VERSION, records = entry.records })
		end)
		if ok then
			written = true
			break
		end
		entry.dirty = true
		warn("[MiniMotorways] Could not save profile (essai " .. attempt .. "/" .. SAVE_ATTEMPTS .. "): " .. tostring(err))
		if attempt < SAVE_ATTEMPTS then
			task.wait(RETRY_BASE_SECONDS * 2 ^ (attempt - 1))
		end
	end
	entry.saving = false
	-- Joueur parti dont la dernière écriture vient d'aboutir : le cache peut être libéré.
	if written and entry.departed and cache[entry.userId] == entry then
		cache[entry.userId] = nil
	end
	return written
end

-- Retourne la table des records du joueur (carte -> meilleur score). Peut
-- attendre le DataStore la première fois : à appeler hors Heartbeat.
function Profile.load(player)
	local userId = player.UserId
	local cached = cache[userId]
	if cached then
		-- Joueur revenu avant l'écriture de ses données : l'entrée reste en service.
		cached.departed = nil
		return cached.records
	end

	-- Une lecture est déjà en vol pour ce joueur : on attend son résultat.
	if loading[userId] then
		while loading[userId] do
			task.wait(SAVE_POLL_SECONDS)
		end
		cached = cache[userId]
		if cached then
			cached.departed = nil
			return cached.records
		end
		-- La première lecture n'a rien mis en cache (joueur parti) : on lit à notre tour.
	end

	local key = keyFor(userId)
	loading[userId] = true
	local ok, value = fetch(key)
	loading[userId] = nil
	-- Pendant la lecture, un autre appel a pu charger le même profil : le premier gagne.
	cached = cache[userId]
	if cached then
		return cached.records
	end

	local entry = {
		userId = userId,
		key = key,
		records = decode(value),
		loaded = ok,
		-- Un profil au format plat est réécrit en schéma 2 à la prochaine sauvegarde.
		dirty = ok and type(value) == "table" and value.schema ~= SCHEMA_VERSION,
		saving = false,
	}
	if player.Parent == nil then
		-- Joueur parti pendant la lecture : rien à garder en cache.
		return entry.records
	end
	cache[userId] = entry
	if not ok then
		task.spawn(reloadUntilLoaded, entry)
	end
	return entry.records
end

-- Sauvegarde immédiate du profil du joueur (sortie). Sans effet si rien n'a changé.
function Profile.save(player)
	local entry = cache[player.UserId]
	if not entry then
		return true
	end
	return saveEntry(entry)
end

-- Sauvegarde toutes les entrées modifiées, en parallèle, avec un délai maximal
-- (la fermeture du serveur accorde une trentaine de secondes).
function Profile.flushAll()
	local pending = {}
	for _, entry in pairs(cache) do
		-- Une écriture en cours a déjà remis `dirty` à faux : on l'attend aussi, la
		-- fermeture du serveur ne doit pas la couper avant son résultat.
		if entry.dirty or entry.saving then
			table.insert(pending, entry)
		end
	end
	if #pending == 0 then
		return
	end

	local remaining = #pending
	for _, entry in ipairs(pending) do
		task.spawn(function()
			pcall(saveEntry, entry)
			remaining -= 1
		end)
	end
	local deadline = tick() + FLUSH_TIMEOUT_SECONDS
	while remaining > 0 and tick() < deadline do
		task.wait(SAVE_POLL_SECONDS)
	end
end

-- Enregistre un score et renvoie le meilleur de la carte. N'attend jamais.
-- Si le profil n'est pas encore en cache, le score est fusionné dès que la
-- lecture aboutit, et la valeur renvoyée est alors le score seul.
function Profile.submit(player, mapId, score)
	local value = cleanScore(score)
	local validMap = type(mapId) == "string" and #mapId > 0 and #mapId <= MAX_MAP_ID_LENGTH
	local entry = cache[player.UserId]

	if not entry then
		if not (validMap and value) then
			return 0
		end
		task.spawn(function()
			local records = Profile.load(player)
			if bestOf(records, mapId) < value then
				records[mapId] = value
			end
			local loaded = cache[player.UserId]
			if loaded then
				loaded.dirty = true
			end
		end)
		return value
	end

	if not (validMap and value) then
		return bestOf(entry.records, mapId)
	end
	local best = bestOf(entry.records, mapId)
	if value > best then
		entry.records[mapId] = value
		best = value
		entry.dirty = true
	end
	return best
end

-- Meilleur score d'une carte. Peut attendre le DataStore (voir Profile.load).
function Profile.getBest(player, mapId)
	return bestOf(Profile.load(player), mapId)
end

-- Remet tous les records à zéro, en mémoire puis dans le DataStore. Refusé si le
-- profil n'a pas pu être lu : effacer une copie vide ne doit pas écraser les scores.
function Profile.reset(player)
	local records = Profile.load(player)
	local entry = cache[player.UserId]
	if not entry or not entry.loaded then
		return false
	end
	for mapId in pairs(records) do
		records[mapId] = nil
	end
	entry.dirty = true
	return saveEntry(entry)
end

-- Libère le cache d'un joueur parti, sauf une modification non encore écrite :
-- elle reste en mémoire jusqu'à une sauvegarde réussie.
function Profile.forget(player)
	local entry = cache[player.UserId]
	if not entry then
		return
	end
	if entry.dirty or entry.saving then
		-- Libérée par saveEntry dès que l'écriture aboutit.
		entry.departed = true
	else
		cache[player.UserId] = nil
	end
end

return Profile
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">RoadRenderer</string>
          <ProtectedString name="Source"><![CDATA[--[[
	RoadRenderer.luau
	Transforme les pièces de RoadGeometry en Parts. Un seul rendu de route :
	chaque case donne au plus une dizaine de parts (virage : 6), toutes
	ancrées, sans collision ni ombre. Aucune logique de partie ici ; le suivi
	des cases à redessiner est dans SessionRoadVisuals.

	Couches (RoadConfig.Layers) : liseré blanc, surface graphite ou pont. Une
	couche a une hauteur et une couleur, donc les pièces d'une même couche qui
	se chevauchent restent invisibles (ni couture, ni triangle).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local RoadConfig = require(Shared.RoadConfig)
local RoadGeometry = require(Shared.RoadGeometry)
local SessionUtil = require(script.Parent.SessionUtil)
local makePart = SessionUtil.makePart
local animateRoadPart = SessionUtil.animateRoadPart

local RoadRenderer = {}

-- Un Cylinder a son axe selon X : la rotation le couche debout, son disque
-- est alors dans le plan XZ, comme les cases vues d'en haut.
local CYLINDER_UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local NEIGHBOR_DIRS = {
	{ name = "N", dx = 0, dy = -1 },
	{ name = "E", dx = 1, dy = 0 },
	{ name = "S", dx = 0, dy = 1 },
	{ name = "W", dx = -1, dy = 0 },
}

-- Nom de part, couleur et dalle d'une couche de RoadGeometry. Le liseré d'une
-- case de pont est plus haut que celui d'une route : le pont passe sur l'eau.
local function layerStyle(layer, isBridge)
	local layers = RoadConfig.Layers
	if layer == "edge" then
		if isBridge then
			return "RoadBridgeEdge", Config.Colors.BridgeEdge, layers.BridgeEdge
		end
		return "RoadEdge", Config.Colors.RoadEdge, layers.Edge
	end
	if layer == "bridge" then
		return "RoadBridge", Config.Colors.Bridge, layers.Bridge
	end
	return "RoadBody", Config.Colors.Road, layers.Body
end

-- Raccords de la case : un par côté orthogonal occupé par un bâtiment. Les
-- routes s'arrêtent alors exactement au bord de la case, sans entrer dessous.
local function connectorsAround(session, x, y)
	local connectors = {}
	for _, dir in ipairs(NEIGHBOR_DIRS) do
		if session.buildings[Grid.key(x + dir.dx, y + dir.dy)] then
			connectors[RoadGeometry.connectorKey(x, y, dir.name)] = true
		end
	end
	return connectors
end

-- Signature de la forme d'une case : deux cases de même signature ont
-- exactement les mêmes pièces, il est inutile de les redessiner.
function RoadRenderer.signature(session, key)
	local x, y = Grid.parse(key)
	if not x or not session.roads[key] then
		return nil
	end
	local mask = RoadGeometry.neighborMask(session.roads, x, y, session.bridges, connectorsAround(session, x, y))
	return mask * 2 + (session.bridges[key] and 1 or 0)
end

-- Crée les parts de la case `key` sous session.world.Roads et les renvoie.
-- reveal : nil (pas d'animation) ou le délai d'apparition en secondes.
function RoadRenderer.buildCell(session, key, reveal)
	local x, y = Grid.parse(key)
	if not x or not session.roads[key] then
		return {}
	end

	local tile = session.tile
	local isBridge = session.bridges[key] == true
	local pieces = RoadGeometry.cellPieces(
		session.roads,
		session.bridges,
		connectorsAround(session, x, y),
		x,
		y
	)

	local parts = {}
	for _, piece in ipairs(pieces) do
		local name, color, slab = layerStyle(piece.layer, isBridge)
		local pieceWidth, pieceDepth = piece.w, piece.h
		-- Les pièces actuelles valent toutes 0 ; un quart de tour échange les axes.
		if piece.rotation % 180 == 90 then
			pieceWidth, pieceDepth = pieceDepth, pieceWidth
		end
		local position = Vector3.new(
			session.origin.X + (x + piece.cx) * tile,
			session.origin.Y + slab.Top - slab.Thickness * 0.5,
			session.origin.Z + (y + piece.cy) * tile
		)

		local props = { Name = name, Color = color, CastShadow = false }
		local size
		if piece.kind == "disk" then
			size = Vector3.new(slab.Thickness, pieceWidth * tile, pieceWidth * tile)
			props.Shape = Enum.PartType.Cylinder
			props.CFrame = CFrame.new(position) * CYLINDER_UPRIGHT
		else
			size = Vector3.new(pieceWidth * tile, slab.Thickness, pieceDepth * tile)
			props.CFrame = CFrame.new(position)
		end
		props.Size = size
		props.Parent = session.world.Roads

		local part = makePart(props)
		if reveal then
			animateRoadPart(part, size, reveal, session.tweens)
		end
		table.insert(parts, part)
	end
	return parts
end

-- Rond-point : anneau graphite à liseré blanc et île centrale, dans le même
-- langage que les routes (mêmes couleurs, mêmes couches). Posé sur la case.
function RoadRenderer.buildRoundabout(session, key)
	local x, y = Grid.parse(key)
	if not x then
		return nil
	end
	local tile = session.tile
	local layers = RoadConfig.Layers
	local dimensions = Config.Dimensions.Road
	local outer = layers.RoundaboutDiameter
	local ringBody = outer - (dimensions.Edge - dimensions.Width)

	local model = Instance.new("Model")
	model.Name = "Roundabout"

	local function disk(name, diameter, slab, color)
		makePart({
			Name = name,
			Parent = model,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(slab.Thickness, diameter * tile, diameter * tile),
			CFrame = CFrame.new(Grid.center(session.origin, x, y, slab.Top - slab.Thickness * 0.5))
				* CYLINDER_UPRIGHT,
			Color = color,
			CastShadow = false,
		})
	end
	disk("RoundaboutEdge", outer, layers.RoundaboutEdge, Config.Colors.RoadEdge)
	disk("RoundaboutBody", ringBody, layers.RoundaboutBody, Config.Colors.Road)
	disk("RoundaboutIsland", layers.RoundaboutIslandDiameter, layers.RoundaboutIsland, Config.Colors.White)

	model.Parent = session.world.FX
	return model
end

return RoadRenderer
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Session</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Session.luau
	Une partie = une ville. Tout est simulé côté serveur :
	  - génération des maisons / destinations
	  - routes et ponts (budget)
	  - trajets des voitures (A*)
	  - horloge de jeu (jours, mois, vitesse), score, statistiques
	Le client ne fait qu'envoyer des demandes de routes et afficher l'état.

	Horloge unique : Session.elapsed (secondes simulées) avance d'un même pas
	pour tous les systèmes. Le jour, la semaine et le mois en sont déduits.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Maps = require(Shared.Maps)
local Remotes = require(Shared.Remotes)
local RoadConfig = require(Shared.RoadConfig)
local WorldBuilder = require(script.Parent.WorldBuilder)
local Profile = require(script.Parent.Profile)
local StoreSystem = require(script.Parent.StoreSystem)
local SessionUtil = require(script.Parent.SessionUtil)
local clamp = SessionUtil.clamp

local Session = {}
Session.__index = Session

-- Les méthodes sont réparties par responsabilité dans des modules voisins.
require(script.Parent.SessionBuildings)(Session)
require(script.Parent.SessionRoads)(Session)
require(script.Parent.SessionRoadVisuals)(Session)
require(script.Parent.SessionTraffic)(Session)
require(script.Parent.SessionProgress)(Session)

local Time = Config.Time
local WEEK_DURATION = Config.Game.WeekDuration
local DAY_DURATION = WEEK_DURATION / Time.DaysPerWeek

-- Tolérance flottante : sur les bornes de jour et de semaine (60 / (60 / 7)
-- n'est pas exactement 7) et sur le reste d'un découpage de frame, qui sans
-- elle ajouterait un pas de simulation quasi nul.
local FLOAT_EPSILON = 1e-9

-- Compteurs présents à zéro dans le payload de fin, même s'ils n'ont pas
-- encore été incrémentés. recordStat accepte aussi des noms supplémentaires.
local STAT_NAMES = {
	"deliveries",
	"carsSpawned",
	"roadsBuilt",
	"roadsErased",
	"storesSpawned",
	"housesSpawned",
	"demandsCreated",
	"demandsServed",
	"weeksCompleted",
	"rewardsChosen",
	"stuckSeconds",
}

local function unitIndex(seconds, unit)
	return math.floor(seconds / unit + FLOAT_EPSILON)
end

-- Un index de monde invalide (nil, NaN, infini) ne doit pas placer la ville
-- à une origine absurde : on retombe sur le premier emplacement.
local function sanitizeWorldIndex(value)
	local index = tonumber(value)
	if not index or index ~= index or math.abs(index) == math.huge then
		return 1
	end
	return math.max(0, math.floor(index))
end

local function sameFields(a, b)
	for key, value in pairs(b) do
		if a[key] ~= value then
			return false
		end
	end
	for key in pairs(a) do
		if b[key] == nil then
			return false
		end
	end
	return true
end

local function copyTable(source)
	local copy = {}
	for key, value in pairs(source) do
		copy[key] = value
	end
	return copy
end

local function initStats()
	local stats = {}
	for _, name in ipairs(STAT_NAMES) do
		stats[name] = 0
	end
	return stats
end

-- Remet à zéro toute la partie en cours. Appelé à la création et à chaque
-- start() : rien ne doit survivre d'une partie précédente.
local function resetGameState(self)
	self.roads = {}
	self.bridges = {}
	self.roadParts = {}
	self.roadSignatures = {}
	self.roadDirty = {}
	self.roadReveal = {}
	self.roadBuildingsSeen = 0
	self.roundaboutParts = {}
	self.intersections = {}
	self.intersectionReservations = {}
	self.buildings = {}
	self.buildingList = {}
	self.houses = {}
	self.destinations = {}
	self.cars = {}
	self.servedStores = {}
	self.criticalTimes = {}
	self.upgrades = {}
	self.gameOverReason = nil
	self.routeCache = {}
	self.routeCacheVersion = nil
	-- Cache des cases tenues par les bâtiments (SessionTraffic). Un cache d'une
	-- partie précédente ne doit jamais servir à la suivante : la version de
	-- route repart de zéro, il faut donc aussi le vider ici.
	self.holdCells = {}
	self.holdCellVersion = nil
	self.holdCellCount = nil

	self.score = 0
	self.elapsed = 0
	self.week = 1
	self.weekTime = 0
	self.satisfaction = Config.Traffic.SatisfactionStart
	self.budget = Config.Roads.StartBudget
	self.bridgesLeft = Config.Roads.StartBridges
	self.roundaboutsLeft = Config.Roads.StartRoundabouts
	self.speed = Time.MinSpeed
	self.stats = initStats()

	self.roadVersion = 0
	self.running = false
	self.paused = false
	self.over = false
	self.awaitingChoice = false
	self.choice = nil

	self.stateClock = 0
	self.nextBuildingId = 1
	self.lastState = nil
	self:updateClock()
end

-- Détruit le monde visuel et les stores de la partie courante, et arrête les
-- tweens. Ne touche pas aux tables de jeu : resetGameState s'en charge.
local function teardownGame(self)
	SessionUtil.cancelTweens(self.tweens)
	if self.storeSystem then
		self.storeSystem:destroy()
		self.storeSystem = nil
	end
	if self.world and self.world.folder then
		self.world.folder:Destroy()
	end
	self.world = nil
end

local function buildGame(self)
	self.world = WorldBuilder.build(self)
	-- StoreSystem réutilise les bâtiments, les maisons et les voitures de
	-- Session : un seul système, pas de doublon.
	self.storeSystem = StoreSystem.new(self)
	self.storeSystem:seed()
end

function Session.new(player, mapId, worldIndex)
	local map = Maps.getById(mapId) or Maps.all()[1]
	local index = sanitizeWorldIndex(worldIndex)

	local self = setmetatable({}, Session)
	self.player = player
	self.mapId = map.id
	self.map = map
	self.worldIndex = index
	self.origin = Vector3.new(index * Config.World.OriginSpacing, Config.World.BaseY, 0)
	self.size = Config.Grid.Size
	self.tile = Config.Grid.TileSize
	self.tweens = {}
	self.destroyed = false
	self.world = nil
	self.storeSystem = nil

	-- Le monde n'est construit qu'au start() : une session créée mais non
	-- démarrée n'occupe aucun Instance dans Workspace.
	resetGameState(self)
	return self
end

-- Horloge dérivée de self.elapsed : semaine, jour de la semaine, mois.
-- Un mois = WeeksPerMonth semaines ; les noms de mois bouclent sur l'année.
function Session:updateClock()
	local completedWeeks = unitIndex(self.elapsed, WEEK_DURATION)
	self.week = completedWeeks + 1
	self.weekTime = math.max(0, self.elapsed - completedWeeks * WEEK_DURATION)

	local dayIndex = unitIndex(self.elapsed, DAY_DURATION)
	self.day = dayIndex + 1
	self.dayOfWeek = dayIndex % Time.DaysPerWeek + 1
	self.dayProgress = clamp((self.elapsed - dayIndex * DAY_DURATION) / DAY_DURATION, 0, 1)

	local monthIndex = math.floor((self.week - 1) / Time.WeeksPerMonth)
	self.month = monthIndex + 1
	self.monthName = Time.MonthNames[monthIndex % #Time.MonthNames + 1]
	self.monthWeek = (self.week - 1) % Time.WeeksPerMonth + 1
	self.monthProgress = clamp(
		((self.monthWeek - 1) + self.weekTime / WEEK_DURATION) / Time.WeeksPerMonth,
		0,
		1
	)
end

-- Statistiques : un nom inconnu est accepté (un module peut en ajouter un),
-- un montant non numérique est ignoré.
function Session:recordStat(name, amount)
	if type(name) ~= "string" or type(amount) ~= "number" or amount ~= amount then
		return
	end
	self.stats[name] = (self.stats[name] or 0) + amount
end

-- Point d'entrée unique du score d'une livraison (appelé par le trafic quand
-- une voiture arrive). Une livraison vaut DeliveryScore, plus un bonus à la
-- première livraison vers chaque magasin et un bonus pour un trajet long.
function Session:onDelivery(house, destination)
	if self.over or type(destination) ~= "table" then
		return 0
	end

	local points = Config.Game.DeliveryScore
	local storeId = destination.id
	if storeId ~= nil and not self.servedStores[storeId] then
		self.servedStores[storeId] = true
		points += Config.Game.NewStoreBonus
	end
	if type(house) == "table" and house.x and house.y and destination.x and destination.y then
		local distance = math.abs(house.x - destination.x) + math.abs(house.y - destination.y)
		if distance >= Config.Game.LongTripCells then
			points += Config.Game.LongTripBonus
		end
	end

	self.score += points
	self.satisfaction = math.min(
		Config.Traffic.SatisfactionMax,
		self.satisfaction + Config.Game.DeliverySatisfaction
	)
	self:recordStat("deliveries", 1)
	return points
end

function Session:sendRoadState()
	if not self.player then
		return
	end
	local roadCells = {}
	for key in pairs(self.roads) do
		roadCells[#roadCells + 1] = key
	end
	local bridgeCells = {}
	for key in pairs(self.bridges) do
		bridgeCells[#bridgeCells + 1] = key
	end
	local buildingCells = {}
	for _, building in ipairs(self.buildingList) do
		buildingCells[#buildingCells + 1] = building.key
	end
	Remotes.get("RoadState"):FireClient(self.player, {
		roads = roadCells,
		bridges = bridgeCells,
		buildings = buildingCells,
		budget = self.budget,
		bridgesLeft = self.bridgesLeft,
		count = #roadCells,
		allowDiagonals = RoadConfig.AllowDiagonals,
		roadVersion = self.roadVersion,
	})
end

-- État envoyé au client (remote State). Champs : score, week, weekProgress,
-- day, dayOfWeek, dayProgress, month, monthName, monthWeek, monthProgress,
-- budget, bridges, roundabouts, satisfaction, speed, paused, awaitingChoice,
-- choice, over, houses, destinations, largeStores, cars, roadsBuilt.
-- Un envoi identique au précédent est ignoré : les appels nombreux (routes,
-- achats, voitures) ne génèrent pas de trafic inutile. update() l'envoie au
-- plus toutes les Time.StateInterval secondes réelles, plus à chaque changement
-- d'état (vitesse, pause, choix, fin de partie).
function Session:sendState()
	if not self.player then
		return
	end
	local roadCount = 0
	for _ in pairs(self.roads) do
		roadCount += 1
	end
	local payload = {
		score = self.score,
		week = self.week,
		weekProgress = clamp(self.weekTime / WEEK_DURATION, 0, 1),
		day = self.day,
		dayOfWeek = self.dayOfWeek,
		dayProgress = self.dayProgress,
		month = self.month,
		monthName = self.monthName,
		monthWeek = self.monthWeek,
		monthProgress = self.monthProgress,
		budget = self.budget,
		bridges = self.bridgesLeft,
		roundabouts = self.roundaboutsLeft,
		satisfaction = self.satisfaction,
		speed = self.speed,
		paused = self.paused,
		awaitingChoice = self.awaitingChoice,
		choice = self.choice,
		over = self.over,
		houses = #self.houses,
		destinations = #self.destinations,
		largeStores = self.storeSystem and self.storeSystem.largeCount or 0,
		cars = #self.cars,
		roadsBuilt = roadCount,
	}

	local last = self.lastState
	if last and sameFields(last, payload) then
		return
	end
	self.lastState = payload
	Remotes.get("State"):FireClient(self.player, payload)
end

-- Un pas de simulation : toutes les parties du jeu reçoivent le même dt.
-- Le choix de semaine est traité en fin de pas, une fois la semaine close.
function Session:simulateStep(step)
	local previousWeek = self.week
	self.elapsed += step
	self:updateClock()

	-- Magasins, demandes, surcharge et évolutions (StoreSystem).
	if self.storeSystem then
		self.storeSystem:update(step)
	end

	for _, house in ipairs(self.houses) do
		if not house.car then
			house.timer -= step
			if house.timer <= 0 then
				house.timer = 0
				self:trySpawnCar(house)
			end
		end
	end

	-- stuckSeconds est compté par le trafic, au moment où une voiture est
	-- réellement bloquée. Le compter aussi ici doublerait la statistique.
	for i = #self.cars, 1, -1 do
		local car = self.cars[i]
		if self:updateCar(car, step) then
			table.remove(self.cars, i)
			self:retireCar(car)
		end
	end

	self:updateSatisfaction(step)

	if self.week > previousWeek and not self.over then
		self:offerWeekChoice()
	end
end

function Session:start()
	if self.destroyed then
		return
	end

	-- Chaque start() repart d'une partie neuve : monde, stores, compteurs.
	teardownGame(self)
	resetGameState(self)
	buildGame(self)
	self.running = true

	Remotes.get("GameStarted"):FireClient(self.player, {
		mapId = self.mapId,
		origin = self.origin,
		size = self.size,
		tile = self.tile,
		weekDuration = WEEK_DURATION,
	})

	self:rebuildRoadTopology()
	self:updateBuildingConnections()
	self:sendState()
	self:sendRoadState()
	self.storeSystem:broadcast()
	self:toast("Reliez les maisons aux magasins de la même couleur. Les pastilles au-dessus d'un magasin sont ses demandes.")
end

function Session:update(dt)
	if self.destroyed then
		return
	end

	-- Même en pause, on peut effacer des routes : le rendu doit se mettre à
	-- jour sans attendre la reprise de la simulation. Sans changement (ni route
	-- ni bâtiment neuf), le flush ne fait rien.
	self:flushRoadRender()

	if not self.running or self.paused or self.over or self.awaitingChoice then
		return
	end
	if type(dt) ~= "number" or not (dt > 0) then
		return
	end

	-- Le temps simulé = temps réel × vitesse. Une grosse frame est découpée
	-- en pas de MaxSimStep pour que le trafic reste stable à vitesse 3.
	local remaining = dt * self.speed
	while remaining > FLOAT_EPSILON do
		local step = math.min(remaining, Time.MaxSimStep)
		remaining -= step
		self:simulateStep(step)
		if self.over or self.paused or self.awaitingChoice then
			break
		end
	end

	-- La cadence d'envoi se mesure en temps réel, pas en temps simulé : à
	-- vitesse 3 l'interface reste à 5 Hz.
	self.stateClock += dt
	if self.stateClock >= Time.StateInterval then
		self.stateClock = 0
		self:sendState()
	end
end

-- Vitesse de simulation : seulement 1, 2 ou 3 (entiers). Toute autre valeur
-- envoyée par le client est ignorée.
function Session:setSpeed(value: any)
	-- Forme positive : seul un nombre entier dans l'intervalle est accepté.
	if
		not self.over
		and type(value) == "number"
		and value == math.floor(value)
		and value >= Time.MinSpeed
		and value <= Time.MaxSpeed
		and value ~= self.speed
	then
		self.speed = value
		self:sendState()
	end
end

function Session:setPaused(value)
	if type(value) ~= "boolean" or self.destroyed then
		return
	end
	if self.over or self.awaitingChoice then
		return
	end
	if value == self.paused then
		return
	end
	self.paused = value
	self:sendState()
end

function Session:toast(text)
	if not self.player then
		return
	end
	Remotes.get("Toast"):FireClient(self.player, text)
end

-- Fin de partie, exactement une fois : le client reçoit le bilan complet.
-- Charge GameOver : mapId, score, best, week, durationSeconds (entier), day,
-- dayOfWeek, month, monthName, stats (copie : compteurs de STAT_NAMES et
-- autres), reason ("overload" : un magasin critique, "traffic" : voitures
-- bloquées, "satisfaction" : repli si aucune cause n'est enregistrée), et
-- overload, toujours présent en données simples : criticalCount, pressure,
-- seconds, storeId, colorIndex, colorName (nil si aucun magasin critique).
function Session:gameOver()
	if self.over then
		return
	end
	self.over = true
	self.running = false
	self.paused = false
	self.awaitingChoice = false
	self.choice = nil

	local best = self.score
	if self.player then
		best = Profile.submit(self.player, self.mapId, self.score)
	end

	local overload = nil
	if self.getOverloadSummary then
		overload = self:getOverloadSummary()
	end
	local reason = self.gameOverReason and self.gameOverReason.kind or "satisfaction"

	if self.player then
		Remotes.get("GameOver"):FireClient(self.player, {
			mapId = self.mapId,
			score = self.score,
			best = best,
			week = self.week,
			durationSeconds = math.floor(self.elapsed),
			day = self.day,
			dayOfWeek = self.dayOfWeek,
			month = self.month,
			monthName = self.monthName,
			stats = copyTable(self.stats),
			reason = reason,
			overload = overload,
		})
	end
	self:sendState()
end

-- Arrêt définitif (retour au lobby, joueur parti, nouvelle partie). Idempotent :
-- le monde, les stores et les tweens disparaissent, toutes les tables sont vidées.
function Session:destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	teardownGame(self)
	resetGameState(self)
	self.running = false
	self.over = true
end

return Session
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">SessionBuildings</string>
          <ProtectedString name="Source"><![CDATA[--[[
	SessionBuildings.luau
	Bâtiments de Session : placement, connexions aux routes, topologie.
	La construction visuelle des Models est déléguée à BuildingModels.
	Ajoute ses méthodes à Session ; appelé une seule fois depuis Session.luau.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Maps = require(Shared.Maps)
local Grid = require(Shared.Grid)
local RoadConfig = require(Shared.RoadConfig)
local RoadNetwork = require(Shared.RoadNetwork)
local StoreConfig = require(Shared.StoreConfig)
local COLORS = Config.HouseColors
local SessionUtil = require(script.Parent.SessionUtil)
local BuildingModels = require(script.Parent.BuildingModels)
local animateModelScale = SessionUtil.animateModelScale

-- Deux cases d'écart au minimum entre bâtiments (en distance de Manhattan, donc
-- les cases en diagonale sont acceptées).
local MIN_MANHATTAN_SPACING = 2

-- Un magasin qui apparaît part légèrement plus petit et grandit en fondu.
local SPAWN_FROM_SCALE = 0.65

-- Un magasin qui évolue : l'ancien modèle s'efface, puis il est détruit après
-- la fin du fondu (délai de sécurité compris).
local REPLACE_FADE_DURATION = 0.2
local REPLACE_CLEANUP_DELAY = 0.24

-- Directions d'entrée, dans l'ordre des quatre côtés. L'angle est celui de
-- BuildingModels : 0 pointe vers +Z (écran bas), pi/2 vers +X.
local ENTRANCE_DIRECTIONS = {
	{ angle = 0, dx = 0, dy = 1 },
	{ angle = math.pi, dx = 0, dy = -1 },
	{ angle = math.pi * 0.5, dx = 1, dy = 0 },
	{ angle = -math.pi * 0.5, dx = -1, dy = 0 },
}

return function(Session)
	function Session:isFreeCell(x, y)
		if not Grid.inBounds(x, y) then
			return false
		end
		local key = Grid.key(x, y)
		return not self.buildings[key] and not self.roads[key] and not Maps.isWater(self.map, x, y)
	end

	function Session:buildableNeighborCount(x, y)
		local count = 0
		for _, neighbor in ipairs(Grid.neighbors8(x, y)) do
			local nx, ny = neighbor[1], neighbor[2]
			if Grid.inBounds(nx, ny) then
				local key = Grid.key(nx, ny)
				if not self.buildings[key] and not Maps.isWater(self.map, nx, ny) then
					count += 1
				end
			end
		end
		return count
	end

	function Session:hasBuildableNeighbor(x, y)
		return self:buildableNeighborCount(x, y) >= StoreConfig.Houses.MinBuildableNeighbors
	end

	-- Règles de terrain (arbres décoratifs, marge du bord) partagées avec les
	-- magasins quand StoreSystem est présent. Sans lui, seules les règles de Session.
	function Session:passesStoreRules(x, y)
		local store = self.storeSystem
		if not store or not store.isBuildableSpot then
			return true
		end
		return store:isBuildableSpot(x, y, StoreConfig.Houses.MinBuildableNeighbors)
	end

	-- Tirage aléatoire borné. Le bord de la carte (une case) reste libre, comme
	-- pour l'emplacement des magasins dans StoreSystem.
	function Session:findBuildingSpot(exclude, minDistance)
		for _ = 1, 500 do
			local x = math.random(1, self.size - 2)
			local y = math.random(1, self.size - 2)
			if self:isFreeCell(x, y) and self:hasBuildableNeighbor(x, y) and self:passesStoreRules(x, y) then
				local ok = true
				if exclude then
					local distance = math.abs(x - exclude[1]) + math.abs(y - exclude[2])
					if distance < (minDistance or 0) then
						ok = false
					end
				end
				if ok then
					for _, other in ipairs(self.buildingList) do
						if math.abs(x - other.x) + math.abs(y - other.y) < MIN_MANHATTAN_SPACING then
							ok = false
							break
						end
					end
				end
				if ok then
					return x, y
				end
			end
		end
		return nil
	end

	-- Face d'entrée : le côté tourné vers une route voisine si elle existe,
	-- sinon le premier côté libre, choisi de façon déterministe par l'identifiant.
	function Session:entranceAngle(x, y, id)
		for _, direction in ipairs(ENTRANCE_DIRECTIONS) do
			local nx, ny = x + direction.dx, y + direction.dy
			if Grid.inBounds(nx, ny) and self.roads[Grid.key(nx, ny)] then
				return direction.angle
			end
		end

		local count = #ENTRANCE_DIRECTIONS
		local start = id % count
		for step = 0, count - 1 do
			local direction = ENTRANCE_DIRECTIONS[(start + step) % count + 1]
			local nx, ny = x + direction.dx, y + direction.dy
			if Grid.inBounds(nx, ny) and not Maps.isWater(self.map, nx, ny) then
				return direction.angle
			end
		end
		return 0
	end

	-- Crée le Model d'un bâtiment sur la case (x, y) et range le Model dans le
	-- monde. Un magasin grandit en fondu ; une maison, plus petite, se contente
	-- du fondu. L'entrée est celle du bâtiment s'il en a déjà une, pour qu'elle
	-- ne change pas à l'évolution.
	function Session:buildBuildingModel(kind, id, x, y, colorIndex, storeType, skipSpawnAnimation, entranceAngle)
		local model = BuildingModels.build(kind, id, Grid.center(self.origin, x, y, 0), colorIndex, storeType, {
			parent = self.world.Buildings,
			entranceAngle = entranceAngle or self:entranceAngle(x, y, id),
		})
		if not skipSpawnAnimation then
			local duration = StoreConfig.Visual.SpawnAnimationDuration
			if kind == "store" then
				animateModelScale(model, SPAWN_FROM_SCALE, 1, duration, self.tweens)
			end
			BuildingModels.fadeIn(model, duration, self.tweens)
		end
		return model
	end

	function Session:createBuilding(kind, x, y, colorIndex, storeType)
		local id = self.nextBuildingId
		self.nextBuildingId += 1

		local entranceAngle = self:entranceAngle(x, y, id)
		local model = self:buildBuildingModel(kind, id, x, y, colorIndex, storeType, false, entranceAngle)
		local palette = COLORS[colorIndex] or COLORS[1]
		local building = {
			id = id,
			kind = kind,
			x = x,
			y = y,
			key = Grid.key(x, y),
			colorIndex = colorIndex,
			color = palette.color,
			model = model,
			entranceAngle = entranceAngle,
		}
		if kind == "store" then
			building.storeType = storeType or "small"
		end

		self.buildings[building.key] = building
		table.insert(self.buildingList, building)
		if kind == "house" then
			table.insert(self.houses, building)
		else
			table.insert(self.destinations, building)
		end

		-- Le client a besoin de connaître les nouvelles cases occupées pour
		-- refuser immédiatement une route qui traverserait un bâtiment.
		self:rebuildRoadTopology()
		self:updateBuildingConnections()
		self:sendRoadState()
		return building
	end

	-- Évolution petit -> grand magasin : même case, même couleur. L'ancien
	-- modèle s'efface pendant que le nouveau grandit en fondu.
	function Session:replaceStoreModel(store)
		if not store or not self.world then
			return
		end

		local oldModel = store.model
		if oldModel then
			BuildingModels.fadeOut(oldModel, REPLACE_FADE_DURATION, self.tweens)
			task.delay(REPLACE_CLEANUP_DELAY, function()
				if oldModel.Parent then
					oldModel:Destroy()
				end
			end)
		end

		local newModel = self:buildBuildingModel(
			"store",
			store.id,
			store.x,
			store.y,
			store.colorIndex,
			"large",
			true,
			store.entranceAngle
		)
		store.model = newModel
		local duration = StoreConfig.Visual.EvolutionDuration
		BuildingModels.fadeIn(newModel, duration, self.tweens)
		animateModelScale(newModel, StoreConfig.Visual.EvolutionStartScale, 1, duration, self.tweens)
		self:destinationPulse(store)
	end

	-- isReachable(store) (optionnel) : fourni par le trafic, il écarte les
	-- magasins sans trajet quand un autre candidat existe.
	function Session:findDestinationForHouse(house, requireAvailable, isReachable)
		if self.storeSystem then
			return self.storeSystem:findDestination(house, requireAvailable, isReachable)
		end

		local best = nil
		local bestDistance = math.huge
		for _, destination in ipairs(self.destinations) do
			if destination.colorIndex == house.colorIndex then
				local distance = math.abs(destination.x - house.x) + math.abs(destination.y - house.y)
				if distance < bestDistance then
					best = destination
					bestDistance = distance
				end
			end
		end
		return best
	end

	function Session:connectorCells(building)
		local cells = {}
		local allowDiagonals = RoadConfig.BuildingConnection == "all"
		for _, neighbor in ipairs(RoadNetwork.neighbors(building.x, building.y, allowDiagonals)) do
			local nx, ny = neighbor[1], neighbor[2]
			if Grid.inBounds(nx, ny) then
				local key = Grid.key(nx, ny)
				if self.roads[key] then
					table.insert(cells, key)
				end
			end
		end
		return cells
	end

	-- Deux listes de connexions identiques, dans le même ordre (connectorCells est
	-- déterministe pour un même réseau).
	local function sameCells(a, b)
		if not a or #a ~= #b then
			return false
		end
		for index = 1, #a do
			if a[index] ~= b[index] then
				return false
			end
		end
		return true
	end

	-- Une route touchant le côté d'une maison ou d'un magasin inscrit la
	-- connexion dans le graphe. Cette passe est appelée uniquement après une
	-- modification du réseau, jamais à chaque frame. Les bâtiments dont les
	-- connexions changent voient leur entrée recalculée.
	function Session:updateBuildingConnections()
		for _, building in ipairs(self.buildingList) do
			local connections = self:connectorCells(building)
			if not sameCells(building.connections, connections) then
				building.aimPending = true
			end
			building.connections = connections
			building.connected = #connections > 0
		end
		self:refreshBuildingEntrances()
	end

	-- Remet l'entrée des bâtiments dont le réseau a changé vers le côté route.
	-- Seule la dalle est refaite, et seulement si le côté change. Un magasin
	-- évolué garde son entrée : store.entranceAngle sert à son nouveau modèle.
	function Session:refreshBuildingEntrances()
		for _, building in ipairs(self.buildingList) do
			if building.aimPending then
				building.aimPending = false
				local angle = self:entranceAngle(building.x, building.y, building.id)
				if angle ~= building.entranceAngle and building.model then
					building.entranceAngle = angle
					BuildingModels.aimEntrance(
						building.model,
						Grid.center(self.origin, building.x, building.y, 0),
						building.kind,
						building.id,
						building.storeType,
						angle
					)
				end
			end
		end
	end

	function Session:rebuildRoadTopology()
		self.intersections = {}
		for key in pairs(self.roads) do
			if RoadNetwork.isIntersectionKey(self.roads, key, RoadConfig.AllowDiagonals) then
				self.intersections[key] = true
			end
		end

		-- Une réservation dont la route a disparu ou dont la voiture n'existe
		-- plus est libérée immédiatement.
		for key, car in pairs(self.intersectionReservations) do
			if not self.roads[key] or not car.path then
				self.intersectionReservations[key] = nil
			end
		end
	end
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">SessionProgress</string>
          <ProtectedString name="Source"><![CDATA[--[[
	SessionProgress.luau
	Progression de Session : satisfaction, surcharge, choix hebdomadaires,
	récompenses et amélioration de la circulation.
	Ajoute ses méthodes à Session ; appelé une seule fois depuis Session.luau.

	Surcharge (formule) : tant qu'au moins un magasin est critique, la
	satisfaction baisse de
	    StoreSystem:getOverloadDrain() × pression
	    pression = 1 + min(OverloadMaxExtra, tempsCritique / OverloadRampSeconds)
	où tempsCritique est le temps passé en critique par le magasin le plus
	négligé. Dès que ce magasin n'est plus plein (une livraison l'a libéré),
	son compteur repart de zéro. Au départ, le drain
	est celui de StoreConfig : la pression ne fait que croître doucement, et
	plafonne à deux fois le drain de base.
	Les voitures bloquées (Config.Traffic) s'ajoutent sans multiplicateur.
	Tout est gelé pendant la pause et pendant un choix de récompense.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Progression = Config.Progression

-- Bonus de routes d'une semaine : nul en semaine 1, puis par paliers réguliers
-- et plafonné. Les lots restent proches de leurs valeurs de base.
local function roadBonus(week)
	local steps = math.floor((week - 1) / Progression.RoadsWeeksPerStep)
	return math.min(Progression.RoadsMaxBonus, steps * Progression.RoadsPerStep)
end

-- Le texte de Config contient le lot de base : on remplace son premier nombre
-- par le montant réel de la semaine.
local function withAmount(text, amount)
	return (string.gsub(text, "%d+", tostring(amount), 1))
end

-- Copie d'une récompense pour la proposition : les montants de la semaine sont
-- figés au moment de l'offre, et Config n'est jamais modifiée.
local function makeOption(reward, week)
	local bonus = roadBonus(week)
	local option = {
		id = reward.id,
		kind = reward.kind,
		amount = reward.amount,
		roads = reward.roads,
		trafficFactor = reward.trafficFactor,
		title = reward.title,
		description = reward.description,
	}
	if option.kind == "roads" then
		option.amount = reward.amount + bonus
		option.title = withAmount(reward.title, option.amount)
		option.description = withAmount(reward.description, option.amount)
	elseif option.roads then
		option.roads = reward.roads + bonus
		option.description = withAmount(reward.description, option.roads)
	end
	return option
end

-- Pression de surcharge selon le temps passé en critique (voir l'en-tête).
local function overloadPressure(seconds)
	return 1 + math.min(Progression.OverloadMaxExtra, seconds / Progression.OverloadRampSeconds)
end

return function(Session)
	-- Temps passé en surcharge critique, par magasin (clé = magasin). Il ne
	-- s'accumule que pendant la simulation, donc pas pendant une pause.
	function Session:trackCriticalStores(dt)
		local times = self.criticalTimes or {}
		self.criticalTimes = times
		for _, store in ipairs(self.destinations) do
			if store.critical then
				times[store] = (times[store] or 0) + dt
			else
				times[store] = nil
			end
		end
	end

	-- Résumé de la surcharge en données simples (HUD, écran de fin). Le magasin
	-- « worst » est celui qui est critique depuis le plus longtemps.
	function Session:getOverloadSummary()
		local summary = {
			criticalCount = 0,
			pressure = 1,
			seconds = 0,
			storeId = nil,
			colorIndex = nil,
			colorName = nil,
		}
		local times = self.criticalTimes or {}
		local worst = nil
		for _, store in ipairs(self.destinations) do
			if store.critical then
				summary.criticalCount += 1
				local seconds = times[store] or 0
				if worst == nil or seconds > summary.seconds then
					worst = store
					summary.seconds = seconds
				end
			end
		end
		if worst then
			summary.storeId = worst.id
			summary.colorIndex = worst.colorIndex
			local color = Config.HouseColors[worst.colorIndex]
			summary.colorName = color and color.name
		end
		summary.pressure = overloadPressure(summary.seconds)
		return summary
	end

	-- Multiplicateur de la distance de sécurité des voitures (1 = inchangé).
	-- Le trafic le lit pour raccourcir l'espacement après une amélioration.
	function Session:getTrafficMultiplier()
		return self.upgrades and self.upgrades.traffic or 1
	end

	-- Jauge de satisfaction : baisse avec les voitures bloquées et la surcharge,
	-- et ne remonte que lorsque le trafic coule.
	function Session:updateSatisfaction(dt)
		-- Pause, choix de récompense ou partie finie : rien ne bouge.
		if self.over or self.paused or self.awaitingChoice or not self.running then
			return
		end

		local drain = 0
		for _, car in ipairs(self.cars) do
			-- Une voiture sans trajet n'est pas encore "dans le trafic" :
			-- on ne pénalise que les voitures réellement bloquées sur un chemin.
			if car.path and car.waitTime >= Config.Traffic.StuckAfter then
				drain += Config.Traffic.DrainPerStuckCar
			end
		end

		self:trackCriticalStores(dt)
		local overload = self:getOverloadSummary()
		if self.storeSystem then
			drain += self.storeSystem:getOverloadDrain() * overload.pressure
		end

		if drain > 0 then
			self.satisfaction -= drain * dt
		else
			self.satisfaction = math.min(
				Config.Traffic.SatisfactionMax,
				self.satisfaction + Config.Traffic.RegenPerSecond * dt
			)
		end

		if self.satisfaction <= 0 then
			self.satisfaction = 0
			-- La cause reste disponible pour l'écran de fin. Un magasin critique
			-- l'emporte sur les voitures bloquées.
			if overload.storeId then
				self.gameOverReason = {
					kind = "overload",
					storeId = overload.storeId,
					colorIndex = overload.colorIndex,
					colorName = overload.colorName,
					seconds = overload.seconds,
				}
			else
				self.gameOverReason = { kind = "traffic" }
			end
			self:gameOver()
		end
	end

	-- Deux propositions différentes : une carte spéciale (pont, rond-point ou
	-- amélioration de circulation, seulement si elle n'est pas au maximum) et
	-- un lot de routes. Sans carte spéciale disponible, deux lots différents.
	function Session:pickWeekChoices()
		local rng = self.random or math
		local specials = {}
		if self.bridgesLeft < Config.Roads.MaxBridges then
			table.insert(specials, Config.Rewards.Bridge)
		end
		if self.roundaboutsLeft < Config.Roads.MaxRoundabouts then
			table.insert(specials, Config.Rewards.Roundabout)
		end
		if self:getTrafficMultiplier() > Progression.TrafficMinFactor then
			table.insert(specials, Config.Rewards.Traffic)
		end

		local first, second
		if #specials == 0 then
			first = Config.Rewards.Roads
			second = Config.Rewards.RoadsLarge
		else
			first = specials[rng.random(1, #specials)]
			second = rng.random() < 0.25 and Config.Rewards.RoadsLarge or Config.Rewards.Roads
		end

		local options = { makeOption(first, self.week), makeOption(second, self.week) }
		if rng.random() < 0.5 then
			options[1], options[2] = options[2], options[1]
		end
		return options
	end

	function Session:offerWeekChoice()
		if self.over or self.awaitingChoice then
			return
		end
		self.awaitingChoice = true
		self.paused = true
		self.choice = {
			week = self.week,
			options = self:pickWeekChoices(),
		}
		-- La proposition arrive à la fin de la semaine qui vient de se terminer.
		if self.recordStat then
			self:recordStat("weeksCompleted", 1)
		end
		if self.player then
			Remotes.get("WeekChoice"):FireClient(self.player, self.choice)
		end
		self:sendState()
	end

	function Session:chooseReward(optionId)
		if not self.awaitingChoice or not self.choice then
			return
		end
		-- Seules les options proposées cette semaine sont acceptées.
		local selected = nil
		for _, option in ipairs(self.choice.options or {}) do
			if option.id == optionId then
				selected = option
				break
			end
		end
		if not selected then
			return
		end

		-- Les outils spéciaux sont accompagnés de routes (20 routes pour un pont
		-- ou un rond-point, comme dans Mini Motorways).
		local roadGain = selected.roads or 0
		if selected.kind == "roads" then
			roadGain += selected.amount
		elseif selected.kind == "bridges" then
			self.bridgesLeft = math.min(Config.Roads.MaxBridges, self.bridgesLeft + selected.amount)
		elseif selected.kind == "roundabouts" then
			self.roundaboutsLeft = math.min(Config.Roads.MaxRoundabouts, self.roundaboutsLeft + selected.amount)
		end
		if roadGain > 0 then
			self.budget = math.min(Config.Roads.MaxBudget, self.budget + roadGain)
		end
		if selected.trafficFactor then
			self.upgrades = self.upgrades or {}
			self.upgrades.traffic = math.max(
				Progression.TrafficMinFactor,
				self:getTrafficMultiplier() * selected.trafficFactor
			)
		end

		-- Choix consommé une seule fois : la proposition est close avant tout
		-- envoi, donc un second appel ne peut plus rien accorder.
		self.awaitingChoice = false
		self.choice = nil
		self.paused = false
		if self.recordStat then
			self:recordStat("rewardsChosen", 1)
		end
		self:sendState()
		self:sendRoadState()

		local gainText = selected.title or "Amélioration"
		if selected.roads and selected.roads > 0 then
			gainText = gainText .. " + " .. tostring(selected.roads) .. " routes"
		end
		self:toast("Amélioration choisie : " .. gainText .. ".")
	end
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">SessionRoadVisuals</string>
          <ProtectedString name="Source"><![CDATA[--[[
	SessionRoadVisuals.luau
	Rendu des routes de Session : un seul renderer (RoadRenderer) piloté par
	RoadGeometry. Ajoute ses méthodes à Session ; appelé une seule fois depuis
	Session.luau.

	Rendu incrémental : un changement marque la case et ses quatre voisines
	(RoadGeometry.affectedCells) dans self.roadDirty ; flushRoadRender redessine
	chacune une seule fois, et seulement si sa forme a vraiment changé. Le réseau
	entier n'est jamais redessiné.

	État : self.roadParts[key] = parts de la case, self.roadSignatures[key] =
	forme rendue, self.roadDirty = cases à redessiner, self.roadReveal[key] =
	délai d'apparition d'une case neuve, self.roadBuildingsSeen = bâtiments déjà
	pris en compte (leurs côtés donnent les raccords).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Grid = require(Shared.Grid)
local RoadGeometry = require(Shared.RoadGeometry)
local RoadRenderer = require(script.Parent.RoadRenderer)
local SessionUtil = require(script.Parent.SessionUtil)

return function(Session)
	local function destroyParts(parts)
		for _, part in ipairs(parts) do
			SessionUtil.stopRoadPartReveal(part)
			part:Destroy()
		end
	end

	-- Marque à redessiner chaque case de `keys` et ses quatre voisines ; reveals
	-- (clé -> délai) désigne les cases neuves qui apparaissent en animation.
	function Session:markRoadsDirty(keys, reveals)
		for _, key in ipairs(keys) do
			for _, affected in ipairs(RoadGeometry.affectedCells(key)) do
				self.roadDirty[affected] = true
			end
		end
		if reveals then
			for key, delay in pairs(reveals) do
				self.roadReveal[key] = delay
			end
		end
	end

	-- Détruit les parts d'une case, et seulement les siennes.
	function Session:removeRoadVisual(key)
		local parts = self.roadParts[key]
		if parts then
			destroyParts(parts)
			self.roadParts[key] = nil
		end
		self.roadSignatures[key] = nil
	end

	-- Redessine une case sans condition : ses anciennes parts disparaissent.
	function Session:renderRoadCell(key, reveal)
		self:removeRoadVisual(key)
		if not self.world or not self.roads[key] then
			return
		end
		self.roadParts[key] = RoadRenderer.buildCell(self, key, reveal)
		self.roadSignatures[key] = RoadRenderer.signature(self, key)
	end

	-- Les bâtiments apparus depuis le dernier rendu : leurs côtés donnent de
	-- nouveaux raccords aux routes voisines (une maison peut naître au bord
	-- d'une route). Les bâtiments ne bougent ni ne disparaissent en cours de
	-- partie, un simple compteur suffit.
	local function syncBuildings(self)
		local list = self.buildingList
		if #list == self.roadBuildingsSeen then
			return
		end
		local cells = {}
		for index = self.roadBuildingsSeen + 1, #list do
			cells[#cells + 1] = list[index].key
		end
		self.roadBuildingsSeen = #list
		self:markRoadsDirty(cells)
	end

	-- Point d'entrée unique du rendu : appelé à la fin de chaque lot de routes
	-- et à chaque frame par Session:update. Sans changement, il ne fait rien.
	function Session:flushRoadRender()
		if not self.world then
			return
		end
		syncBuildings(self)
		if next(self.roadDirty) == nil then
			return
		end

		local dirty, reveals = self.roadDirty, self.roadReveal
		self.roadDirty, self.roadReveal = {}, {}
		for key in pairs(dirty) do
			if self.roads[key] then
				local reveal = reveals[key]
				if reveal or self.roadSignatures[key] ~= RoadRenderer.signature(self, key) then
					self:renderRoadCell(key, reveal)
				end
			end
		end
	end

	-- Détruit toutes les parts de route ; le prochain rendu repart de zéro.
	function Session:clearRoadVisuals()
		for _, parts in pairs(self.roadParts) do
			destroyParts(parts)
		end
		self.roadParts = {}
		self.roadSignatures = {}
	end

	-- Noms historiques des points d'entrée du rendu.
	function Session:rebuildRoadRibbons()
		self:flushRoadRender()
	end

	function Session:clearRoadRibbons()
		self:clearRoadVisuals()
	end

	-- cells : cases { x, y } (le format d'un tracé), toutes marquées à redessiner.
	function Session:addRoadRibbons(cells)
		local keys = {}
		for _, cell in ipairs(cells) do
			if type(cell) == "table" and type(cell[1]) == "number" and type(cell[2]) == "number" then
				keys[#keys + 1] = Grid.key(math.floor(cell[1]), math.floor(cell[2]))
			end
		end
		self:markRoadsDirty(keys)
		self:flushRoadRender()
	end

	-- Visuel d'une case de route, tout de suite. isBridge est ignoré : le pont
	-- est lu dans self.bridges, comme le fait le rendu à chaque redessin.
	function Session:createRoadVisual(key, _isBridge, delay, animate)
		self:renderRoadCell(key, if animate ~= false then delay or 0 else nil)
	end

	function Session:refreshRoadVisual(key)
		self:renderRoadCell(key, nil)
	end

	function Session:createRoundaboutVisual(key)
		if self.roundaboutParts[key] then
			self.roundaboutParts[key]:Destroy()
		end
		self.roundaboutParts[key] = RoadRenderer.buildRoundabout(self, key)
	end
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">SessionRoads</string>
          <ProtectedString name="Source"><![CDATA[--[[
	SessionRoads.luau
	Routes de Session : validation, construction, rond-points, effacement.
	Ajoute ses méthodes à Session ; appelé une seule fois depuis Session.luau.

	Le client envoie des cases brutes : chaque coordonnée est revalidée ici.
	Un lot modifie le réseau une seule fois (topologie, connexions des
	bâtiments, trajets des voitures, envoi au client).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Maps = require(Shared.Maps)
local Grid = require(Shared.Grid)
local RoadConfig = require(Shared.RoadConfig)

-- Raisons de refus liées aux ressources : le toast les affiche, l'aperçu
-- client utilise les mêmes règles.
local REASON_NO_BUDGET = "Plus de routes disponibles"
local REASON_NO_BRIDGE = "Plus de ponts disponibles"

local MAX_CELLS = RoadConfig.Input.MaxCellsPerRequest

-- Lit une case envoyée par un client. Renvoie nil si une coordonnée n'est pas
-- un nombre fini, ou si la case est hors carte. Le -0 est ramené à 0 : sans
-- cela, "-0:3" serait une clé distincte de "0:3" et casserait le réseau.
local function readCell(x, y)
	if type(x) ~= "number" or type(y) ~= "number" then
		return nil
	end
	if x ~= x or y ~= y or math.abs(x) == math.huge or math.abs(y) == math.huge then
		return nil
	end
	x = math.floor(x) + 0
	y = math.floor(y) + 0
	if not Grid.inBounds(x, y) then
		return nil
	end
	return x, y
end

return function(Session)
	-- Une case de route coûte une pièce de route, plus un pont sur l'eau.
	function Session:canDraw(x, y)
		if not Grid.inBounds(x, y) then
			return false, "Hors de la carte"
		end
		local key = Grid.key(x, y)
		if self.buildings[key] then
			return false, "Bâtiment"
		end
		if self.roads[key] then
			return false, "Route déjà construite"
		end
		local water = Maps.isWater(self.map, x, y)
		if water and self.bridgesLeft <= 0 then
			return false, REASON_NO_BRIDGE
		end
		if self.budget < 1 then
			return false, REASON_NO_BUDGET
		end
		return true, water and "bridge" or "road"
	end

	-- La pause manuelle fige la simulation, pas l'édition des routes. En revanche,
	-- toute édition est bloquée pendant le choix de semaine.
	function Session:canEditRoads()
		return self.running and not self.over and not self.awaitingChoice
	end

	-- Une seule reconstruction par lot : topologie, connexions des bâtiments,
	-- trajets des voitures, puis état envoyé au client.
	function Session:commitRoadChange(count, statName)
		self.roadVersion += 1
		self:rebuildRoadTopology()
		self:updateBuildingConnections()
		self:refreshCarPaths()
		if self.recordStat then
			self:recordStat(statName, count)
		end
		self:sendState()
		self:sendRoadState()
	end

	function Session:drawRoad(cells)
		if not self:canEditRoads() or type(cells) ~= "table" then
			return
		end
		-- Un lot trop grand est refusé en entier, comme le fait Bootstrap.
		if #cells > MAX_CELLS then
			return
		end

		local placed = 0
		local limit = nil
		local newRoads = {}
		for _, cell in ipairs(cells) do
			local x, y = nil, nil
			if type(cell) == "table" then
				x, y = readCell(cell[1], cell[2])
			end
			if x then
				local key = Grid.key(x, y)
				local ok, detail = self:canDraw(x, y)
				if ok then
					local isBridge = detail == "bridge"
					self.roads[key] = true
					if isBridge then
						self.bridges[key] = true
						self.bridgesLeft -= 1
					end
					self.budget -= 1
					table.insert(newRoads, { key = key, isBridge = isBridge })
					placed += 1
				elseif detail == REASON_NO_BUDGET or detail == REASON_NO_BRIDGE then
					limit = limit or detail
				end
			end
		end

		-- Le tracé s'arrête proprement quand les ressources manquent : les cases
		-- restantes sont refusées sans être facturées.
		if limit then
			self:toast(limit)
		end
		if placed == 0 then
			return
		end

		-- Toutes les cases sont posées avant le rendu : les extrémités et les
		-- virages connaissent déjà leurs voisins. Une seule passe dessine les
		-- cases neuves (en animation) et redessine leurs voisines si leur forme
		-- change (une ancienne extrémité peut devenir un virage).
		-- Un très long tracé n'est pas animé : chaque pièce animée réplique sa
		-- taille et sa transparence à chaque frame, ce qui coûte trop pour des
		-- centaines de pièces.
		local stagger = RoadConfig.Construction
		local animate = #newRoads <= stagger.MaxAnimatedCells
		local reveals = animate and {} or nil
		local placedKeys = {}
		for index, road in ipairs(newRoads) do
			if reveals then
				reveals[road.key] = math.min((index - 1) * stagger.RevealStagger, stagger.RevealStaggerMax)
			end
			placedKeys[index] = road.key
		end
		self:markRoadsDirty(placedKeys, reveals)
		self:flushRoadRender()

		self:commitRoadChange(placed, "roadsBuilt")
	end

	function Session:placeRoundabout(x, y)
		if not self:canEditRoads() then
			return
		end
		if type(x) ~= "number" or type(y) ~= "number" then
			return
		end
		x, y = readCell(x, y)
		if not x then
			self:toast("Placez le rond-point sur la carte.")
			return
		end
		if self.roundaboutsLeft <= 0 then
			self:toast("Plus de ronds-points disponibles.")
			return
		end
		local key = Grid.key(x, y)
		if not self.roads[key] then
			self:toast("Placez le rond-point sur une route.")
			return
		end
		if self.roundaboutParts[key] then
			self:toast("Il y a déjà un rond-point ici.")
			return
		end
		if self.bridges[key] then
			self:toast("Un rond-point ne peut pas être posé sur un pont.")
			return
		end

		-- Le rond-point ne change pas le réseau : pas de version ni de trajets.
		self.roundaboutsLeft -= 1
		self:createRoundaboutVisual(key)
		self:sendState()
		self:toast("Rond-point placé.")
	end

	-- Retire une case de route et rend exactement ce qu'elle avait coûté (pièce,
	-- pont, rond-point). Ne reconstruit pas le réseau : c'est le rôle du lot.
	function Session:removeRoadCell(key)
		if type(key) ~= "string" or not self.roads[key] then
			return false
		end
		if not Grid.parse(key) then
			return false
		end

		local roundabout = self.roundaboutParts[key]
		if roundabout then
			roundabout:Destroy()
			self.roundaboutParts[key] = nil
			self.roundaboutsLeft = math.min(Config.Roads.MaxRoundabouts, self.roundaboutsLeft + 1)
		end

		self.roads[key] = nil
		self.intersectionReservations[key] = nil
		if self.bridges[key] then
			self.bridges[key] = nil
			self.bridgesLeft = math.min(Config.Roads.MaxBridges, self.bridgesLeft + 1)
		end
		self.budget = math.min(Config.Roads.MaxBudget, self.budget + 1)

		-- Les parts de la case partent tout de suite ; ses voisines changent de
		-- forme (une route peut redevenir une extrémité) et sont redessinées une
		-- seule fois par le rendu, même si le lot touche plusieurs cases.
		self:removeRoadVisual(key)
		self:markRoadsDirty({ key })
		return true
	end

	-- Finalise un effacement : rendu des voisines (une fois par case), puis une
	-- seule mise à jour du réseau pour tout le lot.
	function Session:finishRoadErase(removed)
		self:flushRoadRender()
		self:commitRoadChange(removed, "roadsErased")
	end

	function Session:eraseRoad(key)
		if not self:canEditRoads() then
			return false
		end
		if not self:removeRoadCell(key) then
			return false
		end
		self:finishRoadErase(1)
		return true
	end

	function Session:eraseRoads(keys)
		if not self:canEditRoads() or type(keys) ~= "table" or #keys > MAX_CELLS then
			return
		end
		local removed = 0
		for _, key in ipairs(keys) do
			if self:removeRoadCell(key) then
				removed += 1
			end
		end
		if removed > 0 then
			self:finishRoadErase(removed)
		end
	end
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">SessionTraffic</string>
          <ProtectedString name="Source"><![CDATA[--[[
	SessionTraffic.luau
	Circulation de Session : voitures, trajets, réservations d'intersection.
	Ajoute ses méthodes à Session ; appelé une seule fois depuis Session.luau.

	Une voiture suit un chemin de cases de route, mais sa position est continue :
	elle avance le long d'un segment (ligne droite, ou arc de Bézier dans un
	virage) et ne saute jamais d'une case à l'autre. Les intersections et les
	cases qui touchent un bâtiment se réservent par suites entières avant d'y
	entrer : deux voitures ne s'y croisent pas, une voiture qui ne peut pas
	les prendre s'arrête avant, et une boucle d'attente est cassée. Les trajets
	sont mis en cache par version du réseau et ne sont recalculés que pour les
	voitures dont la route a disparu.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Pathfinding = require(Shared.Pathfinding)
local RoadConfig = require(Shared.RoadConfig)
local StoreConfig = require(Shared.StoreConfig)
local SessionUtil = require(script.Parent.SessionUtil)
local CarModel = require(script.Parent.CarModel)
local COLORS = Config.HouseColors
local clamp = SessionUtil.clamp

local TRAFFIC = RoadConfig.Traffic
local VEHICLE = RoadConfig.Vehicle
local DEFAULT_HEADING = Vector3.new(0, 0, -1)
-- Reste de course (studs) au-dessous duquel une voiture arrêtée devant une
-- case occupée compte comme en attente.
local STOP_EPSILON = 0.05
-- Plancher de la vitesse relative dans un arc très serré.
local MIN_TURN_FACTOR = 0.2
-- Longueur maximale de la chaîne d'attente examinée pour trouver une boucle.
local CYCLE_LIMIT = 64

-- Voies de chaque partie, indexées par la table des voitures de la session
-- (recréée à chaque remise à zéro : les voies repartent donc vides, sans champ
-- de plus dans Session). Les clés faibles laissent partir une partie finie.
local lanesOfCars = setmetatable({}, { __mode = "k" })
-- Numéro de voiture : ordre total pour désigner qui casse une boucle d'attente.
local nextCarId = 0

-- Vecteur unitaire, ou nil si le vecteur est (presque) nul.
local function unitOrNil(vector)
	local magnitude = vector.Magnitude
	if magnitude < 0.0001 then
		return nil
	end
	return vector / magnitude
end

local function cellCenter(session, key)
	local x, y = Grid.parse(key)
	return Grid.center(session.origin, x, y, 0.5)
end

-- Origine et destination du trajet en cours, selon l'aller ou le retour.
local function carEnds(car)
	if car.state == "out" then
		return car.house, car.dest
	end
	return car.dest, car.house
end

-- Point de la courbe de Bézier quadratique d'un virage (u dans [0, 1]).
local function bezierPoint(seg, u)
	local a = 1 - u
	return seg.lineEnd * (a * a) + seg.ctrl * (2 * a * u) + seg.to * (u * u)
end

-- Segment parcouru par une voiture : une ligne droite, suivie d'un arc de
-- Bézier si le segment tourne à son extrémité. `cut` est la distance du
-- centre de la case à laquelle l'arc commence.
local function makeSegment(from, to, nextPoint, cut)
	local seg = {
		from = from,
		lineEnd = to,
		ctrl = nil,
		to = to,
		samples = nil,
		speedLimit = 1,
		lineLength = 0,
		curveLength = 0,
		length = 0,
	}
	local delta = to - from
	local len = delta.Magnitude
	if nextPoint and len > 0.0001 then
		local outDelta = nextPoint - to
		local outLen = outDelta.Magnitude
		if outLen > 0.0001 then
			local dirIn = delta / len
			local dirOut = outDelta / outLen
			if dirIn:Dot(dirOut) < VEHICLE.TurnDot then
				local radius = math.min(cut, len * 0.5, outLen * 0.5)
				seg.lineEnd = to - dirIn * radius
				seg.ctrl = to
				seg.to = to + dirOut * radius
				-- Longueur de l'arc sur quelques échantillons : la vitesse de la
				-- voiture reste constante dans le virage.
				local count = VEHICLE.CurveSamples
				local samples = { 0 }
				local total = 0
				local previous = seg.lineEnd
				for i = 1, count do
					local point = bezierPoint(seg, i / count)
					total += (point - previous).Magnitude
					samples[i + 1] = total
					previous = point
				end
				seg.samples = samples
				seg.curveLength = total
				-- Courbure maximale de l'arc : 1,414 / rayon. La voiture ralentit pour
				-- que son cap tourne à moins de 80 % de la vitesse de rotation limite.
				local safe = 0.8 * VEHICLE.TurnRate * radius / math.sqrt(2) / Config.Traffic.CarSpeed
				seg.speedLimit = clamp(safe, MIN_TURN_FACTOR, 1)
			end
		end
	end
	seg.lineLength = (seg.lineEnd - from).Magnitude
	seg.length = seg.lineLength + seg.curveLength
	return seg
end

-- Cap exprimé en angle autour de Y (0 = vers -Z, l'avant de la voiture).
local function yawOf(direction)
	return math.atan2(direction.X, -direction.Z)
end

local function headingFromYaw(yaw)
	return Vector3.new(math.sin(yaw), 0, -math.cos(yaw))
end

-- Ramène un écart d'angle dans [-pi, pi[ pour tourner par le plus court côté.
local function wrapAngle(angle)
	return (angle + math.pi) % (2 * math.pi) - math.pi
end

-- Paramètre u de la courbe pour une distance `distance` depuis son début.
local function curveParameter(seg, distance)
	if distance <= 0 then
		return 0
	end
	if distance >= seg.curveLength then
		return 1
	end
	local samples = seg.samples
	local count = #samples - 1
	for i = 1, count do
		if samples[i + 1] >= distance then
			local span = samples[i + 1] - samples[i]
			local fraction = 0
			if span > 0 then
				fraction = (distance - samples[i]) / span
			end
			return (i - 1 + fraction) / count
		end
	end
	return 1
end

-- Point de l'axe central à la distance `s` le long du segment.
local function pointAt(seg, s)
	if not seg.ctrl or s <= seg.lineLength then
		if seg.lineLength <= 0.0001 then
			return seg.lineEnd
		end
		return seg.from:Lerp(seg.lineEnd, clamp(s / seg.lineLength, 0, 1))
	end
	return bezierPoint(seg, curveParameter(seg, s - seg.lineLength))
end

-- Direction de déplacement à la distance `s` (nil si elle est indéfinie).
local function tangentAt(seg, s)
	if seg.ctrl and s > seg.lineLength then
		local u = curveParameter(seg, s - seg.lineLength)
		local a = 1 - u
		return unitOrNil((seg.ctrl - seg.lineEnd) * a + (seg.to - seg.ctrl) * u)
	end
	return unitOrNil(seg.lineEnd - seg.from)
end

return function(Session)
	-- Voies ------------------------------------------------------------------------

	-- Une voie est une paire orientée (nœud de départ, nœud d'arrivée) : deux sens
	-- de circulation ne se gênent jamais. Chaque voie liste ses voitures : l'écart
	-- avec la voiture qui précède ne parcourt jamais tout le trafic.
	local function leaveLane(car)
		local list = car.lane
		if not list then
			return
		end
		local count = #list
		for i = 1, count do
			if list[i] == car then
				list[i] = list[count]
				list[count] = nil
				break
			end
		end
		car.lane = nil
	end

	local function laneList(self, from, to, create)
		local lanes = lanesOfCars[self.cars]
		if not lanes then
			if not create then
				return nil
			end
			lanes = {}
			lanesOfCars[self.cars] = lanes
		end
		local byFrom = lanes[from]
		if not byFrom then
			if not create then
				return nil
			end
			byFrom = {}
			lanes[from] = byFrom
		end
		local list = byFrom[to]
		if not list and create then
			list = {}
			byFrom[to] = list
		end
		return list
	end

	local function setLane(self, car, from, to)
		if car.lane and car.laneFrom == from and car.laneTo == to then
			return
		end
		leaveLane(car)
		car.laneFrom = from
		car.laneTo = to
		local list = laneList(self, from, to, true)
		list[#list + 1] = car
		car.lane = list
	end

	-- Réservations d'intersection ---------------------------------------------

	-- Cases réservées : les intersections, et les cases qui touchent un bâtiment.
	-- Une route qui longe une maison n'est pas une intersection, mais une voiture
	-- qui en sort ou qui s'y gare ne doit pas croiser une voiture de passage.
	local function isHoldCell(self, key)
		if self.intersections[key] then
			return true
		end
		if self.holdCellVersion ~= self.roadVersion or self.holdCellCount ~= #self.buildingList then
			local cells = {}
			for _, building in ipairs(self.buildingList) do
				for _, cellKey in ipairs(building.connections or {}) do
					cells[cellKey] = true
				end
			end
			self.holdCells = cells
			self.holdCellVersion = self.roadVersion
			self.holdCellCount = #self.buildingList
		end
		return self.holdCells[key] == true
	end

	local function removeHeld(car, key)
		local held = car.held
		for i = #held, 1, -1 do
			if held[i] == key then
				table.remove(held, i)
			end
		end
	end

	-- Réserve, tout ou rien, la suite de cases réservables consécutives qui
	-- commence au nœud j du trajet. Une voiture ne garde donc jamais une
	-- intersection en attendant la suivante : deux voitures de sens opposés sur
	-- deux intersections voisines ne se bloquent pas. Renvoie false (et note la
	-- voiture qui bloque) si une case est tenue par une autre voiture. `force`
	-- prend les cases même tenues : réservé à la rupture d'une boucle d'attente.
	local function secureNode(self, car, j, force)
		if not TRAFFIC.IntersectionReservation then
			return true
		end
		local path = car.path
		local first = path[j]
		if not first or not isHoldCell(self, first) then
			return true
		end
		local last = j
		local nextKey = path[last + 1]
		while nextKey and isHoldCell(self, nextKey) do
			last += 1
			nextKey = path[last + 1]
		end

		local reservations = self.intersectionReservations
		if not force then
			for k = j, last do
				local holder = reservations[path[k]]
				-- Une réservation orpheline (voiture sans trajet) ne bloque jamais le réseau.
				if holder and holder ~= car and holder.path ~= nil then
					car.blocker = holder
					car.blockedIndex = j
					return false
				end
			end
		end
		for k = j, last do
			local key = path[k]
			local holder = reservations[key]
			if holder ~= car then
				if holder then
					removeHeld(holder, key)
				end
				reservations[key] = car
				car.held[#car.held + 1] = key
			end
		end
		return true
	end

	-- Une voiture qui attend une case tenue par une voiture qui attend, ... qui
	-- attend la première : boucle d'attente. Renvoie la voiture de numéro le plus
	-- bas de la boucle (la seule autorisée à la casser), ou nil s'il n'y a pas de boucle.
	local function lowestInWaitCycle(car)
		local lowest = car
		local cursor = car.blocker
		for _ = 1, CYCLE_LIMIT do
			if cursor == nil then
				return nil
			end
			if cursor == car then
				return lowest
			end
			if cursor.id < lowest.id then
				lowest = cursor
			end
			cursor = cursor.blocker
		end
		return nil
	end

	-- Case sous la voiture, si c'est une route : celle-là n'est jamais rendue
	-- tant que la voiture s'y trouve.
	local function standingKey(self, car)
		if not car.center then
			return nil
		end
		local x, y = Grid.cellFromWorld(self.origin, car.center)
		local key = Grid.key(x, y)
		return self.roads[key] and key or nil
	end

	function Session:releaseCarReservation(car, key)
		if not key then
			return
		end
		if self.intersectionReservations[key] == car then
			self.intersectionReservations[key] = nil
		end
		removeHeld(car, key)
	end

	-- Libère toutes les réservations de la voiture, sauf `keepKey` : la case
	-- où elle se trouve encore reste occupée tant qu'elle n'en est pas sortie.
	function Session:releaseCarReservations(car, keepKey)
		local kept = {}
		for _, key in ipairs(car.held) do
			if key == keepKey then
				kept[#kept + 1] = key
			elseif self.intersectionReservations[key] == car then
				self.intersectionReservations[key] = nil
			end
		end
		car.held = kept
	end

	-- Libère les réservations qui ne servent plus à la voiture après un
	-- changement de trajet : seules restent la case quittée et celles du trajet
	-- restant.
	function Session:releaseUnusedHolds(car)
		local path = car.path
		local keep = {}
		if car.lastKey then
			keep[car.lastKey] = true
		end
		for i = car.index, #path do
			keep[path[i]] = true
		end
		for i = #car.held, 1, -1 do
			local key = car.held[i]
			if not keep[key] then
				self:releaseCarReservation(car, key)
			end
		end
	end

	-- Une voiture arrêtée derrière une autre ne garde pas les cases qu'elle n'a
	-- pas encore atteintes : la voiture de devant peut en avoir besoin, et sans
	-- cela chacune attendrait l'autre (l'une retient la case, l'autre bloque le
	-- passage). La case du segment en cours n'est rendue qu'avant d'y entrer.
	local function releaseAheadHolds(self, car)
		local path = car.path
		local reservations = self.intersectionReservations
		local k = car.index
		if car.s > 0 then
			k += 1
		end
		-- Une suite prise en avance commence au nœud visé ou au suivant.
		if reservations[path[k]] ~= car then
			k += 1
		end
		while path[k] and reservations[path[k]] == car do
			self:releaseCarReservation(car, path[k])
			k += 1
		end
	end

	-- Trajets ------------------------------------------------------------------

	-- Chemin de cases entre deux bâtiments, depuis une case de route donnée
	-- (fromKey) ou depuis les connecteurs de l'origine. Une seule recherche
	-- même avec plusieurs connecteurs de départ.
	function Session:computeRoute(origin, goal, fromKey)
		local goalSet = {}
		for _, key in ipairs(self:connectorCells(goal)) do
			goalSet[key] = true
		end
		if next(goalSet) == nil then
			return nil
		end

		local starts = fromKey and { fromKey } or self:connectorCells(origin)
		return Pathfinding.findFromAny(self.roads, self.size, starts, goalSet, RoadConfig.AllowDiagonals)
	end

	-- Mis en cache : les chemins sont recalculés seulement quand la version du
	-- réseau change.
	function Session:findRoute(origin, goal, fromKey)
		if self.routeCacheVersion ~= self.roadVersion then
			self.routeCache = {}
			self.routeCacheVersion = self.roadVersion
		end
		local startName = fromKey or Grid.key(origin.x, origin.y)
		local cacheKey = startName .. ">" .. Grid.key(goal.x, goal.y)
		local cached = self.routeCache[cacheKey]
		if cached == nil then
			cached = self:computeRoute(origin, goal, fromKey) or false
			self.routeCache[cacheKey] = cached
		end
		return cached or nil
	end

	-- Magasin de la couleur de la maison, avec une demande libre, le plus proche
	-- par la route. Une seule recherche vers les connecteurs de tous ces magasins
	-- (au lieu d'une par magasin). Renvoie le magasin et le chemin, ou nil.
	local function nearestReachableStore(self, house)
		local goalSet, owner = {}, {}
		local found = false
		for _, store in ipairs(self.destinations) do
			if store.colorIndex == house.colorIndex and store.demands - store.reserved > 0 then
				for _, key in ipairs(self:connectorCells(store)) do
					goalSet[key] = true
					owner[key] = store
					found = true
				end
			end
		end
		if not found then
			return nil, nil
		end
		local path = Pathfinding.findFromAny(
			self.roads,
			self.size,
			self:connectorCells(house),
			goalSet,
			RoadConfig.AllowDiagonals
		)
		if not path then
			return nil, nil
		end
		return owner[path[#path]], path
	end

	-- Chemin restant de la voiture. Une voiture déjà sur le réseau repart de la
	-- dernière case atteinte ; sinon elle part du connecteur de sa maison.
	function Session:findPath(car)
		local origin, goal = carEnds(car)
		local fromKey = car.lastKey
		if fromKey then
			if not self.roads[fromKey] then
				return nil
			end
			return self:findRoute(origin, goal, fromKey)
		end
		return self:findRoute(origin, goal, nil)
	end

	-- Prépare le segment vers le nœud courant du trajet, depuis la position
	-- actuelle : la voiture ne se téléporte jamais vers une case.
	function Session:startSegment(car)
		local path = car.path
		local index = car.index
		local count = #path
		local origin, goal = carEnds(car)
		local targetKey = path[index]
		local target = targetKey and cellCenter(self, targetKey) or self:carTargetSpot(car)

		local nextPoint = nil
		if index < count then
			nextPoint = cellCenter(self, path[index + 1])
		elseif index == count then
			nextPoint = self:carTargetSpot(car)
		end

		car.seg = makeSegment(car.center, target, nextPoint, self.tile * VEHICLE.CornerCutTiles)
		car.s = 0
		setLane(self, car, index > 1 and path[index - 1] or origin, targetKey or goal)
	end

	-- Le trajet restant ne traverse que des cases encore routières : il n'y a
	-- alors aucune raison de le recalculer.
	local function pathIntact(self, car)
		local path = car.path
		if car.lastKey and not self.roads[car.lastKey] then
			return false
		end
		for i = car.index, #path do
			if not self.roads[path[i]] then
				return false
			end
		end
		return true
	end

	-- Recalcule le trajet après un changement du réseau. Le segment en cours
	-- est conservé quand sa cible existe encore ; sinon la voiture revient
	-- à la dernière case atteinte, ou reste sur place sans route.
	function Session:replanCar(car)
		car.roadVersion = self.roadVersion
		local oldKey = car.path and car.path[car.index] or nil
		local lastKey = car.lastKey

		if oldKey and self.roads[oldKey] then
			local origin, goal = carEnds(car)
			local tail = self:findRoute(origin, goal, oldKey)
			if tail then
				local path = {}
				local offset = 0
				if lastKey and self.roads[lastKey] then
					path[1] = lastKey
					offset = 1
				end
				for i, key in ipairs(tail) do
					path[i + offset] = key
				end
				car.path = path
				car.index = offset + 1
				car.lostTime = 0
				self:releaseUnusedHolds(car)
				self:startSegment(car)
				return
			end
		end

		local path = self:findPath(car)
		if path then
			car.path = path
			car.index = 1
			car.lostTime = 0
			self:releaseUnusedHolds(car)
			self:startSegment(car)
		else
			car.path = nil
			car.seg = nil
			self:releaseCarReservations(car, standingKey(self, car))
			car.retry = Config.Traffic.RetryPathInterval
		end
	end

	-- Après un lot de routes (la version du réseau a déjà changé) : une voiture
	-- dont le trajet reste valide continue sans recherche ; les autres sont
	-- recalculées une seule fois, à leur prochain pas.
	function Session:refreshCarPaths()
		for _, car in ipairs(self.cars) do
			if car.path and pathIntact(self, car) then
				car.roadVersion = self.roadVersion
			else
				car.retry = 0
			end
		end
	end

	-- Espacement -----------------------------------------------------------------

	-- Distance le long du trajet jusqu'à la voiture qui précède sur la même
	-- voie (ou sur les voies suivantes du trajet), ou nil si la voie est libre.
	function Session:frontGap(car)
		local horizon = VEHICLE.LookaheadTiles * self.tile
		local best = nil

		local list = car.lane
		if list then
			local s = car.s
			for i = 1, #list do
				local other = list[i]
				if other ~= car and other.s > s then
					local d = other.s - s
					if d < horizon and (best == nil or d < best) then
						best = d
					end
				end
			end
		end

		local path = car.path
		if path and car.seg then
			local _, goal = carEnds(car)
			local along = car.seg.length - car.s
			for j = car.index + 1, #path + 1 do
				if along >= horizon then
					break
				end
				local ahead = laneList(self, path[j - 1], path[j] or goal, false)
				if ahead then
					for i = 1, #ahead do
						local d = along + ahead[i].s
						if d < horizon and (best == nil or d < best) then
							best = d
						end
					end
				end
				along += self.tile
			end
		end
		return best
	end

	-- Apparence -----------------------------------------------------------------

	-- Place de stationnement du bâtiment, côté de son connecteur : la voiture
	-- reste entièrement dans la case du bâtiment, son bout extérieur affleurant
	-- le bord de la case. Elle ne déborde jamais dans la case du connecteur.
	-- Chaque connecteur a sa place : deux voitures qui utilisent des connecteurs
	-- différents ne se garent jamais au même endroit.
	function Session:parkingSpot(building, connectorKey)
		local base = Grid.center(self.origin, building.x, building.y, CarModel.CenterY)
		local x, y = Grid.parse(connectorKey)
		if not x then
			return base
		end
		local toConnector = Grid.center(self.origin, x, y, CarModel.CenterY) - base
		local reach = self.tile * (0.5 - Config.Dimensions.Car.Length * 0.5)
		return base + toConnector.Unit * reach
	end

	-- Point d'arrivée du trajet : la place du bâtiment d'arrivée, reliée au
	-- dernier connecteur du chemin.
	function Session:carTargetSpot(car)
		local _, goal = carEnds(car)
		return self:parkingSpot(goal, car.path[#car.path])
	end

	function Session:createCarVisual(house, spot)
		local palette = COLORS[house.colorIndex]
		local model = CarModel.create(palette.color, self.tile)
		model:PivotTo(CFrame.new(spot))
		model.Parent = self.world.Cars
		return model
	end

	-- Cycle de vie ----------------------------------------------------------------

	-- Crée la voiture d'un trajet déjà validé (demande réservée, chemin connu).
	function Session:createCar(house, destination, demandId, path)
		local homeSpot = self:parkingSpot(house, path[1])
		nextCarId += 1
		local car = {
			id = nextCarId,
			house = house,
			dest = destination,
			demandId = demandId,
			claim = true,
			state = "out",
			path = path,
			index = 1,
			lastKey = nil,
			held = {},
			reserveWait = 0,
			blocker = nil,
			blockedIndex = nil,
			center = homeSpot,
			pos = homeSpot,
			s = 0,
			seg = nil,
			lane = nil,
			heading = nil,
			speedFactor = 0,
			laneFrom = false,
			laneTo = false,
			roadVersion = self.roadVersion,
			blocked = false,
			waitTime = 0,
			lostTime = 0,
			retry = 0,
			part = self:createCarVisual(house, homeSpot),
		}

		table.insert(self.cars, car)
		house.car = car
		self:startSegment(car)
		if self.recordStat then
			self:recordStat("carsSpawned", 1)
		end
		return car
	end

	function Session:trySpawnCar(house)
		if house.car or self.over or not self.world then
			return
		end

		-- Un seul calcul de chemin pour tous les magasins candidats : la maison
		-- ne vise qu'un magasin qu'une route atteint réellement.
		local nearest, nearestPath = nearestReachableStore(self, house)
		local destination = self:findDestinationForHouse(house, true, function(store)
			return store == nearest
		end)
		if not destination then
			house.dest = nil
			house.timer = StoreConfig.Demand.NoDemandRetry
			return
		end

		-- Aucune voiture sans route : on vérifie le trajet avant de réserver la
		-- demande ou de créer le modèle.
		local path = destination == nearest and nearestPath or self:findRoute(house, destination, nil)
		if not path then
			house.dest = nil
			house.timer = StoreConfig.Demand.NoDemandRetry
			return
		end

		-- La demande est réservée immédiatement : deux voitures ne peuvent
		-- jamais servir le même pin.
		local demandId = self.storeSystem and self.storeSystem:claimDemand(destination)
		if not demandId then
			house.timer = StoreConfig.Demand.NoDemandRetry
			return
		end
		house.dest = destination
		self:createCar(house, destination, demandId, path)
	end

	-- Fin de trajet : livraison à l'aller, retour à la maison.
	function Session:completeLeg(car)
		if car.state ~= "out" then
			return true
		end

		local delivered = false
		if car.dest and car.demandId and self.storeSystem then
			delivered = self.storeSystem:consumeDemand(car.dest, car.demandId)
		end
		car.demandId = nil
		car.claim = false

		-- On ne marque des points que si une demande a réellement été
		-- consommée. Une voiture qui arrive après coup ne peut pas voler le
		-- pin d'une autre. Session:onDelivery est le seul endroit qui score.
		if delivered then
			self:onDelivery(car.house, car.dest)
			self:destinationPulse(car.dest)
		end

		car.state = "back"
		car.waitTime = 0
		car.lostTime = 0
		car.roadVersion = self.roadVersion
		local path = self:findPath(car)
		if path then
			-- Le retour repart du connecteur du magasin : la voiture garde
			-- cette case jusqu'à la quitter, pour qu'aucune autre n'y entre.
			car.path = path
			car.index = 1
			self:releaseUnusedHolds(car)
			self:startSegment(car)
		else
			car.path = nil
			car.seg = nil
			self:releaseCarReservations(car)
			car.retry = Config.Traffic.RetryPathInterval
		end
		return false
	end

	-- Arrivée au bout du segment courant : nœud du trajet, ou place du bâtiment.
	-- Renvoie true si la voiture doit être retirée.
	function Session:arriveAt(car)
		local index = car.index
		local key = car.path[index]
		if not key then
			return self:completeLeg(car)
		end
		car.lastKey = key
		if index > 1 then
			self:releaseCarReservation(car, car.path[index - 1])
		end
		car.index = index + 1
		self:startSegment(car)
		return false
	end

	-- Distance (depuis le début du segment) que la voiture peut atteindre :
	-- nil si elle ne peut pas entrer dans le segment, la longueur du segment si
	-- tout est libre. Les cases réservables se prennent en avance, avant d'y
	-- entrer : si la suivante n'est pas libre, la voiture s'arrête avant elle
	-- (au bout du segment, ou au début de l'arc qui la pousserait dans la case),
	-- jamais dedans. Le second résultat indique que la voiture doit s'arrêter
	-- avant la case suivante.
	local function segmentRoom(self, car)
		local seg = car.seg
		local index = car.index
		if car.s <= 0 and not secureNode(self, car, index) then
			return nil, true
		end
		if secureNode(self, car, index + 1) then
			return seg.length, false
		end
		local stop = seg.ctrl and seg.lineLength or seg.length
		if car.s > stop then
			-- Trop tard pour s'arrêter avant l'arc.
			return seg.length, false
		end
		return stop, true
	end

	-- Cap de la voiture : il suit exactement la tangente de la trajectoire, donc
	-- la carrosserie reste dans la chaussée dans les virages. Seule une rupture
	-- de la tangente (demi-tour sur la place de stationnement, nouveau trajet)
	-- est lissée : l'écart créé par la rupture s'efface en angle, avec un lissage
	-- exponentiel et une vitesse de rotation limitée.
	function Session:smoothHeading(car, tangentYaw, h)
		local lastTangent = car.tangentYaw or tangentYaw
		local jump = wrapAngle(tangentYaw - lastTangent)
		car.tangentYaw = tangentYaw
		local offset = car.yawOffset or 0
		if math.abs(jump) > VEHICLE.TurnRate * h then
			offset = wrapAngle(offset - jump)
		end
		local alpha = 1 - math.exp(-TRAFFIC.HeadingLerp * h)
		local maxTurn = VEHICLE.TurnRate * h
		local target = offset - clamp(offset * alpha, -maxTurn, maxTurn)
		-- L'écart ne peut que se réduire : jamais de rotation à contresens.
		if math.abs(target) > math.abs(offset) then
			target = offset
		end
		car.yawOffset = target
		return headingFromYaw(tangentYaw + target)
	end

	-- Avance la voiture d'un pas `h` (secondes simulées). Renvoie true si la
	-- voiture doit être retirée.
	function Session:stepCar(car, h, spacing)
		local path = car.path
		local seg = car.seg
		local gap = self:frontGap(car)
		local blockedByGap = gap ~= nil and gap <= spacing

		car.blocker = nil
		local room, stopAhead = seg.length, false
		if blockedByGap then
			releaseAheadHolds(self, car)
		else
			room, stopAhead = segmentRoom(self, car)
		end
		local waitingForNode = room == nil
		if waitingForNode then
			room = 0
		elseif stopAhead and room - car.s <= STOP_EPSILON then
			waitingForNode = true
		end

		if waitingForNode then
			car.reserveWait += h
			-- Boucle d'attente : une seule voiture de la boucle prend la case, les
			-- autres suivent ensuite chacune à leur tour.
			if car.reserveWait >= VEHICLE.DeadlockCheckTime and car.blocker and lowestInWaitCycle(car) == car then
				secureNode(self, car, car.blockedIndex, true)
				car.reserveWait = 0
			end
		else
			car.reserveWait = 0
		end

		local blocked = blockedByGap or waitingForNode
		local mustStop = stopAhead or car.index > #path
		local remain = room - car.s

		local speed = Config.Traffic.CarSpeed
		local speedTarget = 1
		if seg.ctrl then
			speedTarget = math.min(speedTarget, TRAFFIC.TurnSpeedFactor, seg.speedLimit)
		end
		local targetKey = path[car.index]
		if targetKey and self.intersections[targetKey] then
			speedTarget = math.min(speedTarget, TRAFFIC.IntersectionApproachSlow)
		end
		if gap and not blockedByGap and gap < spacing + VEHICLE.FollowBand then
			speedTarget = math.min(speedTarget, math.max(0.2, (gap - spacing) / VEHICLE.FollowBand))
		end
		local misalign = car.yawOffset
		if misalign and misalign ~= 0 then
			speedTarget = math.min(speedTarget, math.max(0, 1 - math.abs(misalign) / VEHICLE.AlignAngle))
		end
		-- Arrivée à la place du bâtiment, ou case suivante prise : la voiture
		-- freine pour s'arrêter au point d'arrêt (vitesse = racine de 2 a d), au
		-- lieu de s'arrêter net. Un retour part ainsi de l'arrêt.
		if not blocked and mustStop then
			local brake = speed * TRAFFIC.Braking * VEHICLE.StopBrakeFactor
			speedTarget = math.min(speedTarget, math.sqrt(2 * brake * math.max(remain, 0)) / speed)
		end
		if blocked then
			speedTarget = 0
		end

		local factor = car.speedFactor
		if speedTarget > factor then
			factor = math.min(speedTarget, factor + TRAFFIC.Acceleration * h)
		else
			factor = math.max(speedTarget, factor - TRAFFIC.Braking * h)
		end
		car.speedFactor = factor

		car.blocked = blocked
		if blocked then
			car.waitTime += h
			if car.waitTime >= Config.Traffic.StuckAfter and self.recordStat then
				self:recordStat("stuckSeconds", h)
			end
		else
			car.waitTime = math.max(0, car.waitTime - 2 * h)
		end

		local distance = 0
		if not blocked then
			distance = speed * factor * h
			if gap then
				distance = math.min(distance, math.max(0, gap - spacing))
			end
			if mustStop then
				distance = math.min(distance, remain)
			end
		end

		local first = true
		while distance > 0 and car.seg do
			if not first then
				room = segmentRoom(self, car)
				if room == nil then
					-- La case suivante n'est pas libre : on s'arrête à la case.
					break
				end
			end
			first = false
			local current = car.seg
			local available = room - car.s
			if distance < available then
				car.s += distance
				break
			end
			distance -= available
			car.s = room
			if room < current.length then
				-- Arrêt avant l'arc : la voiture attend là.
				break
			end
			car.center = current.to
			if self:arriveAt(car) then
				return true
			end
		end

		seg = car.seg
		if seg then
			car.center = pointAt(seg, car.s)
			local tangent = tangentAt(seg, car.s)
			local heading = car.heading or tangent or DEFAULT_HEADING
			if tangent then
				heading = self:smoothHeading(car, yawOf(tangent), h)
			end
			car.heading = heading

			-- Voie de droite : le décalage suit le cap lissé, donc reste continu.
			local right = Vector3.new(-heading.Z, 0, heading.X)
			local lane = self.tile * VEHICLE.LaneOffsetTiles
			if seg.ctrl and car.s > seg.lineLength then
				local u = math.min((car.s - seg.lineLength) / seg.curveLength, 1)
				lane *= 1 - VEHICLE.CurveLanePull * math.sin(math.pi * u)
			end
			car.pos = car.center + right * lane
			if car.part then
				-- Sur un pont, le tablier est plus haut que la route : la voiture
				-- monte de la même hauteur pour ne pas s'enfoncer dans le tablier.
				local lift = 0
				if next(self.bridges) ~= nil then
					local cx, cy = Grid.cellFromWorld(self.origin, car.pos)
					if self.bridges[Grid.key(cx, cy)] then
						lift = RoadConfig.Layers.Bridge.Top - RoadConfig.Layers.Body.Top
					end
				end
				local position = car.pos + Vector3.new(0, lift, 0)
				car.part:PivotTo(CFrame.lookAt(position, position + heading))
			end
		end
		return false
	end

	-- Met à jour une voiture. Renvoie true si elle doit être retirée.
	function Session:updateCar(car, dt)
		if car.roadVersion ~= self.roadVersion then
			self:replanCar(car)
		end

		if not car.seg then
			-- Sans route, la voiture reste à sa place et réessaie régulièrement.
			-- Après ClaimTimeout elle disparaît : sa demande est alors libérée.
			car.blocked = true
			car.lostTime += dt
			car.retry -= dt
			if car.retry <= 0 then
				self:replanCar(car)
			end
			return car.lostTime >= StoreConfig.Demand.ClaimTimeout
		end

		-- L'amélioration de circulation raccourcit la distance de sécurité.
		local spacing = Config.Traffic.CarSpacing
		if self.getTrafficMultiplier then
			spacing *= self:getTrafficMultiplier()
		end

		local remaining = dt
		while remaining > 0 do
			local h = math.min(remaining, VEHICLE.MaxStep)
			remaining -= h
			if self:stepCar(car, h, spacing) then
				return true
			end
			if not car.seg then
				return false
			end
		end
		return false
	end

	function Session:retireCar(car)
		leaveLane(car)
		self:releaseCarReservations(car)
		if car.claim and car.dest and car.demandId and self.storeSystem then
			self.storeSystem:releaseClaim(car.dest, car.demandId)
			car.claim = false
			car.demandId = nil
		end
		if car.part then
			car.part:Destroy()
			car.part = nil
		end
		local house = car.house
		if house and house.car == car then
			house.car = nil
			house.timer = Config.Game.SpawnInterval
		end
	end

	function Session:destinationPulse(destination)
		if not destination or not self.world then
			return
		end

		local ring = Instance.new("Part")
		ring.Name = "Delivery"
		ring.Shape = Enum.PartType.Cylinder
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanQuery = false
		ring.CanTouch = false
		local startSize = destination.storeType == "large" and 4.5 or 3.2
		local endSize = destination.storeType == "large" and 10.5 or 7.5
		ring.Material = Enum.Material.Neon
		ring.Color = destination.color
		ring.Transparency = 0.35
		ring.Size = Vector3.new(0.1, startSize, startSize)
		ring.CFrame = CFrame.new(Grid.center(self.origin, destination.x, destination.y, 0.35))
			* CFrame.Angles(0, 0, math.rad(90))
		ring.Parent = self.world.FX

		-- Suivi par la session : destroy() arrête l'anneau en cours.
		local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		SessionUtil.trackTween(
			self.tweens,
			TweenService:Create(ring, info, {
				Size = Vector3.new(0.1, endSize, endSize),
				Transparency = 1,
			})
		):Play()

		task.delay(0.6, function()
			if ring.Parent then
				ring:Destroy()
			end
		end)
	end
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">SessionUtil</string>
          <ProtectedString name="Source"><![CDATA[--[[
	SessionUtil.luau
	Petites fonctions partagées par les modules de Session (pièces, tweens,
	animations). Aucune dépendance sur l'état d'une partie.
]]

local TweenService = game:GetService("TweenService")

local function clamp(value, minValue, maxValue)
	if value < minValue then
		return minValue
	elseif value > maxValue then
		return maxValue
	end
	return value
end

local function makePart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	-- Rendu à plat : aucune ombre dynamique, les ombres sont dessinées en pièces.
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth

	-- La forme d'abord : l'ordre de pairs est arbitraire, et changer Shape après
	-- Size pourrait écraser les dimensions déjà posées.
	if props.Shape then
		p.Shape = props.Shape
	end

	local parent = nil
	for key, value in pairs(props) do
		if key == "Parent" then
			parent = value
		elseif key ~= "Shape" then
			p[key] = value
		end
	end
	if parent then
		p.Parent = parent
	end
	return p
end

-- Enregistre un tween dans `tweens` (table clé = tween, valeur = connexion à
-- Completed) pour pouvoir l'arrêter à la fin de la partie. Sans table, le tween
-- n'est simplement pas suivi.
local function trackTween(tweens, tween)
	if tweens then
		local connection
		connection = tween.Completed:Connect(function()
			tweens[tween] = nil
			connection:Disconnect()
		end)
		tweens[tween] = connection
	end
	return tween
end

-- Arrête tous les tweens suivis puis vide la table. Chaque connexion est coupée
-- avant l'arrêt : rien ne reste branché, même si Completed ne revient pas.
local function cancelTweens(tweens)
	local active = {}
	for tween, connection in pairs(tweens) do
		active[#active + 1] = { tween = tween, connection = connection }
	end
	for _, entry in ipairs(active) do
		entry.connection:Disconnect()
		entry.tween:Cancel()
	end
	for tween in pairs(tweens) do
		tweens[tween] = nil
	end
end

-- Tween d'apparition en cours, par pièce de route (clés faibles : une pièce
-- détruite disparaît de la table sans autre ménage).
local revealTweens = setmetatable({}, { __mode = "k" })

-- Arrête l'apparition d'une pièce qui va être détruite : un tween ne doit pas
-- continuer à écrire sur une cible morte, ni rester dans la table de Session.
local function stopRoadPartReveal(part)
	local tween = revealTweens[part]
	if tween then
		revealTweens[part] = nil
		tween:Cancel()
	end
end

-- Petite apparition de la route : la pièce grandit et devient opaque.
-- Le délai permet de faire apparaître les cases l'une après l'autre quand
-- le joueur trace un trait continu. Chaque pièce animée coûte une réplication
-- de Size et Transparency à chaque frame : l'appelant limite le nombre de cases.
local function animateRoadPart(part, finalSize, delay, tweens)
	local startSize = Vector3.new(
		math.max(0.04, finalSize.X * 0.52),
		math.max(0.04, finalSize.Y * 0.52),
		math.max(0.04, finalSize.Z * 0.52)
	)
	part.Size = startSize
	part.Transparency = 0.45

	local tween = trackTween(tweens, TweenService:Create(
		part,
		TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delay),
		{ Size = finalSize, Transparency = 0 }
	))
	revealTweens[part] = tween
	tween:Play()
end

-- Anime un Model entier autour de son WorldPivot. Sert à l'apparition d'un
-- magasin et à sa transformation petit carré -> grand cercle. On passe par
-- une NumberValue pour pouvoir tween une valeur puis appeler Model:ScaleTo.
-- Model:ScaleTo n'existe que sur un Model : indexer la méthode sur une Part
-- lèverait une erreur, d'où le test IsA.
local function animateModelScale(model, fromScale, toScale, duration, tweens)
	if not model or not model:IsA("Model") then
		return
	end

	model:ScaleTo(fromScale)
	local value = Instance.new("NumberValue")
	value.Name = "ScaleAnimation"
	value.Value = fromScale

	local connection
	connection = value.Changed:Connect(function(scale)
		if model.Parent then
			model:ScaleTo(scale)
		end
	end)

	local tween = trackTween(tweens, TweenService:Create(
		value,
		TweenInfo.new(duration or 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Value = toScale }
	))
	local finished
	finished = tween.Completed:Connect(function()
		finished:Disconnect()
		if connection then
			connection:Disconnect()
		end
		if model.Parent then
			model:ScaleTo(toScale)
		end
		value:Destroy()
	end)

	value.Parent = model
	tween:Play()
end

return {
	clamp = clamp,
	makePart = makePart,
	trackTween = trackTween,
	cancelTweens = cancelTweens,
	animateRoadPart = animateRoadPart,
	stopRoadPartReveal = stopRoadPartReveal,
	animateModelScale = animateModelScale,
}
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">StoreSystem</string>
          <ProtectedString name="Source"><![CDATA[--[[
	StoreSystem.luau
	Gestion serveur des magasins / destinations :
	  - apparition progressive selon le temps simulé, difficulté lissée
	  - placement semi-aléatoire validé (zones pondérées, espacement, arbres)
	  - maisons en petits groupes autour de leur magasin
	  - génération et réservation des demandes (pins)
	  - évolution petit magasin -> grand magasin
	  - surcharge et compte à rebours
	  - synchronisation de l'état vers le client (StoreState)

	Session reste propriétaire des bâtiments, des routes et des voitures.
	StoreSystem réutilise Session:createBuilding et ne crée pas de second
	système parallèle.

	Aléa : self.rng reprend session.random s'il existe (même interface que
	math.random), ce qui rend les tests reproductibles sans toucher au code.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local StoreConfig = require(Shared.StoreConfig)

local StoreSystem = {}
StoreSystem.__index = StoreSystem

local COLORS = Config.HouseColors
-- Un magasin reçoit une couleur unique : il ne peut pas y en avoir plus que
-- de couleurs dans la palette.
local MAX_STORES = math.min(StoreConfig.Spawn.MaxStores, #COLORS)

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function distanceSquared(ax, ay, bx, by)
	local dx = ax - bx
	local dy = ay - by
	return dx * dx + dy * dy
end

-- Vrai si (x, y) est à au moins minDistance de chaque élément de la liste.
local function isFarEnough(list, x, y, minDistance)
	local limit = minDistance * minDistance
	for _, item in ipairs(list) do
		if distanceSquared(x, y, item.x, item.y) < limit then
			return false
		end
	end
	return true
end

-- Une maison reste dans l'anneau autour de son magasin : assez loin pour ne
-- pas le toucher, assez près pour que le trajet reste court.
local function isInHouseRing(store, x, y)
	local squared = distanceSquared(x, y, store.x, store.y)
	return squared >= StoreConfig.Houses.MinDistanceFromStore ^ 2
		and squared <= StoreConfig.Houses.MaxDistanceFromStore ^ 2
end

-- Vrai si (x, y) tombe sur la droite passant par deux maisons du même magasin :
-- une rangée droite ne ressemble pas à un petit groupe irrégulier.
local function alignsWithHouses(houses, x, y)
	for i = 1, #houses do
		for j = i + 1, #houses do
			local a, b = houses[i], houses[j]
			if (b.x - a.x) * (y - a.y) - (b.y - a.y) * (x - a.x) == 0 then
				return true
			end
		end
	end
	return false
end

-- Intervalle (min, max) des magasins suivants à l'instant `elapsed`.
-- Fonction pure et continue : aucun saut au passage d'un palier. Entre
-- deux paliers, chaque borne glisse linéairement vers celle du palier suivant.
function StoreSystem.spawnIntervalRange(elapsed)
	local tiers = StoreConfig.Spawn.Tiers
	local start = 0
	for index, tier in ipairs(tiers) do
		if index == #tiers or elapsed < tier.untilTime then
			local nextTier = tiers[index + 1] or tier
			local alpha = 0
			if index < #tiers then
				alpha = math.clamp((elapsed - start) / (tier.untilTime - start), 0, 1)
			end
			return lerp(tier.minInterval, nextTier.minInterval, alpha),
				lerp(tier.maxInterval, nextTier.maxInterval, alpha)
		end
		start = tier.untilTime
	end
	local last = tiers[#tiers]
	return last.minInterval, last.maxInterval
end

-- Facteur appliqué aux intervalles de demandes : 1 au début, puis une baisse
-- linéaire jusqu'à RampMinMultiplier en RampDuration secondes simulées.
function StoreSystem.demandRampFactor(elapsed)
	local ramp = math.clamp(elapsed / StoreConfig.Demand.RampDuration, 0, 1)
	return 1 - ramp * (1 - StoreConfig.Demand.RampMinMultiplier)
end

function StoreSystem.new(session)
	local self = setmetatable({}, StoreSystem)
	self.session = session
	-- Alias volontaire : Session.destinations est la liste officielle des
	-- magasins utilisée par les maisons, les voitures et l'état du jeu.
	self.stores = session.destinations
	self.rng = session.random or math
	self.spawnClock = 0
	self.houseClock = StoreConfig.Houses.FirstSpawnDelay
	-- largeCount compte les grands magasins finis ; evolvingCount ceux en
	-- cours d'évolution. Les deux comptent pour la limite de grands magasins.
	self.largeCount = 0
	self.evolvingCount = 0
	self.dirty = false
	self.broadcastClock = 0
	return self
end

function StoreSystem:randomRange(minValue, maxValue)
	return minValue + self.rng.random() * (maxValue - minValue)
end

-- Statistiques de partie : ignorées tant que Session ne les enregistre pas.
function StoreSystem:recordStat(name, amount)
	if self.session.recordStat then
		self.session:recordStat(name, amount)
	end
end

function StoreSystem:seed()
	local spawned = 0
	for _ = 1, StoreConfig.Spawn.StartStores do
		if not self:spawnStore(true) then
			break
		end
		spawned += 1
	end
	self.spawnClock = spawned > 0 and self:nextSpawnInterval() or StoreConfig.Spawn.RetryDelay
	self.houseClock = StoreConfig.Houses.FirstSpawnDelay
	self.dirty = true
end

-- Horloge unique : le temps simulé appartient à Session (session.elapsed).
-- Une session sans horloge (fausse session de test) compte pour 0.
local function simulatedTime(session)
	return session.elapsed or 0
end

function StoreSystem:nextSpawnInterval()
	local minInterval, maxInterval = StoreSystem.spawnIntervalRange(simulatedTime(self.session))
	return self:randomRange(minInterval, maxInterval)
end

-- Couleur libre tirée au hasard : chaque magasin garde une couleur unique.
function StoreSystem:pickColor()
	local used = {}
	for _, store in ipairs(self.stores) do
		used[store.colorIndex] = true
	end

	local free = {}
	for index = 1, #COLORS do
		if not used[index] then
			table.insert(free, index)
		end
	end
	if #free == 0 then
		return nil
	end
	return free[self.rng.random(1, #free)]
end

function StoreSystem:pickZone()
	local zones = StoreConfig.Spawn.Zones
	local total = 0
	for _, zone in ipairs(zones) do
		total += zone.weight
	end

	local pick = self.rng.random() * total
	for _, zone in ipairs(zones) do
		pick -= zone.weight
		if pick <= 0 then
			return zone
		end
	end
	return zones[#zones]
end

-- Vrai si un arbre occupe la case ou l'une de ses voisines. Un bâtiment
-- déborde de sa case (1,3 à 1,6 case de large) : il ne doit pas recouvrir
-- un arbre posé dans une case voisine.
function StoreSystem:isNearTree(x, y)
	local treeCells = self.session.world and self.session.world.treeCells
	if not treeCells then
		return false
	end
	for dx = -1, 1 do
		for dy = -1, 1 do
			if treeCells[(x + dx) .. ":" .. (y + dy)] then
				return true
			end
		end
	end
	return false
end

-- Règles communes aux magasins et aux maisons : case libre (ni eau, ni route,
-- ni bâtiment), à une case du bord de la carte au moins, hors arbres, et
-- entourée d'assez de cases constructibles.
function StoreSystem:isBuildableSpot(x, y, minBuildableNeighbors)
	local size = self.session.size
	if x < 1 or y < 1 or x > size - 2 or y > size - 2 then
		return false
	end
	if not self.session:isFreeCell(x, y) or self:isNearTree(x, y) then
		return false
	end
	return self.session:buildableNeighborCount(x, y) >= minBuildableNeighbors
end

function StoreSystem:isStoreSpotValid(x, y)
	if not self:isBuildableSpot(x, y, StoreConfig.Spawn.MinBuildableNeighbors) then
		return false
	end
	return isFarEnough(self.stores, x, y, StoreConfig.Spawn.MinStoreDistance)
		and isFarEnough(self.session.buildingList, x, y, StoreConfig.Spawn.MinBuildingDistance)
end

-- Repli déterministe : on tire au hasard parmi toutes les cases valides de la
-- zone. Utilisé seulement quand l'échantillonnage aléatoire n'a rien trouvé.
function StoreSystem:pickValidCell(isValid, minX, minY, maxX, maxY)
	local candidates = {}
	for x = math.max(1, minX), maxX do
		for y = math.max(1, minY), maxY do
			if isValid(x, y) then
				table.insert(candidates, { x, y })
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	local pick = candidates[self.rng.random(1, #candidates)]
	return pick[1], pick[2]
end

function StoreSystem:findStoreSpot()
	local size = self.session.size
	local center = (size - 1) * 0.5
	local half = size * 0.5

	for _ = 1, StoreConfig.Spawn.MaxAttempts do
		local zone = self:pickZone()
		local radius = self:randomRange(zone.minRadius, zone.maxRadius) * half
		local angle = self.rng.random() * math.pi * 2
		local x = math.floor(center + math.cos(angle) * radius + 0.5)
		local y = math.floor(center + math.sin(angle) * radius + 0.5)
		if self:isStoreSpotValid(x, y) then
			return x, y
		end
	end

	-- Les zones pondérées sont peut-être toutes occupées : on cherche partout.
	return self:pickValidCell(function(x, y)
		return self:isStoreSpotValid(x, y)
	end, 1, 1, size - 2, size - 2)
end

function StoreSystem:isHouseSpotValid(x, y)
	return self:isBuildableSpot(x, y, StoreConfig.Houses.MinBuildableNeighbors)
		and isFarEnough(self.session.buildingList, x, y, StoreConfig.Houses.MinDistanceFromBuilding)
end

-- Une maison se pose autour du magasin, ou près d'une maison déjà présente
-- (groupe). L'espacement et l'anneau sont toujours imposés : pas de maisons
-- collées, et la disposition reste irrégulière.
function StoreSystem:findHouseSpot(store)
	local houses = store.houses
	local config = StoreConfig.Houses
	local function isValid(x, y)
		return isInHouseRing(store, x, y)
			and not alignsWithHouses(houses, x, y)
			and self:isHouseSpotValid(x, y)
	end

	for _ = 1, config.MaxAttempts do
		local anchorX, anchorY = store.x, store.y
		local minRadius, maxRadius = config.MinDistanceFromStore, config.MaxDistanceFromStore
		if #houses > 0 and self.rng.random() < config.ClusterChance then
			local anchor = houses[self.rng.random(1, #houses)]
			anchorX, anchorY = anchor.x, anchor.y
			minRadius, maxRadius = config.ClusterMinDistance, config.ClusterMaxDistance
		end
		local angle = self.rng.random() * math.pi * 2
		local radius = self:randomRange(minRadius, maxRadius)
		local x = math.floor(anchorX + math.cos(angle) * radius + 0.5)
		local y = math.floor(anchorY + math.sin(angle) * radius + 0.5)
		if isValid(x, y) then
			return x, y
		end
	end

	local reach = math.ceil(config.MaxDistanceFromStore)
	return self:pickValidCell(isValid, store.x - reach, store.y - reach, store.x + reach, store.y + reach)
end

function StoreSystem:createHouse(store, x, y)
	local house = self.session:createBuilding("house", x, y, store.colorIndex)
	house.dest = store
	house.homeStore = store
	house.timer = Config.Game.FirstSpawnDelay + self.rng.random() * StoreConfig.Houses.FirstTripJitter
	table.insert(store.houses, house)
	self:recordStat("housesSpawned", 1)
	return house
end

function StoreSystem:spawnHousesForStore(store, count)
	for _ = 1, count do
		if #self.session.houses >= StoreConfig.Houses.MaxHouses
			or #store.houses >= StoreConfig.Houses.MaxHousesPerStore
		then
			break
		end
		local x, y = self:findHouseSpot(store)
		if not x then
			break
		end
		self:createHouse(store, x, y)
	end
end

-- Ajoute une maison à un magasin qui a encore de la place. Si l'emplacement
-- manque près d'un magasin, on essaie les autres dans un ordre aléatoire.
function StoreSystem:spawnHouse()
	if #self.session.houses >= StoreConfig.Houses.MaxHouses then
		return false
	end

	local candidates = {}
	for _, store in ipairs(self.stores) do
		if #store.houses < StoreConfig.Houses.MaxHousesPerStore then
			table.insert(candidates, store)
		end
	end

	while #candidates > 0 do
		local store = table.remove(candidates, self.rng.random(1, #candidates))
		local x, y = self:findHouseSpot(store)
		if x then
			self:createHouse(store, x, y)
			return true
		end
	end
	return false
end

function StoreSystem:markOverload(store)
	if not store.overloaded then
		store.overloaded = true
		store.overloadClock = StoreConfig.Demand.OverloadGrace
		self.dirty = true
	end
end

function StoreSystem:clearOverload(store)
	if store.overloaded or store.critical then
		store.overloaded = false
		store.critical = false
		store.overloadClock = StoreConfig.Demand.OverloadGrace
		self.dirty = true
	end
end

-- Ajoute une demande. Les demandes réservées par une voiture comptent aussi
-- dans la capacité : elles restent affichées jusqu'à la livraison.
function StoreSystem:addDemand(store)
	local demandIds = store.demandIds
	if #demandIds >= store.capacity then
		self:markOverload(store)
		return false
	end

	store.demandSeq += 1
	table.insert(demandIds, tostring(store.id) .. "-" .. tostring(store.demandSeq))
	store.demands = #demandIds
	if store.demands >= store.capacity then
		self:markOverload(store)
	end
	self.dirty = true
	self:recordStat("demandsCreated", 1)
	return true
end

function StoreSystem:claimDemand(store)
	if not store then
		return nil
	end
	for _, demandId in ipairs(store.demandIds) do
		if not store.reservedIds[demandId] then
			store.reservedIds[demandId] = true
			store.reserved += 1
			return demandId
		end
	end
	return nil
end

function StoreSystem:releaseClaim(store, demandId)
	if not store then
		return false
	end
	if demandId and store.reservedIds[demandId] then
		store.reservedIds[demandId] = nil
		store.reserved = math.max(0, store.reserved - 1)
		self.dirty = true
		return true
	end
	return false
end

function StoreSystem:consumeDemand(store, demandId)
	if not store or not demandId then
		return false
	end

	local index = table.find(store.demandIds, demandId)
	if not index then
		-- La demande a déjà été servie : on libère seulement la réservation.
		self:releaseClaim(store, demandId)
		return false
	end

	table.remove(store.demandIds, index)
	if store.reservedIds[demandId] then
		store.reservedIds[demandId] = nil
		store.reserved = math.max(0, store.reserved - 1)
	end
	store.demands = #store.demandIds
	store.delivered += 1
	-- Toute livraison libère la place : le compte à rebours repart de zéro.
	if store.demands < store.capacity then
		self:clearOverload(store)
	end
	self.dirty = true
	self:recordStat("demandsServed", 1)
	return true
end

-- Magasin le plus proche de même couleur. isReachable(store) (optionnel) écarte
-- les magasins sans trajet tant qu'un autre candidat reste ; sans candidat
-- atteignable, on garde le plus proche pour que la voiture réessaie.
function StoreSystem:findDestination(house, requireAvailable, isReachable)
	local best, bestDistance = nil, math.huge
	local fallback, fallbackDistance = nil, math.huge
	for _, store in ipairs(self.stores) do
		if store.colorIndex == house.colorIndex then
			local available = store.demands - store.reserved
			if not requireAvailable or available > 0 then
				local distance = math.abs(store.x - house.x) + math.abs(store.y - house.y)
				if distance < fallbackDistance then
					fallback = store
					fallbackDistance = distance
				end
				if distance < bestDistance and (not isReachable or isReachable(store)) then
					best = store
					bestDistance = distance
				end
			end
		end
	end
	return best or fallback
end

function StoreSystem:demandInterval(store)
	local base = store.storeType == "large"
		and StoreConfig.Demand.LargeInterval
		or StoreConfig.Demand.SmallInterval
	local jitter = StoreConfig.Demand.Jitter
	return math.max(
		StoreConfig.Demand.MinInterval,
		base * StoreSystem.demandRampFactor(simulatedTime(self.session)) * self:randomRange(1 - jitter, 1 + jitter)
	)
end

-- Un petit magasin peut devenir grand tant que la limite n'est pas atteinte,
-- en comptant aussi les évolutions déjà lancées.
function StoreSystem:canEvolve(store)
	return store.storeType == "small"
		and not store.evolving
		and store.age >= StoreConfig.Evolution.MinAge
		and store.delivered >= StoreConfig.Evolution.MinDeliveries
		and self.largeCount + self.evolvingCount < StoreConfig.Evolution.MaxLargeStores
end

function StoreSystem:beginEvolution(store)
	if store.evolving then
		return
	end
	store.evolving = true
	store.evolveTimer = StoreConfig.Evolution.AnimationDuration
	self.evolvingCount += 1
	self.dirty = true
	self.session:replaceStoreModel(store)
end

function StoreSystem:finishEvolution(store)
	store.evolving = false
	store.storeType = "large"
	store.capacity = StoreConfig.Demand.LargeCapacity
	self.evolvingCount -= 1
	self.largeCount += 1
	if store.demands < store.capacity then
		self:clearOverload(store)
	end
	self.dirty = true
end

function StoreSystem:updateStore(store, dt)
	store.age += dt

	if store.evolving then
		store.evolveTimer -= dt
		if store.evolveTimer <= 0 then
			self:finishEvolution(store)
		end
		return
	end

	store.demandClock -= dt
	if store.demandClock <= 0 then
		store.demandClock = self:demandInterval(store)
		-- addDemand signale lui-même la surcharge quand le magasin est plein.
		self:addDemand(store)
	end

	if store.overloaded then
		local wasCritical = store.critical
		store.overloadClock -= dt
		if store.overloadClock <= 0 then
			store.critical = true
		end
		-- Le compte à rebours doit se rafraîchir côté client jusqu'à la
		-- criticité (le passage en critique est lui-même envoyé) : ensuite
		-- l'horloge reste figée à 0 dans le payload, inutile de le réémettre
		-- cinq fois par seconde.
		if not wasCritical then
			self.dirty = true
		end
	end

	if store.storeType == "small" then
		store.evolveClock -= dt
		if store.evolveClock <= 0 then
			if self:canEvolve(store) and self.rng.random() < StoreConfig.Evolution.Chance then
				self:beginEvolution(store)
			else
				local checkInterval = StoreConfig.Evolution.CheckInterval
				local jitter = StoreConfig.Evolution.CheckJitter
				store.evolveClock = self:randomRange(
					checkInterval * (1 - jitter),
					checkInterval * (1 + jitter)
				)
			end
		end
	end
end

function StoreSystem:spawnStore(initial)
	if #self.stores >= MAX_STORES then
		return false
	end
	local colorIndex = self:pickColor()
	if not colorIndex then
		return false
	end
	local x, y = self:findStoreSpot()
	if not x then
		return false
	end

	local store = self.session:createBuilding("store", x, y, colorIndex, "small")
	store.storeType = "small"
	store.capacity = StoreConfig.Demand.SmallCapacity
	store.houses = {}
	store.demandIds = {}
	store.reservedIds = {}
	store.demandSeq = 0
	store.demands = 0
	store.reserved = 0
	store.delivered = 0
	store.age = 0
	store.demandClock = self:randomRange(
		StoreConfig.Demand.FirstDelayMin,
		StoreConfig.Demand.FirstDelayMax
	)
	store.overloaded = false
	store.critical = false
	store.overloadClock = StoreConfig.Demand.OverloadGrace
	store.evolving = false
	store.evolveTimer = 0
	store.evolveClock = StoreConfig.Evolution.MinAge
		+ self:randomRange(0, StoreConfig.Evolution.CheckInterval)

	self:spawnHousesForStore(
		store,
		initial and StoreConfig.Houses.StartHouses or StoreConfig.Houses.HousesPerStore
	)

	self:recordStat("storesSpawned", 1)
	self.dirty = true
	return true
end

function StoreSystem:getOverloadDrain()
	local drain = 0
	for _, store in ipairs(self.stores) do
		if store.critical then
			drain += StoreConfig.Demand.OverloadDrainPerSecond
		end
	end
	return drain
end

function StoreSystem:snapshot()
	local stores = {}
	for _, store in ipairs(self.stores) do
		local demandIds = {}
		for index, demandId in ipairs(store.demandIds or {}) do
			demandIds[index] = demandId
		end
		table.insert(stores, {
			id = store.id,
			x = store.x,
			y = store.y,
			colorIndex = store.colorIndex,
			storeType = store.storeType or "small",
			demands = #demandIds,
			demandIds = demandIds,
			capacity = store.capacity or StoreConfig.Demand.SmallCapacity,
			overloaded = store.overloaded == true,
			critical = store.critical == true,
			evolving = store.evolving == true,
			overloadClock = math.max(0, store.overloadClock or 0),
		})
	end
	return { stores = stores }
end

function StoreSystem:broadcast()
	if not self.session.player then
		return
	end
	Remotes.get("StoreState"):FireClient(self.session.player, self:snapshot())
end

function StoreSystem:update(dt)
	if self.session.over then
		return
	end

	-- Quand le nombre maximal de magasins est atteint, l'horloge s'arrête :
	-- plus aucune tentative de placement inutile.
	if #self.stores < MAX_STORES then
		self.spawnClock -= dt
		if self.spawnClock <= 0 then
			if self:spawnStore(false) then
				self.spawnClock = self:nextSpawnInterval()
			else
				self.spawnClock = StoreConfig.Spawn.RetryDelay
			end
		end
	end

	self.houseClock -= dt
	if self.houseClock <= 0 then
		self:spawnHouse()
		self.houseClock = StoreConfig.Houses.SpawnInterval
	end

	for _, store in ipairs(self.stores) do
		self:updateStore(store, dt)
	end

	-- La cadence de diffusion se mesure en temps réel : dt est en temps simulé,
	-- donc on le ramène au temps réel avec la vitesse choisie (Session:update).
	self.broadcastClock += dt / math.max(1, self.session.speed or 1)
	if (self.dirty and self.broadcastClock >= StoreConfig.Sync.DirtyDelay)
		or self.broadcastClock >= StoreConfig.Sync.IdleDelay
	then
		self.dirty = false
		self.broadcastClock = 0
		self:broadcast()
	end
end

function StoreSystem:destroy()
	-- Une réservation ne survit pas à la partie : les voitures qui la
	-- portaient sont retirées par Session.
	for _, store in ipairs(self.stores) do
		store.reservedIds = {}
		store.reserved = 0
	end
	self.stores = {}
	self.dirty = false
end

return StoreSystem
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <ProtectedString name="Source"><![CDATA[--[[
	WorldBuilder.luau
	Construit le décor 3D d'une ville : un plateau clair posé sur un fond à
	peine plus foncé, une grille très discrète, l'eau et les parcs (formes de
	Maps), quelques arbres, puis les dossiers qui recevront routes, bâtiments
	et voitures.
	Les formes d'eau sont celles de l'aperçu du menu. Les rectangles et les barres
	sont rognés au bord du plateau ; les ellipses doivent rester dans la carte
	(vérifié par les tests).
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Maps = require(Shared.Maps)
local SessionUtil = require(script.Parent.SessionUtil)
local part = SessionUtil.makePart

local WorldBuilder = {}

-- Un Cylinder a son axe selon X : la rotation le couche debout, son disque
-- est alors dans le plan XZ, comme les cases vues d'en haut.
local CYLINDER_UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

-- Hauteurs des couches, en studs, au-dessus du plateau (y = 0). Chaque couche
-- est posée au-dessus de la précédente : aucune surface coplanaire, donc pas de
-- scintillement. Les routes (RoadConfig.Layers, dessus de 0.29 à 0.40) restent
-- au-dessus du décor (0.18 au plus).
local LAYER_THICKNESS = 0.08
local GRASS_TOP = 0.015
local SHORE_TOP = 0.10
local WATER_TOP = 0.12
local DRY_SHORE_TOP = 0.16
local DRY_TOP = 0.18

-- La grille passe sous l'eau : elle disparaît sous les lacs, comme dans le
-- jeu d'origine, et ne concurrence pas les routes. Les lignes sont translucides
-- et se croisent : les horizontales sont posées 0.01 plus haut que les
-- verticales, sinon les deux se disputeraient le même plan à chaque croisement.
local GRID_Y = 0.02
local GRID_THICKNESS = 0.03
local GRID_H_LIFT = 0.01

local TREE_TOP = 0.075
local TREE_THICKNESS = 0.03
-- Carré de cases au centre du plateau, sans arbre (zone de départ).
local START_AREA_CELLS = 4
local TREE_SHADOW_TOP = 0.05
local TREE_SHADOW_THICKNESS = 0.02

-- Plateau : dalle de 1 stud dont le dessus est à y = 0. Les ombres de bord
-- descendent par paliers, sous le plateau, et le fond est plus bas encore.
local BOARD_THICKNESS = 1
local SHADOW_THICKNESS = 0.2
local SHADOW_Y = -1.1
local SHADOW_STEP = 0.1
local BACKDROP_THICKNESS = 0.4
local BACKDROP_Y = -1.6

-- Disque (ou ellipse) plat vu du dessus. Un Cylinder garde un dessus plan à la
-- hauteur voulue ; une sphère aplatie (SpecialMesh) aurait un dôme dont seul le
-- centre atteint cette hauteur, donc une forme visiblement plus petite que celle
-- que Maps.isWater / Maps.isGrass utilisent.
-- width : étendue selon X, depth : étendue selon Z (avant rotation de lacet).
local function addDisk(parent, name, at, width, depth, color, yaw)
	return part({
		Name = name,
		Parent = parent,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(LAYER_THICKNESS, width, depth),
		CFrame = CFrame.new(at) * CFrame.Angles(0, yaw or 0, 0) * CYLINDER_UPRIGHT,
		Color = color,
	})
end

local function isOutside(nx, ny)
	return nx < 0 or nx > 1 or ny < 0 or ny > 1
end

-- Coupe un segment normalisé au plateau [0, 1]² (Liang-Barsky). Renvoie les
-- extrémités rognées, ou rien si le segment ne touche pas le plateau.
local function clipSegment(x1, y1, x2, y2)
	local dx, dy = x2 - x1, y2 - y1
	local ps = { -dx, dx, -dy, dy }
	local qs = { x1, 1 - x1, y1, 1 - y1 }
	local t0, t1 = 0, 1
	for i = 1, 4 do
		local p, q = ps[i], qs[i]
		if p == 0 then
			if q < 0 then
				return nil
			end
		elseif p < 0 then
			t0 = math.max(t0, q / p)
		else
			t1 = math.min(t1, q / p)
		end
	end
	if t0 > t1 then
		return nil
	end
	return x1 + dx * t0, y1 + dy * t0, x1 + dx * t1, y1 + dy * t1
end

-- Dessine une forme normalisée (0..1) sur le plateau. top est le dessus de la
-- couche, grow élargit la forme (liseré de côte). Les rectangles et les barres
-- sont rognés au bord du plateau, pour ne jamais dépasser de la carte.
local function addShape(parent, name, shape, board, color, top, grow)
	local origin, extent = board.origin, board.extent
	local centerY = top - LAYER_THICKNESS * 0.5
	local kind = shape.type

	if kind == "rect" then
		local minX = math.max(origin.X, origin.X + shape.x * extent - grow)
		local maxX = math.min(origin.X + extent, origin.X + (shape.x + shape.w) * extent + grow)
		local minZ = math.max(origin.Z, origin.Z + shape.y * extent - grow)
		local maxZ = math.min(origin.Z + extent, origin.Z + (shape.y + shape.h) * extent + grow)
		if maxX <= minX or maxZ <= minZ then
			return
		end
		part({
			Name = name,
			Parent = parent,
			Size = Vector3.new(maxX - minX, LAYER_THICKNESS, maxZ - minZ),
			CFrame = CFrame.new((minX + maxX) * 0.5, centerY, (minZ + maxZ) * 0.5),
			Color = color,
		})
		return
	end

	if kind == "circle" or kind == "ellipse" then
		local rxNorm = shape.rx or shape.r or 0.05
		local ryNorm = shape.ry or shape.r or rxNorm
		-- La rotation de l'aperçu est horaire à l'écran ; en 3D, l'axe Z
		-- descend et l'axe Y tourne dans le sens inverse.
		local yaw = math.rad(-(shape.rotation or 0))
		addDisk(
			parent,
			name,
			Vector3.new(origin.X + shape.x * extent, centerY, origin.Z + shape.y * extent),
			(rxNorm * extent + grow) * 2,
			(ryNorm * extent + grow) * 2,
			color,
			yaw
		)
		return
	end

	if kind == "bar" then
		local radius = (shape.thickness or 0.04) * extent * 0.5 + grow
		-- Rogner le segment (et non pincer ses extrémités) garde la direction de
		-- la barre telle que Maps.isWater la voit dans le plateau.
		local x1, y1, x2, y2 = clipSegment(shape.x1, shape.y1, shape.x2, shape.y2)
		if not x1 then
			return
		end
		local from = Vector3.new(origin.X + x1 * extent, centerY, origin.Z + y1 * extent)
		local to = Vector3.new(origin.X + x2 * extent, centerY, origin.Z + y2 * extent)
		local delta = to - from
		if delta.Magnitude <= 0 then
			return
		end
		local middle = (from + to) * 0.5
		part({
			Name = name,
			Parent = parent,
			Size = Vector3.new(radius * 2, LAYER_THICKNESS, delta.Magnitude),
			CFrame = CFrame.lookAt(middle, middle + delta.Unit),
			Color = color,
		})
		local function addCap(at)
			addDisk(parent, name, at, radius * 2, radius * 2, color)
		end
		-- Un bout posé hors du plateau reste coupé net : un bout rond dépasserait
		-- de la carte. Une presqu'île garde aussi son côté terre coupé net.
		if not isOutside(shape.x2, shape.y2) then
			addCap(to)
		end
		if not shape.flatStart and not isOutside(shape.x1, shape.y1) then
			addCap(from)
		end
	end
end

-- Générateur pseudo-aléatoire (congruence linéaire) seedé par l'identifiant de
-- la carte : le décor est identique d'une partie à l'autre, et math.random
-- reste disponible pour le reste du jeu.
local function seededRandom(text)
	local state = 1
	for i = 1, #text do
		state = (state * 31 + string.byte(text, i)) % 2147483647
	end
	if state == 0 then
		state = 1
	end
	return function()
		state = (state * 16807) % 2147483647
		return state / 2147483647
	end
end

-- Arbres vus du dessus : de petits disques plats, par groupes de 2 ou 3 dans
-- les cases de parc. Un arbre n'est posé que si son centre et ses bords
-- tombent dans le parc, hors de l'eau. Renvoie les cases occupées par un arbre
-- (clé « x:y », comme Grid.key) pour que les bâtiments les évitent.
local function addTrees(grass, map, board)
	local terrain = Config.Terrain
	local origin, cells, tile = board.origin, board.cells, board.tile
	local rand = seededRandom(map.id)
	local treeCells = {}

	-- La zone de départ, au centre, reste sans arbre : le joueur y commence
	-- toujours sur un terrain dégagé.
	local startFirst = math.floor((cells - START_AREA_CELLS) / 2)
	local function inStartArea(x, y)
		return x >= startFirst
			and x < startFirst + START_AREA_CELLS
			and y >= startFirst
			and y < startFirst + START_AREA_CELLS
	end

	local function usableCell(x, y)
		return x >= 0
			and y >= 0
			and x < cells
			and y < cells
			and not inStartArea(x, y)
			and Maps.isGrass(map, x, y)
			and not Maps.isWater(map, x, y)
	end

	local function usableAt(lx, lz)
		return usableCell(math.floor(lx / tile), math.floor(lz / tile))
	end

	-- lx, lz : position locale, en studs, à partir du coin du plateau.
	local function addDisc(name, lx, lz, diameter, top, thickness, color, transparency)
		part({
			Name = name,
			Parent = grass,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(thickness, diameter, diameter),
			CFrame = CFrame.new(origin.X + lx, top - thickness * 0.5, origin.Z + lz) * CYLINDER_UPRIGHT,
			Color = color,
			Transparency = transparency,
		})
	end

	-- Tous les arbres de la carte se partagent cette liste : deux groupes
	-- voisins ne doivent pas se superposer.
	local placed = {}
	for cy = 0, cells - 1 do
		for cx = 0, cells - 1 do
			if usableCell(cx, cy) and rand() < Config.Terrain.TreeClusterChance then
				local count = 2 + math.floor(rand() * 2)
				local centerX = (cx + 0.5) * tile
				local centerZ = (cy + 0.5) * tile
				for _ = 1, count do
					local angle = rand() * math.pi * 2
					local distance = rand() * terrain.TreeSpread
					local diameter = terrain.TreeDiameter * (0.85 + rand() * 0.3)
					local tone = rand() < 0.5 and Config.Colors.TreeDark or Config.Colors.TreeLight
					local lx = centerX + math.cos(angle) * distance
					local lz = centerZ + math.sin(angle) * distance

					local half = diameter * 0.5
					local clear = usableAt(lx, lz)
						and usableAt(lx - half, lz)
						and usableAt(lx + half, lz)
						and usableAt(lx, lz - half)
						and usableAt(lx, lz + half)
					local spaced = true
					for _, other in ipairs(placed) do
						local dx = other.x - lx
						local dz = other.z - lz
						if dx * dx + dz * dz < terrain.TreeMinSpacing * terrain.TreeMinSpacing then
							spaced = false
						end
					end

					if clear and spaced then
						table.insert(placed, { x = lx, z = lz })
						addDisc(
							"TreeShadow",
							lx + terrain.TreeShadowOffset,
							lz + terrain.TreeShadowOffset,
							diameter * terrain.TreeShadowScale,
							TREE_SHADOW_TOP,
							TREE_SHADOW_THICKNESS,
							Config.Colors.BuildingShadow,
							terrain.TreeShadowTransparency
						)
						addDisc("Tree", lx, lz, diameter, TREE_TOP, TREE_THICKNESS, tone, 0)
						treeCells[math.floor(lx / tile) .. ":" .. math.floor(lz / tile)] = true
					end
				end
			end
		end
	end
	return treeCells
end

-- Grille : une ligne par limite de case intérieure, posée à origin + i * tile,
-- exactement là où Grid.center place les bords de cases.
local function addGrid(grid, board)
	local origin, extent, tile = board.origin, board.extent, board.tile
	local width = Config.Terrain.GridLineWidth
	local transparency = Config.Terrain.GridBaseTransparency
	for i = 1, board.cells - 1 do
		local offset = i * tile
		part({
			Name = "GridV",
			Parent = grid,
			Size = Vector3.new(width, GRID_THICKNESS, extent),
			CFrame = CFrame.new(origin.X + offset, GRID_Y, origin.Z + extent * 0.5),
			Color = Config.Colors.GridTerrain,
			Transparency = transparency,
		})
		part({
			Name = "GridH",
			Parent = grid,
			Size = Vector3.new(extent, GRID_THICKNESS, width),
			CFrame = CFrame.new(origin.X + extent * 0.5, GRID_Y + GRID_H_LIFT, origin.Z + offset),
			Color = Config.Colors.GridTerrain,
			Transparency = transparency,
		})
	end
end

function WorldBuilder.build(session)
	local origin = session.origin
	local size = session.size
	local tile = session.tile
	local map = session.map

	local extent = size * tile
	local center = origin + Vector3.new(extent / 2, 0, extent / 2)
	local board = { origin = origin, extent = extent, cells = size, tile = tile }

	local worlds = Workspace:FindFirstChild("MMWorlds")
	if not worlds then
		worlds = Instance.new("Folder")
		worlds.Name = "MMWorlds"
		worlds.Parent = Workspace
	end

	local root = Instance.new("Folder")
	root.Name = "City_" .. session.worldIndex

	local function folder(name)
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = root
		return f
	end

	local buildings = folder("Buildings")
	local roads = folder("Roads")
	local cars = folder("Cars")
	local fx = folder("FX")
	local water = folder("Water")
	local grass = folder("Grass")
	local grid = folder("Grid")
	-- Le client règle la transparence de la grille pendant la construction.
	grid:SetAttribute("BaseTransparency", Config.Terrain.GridBaseTransparency)
	grid:SetAttribute("ActiveTransparency", Config.Terrain.GridActiveTransparency)

	-- Fond : une seule dalle, à peine plus foncée que le plateau.
	local backdropSize = extent + Config.Terrain.BackdropMargin * 2
	part({
		Name = "Background",
		Parent = root,
		Size = Vector3.new(backdropSize, BACKDROP_THICKNESS, backdropSize),
		CFrame = CFrame.new(center.X, BACKDROP_Y, center.Z),
		Color = Config.Colors.Background,
	})

	-- Ombre de bord très douce : deux couches transparentes, légèrement décalées
	-- en profondeur pour ne jamais être coplanaires.
	for index, layer in ipairs(Config.Terrain.BoardShadow) do
		local shadowSize = extent + layer.grow * 2
		part({
			Name = "BoardShadow",
			Parent = root,
			Size = Vector3.new(shadowSize, SHADOW_THICKNESS, shadowSize),
			CFrame = CFrame.new(center.X, SHADOW_Y - (index - 1) * SHADOW_STEP, center.Z),
			Color = Config.Colors.CardShadow,
			Transparency = layer.transparency,
		})
	end

	-- Plateau clair et uniforme : le seul élément qui reçoit les clics.
	part({
		Name = "Ground",
		Parent = root,
		Size = Vector3.new(extent, BOARD_THICKNESS, extent),
		CFrame = CFrame.new(center.X, -BOARD_THICKNESS * 0.5, center.Z),
		Color = map.land,
		CanQuery = true,
	})

	-- Parcs, puis arbres dans les parcs, puis grille : tout sous l'eau.
	local grassShapes = map.grassShapes or {}
	local waterShapes = map.waterShapes or {}
	local dryShapes = map.dryShapes or {}

	for _, shape in ipairs(grassShapes) do
		addShape(grass, "Grass", shape, board, map.grass, GRASS_TOP, 0)
	end
	local treeCells = addTrees(grass, map, board)
	addGrid(grid, board)

	-- Eau : liseré clair fin, puis remplissage. Les presqu'îles recouvrent
	-- l'eau avec leur propre liseré, puis leur terre ; les parcs secs les
	-- plus petits sont posés en dernier.
	local shoreline = Config.Terrain.Shoreline
	local coast = Config.Colors.Coast
	for _, shape in ipairs(waterShapes) do
		addShape(water, "Shore", shape, board, coast, SHORE_TOP, shoreline)
	end
	for _, shape in ipairs(waterShapes) do
		addShape(water, "Water", shape, board, map.water, WATER_TOP, 0)
	end
	for _, shape in ipairs(dryShapes) do
		addShape(water, "Shore", shape, board, coast, DRY_SHORE_TOP, shoreline)
	end
	for _, shape in ipairs(dryShapes) do
		addShape(water, "Land", shape, board, map.land, DRY_TOP, 0)
	end

	root.Parent = worlds

	return {
		folder = root,
		Buildings = buildings,
		Roads = roads,
		Cars = cars,
		FX = fx,
		Water = water,
		Grass = grass,
		Grid = grid,
		-- Cases occupées par un arbre : les bâtiments doivent les éviter.
		treeCells = treeCells,
	}
end

return WorldBuilder
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="30">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="31">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="32">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="33">
        <Properties>
          <string name="Name">MiniMotorwaysClient</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">CameraController</string>
            <ProtectedString name="Source"><![CDATA[--[[
	CameraController.luau
	Vue aérienne de la ville : cadrage automatique sur la carte, zoom progressif
	à la molette et déplacement borné pour que la carte reste à l'écran.
	L'orientation ne change jamais : seuls la distance (zoom) et la position au
	sol varient. Les réglages sont dans Config.Camera. setSafeInsets réserve les
	marges de l'interface : la carte se cadre dans la zone libre.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local CAMERA = Config.Camera
local ZOOM_EPSILON = 1e-4
local LOBBY_POSE = CFrame.new(0, CAMERA.LobbyHeight, 0) * CFrame.Angles(-math.pi / 2, 0, 0)

local CameraController = {}

-- Carte en cours ; nil tant qu'aucune partie n'est lancée.
local currentOrigin = nil
local currentSize = nil
local currentTile = nil
local active = false

-- zoom : valeur affichée, qui glisse vers zoomGoal (demandée par la molette).
local zoom = 1
local zoomGoal = 1
local panX = 0
local panZ = 0

-- Arrivée sur la carte : la pose part d'un cran plus éloigné puis descend.
local intro = nil
local frameConnection = nil
local viewportConnection = nil

local function clamp(value, minValue, maxValue)
	if value < minValue then
		return minValue
	elseif value > maxValue then
		return maxValue
	end
	return value
end

-- Marges de l'interface en pixels écran (haut, droite, bas, gauche), réglées
-- par setSafeInsets. Une marge absente vaut zéro.
local insets = { top = 0, right = 0, bottom = 0, left = 0 }
-- Part minimale de la vue gardée pour la carte, même si les marges prennent
-- presque tout l'écran.
local MIN_USABLE_FRACTION = 0.25

-- Distance de la caméra, taille d'un pixel au sol (au plan de la carte) et zone
-- utile en pixels pour un zoom donné. La carte tient en entier dans la zone
-- utile, en largeur comme en hauteur, avec la marge Config.Camera.Fit.
local function viewAt(zoomValue)
	local camera = Workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(16, 9)
	local vw = math.max(viewport.X, 1)
	local vh = math.max(viewport.Y, 1)
	local usableW = math.max(vw - insets.left - insets.right, vw * MIN_USABLE_FRACTION)
	local usableH = math.max(vh - insets.top - insets.bottom, vh * MIN_USABLE_FRACTION)
	local halfFov = math.tan(math.rad(CAMERA.FOV) * 0.5)
	local needed = currentSize * currentTile * CAMERA.Fit / zoomValue
	-- Demi-hauteur au sol : la carte tient en hauteur dans usableH et en largeur
	-- dans usableW, la vue faisant vw x vh pixels.
	local halfGround = math.max(needed * vh / (2 * usableH), needed * vh / (2 * usableW))
	return halfGround / halfFov, 2 * halfGround / vh, usableW, usableH
end

-- Déplacement maximal sur un axe. Tant que la carte tient dans la vue sur cet
-- axe, elle reste centrée ; sinon le centre peut dépasser le bord de la carte
-- de PanOverscroll fois l'écart, ce qui garde une part nette de carte visible.
local function panLimit(mapHalf, viewHalf)
	if viewHalf >= mapHalf then
		return 0
	end
	return (mapHalf - viewHalf) * (1 + CAMERA.PanOverscroll)
end

-- Décalage du centre de vue borné pour un zoom donné. Le décalage stocké n'est
-- pas modifié : pendant un zoom, la vue reste dans les bornes du zoom courant
-- sans effacer le déplacement voulu par le joueur. Le pan est mesuré depuis le
-- centre de la zone utile, qui coïncide avec le centre de la carte.
local function clampedPan(zoomValue)
	local mapHalf = currentSize * currentTile * 0.5
	local _, perPixel, usableW, usableH = viewAt(zoomValue)
	local limitX = panLimit(mapHalf, perPixel * usableW * 0.5)
	local limitZ = panLimit(mapHalf, perPixel * usableH * 0.5)
	return clamp(panX, -limitX, limitX), clamp(panZ, -limitZ, limitZ)
end

-- Pose de la caméra au-dessus du centre de la carte (décalé par le pan). La
-- carte se projette au centre de la zone utile : si les marges sont inégales,
-- la visée est décalée de la moitié de l'écart. Le décalage arrière est
-- proportionnel à la distance : orientation fixe.
local function poseFor(zoomValue, offsetX, offsetZ)
	local distance, perPixel = viewAt(zoomValue)
	local shiftX = -(insets.left - insets.right) * 0.5 * perPixel
	local shiftZ = -(insets.top - insets.bottom) * 0.5 * perPixel
	local mapHalf = currentSize * currentTile * 0.5
	local center = currentOrigin + Vector3.new(mapHalf + offsetX + shiftX, 0, mapHalf + offsetZ + shiftZ)
	local eye = center + Vector3.new(0, distance, distance * CAMERA.BackRatio)
	return CFrame.lookAt(eye, center)
end

local function takeControl(camera)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = CAMERA.FOV
end

-- Écrit la pose courante dans la caméra. Appelé sur chaque changement d'état et,
-- pendant une animation seulement, à chaque frame.
local function render()
	local camera = Workspace.CurrentCamera
	if not active or not camera then
		return
	end
	local offsetX, offsetZ = clampedPan(zoom)
	local pose = poseFor(zoom, offsetX, offsetZ)
	if intro then
		local t = clamp(intro.elapsed / CAMERA.IntroSeconds, 0, 1)
		pose = intro.from:Lerp(pose, t * t * (3 - 2 * t))
	end
	camera.CFrame = pose
end

local function needsFrames()
	return zoom ~= zoomGoal or intro ~= nil
end

local function stopFrames()
	if frameConnection then
		frameConnection:Disconnect()
		frameConnection = nil
	end
end

local function onFrame(dt)
	if zoom ~= zoomGoal then
		-- Lissage exponentiel en espace logarithmique : chaque cran de molette a
		-- la même sensation, et la valeur ne dépasse jamais la cible.
		local delta = math.log(zoomGoal / zoom)
		if math.abs(delta) < ZOOM_EPSILON then
			zoom = zoomGoal
		else
			local alpha = 1 - math.exp(-CAMERA.ZoomSmoothing * dt)
			zoom *= math.exp(delta * alpha)
		end
	end
	if intro then
		intro.elapsed += dt
		if intro.elapsed >= CAMERA.IntroSeconds then
			intro = nil
		end
	end
	render()
	if not needsFrames() then
		stopFrames()
	end
end

-- Les frames ne tournent que pendant une animation : rien à faire au repos.
local function updateFrames()
	if not needsFrames() then
		stopFrames()
	elseif not frameConnection then
		frameConnection = RunService.RenderStepped:Connect(onFrame)
	end
end

local function onViewportChanged()
	if active then
		CameraController.refresh(true)
	end
end

-- Suit le viewport de la caméra courante, y compris si Roblox la remplace.
local function bindCamera()
	if viewportConnection then
		viewportConnection:Disconnect()
		viewportConnection = nil
	end
	local camera = Workspace.CurrentCamera
	if camera then
		viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(onViewportChanged)
		if active then
			takeControl(camera)
			render()
		end
	end
end

bindCamera()
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)

-- Valeur numérique finie : un NaN ou un infini donnerait une CFrame invalide,
-- et clamp ne le rattrape pas (toute comparaison avec NaN est fausse).
local function isFinite(value)
	return type(value) == "number" and value == value and math.abs(value) ~= math.huge
end

function CameraController.focus(origin, size, tile, instant)
	-- Une carte invalide laisserait la caméra active sans dimensions : chaque
	-- rendu suivant multiplierait nil.
	if typeof(origin) ~= "Vector3" or not isFinite(size) or not isFinite(tile) or size <= 0 or tile <= 0 then
		return
	end
	currentOrigin = origin
	currentSize = size
	currentTile = tile
	active = true
	zoom = 1
	zoomGoal = 1
	panX = 0
	panZ = 0
	intro = nil

	local camera = Workspace.CurrentCamera
	if camera then
		takeControl(camera)
	end
	if not instant then
		intro = { from = poseFor(1 / CAMERA.IntroZoomOut, 0, 0), elapsed = 0 }
	end
	render()
	updateFrames()
end

function CameraController.refresh(instant)
	if not active then
		return
	end
	if instant then
		zoom = zoomGoal
	end
	render()
	updateFrames()
end

function CameraController.lobby()
	currentOrigin = nil
	currentSize = nil
	currentTile = nil
	active = false
	zoom = 1
	zoomGoal = 1
	panX = 0
	panZ = 0
	intro = nil
	stopFrames()

	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = CAMERA.LobbyFOV
	camera.CFrame = LOBBY_POSE
end

local function setZoomGoal(value)
	if not isFinite(value) then
		return
	end
	zoomGoal = clamp(value, CAMERA.ZoomMin, CAMERA.ZoomMax)
	updateFrames()
end

-- Les méthodes de zoom ne bougent pas la caméra tout de suite : le zoom glisse
-- vers la cible à chaque frame.
function CameraController.zoomBy(delta)
	if not active then
		return
	end
	setZoomGoal(zoomGoal + delta)
end

function CameraController.setZoom(value)
	if not active then
		return
	end
	setZoomGoal(value)
end

function CameraController.pan(deltaX, deltaZ)
	if not active or not isFinite(deltaX) or not isFinite(deltaZ) then
		return
	end
	-- Borné avec la cible du zoom : le décalage reste valide une fois le zoom
	-- arrivé à destination.
	panX += deltaX
	panZ += deltaZ
	panX, panZ = clampedPan(zoomGoal)
	render()
end

-- Déplace la vue de pixelsX, pixelsY pixels écran : la carte suit le curseur
-- ou le doigt, quels que soient le zoom et la résolution.
function CameraController.panByPixels(pixelsX, pixelsY)
	if not active then
		return
	end
	if not Workspace.CurrentCamera then
		return
	end
	-- Un pixel vaut la même distance au sol sur les deux axes.
	local _, perPixel = viewAt(zoom)
	-- Sur l'écran, X va vers la droite (+X monde) et Y vers le bas (+Z monde).
	-- Tirer la carte vers la droite déplace donc la caméra vers la gauche.
	CameraController.pan(-pixelsX * perPixel, -pixelsY * perPixel)
end

-- Marges de l'interface (pixels écran) : la carte se cadre dans la zone libre,
-- jamais sous la barre supérieure, les compteurs ou la barre d'outils.
local function marginOf(value)
	if not isFinite(value) or value < 0 then
		return 0
	end
	return value
end

function CameraController.setSafeInsets(top, right, bottom, left)
	insets.top = marginOf(top)
	insets.right = marginOf(right)
	insets.bottom = marginOf(bottom)
	insets.left = marginOf(left)
	if active then
		panX, panZ = clampedPan(zoomGoal)
		CameraController.refresh(true)
	end
end

-- Valeur demandée : la molette agit sur elle, l'affichage la rejoint ensuite.
function CameraController.getZoom()
	return zoomGoal
end

function CameraController.getMapSize()
	if not currentSize or not currentTile then
		return 0
	end
	return currentSize * currentTile
end

return CameraController
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">InputController</string>
            <ProtectedString name="Source"><![CDATA[--[[
	InputController.luau
	Dessin, effacement et rond-point à la souris ou au doigt.

	Outils (ids partagés avec le HUD, ne pas les renommer) :
	  "build" (touche 1), "erase" (touche 2), "roundabout" (touche 3),
	  "camera" (touche 4 : glisser pour déplacer la vue).
	Clic droit : efface le tracé, quel que soit l'outil. Clic milieu : caméra
	(géré par Main). Deux doigts : caméra, un second doigt ne construit jamais.

	Le tracé est une suite de cases orthogonales sans répétition : un
	mouvement rapide est comblé case par case, et revenir sur une case du
	tracé retire les cases posées après elle. Une case refusée coupe le
	tracé : jamais envoyée, elle sépare deux requêtes. Le client n'envoie
	rien avant le relâchement ; Échap ou un changement d'outil annule sans
	rien consommer. La validation finale et les ressources restent au serveur.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Maps = require(Shared.Maps)
local RoadConfig = require(Shared.RoadConfig)
local RoadNetwork = require(Shared.RoadNetwork)

local RoadPreview = require(script.Parent.RoadPreview)

local InputController = {}
InputController.__index = InputController

local GHOST_SCALE = 1.10
local GHOST_TRANSPARENCY = 0.45
local GHOST_HEIGHT = 0.52
-- Les marqueurs d'aperçu et les routes sont posés à cette hauteur : la visée
-- coupe donc le terrain à ce niveau, et non au sol.
local PICK_HEIGHT = RoadConfig.Visual.PreviewY

-- Ids d'outils par touche, comme le HUD les nomme.
local TOOL_BY_KEY = {
	One = "build",
	Two = "erase",
	Three = "roundabout",
	Four = "camera",
}

-- Position écran d'une entrée, toujours lue sur l'InputObject. Elle est dans
-- le repère que Camera:ScreenPointToRay attend (barre supérieure Roblox
-- déduite) : souris et doigt se visent donc de la même façon.
-- Piège : UserInputService:GetMouseLocation() est en coordonnées de vue,
-- barre incluse. L'associer à ScreenPointToRay décalerait chaque visée de la
-- hauteur de la barre (36 à 58 px), donc ne jamais l'utiliser ici.
local function pointerFrom(input)
	return Vector2.new(input.Position.X, input.Position.Y)
end

local function countEntries(map)
	local count = 0
	for _ in pairs(map) do
		count += 1
	end
	return count
end

-- Centre et écart moyen des doigts posés (au moins deux). Le centre sert au
-- panoramique, l'écart moyen au zoom par pincement.
local function gestureMetrics(touches)
	local sumX, sumY, count = 0, 0, 0
	for _, position in pairs(touches) do
		sumX += position.X
		sumY += position.Y
		count += 1
	end
	local cx, cy = sumX / count, sumY / count
	local spread = 0
	for _, position in pairs(touches) do
		local dx, dy = position.X - cx, position.Y - cy
		spread += math.sqrt(dx * dx + dy * dy)
	end
	return cx, cy, spread / count
end

-- Grille de la ville du joueur : Workspace.MMWorlds.City_N.Grid, où N suit
-- l'origine (index * OriginSpacing sur X, voir Session). Nil tant qu'elle
-- n'existe pas.
-- Couplage isolé ici : GameStarted ne porte pas le nom du monde, donc on le
-- reconstruit depuis l'origine. À retirer si le payload porte City_N.
local function findGrid(origin)
	local worlds = Workspace:FindFirstChild("MMWorlds")
	if not worlds or Config.World.OriginSpacing <= 0 then
		return nil
	end
	local index = math.floor(origin.X / Config.World.OriginSpacing + 0.5)
	local city = worlds:FindFirstChild("City_" .. index)
	if not city then
		return nil
	end
	return city:FindFirstChild("Grid")
end

local function makeGhostPart(size)
	local part = Instance.new("Part")
	part.Name = "MM_Ghost"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = Config.Colors.Teal
	part.Transparency = 1
	part.Size = size
	part.Parent = Workspace
	return part
end

function InputController.new(callbacks)
	local self = setmetatable({}, InputController)
	self.callbacks = callbacks or {}
	self.enabled = false
	self.destroyed = false
	self.tool = "build"
	self.origin = Vector3.zero
	self.size = Config.Grid.Size
	self.tile = Config.Grid.TileSize
	self.map = nil

	-- Réseau tel que le serveur le décrit (RoadState). Lecture seule.
	self.roads = {}
	self.buildingSet = {}
	self.budget = Config.Roads.StartBudget
	self.bridgesLeft = Config.Roads.StartBridges

	self.connections = {}
	self.pointer = nil
	self.hoverClock = 0
	self.ghostKey = nil
	self.gridActive = nil
	self.gridFolder = nil
	-- Grille toujours visible (réglage « grid » du HUD), même hors construction.
	self.gridPinned = false
	self.touches = {}
	self.gesture = nil
	-- Clic milieu tenu (déplacement de vue, dans Main) : aucun tracé ne démarre.
	self.middleDown = false

	self.ghost = nil
	self.preview = RoadPreview.new()
	self:createGhost()
	self:resetStroke()
	self:bind()
	return self
end

function InputController:createGhost()
	-- Le fantôme ne sert qu'au rond-point : les routes ont leur aperçu.
	local size = Vector3.new(self.tile * GHOST_SCALE, 0.04, self.tile * GHOST_SCALE)
	self.ghost = makeGhostPart(size)
end

function InputController:track(connection)
	table.insert(self.connections, connection)
end

function InputController:bind()
	self:track(UserInputService.InputBegan:Connect(function(input, processed)
		self:onInputBegan(input, processed)
	end))
	self:track(UserInputService.InputChanged:Connect(function(input, processed)
		self:onInputChanged(input, processed)
	end))
	self:track(UserInputService.InputEnded:Connect(function(input)
		self:onInputEnded(input)
	end))
	-- Fenêtre perdue : le relâchement peut ne jamais arriver, on annule.
	self:track(UserInputService.WindowFocusReleased:Connect(function()
		self:onFocusLost()
	end))
	self:track(RunService.RenderStepped:Connect(function(dt)
		self:onFrame(dt)
	end))
end

function InputController:onInputBegan(input, processed)
	local kind = input.UserInputType
	if kind == Enum.UserInputType.Touch then
		-- Un doigt posé sur l'interface n'est pas suivi.
		if not processed then
			self:touchBegan(input)
		end
		return
	end

	if kind == Enum.UserInputType.MouseButton3 then
		-- Clic milieu : Main déplace la vue. Tant qu'il est tenu, aucun tracé ni
		-- effacement ne démarre, et un geste en cours est annulé sans rien envoyer.
		self.middleDown = true
		self:cancelDrag()
		return
	end
	if input.KeyCode == Enum.KeyCode.Escape then
		self:cancelDrag()
		return
	end
	if processed or not self.enabled then
		return
	end

	if kind == Enum.UserInputType.MouseButton1 then
		-- Un second bouton pendant un geste ne le remplace jamais : un
		-- déplacement de caméra ou un effacement ne devient pas un tracé.
		if self.dragging or self.middleDown then
			return
		end
		self.pointer = pointerFrom(input)
		self:pressTool(kind, nil, self.pointer)
	elseif kind == Enum.UserInputType.MouseButton2 then
		-- Clic droit : efface, quel que soit l'outil (le clic milieu déplace, dans Main).
		if self.dragging or self.middleDown then
			return
		end
		self.pointer = pointerFrom(input)
		self:beginDrag("erase", kind, nil, self.pointer)
	elseif kind == Enum.UserInputType.Keyboard then
		self:onKey(input.KeyCode)
	end
end

function InputController:onInputChanged(input, processed)
	local kind = input.UserInputType
	if kind == Enum.UserInputType.MouseMovement then
		local previous = self.pointer
		local nextPointer = pointerFrom(input)
		self.pointer = nextPointer
		if not (self.enabled and self.dragging) then
			-- Survol immédiat ; les cases inchangées ne sont pas réécrites.
			self:refreshPreview()
			return
		end
		-- Bouton relâché hors de la fenêtre : on valide le tracé fait jusque-là.
		if self.dragButton and not UserInputService:IsMouseButtonPressed(self.dragButton) then
			self:endDrag()
			return
		end
		if previous then
			self:moveDrag(previous, nextPointer, processed)
		end
	elseif kind == Enum.UserInputType.Touch then
		local previous = self.touches[input]
		if previous == nil or not self.enabled then
			return
		end
		local nextPointer = pointerFrom(input)
		self.touches[input] = nextPointer
		if self.gesture then
			self:updateGesture()
		elseif self.dragging and self.dragTouch == input then
			self:moveDrag(previous, nextPointer, processed)
		end
	end
end

function InputController:onInputEnded(input)
	local kind = input.UserInputType
	if kind == Enum.UserInputType.Touch then
		self:touchEnded(input)
	elseif kind == Enum.UserInputType.MouseButton3 then
		self.middleDown = false
	elseif self.dragging and self.dragButton and kind == self.dragButton then
		self:endDrag()
	end
end

function InputController:onKey(keyCode)
	local tool = TOOL_BY_KEY[keyCode.Name]
	if tool then
		self:setTool(tool)
		if self.callbacks.onToolChanged then
			self.callbacks.onToolChanged(tool)
		end
	end
end

function InputController:onFocusLost()
	self:cancelDrag()
	-- Le relâchement d'un bouton hors de la fenêtre n'arrive jamais : on oublie.
	self.middleDown = false
	self.touches = {}
	self.gesture = nil
	self.pointer = nil
	self:refreshPreview()
end

-- Image par image : seulement l'outil rond-point (le fantôme suit le
-- curseur) et, à cadence réduite, l'aperçu survolé (la caméra peut bouger
-- sous un curseur immobile).
function InputController:onFrame(dt)
	if self.destroyed then
		return
	end
	if self.tool == "roundabout" then
		self:updateGhost()
		return
	end
	self.hoverClock += dt
	if self.hoverClock < RoadConfig.Input.HoverRefresh then
		return
	end
	self.hoverClock = 0
	-- La grille peut être répliquée après le début de la partie : on la
	-- recherche à cette cadence, sans rien faire quand elle est déjà réglée.
	self:updateGridVisibility()
	if not self.dragging then
		self:refreshPreview()
	end
end

-- Une pression de l'outil actif (bouton gauche ou premier doigt).
function InputController:pressTool(mouseButton, touch, position)
	if self.tool == "camera" then
		self:beginDrag("camera", mouseButton, touch, nil)
	elseif self.tool == "roundabout" then
		local cell = self:cellAt(position)
		if cell and self.callbacks.onRoundabout then
			self.callbacks.onRoundabout(cell[1], cell[2])
		end
	elseif self.tool == "erase" then
		self:beginDrag("erase", mouseButton, touch, position)
	else
		self:beginDrag("build", mouseButton, touch, position)
	end
end

-- Démarre un geste : routes ou effacement (case de départ requise), ou caméra.
function InputController:beginDrag(tool, mouseButton, touch, position)
	self:resetStroke()
	local cell = nil
	if tool ~= "camera" then
		cell = self:cellAt(position)
		if not cell then
			return
		end
	end

	self.dragging = true
	self.dragTool = tool
	self.dragButton = mouseButton
	self.dragTouch = touch
	if cell then
		self.lastCell = { cell[1], cell[2] }
		if tool == "erase" then
			self:addErase(cell[1], cell[2])
		else
			self:addBuild(cell[1], cell[2])
		end
	end
	self:refreshPreview()
	self:updateGridVisibility()
end

-- Déplacement du geste courant entre deux positions écran.
function InputController:moveDrag(previous, nextPointer, processed)
	if self.dragTool == "camera" then
		if self.callbacks.onPan then
			self.callbacks.onPan(nextPointer.X - previous.X, nextPointer.Y - previous.Y)
		end
		return
	end
	-- Le tracé ne passe pas sous une fenêtre d'interface : il s'arrête là.
	if processed then
		self:endDrag()
		return
	end
	self:accumulateAxis(nextPointer.X - previous.X, nextPointer.Y - previous.Y)
	local cell = self:cellAt(nextPointer)
	if cell then
		self:extendTo(cell[1], cell[2])
	end
end

-- Axe dominant du geste, avec hystérésis : l'axe ne change que si l'autre
-- composante dépasse la première d'une marge (DragAxisThreshold). Un
-- mouvement hésitant en diagonale ne fait donc pas zigzaguer le tracé.
function InputController:accumulateAxis(dx, dy)
	self.axisX += dx
	self.axisY += dy
	local ax, ay = math.abs(self.axisX), math.abs(self.axisY)
	if math.max(ax, ay) < RoadConfig.Input.AxisMinPixels then
		return
	end
	local band = 1 + RoadConfig.Input.DragAxisThreshold
	if ax > ay * band then
		self.dragAxis = "x"
	elseif ay > ax * band then
		self.dragAxis = "y"
	end
end

-- Comble le chemin orthogonal entre la dernière case et la case pointée.
function InputController:extendTo(x, y)
	local last = self.lastCell
	if x == last[1] and y == last[2] then
		return
	end
	-- Trajet en L selon l'axe du geste. Le module partagé renvoie une liste vide
	-- pour un trajet hors borne (impossible avec la grille actuelle) : le tracé
	-- repart alors de la case visée, sans repli case par case qui pouvait boucler
	-- sans fin sur une coordonnée invalide.
	local path = RoadNetwork.manhattanPath(last[1], last[2], x, y, self.dragAxis)
	for _, step in ipairs(path) do
		if self.dragTool == "erase" then
			self:addErase(step[1], step[2])
		else
			self:addBuild(step[1], step[2])
		end
	end
	self.lastCell = { x, y }
	-- Le prochain axe se décide sur le mouvement depuis cette nouvelle case.
	self.axisX = 0
	self.axisY = 0
	self:refreshPreview()
end

function InputController:addBuild(x, y)
	local key = Grid.key(x, y)
	local index = self.walkIndex[key]
	if index then
		-- Revenir sur une case du tracé retire les cases posées après elle.
		for position = #self.walk, index + 1, -1 do
			local cell = self.walk[position]
			self.walkIndex[Grid.key(cell[1], cell[2])] = nil
			self.walk[position] = nil
		end
		return
	end
	self.walk[#self.walk + 1] = { x, y }
	self.walkIndex[key] = #self.walk
end

function InputController:addErase(x, y)
	local key = Grid.key(x, y)
	-- Seules les routes existantes sont effaçables : le reste n'est pas envoyé.
	if self.eraseSet[key] or not self.roads[key] then
		return
	end
	self.eraseSet[key] = true
	table.insert(self.eraseList, key)
end

function InputController:isWater(x, y)
	return self.map ~= nil and Maps.isWater(self.map, x, y)
end

-- Miroir local de Session:canDraw, dans le même ordre de refus : hors carte
-- et bâtiment, puis eau sans pont, puis budget. Une route déjà posée est
-- « existante » : elle reste valide, ne coûte rien et n'est pas redessinée.
-- Les cases refusées ont valid = false.
function InputController:planCells(list, hover)
	local cells = {}
	local budget = self.budget
	local bridges = self.bridgesLeft
	for _, cell in ipairs(list) do
		local x, y = cell[1], cell[2]
		local key = Grid.key(x, y)
		local existing = self.roads[key] == true
		local valid = true
		if not existing then
			valid = Grid.inBounds(x, y) and not self.buildingSet[key]
			if valid then
				local water = self:isWater(x, y)
				if water and bridges <= 0 then
					valid = false
				elseif budget <= 0 then
					valid = false
				else
					budget -= 1
					if water then
						bridges -= 1
					end
				end
			end
		end
		cells[#cells + 1] = { x = x, y = y, valid = valid, existing = existing, hover = hover }
	end
	return cells
end

-- Aperçu des routes à poser : les routes déjà là ne sont pas redessinées.
function InputController:setBuildPreview(list, hover)
	local visible = {}
	for _, cell in ipairs(self:planCells(list, hover)) do
		if not cell.existing then
			visible[#visible + 1] = cell
		end
	end
	self.preview:setCells(visible)
end

-- Effacement : les routes du tracé, en corail (elles vont disparaître).
function InputController:erasePreview()
	local cells = {}
	for _, key in ipairs(self.eraseList) do
		local x, y = Grid.parse(key)
		if x then
			cells[#cells + 1] = { x = x, y = y, valid = false }
		end
	end
	return cells
end

-- Recalcule l'aperçu : le tracé en cours, sinon la case survolée.
function InputController:refreshPreview()
	if self.destroyed then
		return
	end
	if not self.enabled then
		self.preview:clear()
		return
	end

	if self.dragging and self.dragTool == "build" then
		self:setBuildPreview(self.walk, false)
		return
	end
	if self.dragging and self.dragTool == "erase" then
		self.preview:setCells(self:erasePreview())
		return
	end
	if self.dragging or (self.tool ~= "build" and self.tool ~= "erase") then
		self.preview:clear()
		return
	end

	local cell = self.pointer and self:cellAt(self.pointer) or nil
	if not cell then
		self.preview:clear()
		return
	end
	if self.tool == "erase" then
		if self.roads[Grid.key(cell[1], cell[2])] then
			self.preview:setCells({ { x = cell[1], y = cell[2], valid = false, hover = true } })
		else
			self.preview:clear()
		end
	else
		self:setBuildPreview({ cell }, true)
	end
end

-- Envoie le tracé. Une case refusée coupe le tracé : chaque suite de cases
-- posables part dans sa propre requête, pour que le ruban serveur ne relie
-- jamais deux morceaux par-dessus une case refusée (spec 3.4).
function InputController:commitBuild(walk)
	if not self.callbacks.onDraw then
		return
	end
	local run = {}
	local runHasNew = false
	for _, cell in ipairs(self:planCells(walk, false)) do
		if cell.valid then
			run[#run + 1] = { cell.x, cell.y }
			runHasNew = runHasNew or not cell.existing
		else
			self:sendRun(run, runHasNew)
			run = {}
			runHasNew = false
		end
	end
	self:sendRun(run, runHasNew)
end

-- Envoie une suite continue par lots. Un lot n'a jamais plus de
-- MaxCellsPerRequest cases ; deux lots se chevauchent d'une case pour que le
-- ruban serveur reste continu. Une suite sans case neuve n'est pas envoyée.
function InputController:sendRun(run, hasNew)
	if not hasNew or #run == 0 then
		return
	end
	local maxCells = math.max(2, RoadConfig.Input.MaxCellsPerRequest)
	local count = #run
	local first = 1
	while true do
		local last = math.min(first + maxCells - 1, count)
		local chunk = {}
		for index = first, last do
			chunk[#chunk + 1] = run[index]
		end
		self.callbacks.onDraw(chunk)
		if last >= count then
			break
		end
		first = last
	end
end

function InputController:commitErase(keys)
	if #keys == 0 then
		return
	end
	if self.callbacks.onEraseMany then
		local maxCells = math.max(1, RoadConfig.Input.MaxCellsPerRequest)
		for first = 1, #keys, maxCells do
			local last = math.min(first + maxCells - 1, #keys)
			local chunk = {}
			for index = first, last do
				chunk[#chunk + 1] = keys[index]
			end
			self.callbacks.onEraseMany(chunk)
		end
	elseif self.callbacks.onErase then
		for _, key in ipairs(keys) do
			self.callbacks.onErase(key)
		end
	end
end

function InputController:resetStroke()
	self.dragging = false
	self.dragTool = nil
	self.dragButton = nil
	self.dragTouch = nil
	self.lastCell = nil
	self.dragAxis = nil
	self.axisX = 0
	self.axisY = 0
	self.walk = {}
	self.walkIndex = {}
	self.eraseList = {}
	self.eraseSet = {}
end

-- Fin normale : le tracé part au serveur, puis le geste est oublié.
function InputController:endDrag()
	if not self.dragging then
		return
	end
	local tool = self.dragTool
	local walk = self.walk
	local keys = self.eraseList
	self:resetStroke()
	if tool == "build" then
		self:commitBuild(walk)
	elseif tool == "erase" then
		self:commitErase(keys)
	end
	self:refreshPreview()
	self:updateGridVisibility()
end

-- Annulation (Échap, changement d'outil, fenêtre perdue) : rien n'est envoyé.
function InputController:cancelDrag()
	if not self.dragging then
		return
	end
	self:resetStroke()
	self:refreshPreview()
	self:updateGridVisibility()
end

function InputController:touchBegan(input)
	if not self.enabled then
		return
	end
	-- Un doigt dont la fin n'est jamais arrivée (interruption système) ne doit
	-- pas bloquer le tracé pour le reste de la partie : on l'oublie ici.
	self:forgetEndedTouches()
	-- Un doigt de plus pendant qu'un autre est suivi : geste de caméra, jamais
	-- un tracé. Le tracé du premier doigt est annulé, sans rien envoyer.
	if countEntries(self.touches) > 0 then
		self.touches[input] = pointerFrom(input)
		self:cancelDrag()
		self:startGesture()
		return
	end
	self.touches[input] = pointerFrom(input)
	self.pointer = self.touches[input]
	self:pressTool(nil, input, self.pointer)
end

-- Retire les doigts que Roblox donne déjà pour terminés ou annulés.
function InputController:forgetEndedTouches()
	for input in pairs(self.touches) do
		local state = input.UserInputState
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			self.touches[input] = nil
			if self.dragTouch == input then
				self:cancelDrag()
			end
		end
	end
	if countEntries(self.touches) < 2 then
		self.gesture = nil
	end
end

function InputController:touchEnded(input)
	if self.touches[input] == nil then
		return
	end
	self.touches[input] = nil
	if countEntries(self.touches) == 0 then
		self.gesture = nil
		self.pointer = nil
	else
		self:startGesture()
	end
	if self.dragging and self.dragTouch == input then
		self:endDrag()
	end
end

-- Geste à deux doigts : le centre déplace la vue, l'écart la zoome. Une
-- base est reprise à chaque changement de nombre de doigts, pour qu'un doigt
-- qui se lève ne fasse pas sauter la caméra.
function InputController:startGesture()
	if countEntries(self.touches) < 2 then
		self.gesture = nil
		return
	end
	local cx, cy, spread = gestureMetrics(self.touches)
	self.gesture = { x = cx, y = cy, spread = spread }
end

function InputController:updateGesture()
	local previous = self.gesture
	local cx, cy, spread = gestureMetrics(self.touches)
	self.gesture = { x = cx, y = cy, spread = spread }
	if self.callbacks.onPan then
		self.callbacks.onPan(cx - previous.x, cy - previous.y)
	end
	if self.callbacks.onZoom and previous.spread > 0 and spread > 0 then
		local delta = (spread / previous.spread - 1) * RoadConfig.Input.PinchZoomGain
		if delta ~= 0 then
			self.callbacks.onZoom(delta)
		end
	end
end

-- Position de l'outil de rond-point : suit le curseur, ne change que si la
-- case change.
function InputController:updateGhost()
	if not self.enabled or self.tool ~= "roundabout" or not self.pointer then
		self.ghost.Transparency = 1
		self.ghostKey = nil
		return
	end
	local cell = self:cellAt(self.pointer)
	if not cell then
		self.ghost.Transparency = 1
		self.ghostKey = nil
		return
	end
	local key = Grid.key(cell[1], cell[2])
	if key ~= self.ghostKey then
		self.ghostKey = key
		self.ghost.CFrame = CFrame.new(self:cellCenter(cell[1], cell[2], GHOST_HEIGHT))
	end
	self.ghost.Transparency = GHOST_TRANSPARENCY
end

function InputController:cellCenter(x, y, height)
	return Vector3.new(
		self.origin.X + (x + 0.5) * self.tile,
		self.origin.Y + height,
		self.origin.Z + (y + 0.5) * self.tile
	)
end

-- Grille : plus visible pendant la construction (outil routes ou tracé en
-- cours), discrète sinon. Réglée une seule fois à chaque changement d'état.
function InputController:updateGridVisibility()
	local building = self.gridPinned or (self.enabled and (self.tool == "build" or (self.dragging and self.dragTool ~= "camera")))
	local grid = findGrid(self.origin)
	if building == self.gridActive and grid == self.gridFolder then
		return
	end
	self.gridActive = building
	self.gridFolder = grid
	if not grid then
		return
	end
	local value = grid:GetAttribute(building and "ActiveTransparency" or "BaseTransparency")
	if type(value) ~= "number" then
		return
	end
	for _, child in ipairs(grid:GetChildren()) do
		if child:IsA("BasePart") then
			child.Transparency = value
		end
	end
end

-- Réglage « grid » du HUD : grille toujours visible, ou règle automatique
-- (visible seulement pendant la construction).
function InputController:setGridPinned(value)
	if self.destroyed then
		return
	end
	self.gridPinned = value == true
	self:updateGridVisibility()
end

function InputController:setWorld(origin, size, tile)
	if self.destroyed then
		return
	end
	self:cancelDrag()
	self.origin = origin or Vector3.zero
	self.size = size or Config.Grid.Size
	self.tile = tile or Config.Grid.TileSize
	-- Nouvelle partie : le réseau attend le RoadState de ce monde.
	self.roads = {}
	self.buildingSet = {}
	-- Une case identique dans un autre monde ne doit pas garder l'ancienne place du fantôme.
	self.ghostKey = nil
	self.ghost.Size = Vector3.new(self.tile * GHOST_SCALE, 0.04, self.tile * GHOST_SCALE)
	self.preview:setWorld(self.origin, self.tile)
	self:updateGridVisibility()
	self:refreshPreview()
end

function InputController:setMapId(mapId)
	if self.destroyed then
		return
	end
	self.map = Maps.getById(mapId)
	self:refreshPreview()
end

function InputController:setEnabled(value)
	if self.destroyed then
		return
	end
	self.enabled = value == true
	if not self.enabled then
		-- Aucun geste ne survit à la désactivation (fin, choix de semaine).
		self:cancelDrag()
		self.touches = {}
		self.gesture = nil
		self.pointer = nil
		self.ghost.Transparency = 1
		self.ghostKey = nil
	end
	self:updateGridVisibility()
	self:refreshPreview()
end

function InputController:setTool(tool)
	if self.destroyed then
		return
	end
	if self.dragging then
		self:cancelDrag()
	end
	self.tool = tool
	self.ghostKey = nil
	if tool ~= "roundabout" then
		self.ghost.Transparency = 1
	end
	self:updateGridVisibility()
	self:refreshPreview()
end

-- Le serveur envoie l'état réel du réseau après chaque modification.
function InputController:applyRoadState(data)
	if type(data) ~= "table" then
		return
	end

	local roads = {}
	for _, key in ipairs(data.roads or {}) do
		roads[key] = true
	end
	local buildings = {}
	for _, key in ipairs(data.buildings or {}) do
		buildings[key] = true
	end

	self.roads = roads
	self.buildingSet = buildings
	self.preview:setRoads(roads)
	self.budget = tonumber(data.budget) or self.budget
	self.bridgesLeft = tonumber(data.bridgesLeft) or self.bridgesLeft
	self:refreshPreview()
end

-- Case sous une position écran (repère de pointerFrom), ou nil hors carte. La
-- visée coupe le plan PICK_HEIGHT ; les cases partent du coin de l'origine,
-- comme Grid.center.
function InputController:cellAt(position)
	if self.destroyed or typeof(position) ~= "Vector2" then
		return nil
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return nil
	end

	-- ScreenPointToRay déduit la barre supérieure, comme les positions des
	-- InputObject : le rayon passe exactement sous le curseur ou le doigt.
	local ray = camera:ScreenPointToRay(position.X, position.Y)
	local direction = ray.Direction
	if math.abs(direction.Y) < 0.0001 then
		return nil
	end

	local distance = (self.origin.Y + PICK_HEIGHT - ray.Origin.Y) / direction.Y
	if distance <= 0 then
		return nil
	end

	local hit = ray.Origin + direction * distance
	-- Grid.cellFromWorld suppose la taille de case de Config.Grid, celle que le
	-- serveur envoie dans GameStarted.
	local x, y = Grid.cellFromWorld(self.origin, hit)
	if not Grid.inBounds(x, y) then
		return nil
	end
	return { x, y }
end

-- Libère tout : connexions, fantôme, aperçu. Le contrôleur ne sert plus après.
function InputController:destroy()
	if self.destroyed then
		return
	end
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	self.connections = {}
	self.destroyed = true
	self.enabled = false
	self:resetStroke()
	self.touches = {}
	self.gesture = nil
	self.preview:destroy()
	self.ghost:Destroy()
	self.ghost = nil
	self:updateGridVisibility()
end

return InputController
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="36">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Main.client.luau
	Câble le lobby, le HUD, la caméra et les contrôles.
	Le client n'a aucune autorité : il demande, le serveur décide.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Maps = require(Shared.Maps)

local remotesFolder = ReplicatedStorage:WaitForChild("MMRemotes")
local remoteCache = {}
local function remote(name)
	local found = remoteCache[name]
	if not found then
		found = remotesFolder:WaitForChild(name)
		remoteCache[name] = found
	end
	return found
end

local CameraController = require(script.Parent.CameraController)
local InputController = require(script.Parent.InputController)
local StoreVisualController = require(script.Parent.StoreVisualController)
local Lobby = require(script.Parent.UI.Lobby)
local HUD = require(script.Parent.UI.HUD)

local CORE_GUI_ATTEMPTS = 5

-- StarterGui refuse parfois ces réglages au tout premier instant : on réessaie
-- quelques fois, sans bloquer le client. Le menu Échap de Roblox (Paramètres)
-- n'est pas un CoreGuiType : il reste accessible.
local function hideDefaultUi(attempt)
	local ok, err = pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
		-- Le bouton de réinitialisation remettrait le personnage à zéro, sans
		-- rapport avec une partie de gestion.
		StarterGui:SetCore("ResetButtonCallback", false)
	end)
	if ok then
		return
	end
	if attempt < CORE_GUI_ATTEMPTS then
		task.delay(0.5 * attempt, hideDefaultUi, attempt + 1)
	else
		warn("Interface Roblox non masquée : " .. tostring(err))
	end
end
hideDefaultUi(1)

-- Un affichage qui échoue ne doit pas couper les autres mises à jour du client.
local function guarded(label, handler)
	return function(...)
		local ok, err = pcall(handler, ...)
		if not ok then
			warn(label .. " : " .. tostring(err))
		end
	end
end

CameraController.lobby()

local lobby
local hud
local input
local storeVisuals = StoreVisualController.new()
local currentMapId = nil
local inGame = false

-- La carte se cadre hors des bandes que le HUD déclare (barre, compteurs,
-- outils). Sans getter côté HUD, la carte garde toute la vue.
local function syncSafeInsets()
	if hud and hud.getSafeInsets then
		local top, right, bottom, left = hud:getSafeInsets()
		CameraController.setSafeInsets(top, right, bottom, left)
	end
end

-- Recalcule les marges à chaque changement de taille de la vue, y compris si
-- Roblox remplace la caméra courante.
local viewportConnection = nil
local function bindViewport()
	if viewportConnection then
		viewportConnection:Disconnect()
		viewportConnection = nil
	end
	local camera = workspace.CurrentCamera
	if camera then
		viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(syncSafeInsets)
	end
end
bindViewport()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindViewport)

-- Clic milieu maintenu : glisser déplace la vue sans jamais construire. Les
-- gestes tactiles sont portés par InputController (un doigt construit, deux
-- doigts déplacent et zooment).
local panning = false

local function playMap(mapId)
	if not mapId then
		return
	end
	currentMapId = mapId
	remote("StartGame"):FireServer(mapId)
end

-- Le menu pause s'ouvre avec la demande de pause au serveur ; les commandes de
-- la carte sont coupées derrière lui. P (ou le bouton) le referme.
local function resumeGame()
	remote("SetPaused"):FireServer(false)
	if hud then
		hud:hidePause()
	end
	-- Un choix hebdomadaire rouvert par la reprise garde les commandes coupées.
	if input then
		input:setEnabled(not (hud and hud:isChoiceOpen()))
	end
end

local function pauseGame()
	if not inGame or not hud then
		return
	end
	if hud:isPauseOpen() then
		resumeGame()
		return
	end
	-- Partie terminée : rien à mettre en pause.
	if hud:isGameOverOpen() then
		return
	end
	remote("SetPaused"):FireServer(true)
	hud:showPause()
	if input then
		input:setEnabled(false)
	end
end

-- Réinitialise les commandes et les overlays de la partie précédente. Les
-- magasins ne sont pas touchés ici : StoreVisualController:setWorld les
-- reconstruit, et la caméra est recadrée par GameStarted.
local function resetGameView()
	panning = false
	if input then
		input:setEnabled(false)
		input:setTool("build")
	end
	if hud then
		hud:hideModals()
	end
end

local function goToLobby()
	remote("ReturnToLobby"):FireServer()
	inGame = false
	resetGameView()
	storeVisuals:clear()
	if hud then
		hud:hide()
	end
	if lobby then
		lobby:show()
		lobby:showMaps()
	end
	CameraController.lobby()
end

lobby = Lobby.new({
	onPlay = function()
		lobby:showMaps()
	end,
	onQuit = function()
		player:Kick("Merci d'avoir joué à " .. Config.GameName .. " !")
	end,
	onStartMap = playMap,
	onResetRecords = function()
		remote("ResetRecords"):FireServer()
		lobby:toast("Records réinitialisés")
	end,
})

-- Affiche le menu immédiatement : même si un autre module échoue plus tard,
-- les boutons du lobby restent visibles et réactifs.
lobby:show()

hud = HUD.new({
	onPause = pauseGame,
	onResume = resumeGame,
	-- Nouvelle partie sur le même plan : le serveur repart de zéro, et GameStarted
	-- remet le HUD, la grille, les magasins et la caméra à leur état initial.
	onRestart = function()
		if inGame and currentMapId then
			playMap(currentMapId)
		end
	end,
	-- L'aide (« hints ») se gère dans le HUD lui-même : rien à faire côté jeu.
	onSetting = function(name, value)
		if name == "grid" and input then
			input:setGridPinned(value == true)
		end
	end,
	onMenu = goToLobby,
	onToolChange = function(tool)
		input:setTool(tool)
	end,
	onSpeed = function(value)
		remote("SetSpeed"):FireServer(value)
	end,
	onChooseReward = function(optionId)
		remote("ChooseReward"):FireServer(optionId)
		input:setEnabled(true)
	end,
})

input = InputController.new({
	onDraw = function(cells)
		remote("DrawRoad"):FireServer(cells)
	end,
	onErase = function(key)
		remote("EraseRoad"):FireServer(key)
	end,
	onEraseMany = function(keys)
		remote("EraseRoads"):FireServer(keys)
	end,
	onRoundabout = function(x, y)
		remote("PlaceRoundabout"):FireServer(x, y)
	end,
	onToolChanged = function(tool)
		if hud then
			hud:setTool(tool)
		end
	end,
	-- Outil « main » et glissement à deux doigts : déplacement en pixels écran.
	onPan = CameraController.panByPixels,
	-- Pincement : InputController fournit la variation relative de l'écart,
	-- convertie en zoom par RoadConfig.Input.PinchZoomGain.
	onZoom = CameraController.zoomBy,
})

-- Le clic milieu démarre le déplacement seulement hors de toute interface, mais
-- le déplacement, lui, continue même si le curseur passe sur un bouton.
UserInputService.InputBegan:Connect(function(event, processed)
	if processed or not inGame then
		return
	end
	if event.UserInputType == Enum.UserInputType.MouseButton3 then
		panning = true
	elseif event.KeyCode == Enum.KeyCode.P then
		-- P ouvre et referme le menu pause. Les commandes de la carte sont coupées
		-- derrière le menu : la touche est donc lue ici, pas par InputController.
		pauseGame()
	end
end)

UserInputService.InputChanged:Connect(function(event, processed)
	if not inGame then
		return
	end
	if event.UserInputType == Enum.UserInputType.MouseMovement then
		if panning then
			CameraController.panByPixels(event.Delta.X, event.Delta.Y)
		end
	elseif event.UserInputType == Enum.UserInputType.MouseWheel and not processed then
		-- Molette vers l'avant : Position.Z > 0, donc zoom avant.
		CameraController.zoomBy(event.Position.Z * Config.Camera.ZoomStep)
	end
end)

UserInputService.InputEnded:Connect(function(event)
	if event.UserInputType == Enum.UserInputType.MouseButton3 then
		panning = false
	end
end)

-- Fenêtre perdue clic milieu tenu : le relâchement n'arrive jamais, la vue
-- ne doit pas rester collée au curseur au retour.
UserInputService.WindowFocusReleased:Connect(function()
	panning = false
end)

-- Chaque étape de GameStarted est isolée : si le HUD échoue à s'afficher, la
-- caméra se cadre et les commandes s'activent quand même, sans quoi le joueur
-- resterait devant une carte immobile.
local function runStep(label, step)
	guarded("GameStarted/" .. label, step)()
end

remote("GameStarted").OnClientEvent:Connect(function(data)
	runStep("reset", resetGameView)
	currentMapId = data.mapId
	inGame = true

	runStep("lobby", function()
		lobby:hide()
	end)
	runStep("hud", function()
		hud:showGame(data, Maps.getById(data.mapId))
	end)
	runStep("stores", function()
		storeVisuals:setWorld(data.origin, data.tile)
	end)
	-- Les marges viennent du HUD déjà affiché : la première pose est cadrée juste.
	runStep("camera", function()
		syncSafeInsets()
		CameraController.focus(data.origin, data.size, data.tile)
	end)
	runStep("input", function()
		input:setWorld(data.origin, data.size, data.tile)
		input:setMapId(data.mapId)
		input:setEnabled(true)
		input:setTool("build")
	end)
	runStep("settings", function()
		-- Le réglage « Grille visible » de la session s'applique aussi aux nouvelles parties.
		input:setGridPinned(hud:getSetting("grid"))
		hud:setTool("build")
	end)
end)

remote("State").OnClientEvent:Connect(function(state)
	hud:setState(state)
	if state.over then
		input:setEnabled(false)
	end
end)

remote("StoreState").OnClientEvent:Connect(guarded("StoreState", function(data)
	storeVisuals:apply(data)
end))

remote("RoadState").OnClientEvent:Connect(function(data)
	input:applyRoadState(data)
end)

remote("WeekChoice").OnClientEvent:Connect(function(data)
	hud:showWeekChoice(data)
	input:setEnabled(false)
end)

remote("GameOver").OnClientEvent:Connect(function(data)
	hud:showGameOver(data)
	input:setEnabled(false)
end)

remote("Toast").OnClientEvent:Connect(function(text)
	if inGame then
		hud:toast(text)
	else
		lobby:toast(text)
	end
end)

remote("Profile").OnClientEvent:Connect(function(profile)
	lobby:setProfile(profile)
end)

task.delay(1, function()
	remote("RequestProfile"):FireServer()
end)
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">RoadPreview</string>
            <ProtectedString name="Source"><![CDATA[--[[
	RoadPreview.luau
	Aperçu local du tracé : la forme exacte de la route qui sera posée
	(RoadGeometry), en menthe si elle est valide, en corail si elle est refusée
	ou si elle va être effacée. Aucun objet n'est envoyé au serveur.

	Les pièces sont un pool : une case n'est reconstruite que si elle change, ou
	si un voisin change (ses bras changent). Les routes déjà posées servent de
	contexte sans être copiées : une table à __index lit le réseau du client et
	les cases de l'aperçu. Les pièces sont opaques : deux pièces translucides qui
	se recouvrent dessineraient une couture plus foncée (spec 3.3).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local RoadConfig = require(Shared.RoadConfig)
local RoadGeometry = require(Shared.RoadGeometry)

local RoadPreview = {}
RoadPreview.__index = RoadPreview

local NO_BRIDGES = {}
local HALF_TURN = math.pi / 2
-- Le liseré passe sous la surface : un écart de hauteur évite le scintillement.
local EDGE_LIFT = 0.01

local function makePart()
	local part = Instance.new("Part")
	part.Name = "RoadPreviewCell"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Transparency = 1
	part.Parent = nil
	return part
end

function RoadPreview.new()
	local self = setmetatable({}, RoadPreview)
	self.origin = Vector3.zero
	self.tile = Config.Grid.TileSize
	-- Routes posées telles que le serveur les décrit (ensemble clé -> true).
	self.roads = NO_BRIDGES
	-- Cases de l'aperçu : clé -> { x, y, valid, hover }.
	self.cells = {}
	-- Pièces affichées par case, et pièces libres du pool.
	self.cellParts = {}
	self.free = {}
	self.folder = Instance.new("Folder")
	self.folder.Name = "MM_RoadPreview"
	self.folder.Parent = Workspace
	-- Vue du réseau pour RoadGeometry : routes posées ou cases de l'aperçu,
	-- sans copie de la table des routes.
	self.view = setmetatable({}, {
		__index = function(_, key)
			return self.roads[key] or self.cells[key] ~= nil
		end,
	})
	return self
end

function RoadPreview:setWorld(origin, tile)
	self.origin = origin or self.origin
	self.tile = tile or self.tile
	-- Les routes mémorisées ne valent plus pour le nouveau monde.
	self.roads = NO_BRIDGES
	self:clear()
end

-- Rend une pièce au pool : elle reste dans le dossier, cachée.
function RoadPreview:releaseCell(key)
	local parts = self.cellParts[key]
	if not parts then
		return
	end
	for _, part in ipairs(parts) do
		part.Transparency = 1
		self.free[#self.free + 1] = part
	end
	self.cellParts[key] = nil
end

function RoadPreview:acquire()
	local part = table.remove(self.free)
	if part then
		return part
	end
	part = makePart()
	part.Parent = self.folder
	return part
end

-- Place une pièce de RoadGeometry sur la case x, y (repère de la case en 0..1).
function RoadPreview:place(part, piece, x, y, color)
	local tile = self.tile
	local thickness = RoadConfig.Visual.PreviewHeight
	local lift = if piece.layer == "edge" then -EDGE_LIFT else 0
	local worldX = self.origin.X + (x + piece.cx) * tile
	local worldY = self.origin.Y + RoadConfig.Visual.PreviewY + lift
	local worldZ = self.origin.Z + (y + piece.cy) * tile
	if piece.kind == "disk" then
		-- Un cylindre a son axe en X : il est couché à plat par une rotation.
		local diameter = piece.w * tile
		part.Shape = Enum.PartType.Cylinder
		part.Size = Vector3.new(thickness, diameter, diameter)
		part.CFrame = CFrame.new(worldX, worldY, worldZ) * CFrame.Angles(0, 0, HALF_TURN)
	else
		part.Shape = Enum.PartType.Block
		part.Size = Vector3.new(piece.w * tile, thickness, piece.h * tile)
		part.CFrame = CFrame.new(worldX, worldY, worldZ)
	end
	part.Color = color
	part.Transparency = 0
end

-- Recalcule les pièces d'une case de l'aperçu, selon ses voisins actuels.
function RoadPreview:drawCell(key)
	self:releaseCell(key)
	local cell = self.cells[key]
	if not cell then
		return
	end
	local visual = RoadConfig.Visual
	local color = if cell.valid then visual.PreviewValidColor else visual.PreviewInvalidColor
	local transparency = if cell.hover then visual.PreviewHoverTransparency else 0
	local pieces = RoadGeometry.cellPieces(self.view, NO_BRIDGES, nil, cell.x, cell.y)
	local parts = {}
	for index, piece in ipairs(pieces) do
		local part = self:acquire()
		self:place(part, piece, cell.x, cell.y, color)
		part.Transparency = transparency
		parts[index] = part
	end
	self.cellParts[key] = parts
end

-- Clés des cases de l'aperçu touchées par un changement sur key : la case
-- elle-même et ses quatre voisins, dont les bras peuvent changer.
local function markAround(dirty, key)
	local x, y = Grid.parse(key)
	if not x then
		return
	end
	dirty[key] = true
	dirty[Grid.key(x + 1, y)] = true
	dirty[Grid.key(x - 1, y)] = true
	dirty[Grid.key(x, y + 1)] = true
	dirty[Grid.key(x, y - 1)] = true
end

-- Routes posées (RoadState). Les cases de l'aperçu sont redessinées, car leurs
-- bras dépendent de ces routes.
function RoadPreview:setRoads(roads)
	self.roads = roads or NO_BRIDGES
	for key in pairs(self.cells) do
		self:drawCell(key)
	end
end

-- cells : { {x = , y = , valid = true/false, hover = true/false}, ... }
-- valid = false est affiché en corail (case refusée, ou case à effacer).
-- Seules les cases qui changent sont redessinées.
function RoadPreview:setCells(cells)
	if not self.folder then
		return
	end
	local nextCells = {}
	for _, cell in ipairs(cells or {}) do
		if type(cell) == "table" and type(cell.x) == "number" and type(cell.y) == "number" then
			local x, y = math.floor(cell.x), math.floor(cell.y)
			nextCells[Grid.key(x, y)] = {
				x = x,
				y = y,
				valid = cell.valid ~= false,
				hover = cell.hover == true,
			}
		end
	end

	local dirty = {}
	for key, old in pairs(self.cells) do
		local new = nextCells[key]
		if not new or new.valid ~= old.valid or new.hover ~= old.hover then
			markAround(dirty, key)
		end
	end
	for key in pairs(nextCells) do
		if not self.cells[key] then
			markAround(dirty, key)
		end
	end

	self.cells = nextCells
	for key in pairs(dirty) do
		if nextCells[key] then
			self:drawCell(key)
		else
			self:releaseCell(key)
		end
	end
end

function RoadPreview:clear()
	for key in pairs(self.cellParts) do
		self:releaseCell(key)
	end
	self.cells = {}
end

function RoadPreview:destroy()
	if self.folder then
		self.folder:Destroy()
		self.folder = nil
	end
	self.cells = {}
	self.cellParts = {}
	self.free = {}
end

return RoadPreview
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">StoreVisualController</string>
            <ProtectedString name="Source"><![CDATA[--[[
	StoreVisualController.luau
	Affichage client des demandes (pins) au-dessus des magasins.

	Le serveur reste autoritaire : il envoie l'état des magasins via
	StoreState. Ce module ne crée que des BillboardGui locaux, anime les pins
	et affiche le compte à rebours de surcharge. Il ne modifie jamais la
	logique de jeu.

	Les mises à jour sont différentielles : un pin n'est créé ou retiré que si
	sa demande (identifiant serveur) apparaît ou est servie. Les GUI ne sont
	jamais reconstruits entre deux snapshots.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local StoreConfig = require(Shared.StoreConfig)

local VISUAL = StoreConfig.Visual
local DEMAND = StoreConfig.Demand
local COLORS = Config.Colors

-- Les pins sont rangés en lignes de PinsPerRow ; la première ligne est au
-- contact du magasin, les suivantes s'empilent vers le haut de l'écran.
local MAX_ROWS = math.ceil(DEMAND.LargeCapacity / VISUAL.PinsPerRow)

local StoreVisualController = {}
StoreVisualController.__index = StoreVisualController

local function paletteFor(colorIndex)
	return Config.HouseColors[colorIndex] or Config.HouseColors[1]
end

local function roundCorners(parent)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = parent
end

local function startTween(instance, duration, style, direction, goal)
	local tween = TweenService:Create(instance, TweenInfo.new(duration, style, direction), goal)
	tween:Play()
	return tween
end

local function cancelTween(tween)
	if tween then
		tween:Cancel()
	end
end

-- Hauteur occupée par n lignes de pins, séparées par PinGap.
local function stackHeight(rows)
	if rows <= 0 then
		return 0
	end
	return rows * VISUAL.PinSize + (rows - 1) * VISUAL.PinGap
end

local function rowOfSlot(slot)
	return math.ceil(slot / VISUAL.PinsPerRow)
end

-- Premier emplacement libre de la grille. Un pin en cours de retrait garde sa
-- place jusqu'à sa destruction, pour qu'un nouveau pin ne se superpose pas à
-- lui. Si la grille est pleine, la place d'un pin qui part est reprise.
local function firstFreeSlot(entry)
	local limit = MAX_ROWS * VISUAL.PinsPerRow
	local leaving = nil
	for slot = 1, limit do
		local owner = entry.slots[slot]
		if not owner then
			return slot
		end
		if owner.removed and not leaving then
			leaving = slot
		end
	end
	return leaving or limit
end

-- Décalage (studs) du centre du BillboardGui vers le haut de l'écran. Le bas
-- des pins est posé à PinLift du bord du bâtiment : la taille du magasin est
-- lue dans la config pour que les pins suivent son évolution.
local function offsetFor(storeType)
	local size = if storeType == "large" then VISUAL.LargeSize else VISUAL.SmallSize
	return size * 0.5 + VISUAL.PinLift
end

-- Fond de l'alerte. Le texte reste anthracite : il est plus lisible que le
-- blanc sur le corail, à petite taille.
local function warningColor(level)
	if level == "critical" then
		return COLORS.Danger
	end
	return COLORS.LobbyOrange
end

-- Valide un magasin reçu du serveur. Un élément partiel ou malformé est
-- ignoré, sans toucher aux pins déjà affichés.
local function normalizeState(raw)
	if type(raw) ~= "table" then
		return nil
	end
	local id, x, y = raw.id, raw.x, raw.y
	if type(id) ~= "number" or type(x) ~= "number" or type(y) ~= "number" then
		return nil
	end

	local storeType = if raw.storeType == "large" then "large" else "small"
	local capacity = if storeType == "large" then DEMAND.LargeCapacity else DEMAND.SmallCapacity
	if type(raw.capacity) == "number" then
		capacity = math.clamp(math.floor(raw.capacity), 1, DEMAND.LargeCapacity)
	end

	-- nil = le payload ne dit rien sur les demandes : les pins actuels sont gardés.
	local demandIds = nil
	if type(raw.demandIds) == "table" then
		demandIds = {}
		for _, rawId in ipairs(raw.demandIds) do
			if #demandIds >= capacity then
				break
			end
			table.insert(demandIds, tostring(rawId))
		end
	elseif type(raw.demands) == "number" then
		-- Payload sans identifiants : des emplacements stables évitent de
		-- recréer tous les pins quand le compteur change.
		demandIds = {}
		for index = 1, math.clamp(math.floor(raw.demands), 0, capacity) do
			demandIds[index] = "slot_" .. tostring(index)
		end
	end

	local overloadClock = if type(raw.overloadClock) == "number" then raw.overloadClock else 0
	return {
		id = id,
		x = x,
		y = y,
		colorIndex = if type(raw.colorIndex) == "number" then raw.colorIndex else 1,
		storeType = storeType,
		capacity = capacity,
		demandIds = demandIds,
		overloaded = raw.overloaded == true,
		critical = raw.critical == true,
		overloadClock = math.max(0, math.ceil(overloadClock)),
	}
end

function StoreVisualController.new()
	local self = setmetatable({}, StoreVisualController)
	self.origin = nil
	self.tile = Config.Grid.TileSize
	self.stores = {}
	self.pending = nil

	self.folder = Instance.new("Folder")
	self.folder.Name = "MMStorePins"
	self.folder.Parent = Workspace

	return self
end

function StoreVisualController:setWorld(origin, tile)
	self.origin = origin
	self.tile = tile or Config.Grid.TileSize

	local pending = self.pending
	self.pending = nil
	self:clear()
	if pending then
		self:apply(pending)
	end
end

function StoreVisualController:cellCenter(x, y)
	return self.origin + Vector3.new((x + 0.5) * self.tile, 0.5, (y + 0.5) * self.tile)
end

-- Crée un pin. Le délai échelonne l'apparition d'une vague de nouvelles demandes.
function StoreVisualController:createPin(entry, demandId, delay)
	local palette = paletteFor(entry.colorIndex)
	local slot = firstFreeSlot(entry)
	local owner = entry.slots[slot]
	if owner and owner.removed then
		-- Grille pleine : le pin qui quitte cette place disparaît tout de suite.
		owner.frame:Destroy()
	end

	local frame = Instance.new("Frame")
	frame.Name = "DemandPin"
	frame.Size = UDim2.fromOffset(VISUAL.PinSize, VISUAL.PinSize)
	frame.BackgroundColor3 = palette.color
	frame.BorderSizePixel = 0
	frame.LayoutOrder = (slot - 1) % VISUAL.PinsPerRow + 1
	roundCorners(frame)

	-- Liseré fin et doux : il sépare le pin du fond sans contour épais.
	local stroke = Instance.new("UIStroke")
	stroke.Color = palette.base
	stroke.Thickness = 1
	stroke.Transparency = VISUAL.PinStrokeTransparency
	stroke.Parent = frame

	local scale = Instance.new("UIScale")
	scale.Scale = 0
	scale.Parent = frame

	local pin = {
		slot = slot,
		frame = frame,
		stroke = stroke,
		scale = scale,
		removed = false,
		appear = nil,
	}
	entry.pins[demandId] = pin
	entry.slots[slot] = pin
	frame.Parent = entry.rows[rowOfSlot(slot)]

	local function appear()
		if not pin.removed then
			pin.appear = startTween(
				scale,
				VISUAL.PinAppearDuration,
				Enum.EasingStyle.Back,
				Enum.EasingDirection.Out,
				{ Scale = 1 }
			)
		end
	end
	if delay > 0 then
		task.delay(delay, appear)
	else
		appear()
	end
	return pin
end

-- Retire un pin servi : il rétrécit puis disparaît à sa place. L'appelant le
-- sort de entry.pins tout de suite ; sa place reste occupée jusqu'à destruction.
function StoreVisualController:removePin(entry, pin)
	if pin.removed then
		return
	end
	pin.removed = true
	cancelTween(pin.appear)

	local duration = VISUAL.PinRemoveDuration
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(pin.scale, info, { Scale = 0 }):Play()
	TweenService:Create(pin.frame, info, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(pin.stroke, info, { Transparency = 1 }):Play()

	local frame = pin.frame
	task.delay(duration, function()
		if entry.slots[pin.slot] == pin then
			entry.slots[pin.slot] = nil
		end
		if frame.Parent then
			frame:Destroy()
		end
	end)
end

function StoreVisualController:createEntry(state)
	local anchor = Instance.new("Part")
	anchor.Name = "StorePinAnchor_" .. tostring(state.id)
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(self:cellCenter(state.x, state.y))

	local offset = offsetFor(state.storeType)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "DemandPins"
	billboard.Adornee = anchor
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = VISUAL.PinMaxDistance
	billboard.Size = UDim2.fromOffset(VISUAL.PinRowWidth, VISUAL.PinRowHeight)
	-- La caméra est vue de dessus : world -Z correspond à « haut de l'écran ».
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 0, -offset)

	-- Le bloc des pins est ancré par son bas : il grandit vers le haut, sans
	-- jamais descendre sur le magasin quand une deuxième ligne apparaît.
	local container = Instance.new("Frame")
	container.Name = "Pins"
	container.AnchorPoint = Vector2.new(0.5, 1)
	container.Position = UDim2.fromScale(0.5, 0.5)
	container.Size = UDim2.fromOffset(
		VISUAL.PinsPerRow * VISUAL.PinSize + (VISUAL.PinsPerRow - 1) * VISUAL.PinGap,
		stackHeight(MAX_ROWS)
	)
	container.BackgroundTransparency = 1
	container.Parent = billboard

	local containerScale = Instance.new("UIScale")
	containerScale.Scale = 1
	containerScale.Parent = container

	local stack = Instance.new("UIListLayout")
	stack.FillDirection = Enum.FillDirection.Vertical
	stack.HorizontalAlignment = Enum.HorizontalAlignment.Center
	stack.VerticalAlignment = Enum.VerticalAlignment.Bottom
	stack.SortOrder = Enum.SortOrder.LayoutOrder
	stack.Padding = UDim.new(0, VISUAL.PinGap)
	stack.Parent = container

	local rows = {}
	for row = 1, MAX_ROWS do
		local rowFrame = Instance.new("Frame")
		rowFrame.Name = "Row" .. tostring(row)
		rowFrame.BackgroundTransparency = 1
		rowFrame.BorderSizePixel = 0
		rowFrame.Size = UDim2.new(1, 0, 0, VISUAL.PinSize)
		-- LayoutOrder décroissant : la rangée 1 est la plus basse.
		rowFrame.LayoutOrder = MAX_ROWS + 1 - row

		local rowLayout = Instance.new("UIListLayout")
		rowLayout.FillDirection = Enum.FillDirection.Horizontal
		rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		rowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
		rowLayout.Padding = UDim.new(0, VISUAL.PinGap)
		rowLayout.Parent = rowFrame

		rowFrame.Parent = container
		rows[row] = rowFrame
	end

	local warning = Instance.new("TextLabel")
	warning.Name = "Overload"
	warning.AnchorPoint = Vector2.new(0.5, 1)
	warning.Position = UDim2.new(0.5, 0, 0.5, -VISUAL.PinWarningGap)
	warning.Size = UDim2.fromOffset(VISUAL.PinWarningWidth, VISUAL.PinWarningHeight)
	warning.BackgroundColor3 = COLORS.LobbyOrange
	warning.BorderSizePixel = 0
	warning.Font = Enum.Font.GothamBold
	warning.Text = ""
	warning.TextColor3 = COLORS.Ink
	warning.TextSize = VISUAL.PinWarningTextSize
	warning.Visible = false
	roundCorners(warning)
	warning.Parent = billboard

	local entry = {
		id = state.id,
		anchor = anchor,
		billboard = billboard,
		containerScale = containerScale,
		rows = rows,
		warning = warning,
		pins = {},
		slots = {},
		colorIndex = state.colorIndex,
		storeType = state.storeType,
		offset = offset,
		offsetTween = nil,
		popTween = nil,
		x = state.x,
		y = state.y,
		warningLevel = nil,
		warningRows = 0,
	}

	billboard.Parent = anchor
	anchor.Parent = self.folder
	return entry
end

function StoreVisualController:updateEntry(entry, state)
	if entry.x ~= state.x or entry.y ~= state.y then
		entry.x = state.x
		entry.y = state.y
		entry.anchor.CFrame = CFrame.new(self:cellCenter(state.x, state.y))
	end

	-- Évolution petite -> grand : le décalage glisse vers la nouvelle silhouette
	-- et le bloc de pins rebondit légèrement. La tween n'est relancée que si la
	-- cible change, sinon chaque snapshot couperait l'animation en cours.
	local offset = offsetFor(state.storeType)
	if entry.offset ~= offset then
		entry.offset = offset
		cancelTween(entry.offsetTween)
		entry.offsetTween = startTween(
			entry.billboard,
			VISUAL.EvolutionDuration,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out,
			{ StudsOffsetWorldSpace = Vector3.new(0, 0, -offset) }
		)
	end
	if entry.storeType ~= state.storeType then
		entry.storeType = state.storeType
		cancelTween(entry.popTween)
		entry.containerScale.Scale = VISUAL.PinEvolutionPop
		entry.popTween = startTween(
			entry.containerScale,
			VISUAL.EvolutionDuration,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out,
			{ Scale = 1 }
		)
	end

	if entry.colorIndex ~= state.colorIndex then
		entry.colorIndex = state.colorIndex
		local palette = paletteFor(state.colorIndex)
		for _, pin in pairs(entry.pins) do
			pin.frame.BackgroundColor3 = palette.color
			pin.stroke.Color = palette.base
		end
	end

	-- Les identifiants serveur indexent les pins : le client retire exactement
	-- la demande servie, même si plusieurs demandes changent entre deux snapshots.
	local demandIds = state.demandIds
	if demandIds then
		local targetSet = {}
		for _, demandId in ipairs(demandIds) do
			targetSet[demandId] = true
		end
		for demandId, pin in pairs(entry.pins) do
			if not targetSet[demandId] then
				entry.pins[demandId] = nil
				self:removePin(entry, pin)
			end
		end
		local spawned = 0
		for _, demandId in ipairs(demandIds) do
			if not entry.pins[demandId] then
				self:createPin(entry, demandId, spawned * VISUAL.PinStagger)
				spawned += 1
			end
		end
	end

	-- La rangée la plus haute occupée détermine où se place l'alerte.
	local topRow = 0
	for slot in pairs(entry.slots) do
		topRow = math.max(topRow, rowOfSlot(slot))
	end
	local warning = entry.warning
	if topRow ~= entry.warningRows then
		entry.warningRows = topRow
		warning.Position = UDim2.new(
			0.5,
			0,
			0.5,
			-(stackHeight(topRow) + VISUAL.PinWarningGap)
		)
	end

	local level = nil
	if state.critical then
		level = "critical"
	elseif state.overloaded then
		level = "overload"
	end
	if level ~= entry.warningLevel then
		entry.warningLevel = level
		warning.Visible = level ~= nil
		if level then
			warning.BackgroundColor3 = warningColor(level)
		end
	end
	if level then
		local text = if level == "critical" then "!!" else tostring(state.overloadClock) .. "s"
		if warning.Text ~= text then
			warning.Text = text
		end
	end
end

function StoreVisualController:apply(data)
	if not self.folder then
		return
	end
	if not self.origin then
		self.pending = data
		return
	end
	if type(data) ~= "table" or type(data.stores) ~= "table" then
		return
	end

	-- Un magasin listé avec un élément partiel reste affiché tel quel : seul un
	-- magasin absent de la liste disparaît.
	local incoming = {}
	local listed = {}
	for _, raw in ipairs(data.stores) do
		if type(raw) == "table" and type(raw.id) == "number" then
			listed[raw.id] = true
		end
		local state = normalizeState(raw)
		if state then
			incoming[state.id] = state
		end
	end

	for id, entry in pairs(self.stores) do
		if not listed[id] then
			self:disposeEntry(entry)
			self.stores[id] = nil
		end
	end

	for id, state in pairs(incoming) do
		local entry = self.stores[id]
		if not entry then
			entry = self:createEntry(state)
			self.stores[id] = entry
		end
		self:updateEntry(entry, state)
	end
end

-- Détruit un magasin et ses pins. Les tweens en cours sont annulés avant que
-- leurs instances ne disparaissent.
function StoreVisualController:disposeEntry(entry)
	for _, pin in pairs(entry.pins) do
		pin.removed = true
		cancelTween(pin.appear)
	end
	entry.pins = {}
	cancelTween(entry.offsetTween)
	cancelTween(entry.popTween)
	entry.anchor:Destroy()
end

function StoreVisualController:clear()
	for _, entry in pairs(self.stores) do
		self:disposeEntry(entry)
	end
	self.stores = {}
	self.pending = nil
	if self.folder then
		self.folder:ClearAllChildren()
	end
end

function StoreVisualController:destroy()
	self:clear()
	if self.folder then
		self.folder:Destroy()
		self.folder = nil
	end
end

return StoreVisualController
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="39">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">HUD</string>
              <ProtectedString name="Source"><![CDATA[--[[
	HUD.luau
	Point d'entrée de l'interface de jeu. Les méthodes sont réparties par
	responsabilité dans des modules voisins (même principe que Session) :
	  HUDTopBar      score, jour, mois, horloge, contrôles du temps, jauge de trafic
	  HUDToolbar     colonne d'outils à droite
	  HUDCounters    compteurs du bas et aide
	  HUDOverlays    pause, fin de partie, choix hebdomadaire, toast
	  HUDResponsive  mise en page selon la taille de l'écran, marges de sécurité
	  HUDIcons       pictogrammes dessinés en Frame
	Ce module reçoit l'état serveur et le répartit entre ces parties.

	Callbacks de HUD.new(callbacks), tous optionnels : onPause, onResume,
	onRestart, onMenu, onToolChange(tool), onSpeed(value), onChooseReward(id) et
	onSetting(name, value) avec name « grid » ou « hints ». Le HUD gère lui-même
	l'affichage de l'aide : onSetting « hints » ne demande aucune action.
]]

local Players = game:GetService("Players")

local Theme = require(script.Parent.Theme)

local HUD = {}
HUD.__index = HUD

require(script.Parent.HUDTopBar)(HUD)
require(script.Parent.HUDToolbar)(HUD)
require(script.Parent.HUDCounters)(HUD)
require(script.Parent.HUDOverlays)(HUD)
require(script.Parent.HUDResponsive)(HUD)

-- Chaque mise à jour regroupe les champs de l'état serveur qui la concernent :
-- elle n'est rejouée que si l'un d'eux a changé depuis le dernier état reçu.
-- Les actions passent par `self:` pour rester remplaçables dans les tests.
local UPDATES = {
	{
		fields = { "score" },
		apply = function(self, state)
			local text = tostring(state.score or 0)
			if self.scoreValue.Text ~= text then
				self.scoreValue.Text = text
			end
		end,
	},
	{
		fields = { "week", "weekProgress", "day", "dayOfWeek", "dayProgress", "month", "monthName", "monthWeek", "monthProgress" },
		apply = function(self, state)
			self:setCalendar(state)
		end,
	},
	{
		fields = { "budget", "bridges", "houses", "destinations" },
		apply = function(self, state)
			self:updateCounters(state)
		end,
	},
	{
		fields = { "roundabouts" },
		apply = function(self, state)
			self:setRoundabouts(state.roundabouts or 0)
		end,
	},
	{
		fields = { "satisfaction" },
		apply = function(self, state)
			self:setSatisfaction(state.satisfaction or 0)
		end,
	},
	{
		fields = { "speed" },
		apply = function(self, state)
			self:setSpeed(state.speed or 1)
		end,
	},
	{
		-- Pendant le choix hebdomadaire le serveur est en pause : la carte de choix
		-- l'explique déjà, la barre n'affiche pas de pause en plus.
		fields = { "paused", "awaitingChoice" },
		apply = function(self, state)
			self:setPaused(state.paused == true and not state.awaitingChoice)
		end,
	},
	{
		-- La fin de partie retire l'aide ; seul l'état « over » compte ici.
		fields = { "over" },
		apply = function(self, state)
			if state.over then
				self:setHintShown(false)
			end
		end,
	},
}

-- Vrai si un champ de la liste diffère entre l'état reçu et le précédent.
local function anyChanged(state, previous, fields)
	for _, field in ipairs(fields) do
		if state[field] ~= previous[field] then
			return true
		end
	end
	return false
end

function HUD.new(callbacks)
	local self = setmetatable({}, HUD)
	self.callbacks = callbacks or {}
	self.tool = "build"
	self.toolButtons = {}
	self.mapName = ""
	self.speed = 1
	self.roundabouts = 0
	self.choiceWeek = nil
	self.choiceDismissedWeek = nil
	self.destroyed = false
	self:build()
	return self
end

function HUD:build()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "MM_HUD"
	-- Le HUD survit à la mort du personnage : une partie de gestion n'en dépend pas.
	gui.ResetOnSpawn = false
	-- La vue couvre tout l'écran, barre de Roblox comprise : AbsoluteSize et la
	-- taille de la caméra partagent alors la même origine, et les marges de
	-- getSafeInsets se transmettent telles quelles à CameraController. Le coin
	-- haut gauche reste libre pour le bouton de menu de Roblox, qui subsiste même
	-- quand les CoreGui sont masqués (Theme.Layout.TopLeftInset).
	gui.IgnoreGuiInset = true
	-- Au-dessus du menu d'accueil (20) : les deux ne sont jamais affichés ensemble.
	gui.DisplayOrder = 30
	-- Les éléments frères s'empilent selon leur ZIndex, puis leur ordre de création.
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false
	gui.Parent = playerGui
	self.gui = gui

	-- L'ordre de construction fixe l'ordre des enfants de gui, donc l'empilement
	-- des éléments de même ZIndex : il ne doit pas changer sans raison.
	self:buildTopBar()
	self:buildCounters()
	self:buildToast()
	self:buildHint()
	self:buildToolbar()
	self:buildOverlays()
	self:applyResponsive()
	self.sizeConnection = self.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:applyResponsive()
	end)
end

function HUD:showGame(data, map)
	self.gui.Enabled = true
	-- Une nouvelle partie réaffiche tous les champs au premier état reçu.
	self.applied = nil
	self.choiceWeek = nil
	self.choiceDismissedWeek = nil
	self:hideModals()
	self:clearToasts()
	self:resetTopBar()
	self:resetCounters()
	self.mapName = map and map.name or tostring(data.mapId)
	self:setTool("build")
	self:setSatisfaction(100)
	self:setSpeed(1)
	self:setRoundabouts(data.roundabouts or 0)
	self:applyResponsive()
	-- Le réglage « Astuces » survit à une nouvelle partie de la même session.
	self:flashHint()
end

function HUD:hide()
	self.gui.Enabled = false
end

-- Libère les connexions, les délais, les animations et l'interface. Sans effet
-- au second appel.
function HUD:destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	self:cancelHintTimer()
	self:clearToasts()
	if self.sizeConnection then
		self.sizeConnection:Disconnect()
		self.sizeConnection = nil
	end
	self:releaseOverlays()
	-- Les tweens de Theme encore en cours sur l'interface sont annulés : leur
	-- connexion de fin se libère avec eux.
	Theme.stopTweens(self.gui)
	for _, descendant in ipairs(self.gui:GetDescendants()) do
		Theme.stopTweens(descendant)
	end
	self.gui:Destroy()
end

function HUD:setState(state)
	if not state or self.destroyed then
		return
	end
	local previous = self.applied
	local first = previous == nil
	previous = previous or {}
	local snapshot = {}
	for _, update in ipairs(UPDATES) do
		local changed = first or anyChanged(state, previous, update.fields)
		for _, field in ipairs(update.fields) do
			snapshot[field] = state[field]
		end
		if changed then
			update.apply(self, state)
		end
	end
	self.applied = snapshot

	if state.choice
		and state.choice.options
		and state.choice.week ~= self.choiceDismissedWeek
		and not self.choiceOverlay.Visible
	then
		self:showWeekChoice(state.choice)
	end
end

-- Le rond-point n'est un outil que s'il en reste au moins un.
function HUD:setRoundabouts(value)
	self.roundabouts = tonumber(value) or 0
	local text = tostring(self.roundabouts)
	if self.roundaboutValue.Text ~= text then
		self.roundaboutValue.Text = text
	end
	self.toolButtons.roundabout.Visible = self.roundabouts > 0
	self:layoutToolPill()
	if self.tool == "roundabout" and self.roundabouts <= 0 then
		self:setTool("build")
		if self.callbacks.onToolChange then
			self.callbacks.onToolChange("build")
		end
	end
end

return HUD
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">HUDCounters</string>
              <ProtectedString name="Source"><![CDATA[--[[
	HUDCounters.luau
	Bas de l'écran : cinq pastilles identiques (routes, ponts, rond-points,
	maisons, destinations) et la ligne d'aide. Même hauteur, même arrondi, même
	case de pictogramme et même case de chiffre : seul le pictogramme change.
	Mixin : ajoute ses méthodes à HUD.
]]

local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.HUDIcons)

local L = Theme.Layout

-- Durée d'affichage de l'aide en bas de l'écran, en secondes.
local HINT_DURATION = 22
-- Aide au clavier et à la souris, ou au doigt (sans clavier : pas de clic droit,
-- de molette ni de touche Échap).
local HINT_DESKTOP =
	"Glissez pour tracer  ·  Échap pour annuler  ·  clic droit pour effacer  ·  molette pour zoomer  ·  clic milieu pour déplacer"
local HINT_TOUCH = "Glissez pour tracer  ·  pincez pour zoomer  ·  gomme et main : barre d'outils"

local ICON_SIZE = 20
local CHIP_PADDING = 8
local ICON_GAP = 4
-- Le chiffre occupe le reste de la pastille, après le pictogramme.
local NUMBER_X = CHIP_PADDING + ICON_SIZE + ICON_GAP
local NUMBER_WIDTH = L.ChipWidth - NUMBER_X - CHIP_PADDING + 2

-- Pastilles dans l'ordre d'affichage : nom, champ du HUD qui garde le chiffre,
-- pictogramme et sa couleur, texte avant le premier état serveur (tiret ASCII :
-- le tiret long n'est pas garanti dans la police Roblox). Le fond reste le même
-- pour toutes.
local CHIPS = {
	{ name = "roads", field = "budgetValue", icon = Icons.road, color = Theme.Ink, reset = "-" },
	{ name = "bridges", field = "bridgeValue", icon = Icons.bridge, color = Theme.Bridge, reset = "-" },
	{ name = "roundabouts", field = "roundaboutValue", icon = Icons.roundabout, color = Theme.TealDark, reset = "0" },
	{ name = "houses", field = "houseValue", icon = Icons.house, color = Theme.AccentWarm, reset = "-" },
	{ name = "destinations", field = "storeValue", icon = Icons.store, color = Theme.Ink, reset = "-" },
}

local function makeChip(parent, order, spec)
	local chip = Theme.panel(parent, {
		Name = spec.name,
		Size = UDim2.fromOffset(L.ChipWidth, L.ChipHeight),
		LayoutOrder = order,
		CornerRadius = Theme.Radius.Large,
		-- Active : un clic sur une pastille ne traverse pas l'interface.
		Active = true,
		ZIndex = 43,
	})
	Theme.stroke(chip, Theme.Border, Theme.Stroke.Thin, Theme.Stroke.Transparency)

	-- Case de pictogramme centrée verticalement, à gauche du chiffre.
	local slot = Theme.new("Frame", {
		Parent = chip,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, CHIP_PADDING, 0.5, 0),
		Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 44,
	})
	spec.icon(slot, spec.color)

	-- Chiffre centré dans sa case (Theme.numberLabel centre et borne la taille).
	local value = Theme.numberLabel(chip, "0", {
		Font = Theme.FontBlack,
		TextSize = 15,
		TextColor3 = Theme.Ink,
		ZIndex = 44,
	})
	value.AnchorPoint = Vector2.new(0, 0.5)
	value.Position = UDim2.new(0, NUMBER_X, 0.5, 0)
	value.Size = UDim2.new(0, NUMBER_WIDTH, 1, 0)
	return value
end

-- Écrit un texte seulement s'il change : aucun redessin inutile.
local function setText(label, text)
	if label.Text ~= text then
		label.Text = text
	end
end

return function(HUD)
	-- Compteurs de ressources, en bas au centre.
	function HUD:buildCounters()
		local width = L.ChipCount * L.ChipWidth + (L.ChipCount - 1) * L.ChipGap
		local resources = Theme.new("Frame", {
			Parent = self.gui,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -L.Margin),
			Size = UDim2.fromOffset(width, L.ChipHeight),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 42,
		})
		self.resources = resources
		local layout = Instance.new("UIListLayout")
		layout.FillDirection = Enum.FillDirection.Horizontal
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		layout.Padding = UDim.new(0, L.ChipGap)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = resources

		for order, spec in ipairs(CHIPS) do
			self[spec.field] = makeChip(resources, order, spec)
		end
	end

	-- Aide en bas, au-dessus des compteurs, masquée après quelques secondes.
	function HUD:buildHint()
		local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		self.hint = Theme.label(
			self.gui,
			touchOnly and HINT_TOUCH or HINT_DESKTOP,
			{
				Position = UDim2.new(0.5, 0, 1, -(L.Margin + L.ChipHeight + L.Gap)),
				AnchorPoint = Vector2.new(0.5, 1),
				Size = UDim2.new(0.9, 0, 0, L.HintHeight),
				TextSize = 12,
				TextColor3 = Theme.InkSoft,
				ZIndex = 42,
			}
		)
		Theme.textScaled(self.hint, 12, 7)
		Theme.maxSize(self.hint, 760, L.HintHeight)
		-- Visible par défaut, comme un Label neuf ; showGame relance le délai.
		self.hintShown = true
	end

	-- Affiche ou masque l'aide. Un redimensionnement ne la fait pas réapparaître
	-- après un masquage ; un écran court la masque aussi (voir applyResponsive).
	function HUD:setHintShown(shown)
		self.hintShown = shown
		self.hint.Visible = shown and not self:isShort()
	end

	function HUD:cancelHintTimer()
		if self.hintTimer then
			task.cancel(self.hintTimer)
			self.hintTimer = nil
		end
	end

	-- Montre l'aide si le réglage « Astuces » l'autorise, puis la retire seule.
	-- Un nouvel appel annule l'ancien délai : l'aide ne reste jamais figée.
	function HUD:flashHint()
		self:cancelHintTimer()
		local allowed = self.settings.hints ~= false
		self:setHintShown(allowed)
		if not allowed then
			return
		end
		self.hintTimer = task.delay(HINT_DURATION, function()
			self.hintTimer = nil
			self:setHintShown(false)
		end)
	end

	function HUD:resetCounters()
		for _, spec in ipairs(CHIPS) do
			setText(self[spec.field], spec.reset)
		end
	end

	-- Chaque chiffre vient de la charge serveur ; un champ absent se lit zéro.
	function HUD:updateCounters(state)
		setText(self.budgetValue, tostring(state.budget or 0))
		setText(self.bridgeValue, tostring(state.bridges or 0))
		setText(self.houseValue, tostring(state.houses or 0))
		setText(self.storeValue, tostring(state.destinations or 0))
	end
end
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">HUDIcons</string>
              <ProtectedString name="Source"><![CDATA[--[[
	HUDIcons.luau
	Pictogrammes dessinés avec des Frame et des UICorner (aucune image, aucun
	texte). Chaque fonction crée un carré centré dans le parent, de taille
	DEFAULT_SIZE px sauf indication contraire, et renvoie ce carré.

	Le dessin est exprimé sur une grille de 24 unités, en fractions du carré :
	il suit donc la taille demandée, et son centre tombe toujours au centre du
	carré. Tous les traits ont la même épaisseur (LINE unités, ou
	Theme.Stroke.Max px pour les contours) et des extrémités rondes.

	Paramètres optionnels : couleur (blanc par défaut, pour un fond sombre ou
	teinté ; passer Theme.Ink sur un fond clair) et taille du carré. La couleur
	d'une pastille « pont » est Theme.Bridge.
]]

local Theme = require(script.Parent.Theme)

local Icons = {}

-- Grille de dessin, en unités. Le centre est à CENTER.
local GRID = 24
local CENTER = GRID / 2
-- Épaisseur commune des traits, en unités (2 unités = 2 px au format 24 px).
local LINE = 2
-- Taille par défaut du carré d'un pictogramme, en pixels.
local DEFAULT_SIZE = 24

-- Position et taille en unités de grille, converties en fractions du carré.
local function at(x, y)
	return UDim2.fromScale(x / GRID, y / GRID)
end

local function span(width, height)
	return UDim2.fromScale(width / GRID, height / GRID)
end

-- Carré centré qui porte le pictogramme. Renvoie aussi la couleur retenue.
local function begin(parent, color, size)
	local canvas = Theme.new("Frame", {
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size or DEFAULT_SIZE, size or DEFAULT_SIZE),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	return canvas, color or Theme.White
end

-- Arrondi en fraction du petit côté : 0.5 donne des extrémités rondes.
local function round(frame, fraction)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(fraction or 0.5, 0)
	corner.Parent = frame
end

-- Trait plein centré en (x, y), tourné de rotation degrés. Un trait carré
-- devient un point.
local function bar(canvas, x, y, width, height, color, rotation, fraction)
	local frame = Theme.new("Frame", {
		Parent = canvas,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = at(x, y),
		Size = span(width, height),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Rotation = rotation or 0,
	})
	round(frame, fraction)
	return frame
end

-- Contour fin centré en (x, y) : un cadre sans fond, dont seul le trait est dessiné.
local function outline(canvas, x, y, width, height, color, fraction)
	local frame = Theme.new("Frame", {
		Parent = canvas,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = at(x, y),
		Size = span(width, height),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	round(frame, fraction)
	Theme.stroke(frame, color, Theme.Stroke.Max, 0)
	return frame
end

-- Crayon à 45 degrés : fût, gomme et pointe placés symétriquement autour du centre.
function Icons.pen(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	bar(canvas, CENTER, CENTER, 19, 6, ink, -45)
	bar(canvas, 18.7, 5.3, 5, 5, ink)
	bar(canvas, 5.3, 18.7, 5, 5, ink)
	return canvas
end

-- Poubelle : poignée, couvercle, corps et deux cannelures.
function Icons.trash(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	bar(canvas, CENTER, 4, 6, LINE, ink)
	bar(canvas, CENTER, 6.5, 16, LINE, ink)
	outline(canvas, CENTER, 15, 12, 12, ink, 0.2)
	bar(canvas, 10, 15, LINE, 6, ink)
	bar(canvas, 14, 15, LINE, 6, ink)
	return canvas
end

-- Rond-point : anneau, îlot central et quatre branches qui y entrent.
function Icons.roundabout(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	outline(canvas, CENTER, CENTER, 14, 14, ink)
	bar(canvas, CENTER, CENTER, 4, 4, ink)
	bar(canvas, CENTER, 2.5, LINE, 5, ink)
	bar(canvas, CENTER, 21.5, LINE, 5, ink)
	bar(canvas, 2.5, CENTER, 5, LINE, ink)
	bar(canvas, 21.5, CENTER, 5, LINE, ink)
	return canvas
end

-- Route : deux bords parallèles inclinés et une ligne centrale, vus de dessus.
function Icons.road(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	bar(canvas, 14.3, 15.3, 22, LINE, ink, -35)
	bar(canvas, 9.7, 8.7, 22, LINE, ink, -35)
	bar(canvas, CENTER, CENTER, 8, LINE, ink, -35)
	return canvas
end

-- Déplacement de la vue : croix à quatre pointes en losange.
function Icons.pan(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	bar(canvas, CENTER, CENTER, 18, LINE, ink)
	bar(canvas, CENTER, CENTER, LINE, 18, ink)
	bar(canvas, CENTER, 4, 5, 5, ink, 45, 0.2)
	bar(canvas, CENTER, 20, 5, 5, ink, 45, 0.2)
	bar(canvas, 4, CENTER, 5, 5, ink, 45, 0.2)
	bar(canvas, 20, CENTER, 5, 5, ink, 45, 0.2)
	return canvas
end

-- Retour : flèche pointant à gauche, un trait et deux ailes à 45 degrés. Dessinée
-- en Frame : le glyphe « ← » n'est pas garanti dans la police Roblox.
function Icons.back(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	bar(canvas, CENTER, CENTER, 16, LINE, ink)
	bar(canvas, 6.8, 9.2, 8, LINE, ink, -45)
	bar(canvas, 6.8, 14.8, 8, LINE, ink, 45)
	return canvas
end

-- Pont : tablier et deux pylônes, vus de côté.
function Icons.bridge(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	bar(canvas, CENTER, 14, 20, LINE, ink)
	bar(canvas, 7, CENTER, LINE, 16, ink)
	bar(canvas, 17, CENTER, LINE, 16, ink)
	return canvas
end

-- Lecture : triangle pointant à droite, fait de bandes qui raccourcissent vers les bords.
function Icons.play(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	for row = -2, 2 do
		local width = 14 * (3 - math.abs(row)) / 3
		bar(canvas, 6 + width / 2, CENTER + row * 3.6, width, 3.6, ink, 0, 0.2)
	end
	return canvas
end

-- Recommencer : anneau ouvert et pointe de flèche.
function Icons.reload(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	outline(canvas, CENTER, CENTER, 16, 16, ink)
	bar(canvas, 18.5, 5.5, 6, 6, ink, 45, 0.2)
	return canvas
end

-- Réglages : trois curseurs.
function Icons.sliders(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	for _, row in ipairs({ { y = 6, x = 15 }, { y = 12, x = 8 }, { y = 18, x = 16 } }) do
		bar(canvas, CENTER, row.y, 20, LINE, ink)
		bar(canvas, row.x, row.y, 6, 6, ink)
	end
	return canvas
end

-- Menu : trois barres.
function Icons.menu(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	for _, y in ipairs({ 6, 12, 18 }) do
		bar(canvas, CENTER, y, 16, LINE, ink)
	end
	return canvas
end

-- Circulation : trois petites voitures en file.
function Icons.cars(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	for _, x in ipairs({ 4.5, 12, 19.5 }) do
		bar(canvas, x, CENTER, 5, 9, ink, 0, 0.3)
	end
	return canvas
end

-- Pause : deux barres verticales aux bouts arrondis.
function Icons.pause(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	bar(canvas, 8.5, CENTER, 4, 14, ink, 0, 0.3)
	bar(canvas, 15.5, CENTER, 4, 14, ink, 0, 0.3)
	return canvas
end

-- Maison : petit carré arrondi vu de dessus, avec son faîtage.
function Icons.house(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	outline(canvas, CENTER, CENTER, 16, 16, ink, 0.2)
	bar(canvas, CENTER, CENTER, 8, LINE, ink)
	return canvas
end

-- Destination : disque plein, comme les magasins ronds vus de dessus.
function Icons.store(parent, color, size)
	local canvas, ink = begin(parent, color, size)
	bar(canvas, CENTER, CENTER, 16, 16, ink)
	return canvas
end

return Icons
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">HUDOverlays</string>
              <ProtectedString name="Source"><![CDATA[--[[
	HUDOverlays.luau
	Couches par-dessus la partie : toast en file, menu pause (avec paramètres),
	fin de partie et choix hebdomadaire. Une seule couche modale est ouverte à la
	fois : le menu pause et la fin de partie passent devant le choix, qui reste
	en attente et réapparaît à la reprise. Mixin : ajoute ses méthodes à HUD.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.HUDIcons)

-- Ordre d'empilement des couches (ZIndex) : le choix hebdomadaire passe au-dessus.
local Z_MODAL = 60
local Z_CHOICE = 70

local TOAST_DURATION = 3
-- File des toasts : au-delà, le plus ancien est abandonné pour rester à jour.
local TOAST_QUEUE_MAX = 3

-- Voile sombre léger derrière les cartes, et fondu d'apparition.
local OVERLAY_TRANSPARENCY = 0.18
local FADE_DURATION = Config.Style.Motion.Fast

-- Tailles des cartes. HUDResponsive met les cartes à l'échelle à partir des
-- mêmes valeurs : les modifier ici impose de les modifier là-bas aussi.
local PAUSE_SIZE = UDim2.fromOffset(420, 340)
local OVER_SIZE = UDim2.fromOffset(500, 430)
local CHOICE_SIZE = UDim2.fromOffset(660, 390)
local CARD_PADDING = 30
local CONTENT_Y = 108

local BUTTON_HEIGHT = 44
local MENU_ICON_SIZE = 20
-- Les voitures du circuit sont plus petites que les autres pictogrammes (cercle de 56 px).
local CARS_ICON_SIZE = 28
local BUTTON_GAP = 8
local OPTION_HEIGHT = 226
local OPTION_GAP = 16
-- Touches 1 à 3 pour choisir une amélioration (même ordre que l'affichage).
local OPTION_KEYS = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three }

local SWITCH_WIDTH = 44
local SWITCH_HEIGHT = 24
local KNOB_SIZE = 18
local KNOB_OFF = UDim2.new(0, 3, 0.5, 0)
local KNOB_ON = UDim2.new(0, SWITCH_WIDTH - KNOB_SIZE - 3, 0.5, 0)

-- Réglages du menu : nom transmis à onSetting, libellé affiché.
local SETTINGS_ROWS = {
	{ "grid", "Grille visible" },
	{ "hints", "Astuces" },
}

-- Statistiques principales de la fin de partie (clé de data.stats, libellé).
-- Une ligne n'est créée que si la donnée existe.
local STAT_ROWS = {
	{ "deliveries", "Trajets livrés" },
	{ "demandsServed", "Demandes servies" },
	{ "storesSpawned", "Magasins ouverts" },
	{ "housesSpawned", "Maisons apparues" },
	{ "roadsBuilt", "Routes posées" },
	{ "weeksCompleted", "Semaines terminées" },
}

-- Valeur numérique sûre : nil, NaN et infini donnent la valeur de repli.
local function numberOr(value, fallback)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return fallback
	end
	return value
end

local function textOr(value, fallback)
	if type(value) == "string" and value ~= "" then
		return value
	end
	return fallback
end

-- Entier avec espaces de milliers : 1 234 567.
local function formatNumber(value)
	local n = math.floor(numberOr(value, 0))
	local sign = ""
	if n < 0 then
		sign = "-"
		n = -n
	end
	local digits = tostring(n)
	local groups = ""
	while #digits > 3 do
		groups = " " .. string.sub(digits, -3) .. groups
		digits = string.sub(digits, 1, -4)
	end
	return sign .. digits .. groups
end

-- Durée mm:ss. Les minutes ne se bornent pas à 59 : 3600 s donnent 60:00.
local function formatDuration(seconds)
	local total = math.max(0, math.floor(numberOr(seconds, 0)))
	return string.format("%02d:%02d", math.floor(total / 60), total % 60)
end

-- Phrase lisible pour la raison de fin de partie ; nil si la raison est inconnue.
local function reasonText(data)
	local overload = type(data.overload) == "table" and data.overload or nil
	local reason = textOr(data.reason, nil)
	if reason == nil and overload then
		reason = "overload"
	end
	if reason == "overload" then
		local name = overload and textOr(overload.colorName, nil)
		if name then
			return "Le magasin " .. name .. " est resté trop longtemps surchargé."
		end
		return "Un magasin est resté trop longtemps surchargé."
	elseif reason == "traffic" then
		return "Les voitures sont restées bloquées trop longtemps."
	elseif reason == "satisfaction" then
		return "Les habitants ne sont plus satisfaits."
	end
	return nil
end

-- Garde les options exploitables : une table avec un identifiant à renvoyer.
local function sanitizeOptions(list)
	local options: { any } = {}
	if type(list) ~= "table" then
		return options
	end
	for _, option in ipairs(list) do
		if type(option) == "table" and option.id ~= nil then
			table.insert(options, option)
		end
	end
	return options
end

local function newOverlay(gui, zIndex)
	return Theme.new("Frame", {
		Parent = gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = OVERLAY_TRANSPARENCY,
		BorderSizePixel = 0,
		Visible = false,
		Active = true,
		ZIndex = zIndex,
	})
end

-- Carte centrée ; son UIScale permet de la réduire sur petit écran.
local function newCard(overlay, size, zIndex)
	local card = Theme.new("Frame", {
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		ZIndex = zIndex,
	})
	Theme.corner(card, Theme.Radius.Large)
	Theme.stroke(card, Theme.Border, Theme.Stroke.Max, 0.1)
	local scale = Instance.new("UIScale")
	scale.Parent = card
	return card, scale
end

-- Une couche s'ouvre par un court fondu ; ouvrir une couche déjà visible ne la
-- rejoue pas.
local function openOverlay(overlay)
	if overlay.Visible then
		return
	end
	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	Theme.tween(overlay, { BackgroundTransparency = OVERLAY_TRANSPARENCY }, "fade", FADE_DURATION)
end

local function closeOverlay(overlay)
	Theme.stopTweens(overlay)
	-- Les boutons cachés avec la couche ne doivent pas rouvrir en état de survol.
	Theme.resetHover(overlay)
	overlay.Visible = false
	overlay.BackgroundTransparency = OVERLAY_TRANSPARENCY
end

local function newOptionLayout(parent)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, OPTION_GAP)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = parent
	return layout
end

local function menuButton(parent, order, text, primary, icon, onClick)
	local button = Theme.button(parent, text, {
		Size = UDim2.new(1, 0, 0, BUTTON_HEIGHT),
		LayoutOrder = order,
		BackgroundColor3 = primary and Theme.Teal or Theme.PanelSoft,
		TextColor3 = Theme.Ink,
		TextSize = 18,
		CornerRadius = Theme.Radius.Medium,
		ZIndex = 62,
	}, onClick)
	-- Pictogramme à gauche du libellé, centré verticalement.
	local canvas = icon(button, Theme.Ink, MENU_ICON_SIZE)
	canvas.AnchorPoint = Vector2.new(0, 0.5)
	canvas.Position = UDim2.new(0, 16, 0.5, 0)
	Theme.motion(button)
	return button
end

local function actionButton(parent, text, position, size, primary, onClick)
	local button = Theme.button(parent, text, {
		Position = position,
		Size = size,
		BackgroundColor3 = primary and Theme.Teal or Theme.PanelSoft,
		TextColor3 = Theme.Ink,
		TextSize = 18,
		CornerRadius = Theme.Radius.Medium,
		ZIndex = 62,
	}, onClick)
	Theme.motion(button)
	return button
end

-- Page du menu (boutons empilés) ou page des réglages : une seule est visible.
local function showPausePage(self, page)
	local onSettings = page == "settings"
	self.pauseMenuPage.Visible = not onSettings
	self.pauseSettingsPage.Visible = onSettings
	self.pauseTitle.Text = onSettings and "Paramètres" or "Pause"
	self.pauseCaption.Text = onSettings and "Réglages conservés pendant cette session." or "La partie est en pause."
end

-- Interrupteur à jour. Un changement s'anime ; l'état initial s'affiche sans fondu.
local function paintSwitch(self, name, instant)
	local view = self.switchViews[name]
	if not view then
		return
	end
	local on = self.settings[name] == true
	local color = on and Theme.Teal or Theme.Border
	local knob = on and KNOB_ON or KNOB_OFF
	if instant then
		Theme.stopTweens(view.track)
		Theme.stopTweens(view.knob)
		view.track.BackgroundColor3 = color
		view.knob.Position = knob
	else
		Theme.tween(view.track, { BackgroundColor3 = color }, "color", FADE_DURATION)
		Theme.tween(view.knob, { Position = knob }, "knob", FADE_DURATION)
	end
end

-- Un réglage changé est transmis au jeu. « Astuces » est appliqué ici : coupé,
-- l'aide disparaît tout de suite ; rallumé, elle réapparaît avec son délai
-- d'extinction (jamais figée).
local function applySetting(self, name, value)
	if name == "hints" then
		if value then
			self:flashHint()
		else
			self:cancelHintTimer()
			self:setHintShown(false)
		end
	end
	if self.callbacks.onSetting then
		self.callbacks.onSetting(name, value)
	end
end

-- Ligne cliquable entière : libellé à gauche, interrupteur à droite.
local function buildSwitchRow(self, page, index, name, label)
	local row = Theme.button(page, "", {
		Position = UDim2.fromOffset(CARD_PADDING, CONTENT_Y + (index - 1) * (BUTTON_HEIGHT + BUTTON_GAP)),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, BUTTON_HEIGHT),
		BackgroundTransparency = 1,
		ZIndex = 62,
	}, function()
		self.settings[name] = not self.settings[name]
		paintSwitch(self, name, false)
		applySetting(self, name, self.settings[name])
	end)
	Theme.label(row, label, {
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -80, 1, 0),
		Font = Theme.FontBold,
		TextSize = 16,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 63,
	})
	local track = Theme.new("Frame", {
		Parent = row,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -4, 0.5, 0),
		Size = UDim2.fromOffset(SWITCH_WIDTH, SWITCH_HEIGHT),
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		ZIndex = 63,
	})
	Theme.corner(track, Theme.Radius.Pill)
	local knob = Theme.circle(track, KNOB_SIZE, Theme.White, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = KNOB_OFF,
		ZIndex = 64,
	})
	self.switchViews[name] = { track = track, knob = knob }
	paintSwitch(self, name, true)
end

local function resumePause(self)
	-- Une reprise ne compte qu'une fois : le menu doit être ouvert.
	if not self.pauseOverlay.Visible then
		return
	end
	self:hidePause()
	if self.callbacks.onResume then
		self.callbacks.onResume()
	end
end

local function buildPauseOverlay(self)
	local overlay = newOverlay(self.gui, Z_MODAL)
	self.pauseOverlay = overlay
	local card, scale = newCard(overlay, PAUSE_SIZE, Z_MODAL + 1)
	self.pauseCard = card
	self.pauseScale = scale

	self.pauseTitle = Theme.label(card, "Pause", {
		Position = UDim2.fromOffset(CARD_PADDING, 24),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, 42),
		Font = Theme.FontBlack,
		TextSize = 32,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 62,
	})
	self.pauseCaption = Theme.label(card, "", {
		Position = UDim2.fromOffset(CARD_PADDING, 68),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, 24),
		TextSize = 14,
		TextColor3 = Theme.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 62,
	})

	-- Page du menu : la liste empile les boutons, un bouton masqué ne laisse pas de trou.
	local menuPage = Theme.new("Frame", {
		Parent = card,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 62,
	})
	self.pauseMenuPage = menuPage
	local list = Theme.new("Frame", {
		Parent = menuPage,
		Position = UDim2.fromOffset(CARD_PADDING, CONTENT_Y),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, 4 * BUTTON_HEIGHT + 3 * BUTTON_GAP),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 62,
	})
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, BUTTON_GAP)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = list

	menuButton(list, 1, "Reprendre", true, Icons.play, function()
		resumePause(self)
	end)
	-- Le menu ne se ferme qu'à GameStarted : si le serveur refuse la demande (limite
	-- de débit), la partie reste en pause et le menu reste ouvert pour réessayer.
	self.restartButton = menuButton(list, 2, "Recommencer", false, Icons.reload, function()
		if self.callbacks.onRestart then
			self.callbacks.onRestart()
		end
	end)
	menuButton(list, 3, "Paramètres", false, Icons.sliders, function()
		showPausePage(self, "settings")
	end)
	menuButton(list, 4, "Menu principal", false, Icons.menu, function()
		self:hideModals()
		if self.callbacks.onMenu then
			self.callbacks.onMenu()
		end
	end)

	-- Page des réglages : un interrupteur par réglage, puis le retour.
	local settingsPage = Theme.new("Frame", {
		Parent = card,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 62,
	})
	self.pauseSettingsPage = settingsPage
	for index, row in ipairs(SETTINGS_ROWS) do
		buildSwitchRow(self, settingsPage, index, row[1], row[2])
	end
	actionButton(
		settingsPage,
		"Retour",
		UDim2.fromOffset(CARD_PADDING, CONTENT_Y + #SETTINGS_ROWS * (BUTTON_HEIGHT + BUTTON_GAP)),
		UDim2.new(1, -2 * CARD_PADDING, 0, BUTTON_HEIGHT),
		false,
		function()
			showPausePage(self, "menu")
		end
	)

	showPausePage(self, "menu")
end

-- Vide la liste des statistiques et la reconstruit avec les lignes présentes.
local function rebuildStats(self, stats)
	for _, tile in ipairs(self.statTiles) do
		tile:Destroy()
	end
	table.clear(self.statTiles)
	if type(stats) ~= "table" then
		return
	end
	for index, row in ipairs(STAT_ROWS) do
		local value = numberOr(stats[row[1]], nil)
		if value ~= nil then
			local tile = Theme.new("Frame", {
				Parent = self.statGrid,
				BackgroundColor3 = Theme.PanelSoft,
				BorderSizePixel = 0,
				LayoutOrder = index,
				ZIndex = 62,
			})
			Theme.corner(tile, Theme.Radius.Medium)
			Theme.label(tile, formatNumber(value), {
				Position = UDim2.fromOffset(10, 4),
				Size = UDim2.new(1, -20, 0, 24),
				Font = Theme.FontBlack,
				TextSize = 20,
				TextColor3 = Theme.Ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 63,
			})
			Theme.label(tile, row[2], {
				Position = UDim2.fromOffset(10, 28),
				Size = UDim2.new(1, -20, 0, 18),
				TextSize = 11,
				TextColor3 = Theme.InkSoft,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 63,
			})
			table.insert(self.statTiles, tile)
		end
	end
end

local function buildGameOverOverlay(self)
	local overlay = newOverlay(self.gui, Z_MODAL)
	self.overOverlay = overlay
	local card, scale = newCard(overlay, OVER_SIZE, Z_MODAL + 1)
	self.overCard = card
	self.overScale = scale

	Theme.label(card, "Partie terminée", {
		Position = UDim2.fromOffset(CARD_PADDING, 22),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, 40),
		Font = Theme.FontBlack,
		TextSize = 30,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 62,
	})
	self.finalMap = Theme.label(card, "", {
		Position = UDim2.fromOffset(CARD_PADDING, 62),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, 22),
		TextSize = 14,
		TextColor3 = Theme.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 62,
	})

	Theme.label(card, "SCORE", {
		Position = UDim2.fromOffset(CARD_PADDING, 96),
		Size = UDim2.fromOffset(220, 20),
		TextSize = 11,
		Font = Theme.FontBold,
		TextColor3 = Theme.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 62,
	})
	self.finalScore = Theme.label(card, "0", {
		Position = UDim2.fromOffset(CARD_PADDING, 112),
		Size = UDim2.fromOffset(240, 60),
		Font = Theme.FontBlack,
		TextSize = 50,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 62,
	})
	-- Un score à sept chiffres ou plus déborderait de la case : le texte se réduit.
	Theme.textScaled(self.finalScore, 50, 24)
	self.finalDuration = Theme.label(card, "", {
		Position = UDim2.fromOffset(280, 96),
		Size = UDim2.fromOffset(190, 20),
		TextSize = 14,
		TextColor3 = Theme.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 62,
	})
	-- Meilleur score, ou marque « Nouveau record » sur une pastille.
	self.finalBest = Theme.label(card, "", {
		Position = UDim2.fromOffset(300, 130),
		Size = UDim2.fromOffset(170, 30),
		Font = Theme.FontBold,
		TextSize = 15,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 62,
	})
	Theme.corner(self.finalBest, Theme.Radius.Pill)

	self.finalWeek = Theme.label(card, "", {
		Position = UDim2.fromOffset(CARD_PADDING, 176),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, 20),
		TextSize = 13,
		TextColor3 = Theme.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 62,
	})
	self.finalReason = Theme.label(card, "", {
		Position = UDim2.fromOffset(CARD_PADDING, 198),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, 20),
		TextSize = 13,
		TextColor3 = Theme.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 62,
	})

	Theme.new("Frame", {
		Parent = card,
		Position = UDim2.fromOffset(CARD_PADDING, 222),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, 1),
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		ZIndex = 62,
	})

	-- Grille des statistiques : trois colonnes, les lignes absentes ne laissent pas de case.
	self.statGrid = Theme.new("Frame", {
		Parent = card,
		Position = UDim2.fromOffset(CARD_PADDING, 232),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, 110),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 62,
	})
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(140, 50)
	grid.CellPadding = UDim2.fromOffset(10, 10)
	grid.FillDirectionMaxCells = 3
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = self.statGrid
	self.statTiles = {}

	self.overRestart = actionButton(
		card,
		"Rejouer",
		UDim2.fromOffset(CARD_PADDING, 356),
		UDim2.fromOffset(212, BUTTON_HEIGHT + 2),
		true,
		function()
			-- Même règle que « Recommencer » : la carte reste jusqu'à GameStarted.
			if self.callbacks.onRestart then
				self.callbacks.onRestart()
			end
		end
	)
	self.overMenu = actionButton(
		card,
		"Menu principal",
		UDim2.fromOffset(OVER_SIZE.X.Offset - CARD_PADDING - 212, 356),
		UDim2.fromOffset(212, BUTTON_HEIGHT + 2),
		false,
		function()
			self:hideModals()
			if self.callbacks.onMenu then
				self.callbacks.onMenu()
			end
		end
	)
end

-- Couleur d'accent d'une amélioration : le circuit a la sienne, les autres suivent leur type.
local function optionColor(option)
	if option.trafficFactor then
		return Theme.AccentWarm
	end
	if option.kind == "roads" then
		return Theme.PanelDark
	end
	if option.kind == "bridges" then
		return Theme.Bridge
	end
	return Theme.TealDark
end

-- Pictogramme d'une amélioration, blanc sur la pastille teintée (le circuit,
-- sur fond chaud, est dessiné en encre).
local function drawOptionIcon(circle, option)
	if option.trafficFactor then
		Icons.cars(circle, Theme.Ink, CARS_ICON_SIZE)
	elseif option.kind == "roads" then
		Icons.road(circle, Theme.White)
	elseif option.kind == "bridges" then
		Icons.bridge(circle, Theme.White)
	else
		Icons.roundabout(circle, Theme.White)
	end
end

local function clearChoiceCards(self)
	for _, connection in ipairs(self.choiceConnections) do
		connection:Disconnect()
	end
	table.clear(self.choiceConnections)
	for _, child in ipairs(self.choiceOptions:GetChildren()) do
		if not child:IsA("UIListLayout") then
			-- Le survol d'une carte anime sa sélection : on coupe ces tweens avant
			-- de détruire la carte et ses descendants.
			Theme.stopTweens(child)
			for _, descendant in ipairs(child:GetDescendants()) do
				Theme.stopTweens(descendant)
			end
			child:Destroy()
		end
	end
end

-- Choisit une amélioration : une seule fois, puis la carte se ferme.
local function chooseOption(self, option)
	if not self.choiceOverlay.Visible then
		return
	end
	self.choiceDismissedWeek = self.choiceWeek
	self.choicePending = nil
	closeOverlay(self.choiceOverlay)
	if self.callbacks.onChooseReward then
		self.callbacks.onChooseReward(option.id)
	end
end

local function buildOptionCard(self, option, index, count)
	local card = Theme.new("Frame", {
		Parent = self.choiceOptions,
		Size = UDim2.new(1 / count, -math.ceil(OPTION_GAP * (count - 1) / count), 0, OPTION_HEIGHT),
		BackgroundColor3 = Theme.PanelSoft,
		BorderSizePixel = 0,
		LayoutOrder = index,
		ZIndex = 73,
	})
	Theme.corner(card, Theme.Radius.Large)
	Theme.stroke(card, Theme.Border, Theme.Stroke.Thin, Theme.Stroke.Transparency)

	-- Numéro de la touche (1, 2, 3) dans le coin.
	local badge = Theme.pill(card, tostring(index), {
		Size = UDim2.fromOffset(22, 22),
		TextSize = 12,
		TextColor3 = Theme.InkSoft,
		ZIndex = 74,
	})
	badge.AnchorPoint = Vector2.new(0, 0)
	badge.Position = UDim2.fromOffset(10, 10)

	local circle = Theme.circle(card, 56, optionColor(option), {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 20),
		ZIndex = 74,
	})
	drawOptionIcon(circle, option)

	local title = Theme.label(card, textOr(option.title, "Amélioration"), {
		Position = UDim2.new(0, 12, 0, 86),
		Size = UDim2.new(1, -24, 0, 40),
		Font = Theme.FontBlack,
		TextColor3 = Theme.Ink,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 74,
	})
	Theme.textScaled(title, 18, 11)

	local description = Theme.label(card, textOr(option.description, ""), {
		Position = UDim2.new(0, 12, 0, 130),
		Size = UDim2.new(1, -24, 0, 46),
		TextSize = 12,
		TextColor3 = Theme.InkSoft,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 74,
	})
	Theme.textScaled(description, 12, 9)

	-- Montant de la ressource, en pastille sous la description.
	local amount = numberOr(option.roads, numberOr(option.amount, 0))
	local amountLabel = Theme.pill(card, "+" .. formatNumber(amount) .. " routes", {
		Size = UDim2.fromOffset(120, 24),
		TextSize = 12,
		TextColor3 = Theme.Ink,
		BackgroundColor3 = Theme.Panel,
		ZIndex = 74,
	})
	amountLabel.AnchorPoint = Vector2.new(0.5, 1)
	amountLabel.Position = UDim2.new(0.5, 0, 1, -12)

	-- Zone cliquable couvrant la carte ; le survol la met en avant.
	local hit = Theme.new("TextButton", {
		Parent = card,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Active = true,
		Selectable = true,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		ZIndex = 76,
	})
	local connections = self.choiceConnections
	table.insert(connections, hit.MouseEnter:Connect(function()
		Theme.setSelected(card, true)
	end))
	table.insert(connections, hit.MouseLeave:Connect(function()
		Theme.setSelected(card, false)
	end))
	local function choose()
		chooseOption(self, option)
	end
	-- Activated couvre souris, tactile et manette.
	table.insert(connections, hit.Activated:Connect(choose))
end

local function showChoiceNow(self)
	local pending = self.choicePending
	if not pending then
		return
	end
	self.choiceTitle.Text = type(pending.week) == "number" and ("Semaine " .. tostring(pending.week)) or "Nouvelle amélioration"
	clearChoiceCards(self)
	self.choiceOptionList = pending.options
	for index, option in ipairs(pending.options) do
		buildOptionCard(self, option, index, #pending.options)
	end
	openOverlay(self.choiceOverlay)
end

-- Rouvre le choix mis en attente quand aucune autre couche ne le recouvre.
local function restoreChoice(self)
	if self.choicePending and not self.pauseOverlay.Visible and not self.overOverlay.Visible then
		showChoiceNow(self)
	end
end

local function buildWeekChoiceOverlay(self)
	local overlay = newOverlay(self.gui, Z_CHOICE)
	self.choiceOverlay = overlay
	local card, scale = newCard(overlay, CHOICE_SIZE, Z_CHOICE + 1)
	self.choiceCard = card
	self.choiceScale = scale

	self.choiceTitle = Theme.label(card, "", {
		Position = UDim2.fromOffset(CARD_PADDING, 22),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, 38),
		Font = Theme.FontBlack,
		TextSize = 30,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 72,
	})
	Theme.label(card, "Choisissez une amélioration pour continuer.", {
		Position = UDim2.fromOffset(CARD_PADDING, 62),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, 24),
		TextSize = 14,
		TextColor3 = Theme.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 72,
	})

	local options = Theme.new("Frame", {
		Parent = card,
		Position = UDim2.fromOffset(CARD_PADDING, 106),
		Size = UDim2.new(1, -2 * CARD_PADDING, 0, OPTION_HEIGHT),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 72,
	})
	self.choiceOptions = options
	newOptionLayout(options)
end

-- Notification bref, en file : un message à la fois, chacun reste TOAST_DURATION s.
local function showNextToast(self)
	local message = table.remove(self.toastQueue, 1)
	if not message then
		self.toastShowing = false
		return
	end
	self.toastShowing = true
	self.toastLabel.Text = message
	self.toastLabel.Visible = true
	self.toastTimer = task.delay(TOAST_DURATION, function()
		self.toastTimer = nil
		self.toastLabel.Visible = false
		showNextToast(self)
	end)
end

return function(HUD)
	function HUD:buildToast()
		self.toastLabel = Theme.label(self.gui, "", {
			Position = UDim2.fromScale(0.5, 0.12),
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.new(0.7, 0, 0, 34),
			BackgroundColor3 = Theme.Panel,
			BackgroundTransparency = 0.08,
			TextSize = 13,
			TextColor3 = Theme.Ink,
			Visible = false,
			ZIndex = 55,
		})
		Theme.corner(self.toastLabel, Theme.Radius.Pill)
		Theme.textScaled(self.toastLabel, 13, 8)
		Theme.maxSize(self.toastLabel, 560, 34)
		self.toastQueue = {}
		self.toastShowing = false
	end

	function HUD:buildOverlays()
		-- Réglages de la session : gardés dans l'objet HUD, pas dans le stockage du navigateur.
		-- Grille : par défaut elle suit l'outil (visible en construction) ; épinglée, elle reste visible.
		self.settings = { grid = false, hints = true }
		self.switchViews = {}
		self.statTiles = {}
		self.choiceConnections = {}
		self.choiceOptionList = {}
		self.choicePending = nil

		buildPauseOverlay(self)
		buildGameOverOverlay(self)
		buildWeekChoiceOverlay(self)

		-- Échap ferme le menu pause (ou revient du réglage) ; 1 à 3 choisissent une amélioration.
		self.overlayInput = UserInputService.InputBegan:Connect(function(input, processed)
			if input.KeyCode == Enum.KeyCode.Escape then
				if self.pauseOverlay.Visible then
					if self.pauseSettingsPage.Visible then
						showPausePage(self, "menu")
					else
						resumePause(self)
					end
				end
				return
			end
			if processed or not self.choiceOverlay.Visible then
				return
			end
			for index, key in ipairs(OPTION_KEYS) do
				if input.KeyCode == key then
					local option = self.choiceOptionList[index]
					if option then
						chooseOption(self, option)
					end
					return
				end
			end
		end)
	end

	-- Menu pause : seulement si la fin de partie n'est pas affichée.
	function HUD:showPause()
		if self.pauseOverlay.Visible or self.overOverlay.Visible then
			return
		end
		-- Le choix hebdomadaire reste en attente et réapparaît à la reprise.
		closeOverlay(self.choiceOverlay)
		showPausePage(self, "menu")
		paintSwitch(self, "grid", true)
		paintSwitch(self, "hints", true)
		self.restartButton.Visible = self.callbacks.onRestart and true or false
		openOverlay(self.pauseOverlay)
		self:setPaused(true)
	end

	function HUD:hidePause()
		closeOverlay(self.pauseOverlay)
		showPausePage(self, "menu")
		self:setPaused(false)
		restoreChoice(self)
	end

	-- Libère les connexions globales et celles des cartes de choix (appelé par HUD:destroy).
	function HUD:releaseOverlays()
		if self.overlayInput then
			self.overlayInput:Disconnect()
			self.overlayInput = nil
		end
		for _, connection in ipairs(self.choiceConnections) do
			connection:Disconnect()
		end
		table.clear(self.choiceConnections)
	end

	-- Permet à la touche P de reprendre si le menu est déjà ouvert, sans rouvrir la pause.
	function HUD:isPauseOpen()
		return self.pauseOverlay.Visible
	end

	function HUD:isGameOverOpen()
		return self.overOverlay.Visible
	end

	-- Vrai si le choix hebdomadaire est affiché : les commandes de la carte restent coupées.
	function HUD:isChoiceOpen()
		return self.choiceOverlay.Visible
	end

	-- Valeur d'un réglage de la session (« grid », « hints »).
	function HUD:getSetting(name)
		return self.settings[name] == true
	end

	function HUD:showGameOver(data)
		if type(data) ~= "table" then
			data = {}
		end
		-- La fin de partie annule le choix en attente et les autres couches.
		self.choicePending = nil
		closeOverlay(self.choiceOverlay)
		closeOverlay(self.pauseOverlay)
		showPausePage(self, "menu")
		self.controls.Visible = false
		self:cancelHintTimer()
		self:setHintShown(false)

		self.finalMap.Text = self.mapName or ""
		local score = numberOr(data.score, 0)
		local best = numberOr(data.best, 0)
		self.finalScore.Text = formatNumber(score)
		if score > 0 and score >= best then
			self.finalBest.Text = "Nouveau record !"
			self.finalBest.BackgroundTransparency = 0
			self.finalBest.BackgroundColor3 = Theme.Orange
			self.finalBest.TextColor3 = Theme.Ink
		else
			self.finalBest.Text = "Meilleur : " .. formatNumber(best)
			self.finalBest.BackgroundTransparency = 1
			self.finalBest.TextColor3 = Theme.InkSoft
		end
		self.finalDuration.Text = "Durée " .. formatDuration(data.durationSeconds)

		local parts: { string } = {}
		local week = numberOr(data.week, nil)
		if week then
			table.insert(parts, "Semaine " .. formatNumber(week))
		end
		local day = numberOr(data.day, nil)
		local monthName = textOr(data.monthName, nil)
		if day then
			table.insert(parts, "Jour " .. formatNumber(day) .. (monthName and (" · " .. monthName) or ""))
		end
		self.finalWeek.Text = table.concat(parts, "  ·  ")

		local reason = reasonText(data)
		self.finalReason.Text = reason or ""
		self.finalReason.Visible = reason ~= nil

		rebuildStats(self, data.stats)
		self.overRestart.Visible = self.callbacks.onRestart and true or false
		self.overMenu.Visible = self.callbacks.onMenu and true or false
		openOverlay(self.overOverlay)
	end

	-- Choix hebdomadaire : une demande incomplète est ignorée, sans bloquer la partie.
	function HUD:showWeekChoice(data)
		if type(data) ~= "table" then
			return
		end
		local options = sanitizeOptions(data.options)
		if #options == 0 then
			return
		end
		if self.choiceOverlay.Visible and self.choiceWeek == data.week then
			return
		end
		self.choiceWeek = data.week
		self.choicePending = { week = data.week, options = options }
		-- Une autre couche est ouverte : le choix attend sa fermeture.
		if self.pauseOverlay.Visible or self.overOverlay.Visible then
			return
		end
		showChoiceNow(self)
	end

	function HUD:hideWeekChoice()
		self.choiceDismissedWeek = self.choiceWeek
		self.choicePending = nil
		closeOverlay(self.choiceOverlay)
	end

	-- Ferme toutes les couches et remet le menu pause sur sa page d'accueil.
	function HUD:hideModals()
		self.choicePending = nil
		closeOverlay(self.pauseOverlay)
		closeOverlay(self.overOverlay)
		closeOverlay(self.choiceOverlay)
		showPausePage(self, "menu")
	end

	-- Vide la file et retire le message affiché (nouvelle partie, destruction).
	function HUD:clearToasts()
		if self.toastTimer then
			task.cancel(self.toastTimer)
			self.toastTimer = nil
		end
		table.clear(self.toastQueue)
		self.toastShowing = false
		self.toastLabel.Visible = false
	end

	-- Message bref. Les messages s'enchaînent sans se superposer ; au-delà de la
	-- file, le plus ancien est abandonné.
	function HUD:toast(text)
		local message = textOr(text, nil)
		if not message or self.destroyed then
			return
		end
		if #self.toastQueue >= TOAST_QUEUE_MAX then
			table.remove(self.toastQueue, 1)
		end
		table.insert(self.toastQueue, message)
		if not self.toastShowing then
			showNextToast(self)
		end
	end
end
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">HUDResponsive</string>
              <ProtectedString name="Source"><![CDATA[--[[
	HUDResponsive.luau
	Seul endroit qui connaît les points de rupture : format portrait (téléphone)
	ou paysage, écran court, et la mise à l'échelle des cartes modales.
	Mixin : ajoute isPortrait, isShort, applyResponsive et getSafeInsets à HUD.
]]

local Theme = require(script.Parent.Theme)

local L = Theme.Layout

-- Largeur sous laquelle l'écran est traité comme un téléphone.
local PORTRAIT_WIDTH = 760
local PORTRAIT_RATIO = 0.9
-- Hauteur sous laquelle la ligne d'aide est masquée et les outils passent en bandeau.
local SHORT_HEIGHT = 700
-- Fraction de l'écran qu'une carte modale peut occuper.
local MODAL_WIDTH_RATIO = 0.92
local MODAL_HEIGHT_RATIO = 0.9
local MIN_MODAL_SCALE = 0.35

local function fitScale(width, height, cardWidth, cardHeight)
	return math.max(
		MIN_MODAL_SCALE,
		math.min(1, (width * MODAL_WIDTH_RATIO) / cardWidth, (height * MODAL_HEIGHT_RATIO) / cardHeight)
	)
end

-- Rectangle absolu (x, y, largeur, hauteur) d'un enfant direct de l'interface,
-- calculé comme le moteur : position en échelle et décalage, moins AnchorPoint.
local function rectOf(frame, width, height)
	local size = frame.Size
	local position = frame.Position
	local anchor = frame.AnchorPoint
	local w = width * size.X.Scale + size.X.Offset
	local h = height * size.Y.Scale + size.Y.Offset
	local x = width * position.X.Scale + position.X.Offset - anchor.X * w
	local y = height * position.Y.Scale + position.Y.Offset - anchor.Y * h
	return x, y, w, h
end

return function(HUD)
	function HUD:isPortrait()
		local size = self.gui.AbsoluteSize
		return size.X < PORTRAIT_WIDTH or size.X < size.Y * PORTRAIT_RATIO
	end

	function HUD:isShort()
		return self.gui.AbsoluteSize.Y < SHORT_HEIGHT
	end

	-- La barre du haut et les compteurs ont la même mise en page partout (voir
	-- Theme.Layout) : seuls les outils, l'aide, le toast et l'échelle des cartes
	-- dépendent du format.
	function HUD:applyResponsive()
		local viewport = self.gui.AbsoluteSize
		local width = viewport.X
		local height = viewport.Y
		if width < 2 or height < 2 then
			return
		end

		local portrait = self:isPortrait()
		self.hint.Visible = self.hintShown and not self:isShort()
		self:layoutToolPill()

		-- Le toast passe sous la rangée des contrôles du temps : il ne touche ni la
		-- jauge (même rangée, à gauche) ni le score, quel que soit le format.
		local toastY = L.Margin + L.PanelHeight + L.Gap + L.ControlsHeight + L.Gap
		self.toastLabel.Position = UDim2.new(0.5, 0, 0, toastY)
		self.toastLabel.Size = UDim2.new(portrait and 0.9 or 0.6, 0, 0, L.ControlsHeight - 2)

		-- Les cartes gardent leur taille de conception (HUDOverlays) ; l'échelle s'y applique.
		self.pauseScale.Scale = fitScale(width, height, self.pauseCard.Size.X.Offset, self.pauseCard.Size.Y.Offset)
		self.overScale.Scale = fitScale(width, height, self.overCard.Size.X.Offset, self.overCard.Size.Y.Offset)
		self.choiceScale.Scale = fitScale(width, height, self.choiceCard.Size.X.Offset, self.choiceCard.Size.Y.Offset)
	end

	-- Marges couvertes par l'interface, en pixels, dans l'ordre haut, droite,
	-- bas, gauche (c'est l'ordre attendu par Main pour CameraController). Un
	-- élément large (plus large que haut) occupe le haut ou le bas de l'écran,
	-- un élément haut le côté le plus proche de son centre.
	function HUD:getSafeInsets()
		local width = self.gui.AbsoluteSize.X
		local height = self.gui.AbsoluteSize.Y
		local top, right, bottom, left = 0, 0, 0, 0
		if width < 2 or height < 2 then
			return top, right, bottom, left
		end

		local regions = {
			self.backButton,
			self.scorePanel,
			self.circulation,
			self.controls,
			self.toolPill,
			self.resources,
			self.hint,
		}
		for _, frame in ipairs(regions) do
			if frame.Visible then
				local x, y, w, h = rectOf(frame, width, height)
				if w >= h then
					if y + h / 2 < height / 2 then
						top = math.max(top, y + h)
					else
						bottom = math.max(bottom, height - y)
					end
				elseif x + w / 2 < width / 2 then
					left = math.max(left, x + w)
				else
					right = math.max(right, width - x)
				end
			end
		end
		return math.ceil(top), math.ceil(right), math.ceil(bottom), math.ceil(left)
	end
end
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">HUDToolbar</string>
              <ProtectedString name="Source"><![CDATA[--[[
	HUDToolbar.luau
	Panneau d'outils clair : colonne à droite en paysage, bandeau horizontal
	(plus large que haut) au-dessus de l'aide en portrait ou dans le coin bas
	droit sur un écran court. Outils : construction, suppression, rond-point
	(seulement quand il est disponible) et déplacement de la vue. Les identifiants
	sont ceux lus par InputController et Main. Mixin : ajoute ses méthodes à HUD.
]]

local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.HUDIcons)

local L = Theme.Layout

-- Outils dans l'ordre d'affichage. Chaque touche reprend InputController (1 à 4).
local TOOLS = {
	{ id = "build", key = "1", icon = Icons.pen },
	{ id = "erase", key = "2", icon = Icons.trash },
	{ id = "roundabout", key = "3", icon = Icons.roundabout },
	{ id = "camera", key = "4", icon = Icons.pan },
}

-- 46 px : au-dessus du minimum tactile de 40 px, avec une marge de chaque côté.
local BUTTON_SIZE = 46
local BUTTON_GAP = 6
local PANEL_PADDING = 6
-- Colonne paysage : la largeur est celle d'un bouton plus les marges.
local PANEL_WIDTH = BUTTON_SIZE + 2 * PANEL_PADDING
-- Un second clic dans ce délai (secondes) est ignoré : pas de double envoi.
local CLICK_DEBOUNCE = 0.15

return function(HUD)
	-- Bouton d'outil : pictogramme centré, touche discrète dans le coin, survol
	-- et clic animés par Theme.motion. Les connexions et les animations sont
	-- rangées dans `parts` pour être libérées avec le panneau.
	local function makeToolButton(self, toolPill, spec, order, parts)
		local button = Theme.new("TextButton", {
			Name = spec.id,
			Parent = toolPill,
			Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE),
			LayoutOrder = order,
			BackgroundColor3 = Theme.Panel,
			BackgroundTransparency = 0,
			Text = "",
			Active = true,
			Selectable = true,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			ZIndex = 47,
		})
		Theme.corner(button, Theme.Radius.Medium)
		spec.icon(button, Theme.Ink)

		local hint = Theme.label(button, spec.key, {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -4, 1, -3),
			Size = UDim2.fromOffset(12, 12),
			TextSize = 9,
			Font = Theme.FontBold,
			TextColor3 = Theme.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 48,
		})
		table.insert(parts.hints, hint)

		table.insert(parts.motions, Theme.motion(button))

		local lastClick = nil
		local function activate()
			local now = os.clock()
			if lastClick and now - lastClick < CLICK_DEBOUNCE then
				return
			end
			lastClick = now
			-- On signale l'outil réellement actif : setTool peut revenir à « build ».
			self:setTool(spec.id)
			if self.callbacks.onToolChange then
				self.callbacks.onToolChange(self.tool)
			end
		end
		table.insert(parts.connections, button.Activated:Connect(activate))
		return button
	end

	function HUD:buildToolbar()
		local toolPill = Theme.new("Frame", {
			Parent = self.gui,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -L.Margin, 0.5, 0),
			Size = UDim2.fromOffset(PANEL_WIDTH, BUTTON_SIZE),
			BackgroundColor3 = Theme.Panel,
			BorderSizePixel = 0,
			-- Active : les marges et les espaces entre les boutons absorbent aussi le clic.
			Active = true,
			ZIndex = 46,
		})
		self.toolPill = toolPill
		Theme.corner(toolPill, Theme.Radius.Large)
		Theme.stroke(toolPill, Theme.Border, Theme.Stroke.Thin, Theme.Stroke.Transparency)
		Theme.padding(toolPill, PANEL_PADDING, PANEL_PADDING, PANEL_PADDING, PANEL_PADDING)

		local toolLayout = Instance.new("UIListLayout")
		toolLayout.FillDirection = Enum.FillDirection.Vertical
		toolLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		toolLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		toolLayout.Padding = UDim.new(0, BUTTON_GAP)
		toolLayout.SortOrder = Enum.SortOrder.LayoutOrder
		toolLayout.Parent = toolPill
		self.toolLayout = toolLayout

		-- Connexions, animations et touches : rangées ici pour être libérées
		-- d'un coup quand le panneau disparaît.
		local parts = { connections = {}, motions = {}, hints = {} }
		self.toolHints = parts.hints
		for order, spec in ipairs(TOOLS) do
			self.toolButtons[spec.id] = makeToolButton(self, toolPill, spec, order, parts)
		end
		-- Le rond-point n'apparaît qu'avec au moins un rond-point disponible.
		self.toolButtons.roundabout.Visible = false

		toolPill.Destroying:Connect(function()
			for _, connection in ipairs(parts.connections) do
				connection:Disconnect()
			end
			for _, handle in ipairs(parts.motions) do
				handle:destroy()
			end
			table.clear(parts.connections)
			table.clear(parts.motions)
		end)

		self:setTool("build")
		self:layoutToolPill()
	end

	-- Un seul bouton est sélectionné : l'outil demandé, ou « build » s'il n'est
	-- pas disponible (rond-point sans rond-point, identifiant inconnu).
	function HUD:setTool(tool)
		if (tool == "roundabout" and self.roundabouts <= 0) or not self.toolButtons[tool] then
			tool = "build"
		end
		self.tool = tool
		for name, button in pairs(self.toolButtons) do
			Theme.setSelected(button, name == tool)
		end
	end

	-- Taille et place du panneau selon le format. Les touches n'ont de sens
	-- qu'au clavier : elles sont masquées en portrait.
	function HUD:layoutToolPill()
		local pill = self.toolPill
		if not pill or not self.toolLayout then
			return
		end
		local portrait = self:isPortrait()

		local count = 0
		for _, spec in ipairs(TOOLS) do
			local button = self.toolButtons[spec.id]
			if button and button.Visible then
				count += 1
			end
		end
		-- Longueur du panneau : boutons, espaces entre eux et marges intérieures.
		local length = count * BUTTON_SIZE + math.max(count - 1, 0) * BUTTON_GAP + 2 * PANEL_PADDING

		local short = self:isShort()
		-- Le coin bas droit n'est libre que si le bandeau tient à droite de la
		-- rangée de compteurs, centrée : sinon (paysage de téléphone étroit) il
		-- passe au-dessus d'elle, comme en portrait.
		local chipsWidth = L.ChipCount * L.ChipWidth + (L.ChipCount - 1) * L.ChipGap
		local cornerWidth = 2 * (L.Margin + length + L.Gap) + chipsWidth
		local stacked = portrait or (short and self.gui.AbsoluteSize.X < cornerWidth)
		if stacked then
			-- Au-dessus des compteurs ; la place de l'aide est réservée même quand
			-- elle est masquée, pour que le bandeau ne saute pas.
			local above = L.Margin + L.ChipHeight + L.Gap
			if not short then
				above += L.HintHeight + L.Gap
			end
			self.toolLayout.FillDirection = Enum.FillDirection.Horizontal
			pill.AnchorPoint = Vector2.new(0.5, 1)
			pill.Position = UDim2.new(0.5, 0, 1, -(above + L.Gap))
			pill.Size = UDim2.fromOffset(length, PANEL_WIDTH)
		elseif short then
			-- Écran court en paysage : la colonne toucherait les contrôles du temps.
			-- Le bandeau va dans le coin bas droit, à côté des compteurs.
			self.toolLayout.FillDirection = Enum.FillDirection.Horizontal
			pill.AnchorPoint = Vector2.new(1, 1)
			pill.Position = UDim2.new(1, -L.Margin, 1, -L.Margin)
			pill.Size = UDim2.fromOffset(length, PANEL_WIDTH)
		else
			self.toolLayout.FillDirection = Enum.FillDirection.Vertical
			pill.AnchorPoint = Vector2.new(1, 0.5)
			pill.Position = UDim2.new(1, -L.Margin, 0.5, 0)
			pill.Size = UDim2.fromOffset(PANEL_WIDTH, length)
		end
		for _, hint in ipairs(self.toolHints) do
			hint.Visible = not portrait
		end
	end
end
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">HUDTopBar</string>
              <ProtectedString name="Source"><![CDATA[--[[
	HUDTopBar.luau
	Barre du haut, discrète : flèche retour et jauge de circulation à gauche ;
	à droite un panneau (score, « Jour N », mois avec sa ligne de progression,
	horloge du jour) et, dessous, les contrôles du temps (pause, x1, x2, x3).
	La mise en page est identique sur tous les formats (gabarit Theme.Layout).
	Mixin : ajoute ses méthodes à HUD (voir HUD.luau).
]]

local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.HUDIcons)

local L = Theme.Layout

-- Vitesses proposées, dans l'ordre d'affichage des boutons.
local SPEEDS = { 1, 2, 3 }
local DAYS_PER_WEEK = 7
-- Cases du panneau (colonnes du score, du texte et de l'horloge).
local PANEL_PADDING = 12
local SCORE_WIDTH = 72
local TEXT_X = PANEL_PADDING + SCORE_WIDTH + 2 * Theme.Space.S + 1 + 4
local TEXT_WIDTH = 108
local CLOCK_SIZE = 30
local PROGRESS_HEIGHT = 3
local CONTROL_BUTTON = Vector2.new(32, 28)

local function clamp01(value)
	if value < 0 then
		return 0
	elseif value > 1 then
		return 1
	end
	return value
end

-- Fond clair arrondi des boutons ronds de la barre.
local function softButton(parent, props)
	props.Parent = parent
	props.BackgroundColor3 = Theme.Panel
	props.BackgroundTransparency = 0
	props.Active = true
	props.Selectable = true
	props.AutoButtonColor = false
	props.BorderSizePixel = 0
	local button = Theme.new("TextButton", props)
	Theme.corner(button, Theme.Radius.Pill)
	Theme.motion(button)
	return button
end

return function(HUD)
	local function buildBackButton(self)
		-- Flèche retour : à droite des icônes de Roblox, en haut à gauche.
		local button = softButton(self.gui, {
			Position = UDim2.fromOffset(L.TopLeftInset, L.Margin),
			Size = UDim2.fromOffset(L.BackSize, L.BackSize),
			Text = "",
			ZIndex = 48,
		})
		Icons.back(button, Theme.Ink, 22)
		Theme.stroke(button, Theme.Border, Theme.Stroke.Thin, Theme.Stroke.Transparency)
		button.Activated:Connect(function()
			if self.callbacks.onMenu then
				self.callbacks.onMenu()
			end
		end)
		self.backButton = button
	end

	local function buildTrafficGauge(self)
		-- Jauge de circulation : visible seulement quand la satisfaction baisse.
		local gauge = Theme.new("Frame", {
			Parent = self.gui,
			Position = UDim2.fromOffset(L.TopLeftInset, L.Margin + L.PanelHeight + L.Gap),
			Size = UDim2.fromOffset(L.GaugeWidth, L.GaugeHeight),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 42,
		})
		self.circulation = gauge
		Theme.label(gauge, "TRAFIC", {
			Size = UDim2.new(0.5, 0, 0, 14),
			TextSize = 10,
			Font = Theme.FontBold,
			TextColor3 = Theme.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 43,
		})
		self.satisfactionText = Theme.label(gauge, "100%", {
			Position = UDim2.fromScale(0.5, 0),
			Size = UDim2.new(0.5, 0, 0, 14),
			TextSize = 10,
			Font = Theme.FontBold,
			TextColor3 = Theme.TealDark,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 43,
		})
		local track = Theme.new("Frame", {
			Parent = gauge,
			Position = UDim2.fromOffset(0, 18),
			Size = UDim2.new(1, 0, 0, 6),
			BackgroundColor3 = Theme.Border,
			BorderSizePixel = 0,
			ZIndex = 43,
		})
		Theme.corner(track, Theme.Radius.Pill)
		self.satisfactionFill = Theme.new("Frame", {
			Parent = track,
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Teal,
			BorderSizePixel = 0,
			ZIndex = 44,
		})
		Theme.corner(self.satisfactionFill, Theme.Radius.Pill)
	end

	-- Horloge du jour : une aiguille des minutes qui suit la progression du jour,
	-- une aiguille des heures qui suit le jour de la semaine. Les aiguilles
	-- tournent autour d'un pivot vide au centre (Rotation pivote toujours autour
	-- du centre d'un GuiObject, pas de son AnchorPoint).
	local function buildClock(self, panel)
		local clock = Theme.circle(panel, CLOCK_SIZE, Theme.PanelSoft, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -PANEL_PADDING, 0.5, 0),
			ZIndex = 43,
		})
		self.clock = clock

		local function makeHand(length)
			local pivot = Theme.new("Frame", {
				Parent = clock,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 44,
			})
			Theme.new("Frame", {
				Parent = pivot,
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(2, length),
				BackgroundColor3 = Theme.Ink,
				BorderSizePixel = 0,
				ZIndex = 44,
			})
			return pivot
		end
		self.clockHourPivot = makeHand(7)
		self.clockMinutePivot = makeHand(11)
		Theme.circle(clock, 4, Theme.Ink, {
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 45,
		})
	end

	local function buildScorePanel(self)
		local panel = Theme.panel(self.gui, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -L.Margin, 0, L.Margin),
			Size = UDim2.fromOffset(L.PanelWidth, L.PanelHeight),
			CornerRadius = Theme.Radius.Large,
			-- Active : un clic sur le panneau est absorbé par l'interface, il ne trace
			-- pas de route et ne déplace pas la vue derrière lui.
			Active = true,
			ZIndex = 42,
		})
		Theme.stroke(panel, Theme.Border, Theme.Stroke.Thin, Theme.Stroke.Transparency)
		self.scorePanel = panel

		self.scoreValue = Theme.label(panel, "0", {
			Position = UDim2.fromOffset(PANEL_PADDING, 0),
			Size = UDim2.new(0, SCORE_WIDTH, 1, 0),
			TextSize = 28,
			Font = Theme.FontBlack,
			TextColor3 = Theme.Ink,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 43,
		})
		Theme.textScaled(self.scoreValue, 28, 14)

		Theme.new("Frame", {
			Parent = panel,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, PANEL_PADDING + SCORE_WIDTH + Theme.Space.S, 0.5, 0),
			Size = UDim2.new(0, 1, 0, L.PanelHeight - 2 * PANEL_PADDING),
			BackgroundColor3 = Theme.Border,
			BorderSizePixel = 0,
			ZIndex = 43,
		})

		-- Colonne de texte : « Jour N » au-dessus, mois et semaine dessous, puis la
		-- fine ligne de progression du mois.
		self.dayLabel = Theme.label(panel, "Jour 1", {
			Position = UDim2.fromOffset(TEXT_X, 7),
			Size = UDim2.fromOffset(TEXT_WIDTH, 20),
			TextSize = 15,
			Font = Theme.FontBold,
			TextColor3 = Theme.Ink,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 43,
		})
		Theme.textScaled(self.dayLabel, 15, 10)
		self.monthLabel = Theme.label(panel, "", {
			Position = UDim2.fromOffset(TEXT_X, 26),
			Size = UDim2.fromOffset(TEXT_WIDTH * 0.6, 14),
			TextSize = 11,
			TextColor3 = Theme.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 43,
		})
		Theme.textScaled(self.monthLabel, 11, 8)
		self.weekLabel = Theme.label(panel, "Sem. 1", {
			Position = UDim2.fromOffset(TEXT_X + TEXT_WIDTH * 0.6, 26),
			Size = UDim2.fromOffset(TEXT_WIDTH * 0.4, 14),
			TextSize = 11,
			TextColor3 = Theme.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 43,
		})
		Theme.textScaled(self.weekLabel, 11, 8)

		local track = Theme.new("Frame", {
			Parent = panel,
			Position = UDim2.fromOffset(TEXT_X, L.PanelHeight - PROGRESS_HEIGHT - 6),
			Size = UDim2.fromOffset(TEXT_WIDTH, PROGRESS_HEIGHT),
			BackgroundColor3 = Theme.Border,
			BorderSizePixel = 0,
			ZIndex = 43,
		})
		Theme.corner(track, Theme.Radius.Pill)
		self.monthFill = Theme.new("Frame", {
			Parent = track,
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = Theme.Teal,
			BorderSizePixel = 0,
			ZIndex = 44,
		})
		Theme.corner(self.monthFill, Theme.Radius.Pill)

		buildClock(self, panel)
	end

	-- Contrôles du temps : pause puis les trois vitesses, dans un petit panneau
	-- sous le score. Le bouton actif prend la couleur de sélection des outils.
	local function buildControls(self)
		local controls = Theme.panel(self.gui, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -L.Margin, 0, L.Margin + L.PanelHeight + L.Gap),
			Size = UDim2.fromOffset(L.ControlsWidth, L.ControlsHeight),
			CornerRadius = Theme.Radius.Large,
			Active = true,
			ZIndex = 42,
		})
		Theme.stroke(controls, Theme.Border, Theme.Stroke.Thin, Theme.Stroke.Transparency)
		self.controls = controls
		local layout = Instance.new("UIListLayout")
		layout.FillDirection = Enum.FillDirection.Horizontal
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		layout.Padding = UDim.new(0, 2)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = controls

		local function makeControl(name, order, text, onClick)
			local button = softButton(controls, {
				Name = name,
				Size = UDim2.fromOffset(CONTROL_BUTTON.X, CONTROL_BUTTON.Y),
				LayoutOrder = order,
				Text = text,
				Font = Theme.FontBold,
				TextSize = 13,
				TextColor3 = Theme.Ink,
				ZIndex = 43,
			})
			button.Activated:Connect(onClick)
			return button
		end

		self.pauseButton = makeControl("pause", 1, "", function()
			if self.callbacks.onPause then
				self.callbacks.onPause()
			end
		end)
		Icons.pause(self.pauseButton, Theme.Ink, 16)
		self.speedButtons = {}
		for index, value in ipairs(SPEEDS) do
			self.speedButtons[value] = makeControl("speed" .. value, index + 1, "x" .. value, function()
				self:setSpeed(value)
				if self.callbacks.onSpeed then
					self.callbacks.onSpeed(value)
				end
			end)
		end
	end

	function HUD:buildTopBar()
		buildBackButton(self)
		buildTrafficGauge(self)
		buildScorePanel(self)
		buildControls(self)
		self.paused = false
		self:setPaused(false)
		self:setSpeed(1)
	end

	-- Remet la barre à zéro au lancement d'une partie ; le prochain état serveur
	-- recale le calendrier et l'horloge.
	function HUD:resetTopBar()
		self.controls.Visible = true
		self.scoreValue.Text = "0"
		self.dayLabel.Text = "Jour 1"
		self.monthLabel.Text = ""
		self.weekLabel.Text = "Sem. 1"
		-- Un tween de la partie précédente ne doit pas ramener la barre en arrière.
		Theme.stopTweens(self.monthFill)
		self.monthFill.Size = UDim2.fromScale(0, 1)
		self.clockMinutePivot.Rotation = 0
		self.clockHourPivot.Rotation = 0
		self:setPaused(false)
	end

	function HUD:setSatisfaction(value)
		local ratio = clamp01(value / 100)
		Theme.tween(self.satisfactionFill, { Size = UDim2.fromScale(ratio, 1) }, "size", Theme.Motion.Fast)

		local color = Theme.Teal
		if ratio <= 0.3 then
			color = Theme.Danger
		elseif ratio <= 0.6 then
			color = Theme.Orange
		end
		self.satisfactionFill.BackgroundColor3 = color
		self.satisfactionText.Text = tostring(math.floor(value + 0.5)) .. "%"
		self.satisfactionText.TextColor3 = color
		self.circulation.Visible = value < 99.5
	end

	function HUD:setSpeed(value)
		local speed = math.floor(tonumber(value) or 1)
		self.speed = math.clamp(speed, SPEEDS[1], SPEEDS[#SPEEDS])
		for _, option in ipairs(SPEEDS) do
			Theme.setSelected(self.speedButtons[option], option == self.speed)
		end
	end

	-- Indicateur de pause : le bouton de pause prend la couleur de sélection et
	-- le cadran de l'horloge se teinte.
	function HUD:setPaused(paused)
		self.paused = paused == true
		Theme.setSelected(self.pauseButton, self.paused)
		Theme.tween(
			self.clock,
			{ BackgroundColor3 = self.paused and Theme.Orange or Theme.PanelSoft },
			"tint",
			Theme.Motion.Fast
		)
	end

	-- Jour, mois, semaine et horloge d'après l'état serveur. Les champs absents
	-- (état ancien, test) sont déduits de la semaine.
	function HUD:setCalendar(state)
		local week = state.week or 1
		local dayOfWeek = tonumber(state.dayOfWeek)
		if not dayOfWeek or dayOfWeek < 1 or dayOfWeek > DAYS_PER_WEEK then
			dayOfWeek = ((week - 1) % DAYS_PER_WEEK) + 1
		end
		dayOfWeek = math.floor(dayOfWeek)
		local day = tonumber(state.day) or ((week - 1) * DAYS_PER_WEEK + dayOfWeek)
		local weekProgress = clamp01(state.weekProgress or 0)
		local dayProgress = clamp01(tonumber(state.dayProgress) or (weekProgress * DAYS_PER_WEEK) % 1)
		local monthProgress = clamp01(tonumber(state.monthProgress) or weekProgress)

		self.dayLabel.Text = "Jour " .. tostring(math.floor(day))
		self.monthLabel.Text = type(state.monthName) == "string" and state.monthName or ""
		self.weekLabel.Text = "Sem. " .. tostring(week)
		self.clockMinutePivot.Rotation = dayProgress * 360
		self.clockHourPivot.Rotation = ((dayOfWeek - 1 + dayProgress) / DAYS_PER_WEEK) * 360
		Theme.tween(self.monthFill, { Size = UDim2.fromScale(monthProgress, 1) }, "size", Theme.Motion.Fast)
	end
end
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Lobby</string>
              <ProtectedString name="Source"><![CDATA[--[[
	Lobby.luau
	Menu principal, choix de la ville, options, palmarès, garage et statistiques.
	Style clair de la capture : fond quadrillé, titre, boutons menthe et cartes
	avec aperçu circulaire. Couleurs : Config.Colors, relayées par Theme.
	Le décor animé ne tourne que lorsque le menu principal est visible.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Maps = require(Shared.Maps)
local Theme = require(script.Parent.Theme)
local MapPreview = require(script.Parent.MapPreview)

local COLORS = Config.Colors

local Lobby = {}
Lobby.__index = Lobby

local DEFAULT_MAP_ID = "los_angeles"

-- Cartes des villes : taille de référence, mise à l'échelle sur petit écran.
local CARD_WIDTH = 320
local CARD_HEIGHT = 470
local CARD_GAP = Theme.Space.XL
local MIN_CARD_SCALE = 0.4

-- Seuils d'écran : portrait (téléphone debout) et hauteur courte (paysage).
local PORTRAIT_MIN_WIDTH = 760
local SHORT_HEIGHT = 700

-- Espaces : tous viennent de Theme.Space.
local SECTION_GAP = Theme.Space.M
local HEADER_GAP = Theme.Space.S
local EDGE_MARGIN = Theme.Space.L

local MENU_GAP = Theme.Space.M
local MENU_ITEM_COUNT = 5
local TITLE_SIZE = 92
-- Le titre se réduit pour rester à l'écran, sans descendre sous ce facteur.
local TITLE_MIN_SCALE = 0.3
-- Trois pastilles orange après le titre : décalage, taille et pas entre elles.
local DOT_COUNT = 3
local DOT_SIZE = 24
local DOT_OFFSET = 22
local DOT_STEP = 34
local PLAY_HEIGHT = 64
local PLAY_HEIGHT_SHORT = 48
local HINT_HEIGHT = 22
local HINT_MARGIN = 12
local RAIL_LEFT = 0.024
local RAIL_WIDTH = 58
local RAIL_ITEM = 56
local RAIL_GAP = 10
local RAIL_HEIGHT = 4 * RAIL_ITEM + 3 * RAIL_GAP
local RAIL_ICON_SIZE = 26

local RADIUS_BUTTON = Theme.Radius.Medium
local RADIUS_CARD = Theme.Radius.Large
local RADIUS_MODAL = Theme.Radius.Large

-- Texte d'une valeur absente (pas de record). Un tiret ASCII : le tiret long
-- n'est pas garanti dans la police Roblox.
local NO_SCORE = "-"

-- Anti double-clic : un clic reçu deux fois (Activated + MouseButton1Click)
-- ne compte qu'une fois ; deux clics rapprochés sur une carte lancent la ville.
local CLICK_DEBOUNCE = 0.12
local DOUBLE_CLICK_WINDOW = 0.45

local TOAST_DURATION = 2.4
local RESET_ARM_DURATION = 3

-- Décor : proportions relatives à la largeur de la zone de décor.
local ROAD_RATIO = 0.030
local CAR_RATIO = 0.0105
local CAR_SHADOW_OFFSET = Vector2.new(3, 4)

-- Couleurs propres au lobby, lues dans Config.Colors.
local TOKENS = {
	BackgroundTop = COLORS.LobbyBackgroundTop,
	BackgroundBottom = COLORS.LobbyBackgroundBottom,
	Accent = COLORS.LobbyAccent,
	AccentDeep = COLORS.LobbyAccentDeep,
}

-- Score d'une carte : seul un nombre fini et positif compte, le reste vaut 0.
local function bestOf(value)
	if typeof(value) ~= "number" or value ~= value or value <= 0 or value == math.huge then
		return 0
	end
	return math.floor(value)
end

-- Forme plate arrondie (décor, cartes). Le rayon est un UDim : UDim.new(1, 0)
-- donne une pastille parfaite quelle que soit la taille.
local function plate(parent, props, radius)
	props.Parent = parent
	props.BorderSizePixel = 0
	local frame = Theme.new("Frame", props)
	if radius then
		Theme.corner(frame, radius)
	end
	return frame
end

-- Affiche ou cache une page ou une couche. Cachée, ses boutons repartent sans
-- survol : une cible masquée sous le curseur ne signale pas toujours MouseLeave.
local function setShown(frame, visible)
	if not visible then
		Theme.resetHover(frame)
	end
	frame.Visible = visible
end

-- Icônes de la colonne latérale, en formes plates (pas de caractère Unicode :
-- la police Roblox ne garantit pas leurs glyphes). Une pièce vaut
-- { x, y, largeur, hauteur, rayon, rôle } dans une boîte RAIL_ICON_SIZE ;
-- le rôle « bg » prend la couleur du fond du bouton, pour creuser une forme.
local RAIL_ICONS = {
	map = {
		{ 5, 3, 16, 16, 8, "fg" },
		{ 10, 8, 6, 6, 3, "bg" },
	},
	garage = {
		{ 2, 9, 22, 10, 4, "fg" },
		{ 6, 3, 14, 9, 4, "fg" },
		{ 5, 15, 6, 6, 3, "fg" },
		{ 15, 15, 6, 6, 3, "fg" },
	},
	records = {
		{ 3, 2, 18, 18, 9, "fg" },
		{ 7, 6, 10, 10, 5, "bg" },
		{ 6, 17, 5, 7, 1, "fg" },
		{ 13, 17, 5, 7, 1, "fg" },
	},
	stats = {
		{ 2, 14, 5, 8, 1, "fg" },
		{ 9, 8, 5, 14, 1, "fg" },
		{ 16, 3, 5, 19, 1, "fg" },
	},
}

local function drawRailIcon(button, kind, color)
	local box = Theme.new("Frame", {
		Name = "Icon",
		Parent = button,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(RAIL_ICON_SIZE, RAIL_ICON_SIZE),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	for _, piece in ipairs(RAIL_ICONS[kind]) do
		plate(box, {
			Position = UDim2.fromOffset(piece[1], piece[2]),
			Size = UDim2.fromOffset(piece[3], piece[4]),
			BackgroundColor3 = piece[6] == "bg" and button.BackgroundColor3 or color,
		}, UDim.new(0, piece[5]))
	end
end

-- Flèche « retour » en deux barres fines, sans caractère « ‹ » de la police.
-- La pointe est en (x, centre vertical) ; chaque barre fait CHEVRON_ARM px.
local CHEVRON_ARM = 10
local CHEVRON_HALF = 3.5
local CHEVRON_THICKNESS = 2

local function drawChevron(button, x, color)
	for _, arm in ipairs({ { -45, -CHEVRON_HALF }, { 45, CHEVRON_HALF } }) do
		plate(button, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, x + CHEVRON_HALF, 0.5, arm[2]),
			Size = UDim2.fromOffset(CHEVRON_ARM, CHEVRON_THICKNESS),
			Rotation = arm[1],
			BackgroundColor3 = color,
		}, UDim.new(0, CHEVRON_THICKNESS / 2))
	end
end

-- Point d'une spline de Catmull-Rom : sert à dessiner une route douce avec
-- des segments arrondis, sans image ni mesh.
local function catmullRomPoint(p0, p1, p2, p3, t)
	local t2 = t * t
	local t3 = t2 * t
	return (p1 * 2
			+ (p2 - p0) * t
			+ (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2
			+ (p1 * 3 - p0 - p2 * 3 + p3) * t3)
		* 0.5
end

local function samplePath(controls, stepsPerSegment)
	local points = {}
	for i = 1, #controls - 1 do
		local p0 = controls[math.max(1, i - 1)]
		local p1 = controls[i]
		local p2 = controls[i + 1]
		local p3 = controls[math.min(#controls, i + 2)]
		for step = 0, stepsPerSegment - 1 do
			table.insert(points, catmullRomPoint(p0, p1, p2, p3, step / stepsPerSegment))
		end
	end
	table.insert(points, controls[#controls])
	return points
end

--[[
	Mise en page responsive. Fonction pure : les tests vérifient qu'aucun
	élément ne sort de l'écran sans avoir besoin de rendu. Les positions en
	fraction (0..1) sont relatives à l'écran ; les tailles sont en pixels.
	titleWidth : largeur du titre et de ses pastilles, à taille normale, mesurée
	par TextService (la police n'est connue qu'à l'exécution).
]]
function Lobby.layoutFor(width, height, titleWidth)
	local portrait = width < PORTRAIT_MIN_WIDTH or width < height * 0.9
	local short = height < SHORT_HEIGHT
	local titleX = portrait and 0.08 or 0.21
	-- Le titre se réduit s'il ne tient pas entre son bord gauche et l'écran.
	local titleFit = (width * (1 - titleX) - EDGE_MARGIN) / titleWidth
	local titleScale = math.clamp(
		math.min(portrait and width / 720 or width / 1600, titleFit),
		TITLE_MIN_SCALE,
		1
	)

	-- Sur un écran étroit en paysage, la colonne d'icônes recule la zone des cartes.
	local scrollerX = portrait and 0.05 or 0.09
	local scrollerWidth = portrait and 0.9 or 0.86
	if not portrait then
		local railClear = RAIL_LEFT + (RAIL_WIDTH + SECTION_GAP) / width
		if railClear > scrollerX then
			scrollerX = railClear
			scrollerWidth = 1 - 2 * railClear
		end
	end

	local hintVisible = not short
	local playHeight = short and PLAY_HEIGHT_SHORT or PLAY_HEIGHT
	local hintTop = height - HINT_MARGIN - HINT_HEIGHT
	local playTop = hintVisible and (hintTop - SECTION_GAP - playHeight)
		or (height - EDGE_MARGIN - playHeight)

	-- La zone des cartes va du sous-titre jusqu'au bouton Jouer. Les cartes
	-- rétrécissent si la hauteur ne suffit pas (paysage téléphone).
	-- Le bouton Retour et le sous-titre restent au-dessus de la zone des cartes,
	-- même sur un écran très bas.
	local backY = portrait and 0.028 or 0.048
	local backHeight = portrait and 34 or 42
	local subtitleY = portrait and 0.15 or 0.103
	local subtitleBottom = height * (subtitleY + 0.028)
	local scrollerTop = math.max(
		height * (portrait and 0.19 or 0.145),
		height * backY + backHeight + HEADER_GAP,
		subtitleBottom + HEADER_GAP
	)
	local scrollerHeight = math.max(0, playTop - SECTION_GAP - scrollerTop)
	local cardScale = math.clamp((scrollerHeight - EDGE_MARGIN) / CARD_HEIGHT, MIN_CARD_SCALE, 1)

	local buttonHeight = math.clamp(height * 0.075, 30, 52)
	local infoSize = portrait and 60 or math.clamp(height * 0.068, 52, 74)
	local railTop = math.max(12, math.min(height * 0.34, height - RAIL_HEIGHT - 12))

	return {
		portrait = portrait,
		decorVisible = not portrait,
		railVisible = not portrait,
		railX = RAIL_LEFT,
		railWidth = RAIL_WIDTH,
		railTop = railTop,
		railHeight = RAIL_HEIGHT,
		hintVisible = hintVisible,
		hintTop = hintTop,
		titleX = titleX,
		titleY = portrait and 0.115 or 0.165,
		titleScale = titleScale,
		menuX = portrait and 0.08 or 0.21,
		menuY = portrait and 0.36 or 0.43,
		menuWidth = portrait and 0.84 or 0.19,
		menuHeight = MENU_ITEM_COUNT * buttonHeight + (MENU_ITEM_COUNT - 1) * MENU_GAP,
		buttonHeight = buttonHeight,
		infoSize = infoSize,
		infoX = portrait and 0.94 or 0.955,
		infoY = portrait and 0.94 or 0.925,
		destinationSize = math.clamp(height * 0.16, 100, 190),
		houseSize = math.clamp(height * 0.095, 66, 112),
		mapTitleY = portrait and 0.09 or 0.04,
		mapTitleWidth = portrait and 0.72 or 0.5,
		subtitleY = subtitleY,
		subtitleWidth = portrait and 0.8 or 0.62,
		backY = backY,
		backWidth = portrait and math.min(96, width * 0.28) or 118,
		backHeight = backHeight,
		scrollerX = scrollerX,
		scrollerWidth = scrollerWidth,
		scrollerTop = scrollerTop,
		scrollerHeight = scrollerHeight,
		cardScale = cardScale,
		cardWidth = CARD_WIDTH * cardScale,
		cardHeight = CARD_HEIGHT * cardScale,
		playTop = playTop,
		playHeight = playHeight,
	}
end

function Lobby.new(callbacks)
	local self = setmetatable({}, Lobby)
	self.callbacks = callbacks or {}
	self.cards = {}
	self.recordLabels = {}
	self.menuItems = {}
	self.modalScales = {}
	self.overlays = {}
	self.connections = {}
	self.frameConnection = nil
	self.decorRoads = {}
	self.decorRoutes = {}
	self.decorCars = {}
	self.decorTime = 0
	self.selectedId = (Maps.getById(DEFAULT_MAP_ID) or Maps.all()[1]).id
	self.lastClickId = nil
	self.lastClickAt = 0
	self.toastToken = 0
	self.resetToken = 0
	self.cardScale = 1
	self.destroyed = false
	self:build()
	self:track(self.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:updateResponsive()
	end))
	self:updateResponsive()
	return self
end

-- Garde une connexion persistante pour la libérer dans destroy().
function Lobby:track(connection)
	table.insert(self.connections, connection)
	return connection
end

-- Bouton du lobby : Theme.button (couleur au survol) plus Theme.motion (échelle
-- au survol et au clic, bornée par Theme.Motion). Aucun UIScale n'est ajouté ici
-- à la main : seul Theme.motion en pose un, donc jamais deux échelles par bouton.
-- Les connexions de Theme.button ne sont pas suivies ici : elles sont libérées
-- avec le ScreenGui, car Destroy coupe les événements de l'instance et de ses
-- descendants (le harnais de test reproduit ce comportement).
function Lobby:button(parent, text, props, onClick)
	local button = Theme.button(parent, text, props, onClick)
	Theme.motion(button)
	return button
end

function Lobby:build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "MM_Lobby"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui
	self.gui = gui

	local background = Theme.new("Frame", {
		Parent = gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.LobbyBackground,
		BorderSizePixel = 0,
		Active = false,
		ZIndex = 0,
	})
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(TOKENS.BackgroundTop, TOKENS.BackgroundBottom)
	gradient.Parent = background

	-- La grille est construite à part pour garder des cases carrées, même
	-- sur un écran large, comme sur la capture de référence.
	self.lobbyGrid = Theme.new("Frame", {
		Name = "LobbyGrid",
		Parent = background,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 0,
	})

	local main = Theme.new("Frame", {
		Parent = gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		ZIndex = 1,
	})
	self.mainPage = main

	local mapPage = Theme.new("Frame", {
		Parent = gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		Active = false,
		ZIndex = 2,
	})
	self.mapPage = mapPage

	self:buildDecoration(main)
	self:buildMain(main)
	self:buildMapPage(mapPage)
	self:buildOptions()
	self:buildRecords()
	self:buildGarage()
	self:buildStats()
	self:buildAbout()
	self:buildToast()
	self:select(self.selectedId)
end

function Lobby:buildDecoration(page)
	local decoration = Theme.new("Frame", {
		Parent = page,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		ZIndex = 1,
	})
	self.decoration = decoration

	-- Tracés de la route : une grande courbe qui descend à droite, puis une
	-- branche qui rejoint la petite maison du bas. Les points sont normalisés
	-- et échantillonnés en spline pour obtenir des virages doux.
	local mainControls = {
		Vector2.new(0.735, -0.06),
		Vector2.new(0.735, 0.25),
		Vector2.new(0.735, 0.38),
		Vector2.new(0.760, 0.465),
		Vector2.new(0.795, 0.525),
		Vector2.new(0.805, 0.610),
		Vector2.new(0.803, 0.690),
		Vector2.new(0.780, 0.755),
		Vector2.new(0.720, 0.815),
		Vector2.new(0.650, 0.875),
		Vector2.new(0.570, 0.940),
		Vector2.new(0.470, 1.045),
	}
	local branchControls = {
		Vector2.new(0.797, 0.665),
		Vector2.new(0.790, 0.725),
		Vector2.new(0.760, 0.780),
		Vector2.new(0.720, 0.835),
		Vector2.new(0.700, 0.880),
		Vector2.new(0.700, 0.945),
	}
	self.decorRoutes = {
		{ samples = samplePath(mainControls, 5) },
		{ samples = samplePath(branchControls, 6) },
	}

	local function addRoadPath(samples, factor)
		for i = 1, #samples - 1 do
			local a = samples[i]
			local b = samples[i + 1]
			local shadow = plate(decoration, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(0, 0),
				BackgroundColor3 = Theme.LobbyRoadShadow,
				BackgroundTransparency = 0.38,
				ZIndex = 1,
			}, UDim.new(1, 0))
			table.insert(self.decorRoads, {
				frame = shadow,
				a = a,
				b = b,
				factor = factor * 1.04,
				offset = Vector2.new(5, 7),
			})

			local road = plate(decoration, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(0, 0),
				BackgroundColor3 = Theme.LobbyRoad,
				ZIndex = 2,
			}, UDim.new(1, 0))
			table.insert(self.decorRoads, {
				frame = road,
				a = a,
				b = b,
				factor = factor,
				offset = Vector2.new(0, 0),
			})
		end
	end

	addRoadPath(self.decorRoutes[1].samples, 1)
	addRoadPath(self.decorRoutes[2].samples, 0.82)

	-- Grande destination orange avec épingle, comme sur la capture.
	local destination = Theme.new("Frame", {
		Parent = decoration,
		Position = UDim2.fromScale(0.790, 0.155),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(170, 170),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 10,
	})
	self.decorDestination = destination

	plate(destination, {
		Position = UDim2.fromScale(0.10, 0.12),
		Size = UDim2.fromScale(0.84, 0.84),
		BackgroundColor3 = Theme.CardShadow,
		BackgroundTransparency = 0.25,
		ZIndex = 11,
	}, UDim.new(0, 22))
	plate(destination, {
		Position = UDim2.fromScale(0.04, 0.02),
		Size = UDim2.fromScale(0.88, 0.88),
		BackgroundColor3 = Theme.LobbyRoad,
		ZIndex = 12,
	}, UDim.new(0, 22))
	plate(destination, {
		Position = UDim2.fromScale(0.10, 0.10),
		Size = UDim2.fromScale(0.76, 0.76),
		BackgroundColor3 = TOKENS.AccentDeep,
		ZIndex = 13,
	}, UDim.new(0, 14))
	plate(destination, {
		Position = UDim2.fromScale(0.10, 0.06),
		Size = UDim2.fromScale(0.76, 0.76),
		BackgroundColor3 = Theme.LobbyOrange,
		ZIndex = 14,
	}, UDim.new(0, 14))

	-- Épingle : cercle, pointe en losange et petit trou sombre.
	Theme.circle(destination, 42, Theme.CardShadow, {
		Position = UDim2.fromScale(0.5, 0.43),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 13,
	})
	plate(destination, {
		Position = UDim2.fromScale(0.5, 0.54),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(36, 36),
		Rotation = 45,
		BackgroundColor3 = Theme.InkSoft,
		ZIndex = 14,
	}, UDim.new(0, 5))
	plate(destination, {
		Position = UDim2.fromScale(0.5, 0.532),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(28, 28),
		Rotation = 45,
		BackgroundColor3 = Theme.LobbyRoad,
		ZIndex = 15,
	}, UDim.new(0, 4))
	Theme.circle(destination, 38, Theme.InkSoft, {
		Position = UDim2.fromScale(0.5, 0.43),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 16,
	})
	Theme.circle(destination, 31, Theme.LobbyRoad, {
		Position = UDim2.fromScale(0.5, 0.43),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 17,
	})
	Theme.circle(destination, 12, Theme.InkSoft, {
		Position = UDim2.fromScale(0.5, 0.43),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 18,
	})

	-- Petite maison corail/jaune au bout de la branche.
	local house = Theme.new("Frame", {
		Parent = decoration,
		Position = UDim2.fromScale(0.700, 0.885),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(96, 96),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 10,
	})
	self.decorHouse = house

	plate(house, {
		Position = UDim2.fromScale(0.10, 0.12),
		Size = UDim2.fromScale(0.84, 0.84),
		BackgroundColor3 = Theme.CardShadow,
		BackgroundTransparency = 0.28,
		ZIndex = 11,
	}, UDim.new(0, 12))
	plate(house, {
		Position = UDim2.fromScale(0.04, 0.02),
		Size = UDim2.fromScale(0.88, 0.88),
		BackgroundColor3 = Theme.LobbyRoad,
		ZIndex = 12,
	}, UDim.new(0, 12))
	plate(house, {
		Position = UDim2.fromScale(0.09, 0.09),
		Size = UDim2.fromScale(0.78, 0.78),
		BackgroundColor3 = TOKENS.Accent,
		ZIndex = 13,
	}, UDim.new(0, 8))
	plate(house, {
		Position = UDim2.fromScale(0.08, 0.06),
		Size = UDim2.fromScale(0.76, 0.62),
		BackgroundColor3 = TOKENS.AccentDeep,
		ZIndex = 13,
	}, UDim.new(0, 8))
	plate(house, {
		Position = UDim2.fromScale(0.11, 0.03),
		Size = UDim2.fromScale(0.70, 0.58),
		BackgroundColor3 = Theme.LobbyOrange,
		ZIndex = 14,
	}, UDim.new(0, 7))
	for i = -1, 1 do
		plate(house, {
			Position = UDim2.fromScale(0.5 + i * 0.19, 0.065),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(10, 11),
			BackgroundColor3 = Theme.LobbyOrange,
			ZIndex = 15,
		}, UDim.new(0, 2))
	end

	-- Deux voitures : une sur le grand trajet, une sur la branche. Elles
	-- suivent réellement la courbe et sont orientées dans le sens du trajet.
	local carSettings = {
		{ path = 1, offset = 0.10, speed = 0.072, hiddenEnds = false, color = Theme.LobbyOrange },
		{ path = 2, offset = 0.12, speed = 0.115, hiddenEnds = true, color = Theme.Orange },
	}
	for _, setting in ipairs(carSettings) do
		local shadow = plate(decoration, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(0, 0),
			BackgroundColor3 = Theme.CardShadow,
			BackgroundTransparency = 0.35,
			Visible = false,
			ZIndex = 3,
		}, UDim.new(1, 0))

		local body = plate(decoration, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(0, 0),
			BackgroundColor3 = setting.color,
			Visible = false,
			ZIndex = 4,
		}, UDim.new(1, 0))
		Theme.stroke(body, Theme.LobbyRoad, 1.2, 0.08)

		plate(body, {
			Position = UDim2.fromScale(0.64, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromScale(0.32, 0.62),
			BackgroundColor3 = Theme.LobbyRoad,
			ZIndex = 1,
		}, UDim.new(0, 3))

		table.insert(self.decorCars, {
			body = body,
			shadow = shadow,
			path = setting.path,
			offset = setting.offset,
			speed = setting.speed,
			hiddenEnds = setting.hiddenEnds,
		})
	end

	self:track(decoration:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:updateDecorationLayout()
	end))
	task.defer(function()
		if not self.destroyed then
			self:updateDecorationLayout()
		end
	end)
end

-- Recalcule les segments de route, les longueurs cumulées des trajets et la
-- taille des voitures. Appelé seulement quand la zone de décor change de taille.
function Lobby:updateDecorationLayout()
	local decoration = self.decoration
	if not decoration then
		return
	end
	local size = decoration.AbsoluteSize
	if size.X < 2 or size.Y < 2 then
		return
	end

	local roadThickness = math.clamp(size.X * ROAD_RATIO, 18, 64)
	for _, segment in ipairs(self.decorRoads) do
		local ax = segment.a.X * size.X
		local ay = segment.a.Y * size.Y
		local bx = segment.b.X * size.X
		local by = segment.b.Y * size.Y
		local dx = bx - ax
		local dy = by - ay
		local length = math.sqrt(dx * dx + dy * dy)
		segment.frame.Visible = length > 0.1
		if length > 0.1 then
			segment.frame.Position = UDim2.fromOffset(
				(ax + bx) * 0.5 + segment.offset.X,
				(ay + by) * 0.5 + segment.offset.Y
			)
			segment.frame.Size = UDim2.fromOffset(
				length + roadThickness * 1.15,
				roadThickness * segment.factor
			)
			segment.frame.Rotation = math.deg(math.atan2(dy, dx))
		end
	end

	for _, route in ipairs(self.decorRoutes) do
		local points = {}
		local cumulative = { 0 }
		for i, sample in ipairs(route.samples) do
			points[i] = Vector2.new(sample.X * size.X, sample.Y * size.Y)
		end
		for i = 2, #points do
			cumulative[i] = cumulative[i - 1] + (points[i] - points[i - 1]).Magnitude
		end
		route.points = points
		route.cumulative = cumulative
		route.total = cumulative[#cumulative]
	end

	local carThickness = math.clamp(size.X * CAR_RATIO, 7, 13)
	local carSize = UDim2.fromOffset(carThickness * 2.05, carThickness)
	for _, car in ipairs(self.decorCars) do
		car.body.Size = carSize
		car.shadow.Size = carSize
	end

	self:updateDecorationCars()
end

-- Place les voitures d'après le temps écoulé : appelé à chaque frame tant que
-- le décor est visible, sans aucune allocation de table.
function Lobby:updateDecorationCars()
	for _, car in ipairs(self.decorCars) do
		local route = self.decorRoutes[car.path]
		if route and route.total and route.total > 0 then
			local progress = (self.decorTime * car.speed + car.offset) % 1
			local distance = progress * route.total
			local cumulative = route.cumulative
			local points = route.points
			local last = #points - 1

			local index = 1
			while index < last and cumulative[index + 1] < distance do
				index += 1
			end
			local segmentLength = cumulative[index + 1] - cumulative[index]
			local fraction = segmentLength > 0
				and math.clamp((distance - cumulative[index]) / segmentLength, 0, 1)
				or 0

			local a = points[index]
			local b = points[index + 1]
			local x = a.X + (b.X - a.X) * fraction
			local y = a.Y + (b.Y - a.Y) * fraction
			local angle = math.deg(math.atan2(b.Y - a.Y, b.X - a.X))
			local visible = not (car.hiddenEnds and (progress < 0.045 or progress > 0.93))

			car.body.Position = UDim2.fromOffset(x, y)
			car.body.Rotation = angle
			car.body.Visible = visible
			car.shadow.Position = UDim2.fromOffset(x + CAR_SHADOW_OFFSET.X, y + CAR_SHADOW_OFFSET.Y)
			car.shadow.Rotation = angle
			car.shadow.Visible = visible
		end
	end
end

-- Le décor n'est animé que si le menu principal est affiché : aucune
-- connexion à RenderStepped quand le lobby est caché ou en portrait.
function Lobby:syncFrameLoop()
	local active = not self.destroyed
		and self.gui.Enabled
		and self.mainPage.Visible
		and self.decoration.Visible
	if active and not self.frameConnection then
		self.frameConnection = RunService.RenderStepped:Connect(function(dt)
			self.decorTime += dt
			self:updateDecorationCars()
		end)
	elseif not active then
		self:stopFrameLoop()
	end
end

function Lobby:stopFrameLoop()
	if self.frameConnection then
		self.frameConnection:Disconnect()
		self.frameConnection = nil
	end
end

function Lobby:buildMain(page)
	local titleHolder = Theme.new("Frame", {
		Parent = page,
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 3,
	})
	self.titleHolder = titleHolder

	local titleScale = Instance.new("UIScale")
	titleScale.Parent = titleHolder
	self.titleScale = titleScale

	Theme.label(titleHolder, Config.GameName, {
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		Font = Theme.FontBlack,
		TextSize = TITLE_SIZE,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
	})

	-- Largeur réelle du titre : sert à le réduire pour qu'il tienne à l'écran.
	local bounds = TextService:GetTextSize(
		Config.GameName,
		TITLE_SIZE,
		Theme.FontBlack,
		Vector2.new(3000, 300)
	)
	self.titleWidth = bounds.X + DOT_OFFSET + (DOT_COUNT - 1) * DOT_STEP + DOT_SIZE

	-- Pastilles orange après le titre, comme sur la capture.
	for index = 1, DOT_COUNT do
		Theme.circle(titleHolder, DOT_SIZE, Theme.LobbyOrange, {
			Position = UDim2.fromOffset(bounds.X + DOT_OFFSET + (index - 1) * DOT_STEP, 52),
			ZIndex = 4,
		})
	end

	local menu = Theme.new("Frame", {
		Parent = page,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		ZIndex = 3,
	})
	self.menu = menu
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.Padding = UDim.new(0, MENU_GAP)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	layout.Parent = menu

	-- Entrées du menu (9.2) : jouer, palmarès, statistiques, réglages, quitter.
	-- Les largeurs décalées reprennent le rythme de la capture de référence.
	self:addMenuItem(menu, "Jouer", 0.72, 1, function()
		if self.callbacks.onPlay then
			self.callbacks.onPlay()
		end
	end)
	self:addMenuItem(menu, "Palmarès", 0.80, 2, function()
		self:showRecords()
	end)
	self:addMenuItem(menu, "Statistiques", 0.92, 3, function()
		self:showStats()
	end)
	self:addMenuItem(menu, "Options", 0.84, 4, function()
		self:showOptions()
	end)
	self:addMenuItem(menu, "Sortir", 0.68, 5, function()
		if self.callbacks.onQuit then
			self.callbacks.onQuit()
		end
	end)

	-- Bouton info circulaire, avec une petite icône de document en blanc.
	-- Rayon « pilule » : le bouton reste un cercle à toute taille.
	local info = self:button(page, "", {
		AnchorPoint = Vector2.new(1, 1),
		BackgroundColor3 = Theme.LobbyButton,
		CornerRadius = Theme.Radius.Pill,
		ZIndex = 10,
	}, function()
		self:showAbout()
	end)
	self.infoButton = info

	local document = plate(info, {
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(30, 36),
		BackgroundColor3 = Theme.White,
		ZIndex = 11,
	}, UDim.new(0, 4))
	for index = 1, 3 do
		plate(document, {
			Position = UDim2.fromScale(0.5, 0.16 + (index - 1) * 0.18),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(17, 3),
			BackgroundColor3 = Theme.LobbyButton,
			ZIndex = 12,
		})
	end

	-- Pastille d'alerte posée sur le coin du bouton info.
	Theme.circle(info, 16, TOKENS.Accent, {
		Position = UDim2.fromOffset(-4, -4),
		ZIndex = 11,
	})
end

function Lobby:addMenuItem(menu, text, widthFraction, order, onClick)
	local button = self:button(menu, text, {
		LayoutOrder = order,
		BackgroundColor3 = Theme.LobbyButton,
		TextColor3 = Theme.White,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 30,
		CornerRadius = RADIUS_BUTTON,
	}, onClick)
	Theme.padding(button, 0, 8, 0, 22)
	table.insert(self.menuItems, { button = button, width = widthFraction })
	return button
end

function Lobby:buildMapPage(page)
	self.mapTitle = Theme.label(page, "Choisissez une ville", {
		Position = UDim2.fromScale(0.5, 0.040),
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromScale(0.5, 0.06),
		Font = Theme.FontBlack,
		TextSize = 38,
		TextColor3 = Theme.Ink,
		ZIndex = 3,
	})
	Theme.textScaled(self.mapTitle, 38, 16)

	self.mapSubtitle = Theme.label(page, "Six villes à explorer  ·  choisissez votre prochaine destination", {
		Position = UDim2.fromScale(0.5, 0.103),
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromScale(0.62, 0.028),
		TextSize = 15,
		TextColor3 = Theme.InkSoft,
		ZIndex = 3,
	})
	Theme.textScaled(self.mapSubtitle, 15, 8)

	self.backButton = self:button(page, "Retour", {
		Size = UDim2.fromOffset(118, 42),
		BackgroundColor3 = Theme.Panel,
		TextColor3 = Theme.Ink,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		CornerRadius = RADIUS_BUTTON,
		ZIndex = 4,
	}, function()
		self:showMain()
	end)
	-- Le texte laisse la place à la flèche dessinée à gauche.
	Theme.padding(self.backButton, 0, 8, 0, 32)
	drawChevron(self.backButton, 12, Theme.Ink)
	Theme.stroke(self.backButton, Theme.LobbyGrid, 1, 0.1)

	local scroller = Theme.new("ScrollingFrame", {
		Parent = page,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		CanvasSize = UDim2.fromOffset(0, 0),
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.LobbyButton,
		ClipsDescendants = true,
		ZIndex = 5,
	})
	self.scroller = scroller
	-- Marge de chaque côté de la rangée : le liseré de sélection et l'ombre de la
	-- première et de la dernière carte ne sont pas coupés par ClipsDescendants.
	-- updateCanvas compte ces deux marges dans la largeur de la zone défilante.
	Theme.padding(scroller, 0, CARD_GAP, 0, CARD_GAP)

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, CARD_GAP)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroller
	self.cardLayout = layout

	for index, map in ipairs(Maps.all()) do
		self:buildCard(scroller, map, index)
	end
	self:track(scroller:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:updateCanvas()
	end))
	self:updateCanvas()

	-- Rail d'icônes à gauche, pour retrouver garage, records et statistiques.
	local rail = Theme.new("Frame", {
		Parent = page,
		Size = UDim2.fromOffset(RAIL_WIDTH, RAIL_HEIGHT),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 20,
	})
	self.rail = rail
	local railLayout = Instance.new("UIListLayout")
	railLayout.FillDirection = Enum.FillDirection.Vertical
	railLayout.Padding = UDim.new(0, RAIL_GAP)
	railLayout.SortOrder = Enum.SortOrder.LayoutOrder
	railLayout.Parent = rail

	local railItems = {
		{ kind = "map", active = true, action = nil },
		{ kind = "garage", active = false, action = function()
			self:showGarage()
		end },
		{ kind = "records", active = false, action = function()
			self:showRecords()
		end },
		{ kind = "stats", active = false, action = function()
			self:showStats()
		end },
	}
	for index, item in ipairs(railItems) do
		local button = self:button(rail, "", {
			Size = UDim2.fromOffset(RAIL_ITEM, RAIL_ITEM),
			LayoutOrder = index,
			BackgroundColor3 = item.active and Theme.LobbyButton or Theme.Panel,
			CornerRadius = RADIUS_BUTTON,
			ZIndex = 21,
		}, item.action)
		drawRailIcon(button, item.kind, item.active and Theme.White or Theme.InkSoft)
		if not item.active then
			Theme.stroke(button, Theme.LobbyGrid, 1, 0.1)
		end
	end

	self.playButton = self:button(page, "Jouer", {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0.8, 0, 0, PLAY_HEIGHT),
		BackgroundColor3 = Theme.LobbyButton,
		TextColor3 = Theme.White,
		TextSize = 24,
		CornerRadius = RADIUS_BUTTON,
		ZIndex = 20,
	}, function()
		self:startSelected()
	end)
	Theme.maxSize(self.playButton, 340, PLAY_HEIGHT)

	self.mapHint = Theme.label(page, "Cliquez sur une ville pour la sélectionner  ·  double-cliquez pour jouer", {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0.8, 0, 0, HINT_HEIGHT),
		TextSize = 13,
		TextColor3 = Theme.InkSoft,
		ZIndex = 20,
	})
	Theme.textScaled(self.mapHint, 13, 8)
	Theme.maxSize(self.mapHint, 560, HINT_HEIGHT)
end

function Lobby:buildCard(parent, map, order)
	local holder = Theme.new("Frame", {
		Name = "Card_" .. map.id,
		Parent = parent,
		Size = UDim2.fromOffset(CARD_WIDTH, CARD_HEIGHT),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = order,
		ZIndex = 2,
	})

	-- Toute la carte est dessinée à taille de référence puis mise à l'échelle
	-- par UIScale : textes et aperçu restent proportionnés sur petit écran.
	local inner = Theme.new("Frame", {
		Parent = holder,
		Size = UDim2.fromOffset(CARD_WIDTH, CARD_HEIGHT),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
	})
	local scale = Instance.new("UIScale")
	scale.Parent = inner

	local shadow = plate(inner, {
		Position = UDim2.fromOffset(7, 9),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.CardShadow,
		BackgroundTransparency = 0.05,
		ZIndex = 1,
	}, UDim.new(0, RADIUS_CARD))

	local card = plate(inner, {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Panel,
		ClipsDescendants = true,
		ZIndex = 2,
	}, UDim.new(0, RADIUS_CARD))

	local header = Theme.new("Frame", {
		Parent = card,
		Size = UDim2.new(1, 0, 0.45, 0),
		BackgroundColor3 = map.header,
		BorderSizePixel = 0,
		ZIndex = 2,
	})
	local headerGradient = Instance.new("UIGradient")
	headerGradient.Rotation = 90
	headerGradient.Color = ColorSequence.new(map.header:Lerp(Theme.White, 0.16), map.header)
	headerGradient.Parent = header

	MapPreview.create(header, map, 178, UDim2.fromScale(0.5, 0.035), Vector2.new(0.5, 0))

	local modeBadge = Theme.label(card, string.upper(map.mode), {
		Position = UDim2.fromOffset(14, 14),
		Size = UDim2.fromOffset(96, 22),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.12,
		TextSize = 11,
		Font = Theme.FontBold,
		TextColor3 = map.header:Lerp(Theme.Ink, 0.55),
		ZIndex = 12,
	})
	Theme.corner(modeBadge, Theme.Radius.Pill)

	Theme.label(card, map.name, {
		Position = UDim2.fromScale(0.5, 0.475),
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0.9, 0, 0.07, 0),
		Font = Theme.FontBlack,
		TextSize = 24,
		TextColor3 = Theme.Ink,
		ZIndex = 4,
	})

	local bestLabel = Theme.label(card, "Meilleur : " .. NO_SCORE, {
		Position = UDim2.fromScale(0.5, 0.548),
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0.9, 0, 0.04, 0),
		TextSize = 15,
		TextColor3 = Theme.InkSoft,
		ZIndex = 4,
	})

	plate(card, {
		Position = UDim2.fromScale(0.1, 0.605),
		Size = UDim2.new(0.8, 0, 0, 2),
		BackgroundColor3 = Theme.Border,
		ZIndex = 4,
	})

	Theme.label(card, map.description, {
		Position = UDim2.fromScale(0.1, 0.635),
		Size = UDim2.new(0.8, 0, 0.24, 0),
		TextSize = 14,
		TextColor3 = Theme.InkSoft,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 4,
	})

	local selectedBadge = Theme.label(card, "SÉLECTIONNÉE", {
		Position = UDim2.fromScale(0.5, 0.905),
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(146, 26),
		BackgroundColor3 = Theme.LobbyOrange,
		BackgroundTransparency = 0,
		TextSize = 11,
		Font = Theme.FontBold,
		TextColor3 = Theme.Ink,
		Visible = false,
		ZIndex = 4,
	})
	Theme.corner(selectedBadge, Theme.Radius.Pill)

	-- Contour de sélection : fin et menthe, jamais noir et épais.
	local stroke = Theme.stroke(card, Theme.LobbyButton, 2, 1)

	local hit = Theme.new("TextButton", {
		Parent = card,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Active = true,
		Selectable = true,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		ZIndex = 20,
	})
	local lastHit = 0
	local function activateCard()
		local now = os.clock()
		if now - lastHit < CLICK_DEBOUNCE then
			return
		end
		lastHit = now
		if self.selectedId == map.id
			and self.lastClickId == map.id
			and now - self.lastClickAt < DOUBLE_CLICK_WINDOW
		then
			self.lastClickId = nil
			self:startSelected()
		else
			self:select(map.id)
			self.lastClickId = map.id
			self.lastClickAt = now
		end
	end
	self:track(hit.Activated:Connect(activateCard))
	self:track(hit.MouseButton1Click:Connect(activateCard))

	self.cards[map.id] = {
		holder = holder,
		scale = scale,
		card = card,
		header = header,
		stroke = stroke,
		shadow = shadow,
		bestLabel = bestLabel,
		selectedBadge = selectedBadge,
		map = map,
	}
end

-- Ajuste la zone défilante à la largeur réelle des cartes (échelle comprise).
function Lobby:updateCanvas()
	local scroller = self.scroller
	if not scroller then
		return
	end
	local cardWidth = CARD_WIDTH * self.cardScale
	local contentWidth = #Maps.all() * (cardWidth + CARD_GAP) + CARD_GAP
	local viewportWidth = scroller.AbsoluteSize.X
	scroller.CanvasSize = UDim2.fromOffset(
		math.max(contentWidth, viewportWidth),
		scroller.AbsoluteSize.Y
	)
	self.cardLayout.HorizontalAlignment = contentWidth <= viewportWidth
			and Enum.HorizontalAlignment.Center
		or Enum.HorizontalAlignment.Left
end

-- Modale : fond voilé, carte centrée et mise à l'échelle par updateResponsive.
function Lobby:makeModal(titleText, width, height)
	local overlay = Theme.new("Frame", {
		Parent = self.gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 0.22,
		BorderSizePixel = 0,
		Visible = false,
		Active = true,
		ZIndex = 50,
	})
	table.insert(self.overlays, overlay)

	local card = Theme.new("Frame", {
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		ZIndex = 51,
	})
	Theme.corner(card, RADIUS_MODAL)
	Theme.stroke(card, Theme.Border, 2, 0.1)

	local scale = Instance.new("UIScale")
	scale.Parent = card
	table.insert(self.modalScales, { scale = scale, width = width, height = height })

	local title = Theme.label(card, titleText, {
		Position = UDim2.fromOffset(30, 22),
		Size = UDim2.new(1, -60, 0, 42),
		Font = Theme.FontBlack,
		TextSize = 30,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 52,
	})
	Theme.textScaled(title, 30, 14)

	return overlay, card
end

-- Bouton « Fermer » standard de toutes les modales.
function Lobby:addCloseButton(card, overlay, y, width)
	return self:button(card, "Fermer", {
		Position = UDim2.fromOffset(30, y),
		Size = UDim2.fromOffset(width, 48),
		BackgroundColor3 = Theme.LobbyButton,
		TextColor3 = Theme.White,
		TextSize = 18,
		CornerRadius = RADIUS_BUTTON,
		ZIndex = 52,
	}, function()
		setShown(overlay, false)
	end)
end

function Lobby:buildOptions()
	local overlay, card = self:makeModal("Options", 500, 430)
	self.optionsOverlay = overlay

	Theme.label(card, "Commandes", {
		Position = UDim2.fromOffset(30, 78),
		Size = UDim2.fromOffset(440, 30),
		TextSize = 17,
		Font = Theme.FontBold,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 52,
	})

	Theme.label(
		card,
		"Glissez avec la souris (ou le doigt) pour tracer une route.\n"
			.. "Clic droit pour effacer.  ·  Touches 1 / 2 : route / gomme.\n"
			.. "P : pause.  ·  Chaque semaine, choisissez une amélioration.\n\n"
			.. "Les voitures livrent aux bâtiments de la même couleur.\n"
			.. "Si la jauge de trafic atteint zéro, la partie se termine.",
		{
			Position = UDim2.fromOffset(30, 112),
			Size = UDim2.fromOffset(440, 150),
			TextSize = 14,
			TextColor3 = Theme.InkSoft,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 52,
		}
	)

	-- Réinitialisation en deux temps : le premier clic arme le bouton, le
	-- second efface. Une armure non confirmée retombe toute seule.
	local armed = false
	local reset
	local function setArmed(value)
		armed = value
		local color = value and Theme.Danger or Theme.PanelSoft
		reset.Text = value and "Confirmer ?" or "Réinitialiser mes records"
		reset.BackgroundColor3 = color
		reset.TextColor3 = value and Theme.White or Theme.Danger
		reset:SetAttribute("BaseColor", color)
	end
	reset = self:button(card, "Réinitialiser mes records", {
		Position = UDim2.fromOffset(30, 285),
		Size = UDim2.fromOffset(440, 50),
		BackgroundColor3 = Theme.PanelSoft,
		TextColor3 = Theme.Danger,
		TextSize = 17,
		CornerRadius = RADIUS_BUTTON,
		ZIndex = 52,
	}, function()
		self.resetToken += 1
		if armed then
			setArmed(false)
			if self.callbacks.onResetRecords then
				self.callbacks.onResetRecords()
			end
		else
			setArmed(true)
			local token = self.resetToken
			task.delay(RESET_ARM_DURATION, function()
				if not self.destroyed and token == self.resetToken then
					setArmed(false)
				end
			end)
		end
	end)
	Theme.stroke(reset, Theme.Danger, 2, 0.4)

	self:addCloseButton(card, overlay, 350, 440)
end

function Lobby:buildRecords()
	local overlay, card = self:makeModal("Palmarès", 470, 500)
	self.recordsOverlay = overlay

	for index, map in ipairs(Maps.all()) do
		local y = 82 + (index - 1) * 54
		Theme.circle(card, 14, map.header, {
			Position = UDim2.fromOffset(30, y + 10),
			ZIndex = 52,
		})
		Theme.label(card, map.name, {
			Position = UDim2.fromOffset(56, y),
			Size = UDim2.fromOffset(220, 34),
			TextSize = 17,
			TextColor3 = Theme.Ink,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 52,
		})
		self.recordLabels[map.id] = Theme.label(card, NO_SCORE, {
			Position = UDim2.fromOffset(280, y),
			Size = UDim2.fromOffset(160, 34),
			TextSize = 17,
			Font = Theme.FontBold,
			TextColor3 = Theme.Ink,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 52,
		})

		Theme.new("Frame", {
			Parent = card,
			Position = UDim2.fromOffset(30, y + 42),
			Size = UDim2.fromOffset(410, 1),
			BackgroundColor3 = Theme.Border,
			BorderSizePixel = 0,
			ZIndex = 52,
		})
	end

	self:addCloseButton(card, overlay, 430, 410)
end

function Lobby:buildGarage()
	local overlay, card = self:makeModal("Garage", 520, 430)
	self.garageOverlay = overlay

	Theme.label(card, "Votre collection de voitures", {
		Position = UDim2.fromOffset(30, 82),
		Size = UDim2.fromOffset(460, 26),
		TextSize = 16,
		Font = Theme.FontBold,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 52,
	})

	local colors = Config.HouseColors
	for index = 1, #colors do
		local col = (index - 1) % 4
		local row = math.floor((index - 1) / 4)
		local slot = plate(card, {
			Position = UDim2.fromOffset(38 + col * 115, 128 + row * 96),
			Size = UDim2.fromOffset(96, 76),
			BackgroundColor3 = Theme.PanelSoft,
			ZIndex = 52,
		}, UDim.new(0, 8))
		local body = plate(slot, {
			Position = UDim2.fromScale(0.5, 0.42),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(42, 24),
			BackgroundColor3 = colors[index].color,
			ZIndex = 53,
		}, UDim.new(0, 5))
		plate(body, {
			Position = UDim2.fromScale(0.5, 0.36),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromScale(0.62, 0.42),
			BackgroundColor3 = Theme.White,
			ZIndex = 54,
		})
		Theme.label(slot, colors[index].name, {
			Position = UDim2.fromScale(0, 0.78),
			Size = UDim2.fromScale(1, 0.18),
			TextSize = 10,
			Font = Theme.FontBold,
			TextColor3 = Theme.InkSoft,
			ZIndex = 53,
		})
	end

	self:addCloseButton(card, overlay, 360, 460)
end

function Lobby:buildStats()
	local overlay, card = self:makeModal("Statistiques", 500, 430)
	self.statsOverlay = overlay

	local rows = {
		{ key = "total", label = "Meilleur score total", value = "0" },
		{ key = "played", label = "Villes jouées", value = "0" },
		{ key = "bestMap", label = "Meilleure ville", value = NO_SCORE },
		{ key = "average", label = "Moyenne des records", value = NO_SCORE },
	}
	self.statsLabels = {}
	for index, row in ipairs(rows) do
		local y = 88 + (index - 1) * 64
		Theme.label(card, row.label, {
			Position = UDim2.fromOffset(30, y),
			Size = UDim2.fromOffset(250, 26),
			TextSize = 15,
			TextColor3 = Theme.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 52,
		})
		self.statsLabels[row.key] = Theme.label(card, row.value, {
			Position = UDim2.fromOffset(280, y - 4),
			Size = UDim2.fromOffset(190, 34),
			TextSize = 22,
			Font = Theme.FontBlack,
			TextColor3 = Theme.Ink,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 52,
		})
		Theme.new("Frame", {
			Parent = card,
			Position = UDim2.fromOffset(30, y + 38),
			Size = UDim2.fromOffset(440, 1),
			BackgroundColor3 = Theme.Border,
			BorderSizePixel = 0,
			ZIndex = 52,
		})
	end

	self:addCloseButton(card, overlay, 360, 440)
end

function Lobby:buildAbout()
	local overlay, card = self:makeModal("À propos", 520, 380)
	self.aboutOverlay = overlay

	Theme.label(
		card,
		Config.GameName .. " (prototype Roblox)\n\n"
			.. "Inspiré du jeu de gestion de trafic Mini Motorways.\n"
			.. "Tous les visuels (villes, routes, voitures, interface)\n"
			.. "sont générés en code dans Roblox Studio : aucune image importée.\n\n"
			.. "Tracez des routes entre les maisons et les bâtiments de la même couleur.\n"
			.. "Livrez le plus de trajets possible, semaine après semaine, sans\n"
			.. "laisser le trafic s'effondrer.",
		{
			Position = UDim2.fromOffset(30, 82),
			Size = UDim2.fromOffset(460, 210),
			TextSize = 15,
			TextColor3 = Theme.InkSoft,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 52,
		}
	)

	self:addCloseButton(card, overlay, 310, 460)
end

function Lobby:buildToast()
	self.toastLabel = Theme.label(self.gui, "", {
		Position = UDim2.fromScale(0.5, 0.025),
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0.8, 0, 0, 38),
		BackgroundColor3 = Theme.PanelDark,
		BackgroundTransparency = 0.08,
		TextSize = 14,
		TextColor3 = Theme.White,
		Visible = false,
		ZIndex = 60,
	})
	Theme.corner(self.toastLabel, Theme.Radius.Pill)
	Theme.textScaled(self.toastLabel, 14, 8)
	Theme.maxSize(self.toastLabel, 420, 38)
end

function Lobby:refreshLobbyGrid(width, height)
	local grid = self.lobbyGrid
	if not grid then
		return
	end
	local key = tostring(math.floor(width)) .. ":" .. tostring(math.floor(height))
	if self.lobbyGridKey == key then
		return
	end
	self.lobbyGridKey = key
	grid:ClearAllChildren()

	-- Cases carrées : la grille reste identique à la capture, même quand
	-- la fenêtre change de proportions.
	local step = math.max(90, width / 10)
	for x = step, width, step do
		Theme.new("Frame", {
			Parent = grid,
			Position = UDim2.fromOffset(math.floor(x), 0),
			Size = UDim2.new(0, 1, 1, 0),
			BackgroundColor3 = Theme.LobbyGrid,
			BackgroundTransparency = 0.58,
			BorderSizePixel = 0,
			ZIndex = 0,
		})
	end
	for y = step, height, step do
		Theme.new("Frame", {
			Parent = grid,
			Position = UDim2.fromOffset(0, math.floor(y)),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = Theme.LobbyGrid,
			BackgroundTransparency = 0.58,
			BorderSizePixel = 0,
			ZIndex = 0,
		})
	end
end

function Lobby:updateResponsive()
	if self.destroyed then
		return
	end
	local viewport = self.gui.AbsoluteSize
	local width = viewport.X
	local height = viewport.Y
	if width < 2 or height < 2 then
		return
	end

	local layout = Lobby.layoutFor(width, height, self.titleWidth)
	self.cardScale = layout.cardScale
	self:refreshLobbyGrid(width, height)

	self.decoration.Visible = layout.decorVisible
	if layout.decorVisible then
		self:updateDecorationLayout()
	end
	self.rail.Visible = layout.railVisible
	self.rail.Position = UDim2.new(layout.railX, 0, 0, layout.railTop)

	self.titleHolder.Position = UDim2.fromScale(layout.titleX, layout.titleY)
	self.titleScale.Scale = layout.titleScale

	self.menu.Position = UDim2.fromScale(layout.menuX, layout.menuY)
	self.menu.Size = UDim2.new(layout.menuWidth, 0, 0, layout.menuHeight)
	for _, item in ipairs(self.menuItems) do
		item.button.Size = UDim2.new(item.width, 0, 0, layout.buttonHeight)
	end

	self.decorDestination.Size = UDim2.fromOffset(layout.destinationSize, layout.destinationSize)
	self.decorHouse.Size = UDim2.fromOffset(layout.houseSize, layout.houseSize)

	self.infoButton.Size = UDim2.fromOffset(layout.infoSize, layout.infoSize)
	self.infoButton.Position = UDim2.fromScale(layout.infoX, layout.infoY)

	self.mapTitle.Position = UDim2.fromScale(0.5, layout.mapTitleY)
	self.mapTitle.Size = UDim2.fromScale(layout.mapTitleWidth, 0.06)
	self.mapSubtitle.Position = UDim2.fromScale(0.5, layout.subtitleY)
	self.mapSubtitle.Size = UDim2.fromScale(layout.subtitleWidth, 0.028)

	self.backButton.Position = UDim2.fromScale(0.03, layout.backY)
	self.backButton.Size = UDim2.fromOffset(layout.backWidth, layout.backHeight)

	self.scroller.Position = UDim2.new(layout.scrollerX, 0, 0, layout.scrollerTop)
	self.scroller.Size = UDim2.new(layout.scrollerWidth, 0, 0, layout.scrollerHeight)
	for _, entry in pairs(self.cards) do
		entry.holder.Size = UDim2.fromOffset(layout.cardWidth, layout.cardHeight)
		entry.scale.Scale = layout.cardScale
	end
	self:updateCanvas()

	self.playButton.Position = UDim2.new(0.5, 0, 0, layout.playTop)
	self.playButton.Size = UDim2.new(0.8, 0, 0, layout.playHeight)
	self.mapHint.Visible = layout.hintVisible
	self.mapHint.Position = UDim2.new(0.5, 0, 0, layout.hintTop)

	for _, entry in ipairs(self.modalScales) do
		local fit = math.min(1, (width * 0.92) / entry.width, (height * 0.9) / entry.height)
		entry.scale.Scale = math.max(0.35, fit)
	end

	self:syncFrameLoop()
end

function Lobby:select(mapId)
	if not mapId or not self.cards[mapId] then
		return
	end
	self.selectedId = mapId

	for id, entry in pairs(self.cards) do
		local selected = id == mapId
		entry.stroke.Transparency = selected and 0 or 1
		entry.shadow.BackgroundTransparency = selected and 0.02 or 0.08
		entry.selectedBadge.Visible = selected
	end

	local map = Maps.getById(mapId)
	if map and self.playButton then
		self.playButton.Text = "Jouer  ·  " .. map.name
	end
end

function Lobby:startSelected()
	if self.callbacks.onStartMap then
		self.callbacks.onStartMap(self.selectedId)
	end
end

function Lobby:show()
	if self.destroyed then
		return
	end
	self.gui.Enabled = true
	setShown(self.mainPage, true)
	setShown(self.mapPage, false)
	for _, overlay in ipairs(self.overlays) do
		setShown(overlay, false)
	end
	self:updateResponsive()
	self:syncFrameLoop()
end

function Lobby:hide()
	if self.destroyed then
		return
	end
	self.gui.Enabled = false
	self:syncFrameLoop()
end

function Lobby:showMaps()
	setShown(self.mainPage, false)
	setShown(self.mapPage, true)
	self:select(self.selectedId)
	self:updateResponsive()
	self:syncFrameLoop()
end

function Lobby:showMain()
	setShown(self.mapPage, false)
	setShown(self.mainPage, true)
	self:syncFrameLoop()
end

function Lobby:showOptions()
	self.optionsOverlay.Visible = true
end

function Lobby:showRecords()
	self.recordsOverlay.Visible = true
end

function Lobby:showGarage()
	self.garageOverlay.Visible = true
end

function Lobby:showStats()
	self.statsOverlay.Visible = true
end

function Lobby:showAbout()
	self.aboutOverlay.Visible = true
end

-- Profil : tableau « identifiant de carte -> meilleur score ». Une valeur
-- absente ou invalide compte pour 0 ; un profil mal formé vide l'affichage.
function Lobby:setProfile(profile)
	local scores = typeof(profile) == "table" and profile or {}

	local total = 0
	local played = 0
	local bestMap = nil
	local bestScore = 0
	for _, map in ipairs(Maps.all()) do
		local best = bestOf(scores[map.id])
		total += best
		if best > 0 then
			played += 1
		end
		if best > bestScore then
			bestScore = best
			bestMap = map
		end
		local text = best > 0 and tostring(best) or NO_SCORE
		local entry = self.cards[map.id]
		if entry then
			entry.bestLabel.Text = "Meilleur : " .. text
		end
		local record = self.recordLabels[map.id]
		if record then
			record.Text = text
		end
	end

	local stats = self.statsLabels
	if stats then
		stats.total.Text = tostring(total)
		stats.played.Text = tostring(played)
		stats.bestMap.Text = bestMap and bestMap.name or NO_SCORE
		stats.average.Text = played > 0 and string.format("%.1f", total / played) or NO_SCORE
	end
end

function Lobby:toast(text)
	if self.destroyed or not self.toastLabel then
		return
	end
	self.toastToken += 1
	local token = self.toastToken
	self.toastLabel.Text = text
	self.toastLabel.Visible = true
	task.delay(TOAST_DURATION, function()
		if not self.destroyed and self.toastToken == token then
			self.toastLabel.Visible = false
		end
	end)
end

-- Libère toutes les connexions et l'interface. L'instance ne doit plus servir.
function Lobby:destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	self:stopFrameLoop()
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	self.connections = {}
	self.callbacks = {}
	self.gui:Destroy()
end

return Lobby
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">MapPreview</string>
              <ProtectedString name="Source"><![CDATA[--[[
	MapPreview.luau
	Dessine l'aperçu circulaire d'une carte dans le menu, avec les formes de
	Maps.luau et le même ordre de superposition que WorldBuilder : parcs, liseré
	de côte, eau, puis presqu'îles (liseré, terre sèche). Viennent ensuite le
	réseau et les maisons. Aucune image, aucun libellé.

	Roblox n'a pas d'ellipse native. Une forme elliptique est donc un seul Frame
	dont les coins ont un rayon de 50 % : un disque si rx = ry, sinon une capsule
	de même encombrement que l'ellipse. Le grand axe suit rx, comme dans
	Maps.isWaterAt. Les bouts arrondis des ellipses allongées sont plus pleins
	qu'une vraie ellipse ; les maisons, elles, ne sont jamais posées sur l'eau.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Maps = require(Shared.Maps)

local Theme = require(script.Parent.Theme)

local C = Config.Colors

local MapPreview = {}

-- Réglages, en fractions du diamètre sauf indication contraire (px).
local RING_PADDING = 4 -- px entre le disque et son halo
local HALO_TRANSPARENCY = 0.55 -- halo très doux, pas de liseré dur
-- Liseré de côte : la même épaisseur relative qu'en 3D (Terrain.Shoreline sur
-- le côté du plateau), avec un minimum pour rester visible sur un petit aperçu.
local BOARD_EXTENT = Config.Grid.Size * Config.Grid.TileSize
local SHORE_RATIO = Config.Terrain.Shoreline / BOARD_EXTENT
local SHORE_MIN = 1.8 -- px
local ROAD_THICKNESS = 0.03
local HOUSE_RATIO = 0.075
local HOUSE_MIN = 12 -- px
local DEFAULT_BAR_THICKNESS = 0.04
local MIN_SIZE = 0.5 -- px : une forme plus petite n'est pas dessinée

-- Cadre centré en (x, y), sans bordure. Le zIndex range la forme dans l'ordre
-- de superposition ; rotation est en degrés, sens horaire comme Roblox.
local function addFrame(parent, x, y, width, height, color, zIndex, rotation)
	return Theme.new("Frame", {
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(width, height),
		Rotation = rotation or 0,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = zIndex,
	})
end

-- Coins à 50 % : le cadre devient un disque (carré) ou une capsule (rectangle).
local function roundEnds(frame)
	Theme.corner(frame, UDim.new(0.5, 0))
end

-- Disque centré en (x, y).
local function addDisc(parent, x, y, size, color, zIndex)
	local disc = addFrame(parent, x, y, size, size, color, zIndex)
	roundEnds(disc)
	return disc
end

-- Ellipse : un seul Frame tourné. Le grand axe suit rx dans le repère de la
-- forme (même règle que Maps.isWaterAt), donc tourné de 90 degrés si ry est le
-- plus grand. Un liseré (grow) élargit l'ellipse de chaque côté.
local function drawEllipse(parent, shape, diameter, color, grow, zIndex)
	local rxNorm = shape.rx or shape.r or 0.05
	local ryNorm = shape.ry or shape.r or rxNorm
	local rx = rxNorm * diameter + grow
	local ry = ryNorm * diameter + grow
	local minor = math.min(rx, ry)
	local major = math.max(rx, ry)
	if minor < MIN_SIZE then
		return
	end

	local rotation = shape.rotation or 0
	if ry > rx then
		rotation += 90
	end
	local blob = addFrame(
		parent,
		shape.x * diameter,
		shape.y * diameter,
		major * 2,
		minor * 2,
		color,
		zIndex,
		rotation
	)
	roundEnds(blob)
end

-- Segment épais de (x1, y1) à (x2, y2). Par défaut les deux bouts sont ronds
-- (une seule capsule). Avec flatStart, le bout x1 est une coupe nette côté
-- terre et seul le bout x2 reçoit un capuchon rond, comme en 3D.
local function drawBar(parent, shape, diameter, color, grow, zIndex)
	local x1 = shape.x1 * diameter
	local y1 = shape.y1 * diameter
	local x2 = shape.x2 * diameter
	local y2 = shape.y2 * diameter
	local dx = x2 - x1
	local dy = y2 - y1
	local length = math.sqrt(dx * dx + dy * dy)
	if length <= 0 then
		return
	end
	local thickness = (shape.thickness or DEFAULT_BAR_THICKNESS) * diameter + grow * 2
	local angle = math.deg(math.atan2(dy, dx))
	local centerX = (x1 + x2) * 0.5
	local centerY = (y1 + y2) * 0.5

	if shape.flatStart then
		addFrame(parent, centerX, centerY, length, thickness, color, zIndex, angle)
		addDisc(parent, x2, y2, thickness, color, zIndex)
		return
	end

	-- Capsule : chaque bout rond dépasse du rayon, d'où length + thickness.
	local capsule = addFrame(parent, centerX, centerY, length + thickness, thickness, color, zIndex, angle)
	roundEnds(capsule)
end

-- Rectangle de Maps (rect) : un cadre, avec un arrondi seulement si la forme
-- en demande un. grow élargit le rectangle de chaque côté.
local function drawRect(parent, shape, diameter, color, grow, zIndex)
	local frame = Theme.new("Frame", {
		Parent = parent,
		Position = UDim2.fromOffset(shape.x * diameter - grow, shape.y * diameter - grow),
		Size = UDim2.fromOffset(shape.w * diameter + grow * 2, shape.h * diameter + grow * 2),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = zIndex,
	})
	local radius = (shape.radius or 0) * diameter + grow
	if radius > 0 then
		Theme.corner(frame, radius)
	end
end

-- Dessine une forme de Maps.luau (rect, ellipse, circle, bar). grow élargit la
-- forme de chaque côté : c'est ainsi que le liseré de côte est tracé.
local function drawShape(parent, shape, diameter, color, grow, zIndex)
	local kind = shape.type
	if kind == "rect" then
		drawRect(parent, shape, diameter, color, grow, zIndex)
	elseif kind == "circle" or kind == "ellipse" then
		drawEllipse(parent, shape, diameter, color, grow, zIndex)
	elseif kind == "bar" then
		drawBar(parent, shape, diameter, color, grow, zIndex)
	end
end

function MapPreview.create(parent, map, diameter, position, anchorPoint)
	local id = tostring(map.id or "map")
	local land = map.land or C.Land
	local water = map.water or C.Water
	local grass = map.grass or C.Park
	local coast = C.Coast
	local outline = math.max(SHORE_MIN, diameter * SHORE_RATIO)

	local grassShapes = map.grassShapes or {}
	local waterShapes = map.waterShapes or {}
	local dryShapes = map.dryShapes or {}
	-- Même règle d'eau que la construction (Maps.isWaterAt) : une presqu'île
	-- retire de l'eau, tout le reste est de l'eau si une forme d'eau le couvre.
	local terrain = { waterShapes = waterShapes, dryShapes = dryShapes }

	local wrapperSize = diameter + RING_PADDING * 2
	local wrapper = Theme.new("Frame", {
		Name = "PreviewFrame_" .. id,
		Parent = parent,
		Position = position or UDim2.fromScale(0.5, 0),
		AnchorPoint = anchorPoint or Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(wrapperSize, wrapperSize),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 1,
	})
	-- Halo doux, sans liseré : le cercle se détache par la couleur, pas par un trait.
	Theme.circle(wrapper, wrapperSize, C.RingShadow, {
		Name = "Halo",
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = HALO_TRANSPARENCY,
		ZIndex = 1,
	})

	-- CanvasGroup : il découpe réellement ses enfants selon le cercle, donc l'eau
	-- ne déborde jamais dans les angles.
	local circle = Theme.new("CanvasGroup", {
		Name = "Preview_" .. id,
		Parent = wrapper,
		Position = UDim2.fromOffset(RING_PADDING, RING_PADDING),
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundColor3 = land,
		BorderSizePixel = 0,
		ZIndex = 2,
	})
	Theme.corner(circle, diameter / 2)

	-- Ordre identique à WorldBuilder : parcs, liseré puis eau, presqu'îles.
	for _, shape in ipairs(grassShapes) do
		drawShape(circle, shape, diameter, grass, 0, 1)
	end
	for _, shape in ipairs(waterShapes) do
		drawShape(circle, shape, diameter, coast, outline, 2)
	end
	for _, shape in ipairs(waterShapes) do
		drawShape(circle, shape, diameter, water, 0, 3)
	end
	for _, shape in ipairs(dryShapes) do
		drawShape(circle, shape, diameter, coast, outline, 4)
	end
	for _, shape in ipairs(dryShapes) do
		drawShape(circle, shape, diameter, land, 0, 5)
	end

	-- Réseau : routes anthracite de largeur uniforme, comme en jeu.
	local roads = map.previewRoads or {}
	for _, road in ipairs(roads) do
		if road[1] and road[2] and road[3] and road[4] then
			drawBar(circle, {
				x1 = road[1],
				y1 = road[2],
				x2 = road[3],
				y2 = road[4],
				thickness = ROAD_THICKNESS,
			}, diameter, C.Road, 0, 7)
		end
	end

	-- Maisons : extrémités des routes, hors des bords et hors de l'eau. Chacune a
	-- une ombre décalée, sans contour.
	local houses = Config.HouseColors
	local houseSize = math.max(HOUSE_MIN, diameter * HOUSE_RATIO)
	local seen = {}
	for index, road in ipairs(roads) do
		local points = { { road[1], road[2] }, { road[3], road[4] } }
		for pointIndex, point in ipairs(points) do
			local nx = point[1]
			local ny = point[2]
			if type(nx) == "number" and type(ny) == "number" then
				-- Clé entière au millième : deux extrémités identiques ne tracent qu'une maison.
				local key = math.floor(nx * 1000 + 0.5) * 1000 + math.floor(ny * 1000 + 0.5)
				local inside = nx > 0.02 and nx < 0.98 and ny > 0.02 and ny < 0.98
				if not seen[key] and inside and not Maps.isWaterAt(terrain, nx, ny) then
					seen[key] = true
					local color = C.Teal
					if #houses > 0 then
						color = houses[(index + pointIndex - 1) % #houses + 1].color
					end
					local x = nx * diameter
					local y = ny * diameter
					local shadow = addFrame(circle, x, y + Theme.Shadow.Offset, houseSize, houseSize, C.CardShadow, 8)
					shadow.Name = "HouseShadow"
					shadow.BackgroundTransparency = Theme.Shadow.Transparency
					Theme.corner(shadow, Theme.Radius.Small)
					local house = addFrame(circle, x, y, houseSize, houseSize, color, 9)
					house.Name = "House"
					Theme.corner(house, Theme.Radius.Small)
				end
			end
		end
	end

	return circle
end

return MapPreview
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Theme</string>
              <ProtectedString name="Source"><![CDATA[--[[
	Theme.luau
	Jetons de design et petits constructeurs d'interface, partagés par le menu,
	le HUD et l'aperçu des cartes. Tout est dessiné en code : aucun asset.

	Les couleurs viennent uniquement de Config.Colors : changer la palette là-bas
	suffit. Rayons, contours et durées viennent de Config.Style ; les espacements
	et les échelles de mouvement sont définis ici, pour que l'interface reste
	cohérente d'un écran à l'autre.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local C = Config.Colors
local S = Config.Style

local Theme = {}

-- Couleurs existantes : les modules UI les lisent directement.
Theme.Ink = C.Ink
Theme.InkSoft = C.InkSoft
Theme.Teal = C.Teal
Theme.TealDark = C.TealDark
Theme.Orange = C.Orange
Theme.White = C.White
Theme.Cream = C.Cream
Theme.Background = C.Background
Theme.LobbyBackground = C.LobbyBackground
Theme.LobbyGrid = C.LobbyGrid
Theme.LobbyButton = C.LobbyButton
Theme.LobbyButtonDark = C.LobbyButtonDark
Theme.LobbyOrange = C.LobbyOrange
Theme.LobbyRoad = C.LobbyRoad
Theme.LobbyRoadShadow = C.LobbyRoadShadow
Theme.CardShadow = C.CardShadow
Theme.Danger = C.Danger
Theme.Panel = C.Panel
Theme.PanelSoft = C.PanelSoft
Theme.PanelDark = C.PanelDark
Theme.Border = C.Border

-- Jetons d'usage : chacun désigne un rôle, pas une teinte. Ils ne pointent
-- que vers Config.Colors, donc une seule palette pilote toute l'interface.
Theme.LightGrey = C.Background -- fond général, gris très clair
Theme.OffWhite = C.White -- surfaces et cartes, blanc cassé
Theme.Anthracite = C.Ink -- texte principal
Theme.Accent = C.Teal -- accent pastel principal
Theme.AccentDark = C.TealDark -- liseré d'état
Theme.AccentWarm = C.Orange -- accent chaud, rappel doux
Theme.Selected = C.Orange -- fond d'un outil sélectionné
Theme.Bridge = C.BridgeChip -- pastille « pont » (compteur, choix hebdomadaire)

-- Typographie : familles modernes et lisibles. Les trois graisses servent
-- au texte courant, aux titres et aux chiffres.
Theme.Font = Enum.Font.BuilderSansMedium
Theme.FontBold = Enum.Font.BuilderSansBold
Theme.FontBlack = Enum.Font.BuilderSansExtraBold

-- Échelles. Toute valeur d'interface devrait venir d'ici plutôt que d'un
-- nombre écrit en dur dans un module d'écran.
Theme.Radius = {
	Small = S.CornerRadius.Small,
	Medium = S.CornerRadius.Medium,
	Large = S.CornerRadius.Large,
	-- Coins entièrement arrondis, quelle que soit la taille du bouton.
	Pill = 999,
}
Theme.Space = { XS = 4, S = 8, M = 12, L = 16, XL = 24 }
-- Contours fins et clairs : jamais de gros contour noir.
Theme.Stroke = { Thin = S.Outline.Thin, Max = S.Outline.Max, Transparency = 0.2 }
-- Ombre douce : un cadre décalé et très transparent, sans UIStroke.
Theme.Shadow = { Offset = 3, Transparency = 0.6 }
-- Gabarit commun du HUD, en pixels. Les modules HUDTopBar, HUDCounters,
-- HUDToolbar et HUDResponsive s'y réfèrent : une valeur change ici, et les
-- quatre régions (barre du haut, outils, compteurs, aide) restent alignées.
Theme.Layout = {
	Margin = Theme.Space.L,
	Gap = Theme.Space.S,
	-- Main masque les CoreGui, mais le bouton de menu de Roblox (coin haut
	-- gauche, environ 12 + 44 px) reste affiché : aucun CoreGuiType ne le retire.
	-- Les éléments de ce coin commencent plus à droite pour ne pas le recouvrir.
	TopLeftInset = 60,
	BackSize = 40,
	PanelWidth = 264,
	PanelHeight = 52,
	ControlsWidth = 142,
	ControlsHeight = 36,
	GaugeWidth = 160,
	GaugeHeight = 30,
	-- Compteurs : cinq pastilles identiques tiennent dans 390 px (téléphone).
	ChipWidth = 66,
	ChipHeight = 40,
	ChipGap = 5,
	ChipCount = 5,
	HintHeight = 18,
}
-- Échelles de survol et de clic (Hover, Press, Max) et durées en secondes :
-- Duration est la durée du survol, Fast et Standard servent aux transitions
-- plus longues. Max borne toute échelle à 1.04 pour rester discret.
Theme.Motion = {
	Hover = 1.03,
	Press = 0.97,
	Max = 1.04,
	Duration = S.Motion.Hover,
	Fast = S.Motion.Fast,
	Standard = S.Motion.Standard,
}

function Theme.new(className, props)
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				instance[key] = value
			end
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

-- Arrondi en pixels, ou UDim pour un arrondi relatif (pastille : UDim.new(1, 0)).
function Theme.corner(instance, radius)
	local corner = Instance.new("UICorner")
	if type(radius) == "number" or radius == nil then
		corner.CornerRadius = UDim.new(0, radius or Theme.Radius.Medium)
	else
		corner.CornerRadius = radius
	end
	corner.Parent = instance
	return corner
end

-- Contour fin. L'épaisseur est bornée à Theme.Stroke.Max : un contour plus
-- épais se verrait comme une ligne noire autour des bâtiments et des boutons.
function Theme.stroke(instance, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Theme.Border
	stroke.Thickness = math.min(thickness or Theme.Stroke.Thin, Theme.Stroke.Max)
	stroke.Transparency = transparency or 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = instance
	return stroke
end

function Theme.padding(instance, top, right, bottom, left)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, top)
	padding.PaddingRight = UDim.new(0, right)
	padding.PaddingBottom = UDim.new(0, bottom)
	padding.PaddingLeft = UDim.new(0, left)
	padding.Parent = instance
	return padding
end

function Theme.textScaled(instance, maxTextSize, minTextSize)
	instance.TextScaled = true
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = maxTextSize
	limit.MinTextSize = minTextSize or 8
	limit.Parent = instance
	return limit
end

function Theme.maxSize(instance, maxX, maxY)
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(maxX, maxY)
	limit.Parent = instance
	return limit
end

function Theme.label(parent, text, props)
	local p = props or {}
	p.Parent = parent
	p.Text = text
	p.BackgroundTransparency = p.BackgroundTransparency or 1
	p.BorderSizePixel = 0
	p.Font = p.Font or Theme.Font
	p.TextColor3 = p.TextColor3 or Theme.Ink
	p.TextSize = p.TextSize or 16
	return Theme.new("TextLabel", p)
end

-- Libellé centré dans son parent : ancrage au milieu, alignements centrés et
-- taille bornée. Sert aux chiffres des compteurs, qui doivent rester centrés
-- quelle que soit la résolution.
function Theme.numberLabel(parent, text, props)
	local p = props or {}
	local maxTextSize = p.TextSize or 16
	p.AnchorPoint = Vector2.new(0.5, 0.5)
	p.Position = UDim2.fromScale(0.5, 0.5)
	p.Size = p.Size or UDim2.fromScale(1, 1)
	p.TextXAlignment = Enum.TextXAlignment.Center
	p.TextYAlignment = Enum.TextYAlignment.Center
	p.Font = p.Font or Theme.FontBold
	local label = Theme.label(parent, text, p)
	Theme.textScaled(label, maxTextSize, 8)
	return label
end

-- Ombre douce sans UIStroke : un cadre décalé, très transparent, posé juste
-- derrière la cible. Une ombre enfant serait dessinée par-dessus le fond de
-- la cible, d'où le choix d'un frère placé en ZIndex inférieur.
-- L'ombre suit la cible (ancrage, position, taille, visibilité, ZIndex) et
-- disparaît avec elle. Limites : c'est un frère de la cible, donc à éviter dans
-- un parent à UIListLayout ou UIGridLayout (elle y occuperait sa propre place) ;
-- elle ne suit pas un changement de parent de la cible.
function Theme.shadow(target, radius, offset)
	local parent = target.Parent
	if not parent then
		return nil
	end
	local lift = offset or Theme.Shadow.Offset
	local shadow = Theme.new("Frame", {
		Name = "Shadow",
		Parent = parent,
		BackgroundColor3 = C.CardShadow,
		BackgroundTransparency = Theme.Shadow.Transparency,
		BorderSizePixel = 0,
	})
	Theme.corner(shadow, radius or Theme.Radius.Medium)

	local function follow()
		shadow.AnchorPoint = target.AnchorPoint
		shadow.Position = target.Position + UDim2.fromOffset(0, lift)
		shadow.Size = target.Size
		shadow.Visible = target.Visible
		shadow.ZIndex = target.ZIndex - 1
	end
	follow()

	-- Les changements de la cible sont suivis par des connexions légères, pas par
	-- une boucle : elles sont toutes coupées avec la cible.
	local connections = {}
	for _, property in ipairs({ "AnchorPoint", "Position", "Size", "Visible", "ZIndex" }) do
		table.insert(connections, target:GetPropertyChangedSignal(property):Connect(follow))
	end
	-- L'ombre disparaît avec sa cible, sinon elle resterait affichée seule.
	table.insert(connections, target.Destroying:Connect(function()
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		shadow:Destroy()
	end))
	return shadow
end

-- Carte claire et arrondie. Les options CornerRadius et Shadow ne sont pas
-- des propriétés Roblox : elles sont retirées avant Theme.new.
function Theme.panel(parent, props)
	local p = props or {}
	local radius = p.CornerRadius or Theme.Radius.Large
	local withShadow = p.Shadow
	p.CornerRadius = nil
	p.Shadow = nil
	p.Parent = parent
	p.BackgroundColor3 = p.BackgroundColor3 or Theme.Panel
	p.BorderSizePixel = 0
	local panel = Theme.new("Frame", p)
	Theme.corner(panel, radius)
	if withShadow then
		Theme.shadow(panel, radius)
	end
	return panel
end

-- Pastille : libellé centré sur fond clair, coins entièrement arrondis.
function Theme.pill(parent, text, props)
	local p = props or {}
	p.BackgroundColor3 = p.BackgroundColor3 or Theme.Panel
	p.BackgroundTransparency = p.BackgroundTransparency or 0
	local label = Theme.numberLabel(parent, text, p)
	Theme.corner(label, Theme.Radius.Pill)
	return label
end

-- Tweens. Un nouveau tween remplace celui qui tourne encore pour la même
-- propriété (slot) : deux animations ne se disputent jamais une valeur.
-- Une table à clés faibles évite de retenir les instances détruites ; l'entrée
-- est retirée dès que le tween se termine ou est annulé.
local activeTweens = setmetatable({}, { __mode = "k" })

function Theme.tween(instance, goal, slot, duration)
	-- Sans slot, un emplacement commun : une clé nil ferait échouer la table.
	slot = slot or "default"
	local slots = activeTweens[instance]
	if not slots then
		slots = {}
		activeTweens[instance] = slots
	end
	local previous = slots[slot]
	if previous then
		previous:Cancel()
	end
	local info = TweenInfo.new(duration or Theme.Motion.Duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(instance, info, goal)
	slots[slot] = tween
	local connection
	connection = tween.Completed:Connect(function()
		connection:Disconnect()
		if slots[slot] == tween then
			slots[slot] = nil
		end
	end)
	tween:Play()
	return tween
end

-- Annule les tweens de Theme.tween encore actifs sur instance.
function Theme.stopTweens(instance)
	local slots = activeTweens[instance]
	if not slots then
		return
	end
	activeTweens[instance] = nil
	for _, tween in pairs(slots) do
		tween:Cancel()
	end
end

-- Annule le tween d'un seul emplacement (les autres animations de la cible continuent).
local function cancelSlot(instance, slot)
	local slots = activeTweens[instance]
	local tween = slots and slots[slot]
	if tween then
		slots[slot] = nil
		tween:Cancel()
	end
end

-- Remises à zéro du survol, par cible. Une cible cachée par un ancêtre (couche
-- fermée, page changée) ne signale pas toujours MouseLeave : sans ce rappel
-- elle réapparaîtrait en état de survol. Theme.motion et Theme.button y
-- inscrivent chacun la leur ; l'entrée disparaît avec la cible. addHoverReset
-- renvoie la fonction qui retire l'inscription (et sa connexion, si c'était la
-- dernière).
local hoverResets = setmetatable({}, { __mode = "k" })

local function addHoverReset(target, reset)
	local entry = hoverResets[target]
	if not entry then
		entry = { list = {} }
		entry.connection = target.Destroying:Connect(function()
			hoverResets[target] = nil
		end)
		hoverResets[target] = entry
	end
	table.insert(entry.list, reset)
	return function()
		local index = table.find(entry.list, reset)
		if index then
			table.remove(entry.list, index)
		end
		if #entry.list == 0 and hoverResets[target] == entry then
			entry.connection:Disconnect()
			hoverResets[target] = nil
		end
	end
end

-- Ramène à l'état de repos, sans animation, le survol de root et de tous ses
-- descendants (à appeler quand une couche ou une page est cachée).
function Theme.resetHover(root)
	local function reset(instance)
		local entry = hoverResets[instance]
		if entry then
			-- Copie : une remise à zéro ne doit pas modifier la liste qu'on parcourt.
			for _, fn in ipairs(table.clone(entry.list)) do
				fn()
			end
		end
	end
	reset(root)
	for _, descendant in ipairs(root:GetDescendants()) do
		reset(descendant)
	end
end

-- Un doigt qui se relève ne déclenche pas toujours MouseLeave : la fin du
-- toucher remet donc le survol à zéro.
local function isTouch(input)
	return input.UserInputType == Enum.UserInputType.Touch
end

-- Survol et clic : une échelle (UIScale enfant) animée en Quad, jamais au-delà
-- de Theme.Motion.Max. Un même objet ne reçoit qu'un seul moteur d'animation ;
-- handle:destroy() coupe les connexions, annule les tweens et retire l'échelle.
-- Ne pas l'appliquer à une cible qui a déjà un UIScale de mise à l'échelle
-- d'écran : deux UIScale sur un même objet se disputent la taille.
local motions = setmetatable({}, { __mode = "k" })

function Theme.motion(target, options)
	local existing = motions[target]
	if existing then
		return existing
	end
	local hoverScale = math.min((options and options.hover) or Theme.Motion.Hover, Theme.Motion.Max)
	local pressScale = math.min((options and options.press) or Theme.Motion.Press, Theme.Motion.Max)
	local scale = Theme.new("UIScale", { Name = "MotionScale", Parent = target })
	local hovered = false
	local pressed = false
	local connections = {}
	local destroyed = false

	local function refresh()
		local goal = 1
		if pressed then
			goal = pressScale
		elseif hovered then
			goal = hoverScale
		end
		Theme.tween(scale, { Scale = goal }, "scale")
	end

	table.insert(connections, target.MouseEnter:Connect(function()
		hovered = true
		refresh()
	end))
	table.insert(connections, target.MouseLeave:Connect(function()
		hovered = false
		pressed = false
		refresh()
	end))
	-- Seuls les boutons ont un clic ; un simple cadre garde survol et sortie.
	if target:IsA("GuiButton") then
		table.insert(connections, target.MouseButton1Down:Connect(function()
			pressed = true
			refresh()
		end))
		table.insert(connections, target.MouseButton1Up:Connect(function()
			pressed = false
			refresh()
		end))
	end

	-- Une cible cachée ou sortie de l'arbre ne reçoit plus de MouseLeave : sans
	-- ces liens, son survol resterait figé. On réagit au changement de Visible et
	-- de parent, sans surveiller l'interface à chaque image.
	local function clearState()
		hovered = false
		pressed = false
		refresh()
	end
	table.insert(connections, target:GetPropertyChangedSignal("Visible"):Connect(function()
		if not target.Visible then
			clearState()
		end
	end))
	table.insert(connections, target.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			clearState()
		end
	end))
	table.insert(connections, target.InputEnded:Connect(function(input)
		if isTouch(input) then
			clearState()
		end
	end))
	local removeReset = addHoverReset(target, function()
		hovered = false
		pressed = false
		Theme.stopTweens(scale)
		scale.Scale = 1
	end)

	local handle = {}
	function handle:destroy()
		if destroyed then
			return
		end
		destroyed = true
		removeReset()
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		table.clear(connections)
		Theme.stopTweens(scale)
		scale:Destroy()
		motions[target] = nil
	end
	-- Sans ce lien, la table faible garderait la cible vivante (la fermeture du
	-- handle la référence) tant que destroy n'est pas appelé.
	table.insert(connections, target.Destroying:Connect(function()
		handle:destroy()
	end))
	motions[target] = handle
	return handle
end

-- État sélectionné d'un bouton d'outil : fond d'accent et liseré fin. La
-- couleur de repos est mémorisée au premier appel, puis restaurée.
function Theme.setSelected(button, selected)
	local ring = button:FindFirstChild("SelectionRing")
	if not ring then
		ring = Theme.stroke(button, Theme.AccentDark, Theme.Stroke.Thin, 1)
		ring.Name = "SelectionRing"
	end
	local idle = button:GetAttribute("IdleColor")
	if not idle then
		idle = button.BackgroundColor3
		button:SetAttribute("IdleColor", idle)
	end
	local color = selected and Theme.Selected or idle
	-- BaseColor sert à Theme.button : le survol repart de la couleur courante.
	button:SetAttribute("BaseColor", color)
	Theme.tween(button, { BackgroundColor3 = color }, "color")
	Theme.tween(ring, { Transparency = selected and 0 or 1 }, "ring")
end

function Theme.button(parent, text, props, onClick)
	local p = props or {}
	local cornerRadius = p.CornerRadius
	p.CornerRadius = nil
	p.Parent = parent
	p.Text = text
	p.Active = true
	p.Selectable = true
	p.AutoButtonColor = false
	p.BorderSizePixel = 0
	p.Font = p.Font or Theme.FontBold
	p.TextColor3 = p.TextColor3 or Theme.White
	p.TextSize = p.TextSize or 24
	p.BackgroundColor3 = p.BackgroundColor3 or Theme.Teal

	local maxTextSize = p.TextSize or 24
	local button = Theme.new("TextButton", p)
	Theme.corner(button, cornerRadius or Theme.Radius.Medium)

	button.TextScaled = true
	local textLimit = Instance.new("UITextSizeConstraint")
	textLimit.MaxTextSize = maxTextSize
	textLimit.MinTextSize = 9
	textLimit.Parent = button

	local baseColor = button.BackgroundColor3
	button:SetAttribute("BaseColor", baseColor)

	local function currentBaseColor()
		return button:GetAttribute("BaseColor") or baseColor
	end

	button.MouseEnter:Connect(function()
		if button.Active then
			Theme.tween(button, {
				BackgroundColor3 = currentBaseColor():Lerp(Color3.new(0, 0, 0), 0.09),
			}, "color")
		end
	end)
	button.MouseLeave:Connect(function()
		Theme.tween(button, { BackgroundColor3 = currentBaseColor() }, "color")
	end)
	-- Un bouton caché pendant le survol ne reçoit pas de MouseLeave : sa couleur
	-- repart de la base dès qu'il disparaît, sans attendre le pointeur.
	button:GetPropertyChangedSignal("Visible"):Connect(function()
		if not button.Visible then
			Theme.tween(button, { BackgroundColor3 = currentBaseColor() }, "color")
		end
	end)
	button.InputEnded:Connect(function(input)
		if isTouch(input) then
			Theme.tween(button, { BackgroundColor3 = currentBaseColor() }, "color")
		end
	end)
	addHoverReset(button, function()
		cancelSlot(button, "color")
		button.BackgroundColor3 = currentBaseColor()
	end)
	-- Activated couvre souris / tactile / manette. MouseButton1Click sert de
	-- filet de sécurité sur certaines versions de Studio ; le debounce évite
	-- qu'un même clic déclenche deux fois l'action.
	local lastActivation = 0
	local function activate()
		local now = os.clock()
		if now - lastActivation < 0.12 then
			return
		end
		lastActivation = now
		if onClick then
			onClick()
		end
	end
	button.Activated:Connect(activate)
	button.MouseButton1Click:Connect(activate)

	return button
end

function Theme.circle(parent, diameter, color, props)
	local p = props or {}
	p.Parent = parent
	p.BackgroundColor3 = color
	p.Size = p.Size or UDim2.fromOffset(diameter, diameter)
	p.BorderSizePixel = 0
	local circle = Theme.new("Frame", p)
	Theme.corner(circle, diameter / 2)
	return circle
end

function Theme.grid(parent, step, color, transparency)
	local container = Theme.new("Frame", {
		Name = "GridPattern",
		Parent = parent,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	})
	for i = 1, math.floor(1 / step) - 1 do
		Theme.new("Frame", {
			Parent = container,
			Position = UDim2.fromScale(i * step, 0),
			Size = UDim2.new(0, 1, 1, 0),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency or 0.4,
			BorderSizePixel = 0,
		})
		Theme.new("Frame", {
			Parent = container,
			Position = UDim2.fromScale(0, i * step),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency or 0.4,
			BorderSizePixel = 0,
		})
	end
	return container
end

return Theme
]]></ProtectedString>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="50">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>