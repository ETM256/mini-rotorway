			{ type = "bar", x1 = 0.580, y1 = 0.700, x2 = 0.870, y2 = 0.740, thickness = 0.060 },
			{ type = "bar", x1 = 0.700, y1 = 0.750, x2 = 0.860, y2 = 0.760, thickness = 0.080 },
			-- Chenal vertical, fin, qui rejoint la baie.
			{ type = "bar", x1 = 0.70, y1 = 0.32, x2 = 0.70, y2 = 0.70, thickness = 0.018 },
			{ type = "ellipse", x = 0.70, y = 0.70, rx = 0.075, ry = 0.050 },
		},
		-- Presqu'île crème au centre de la baie : le raccord au continent
		-- est coupé à ras du littoral, sans gros capuchon rond. Seule la
		-- pointe côté eau reste arrondie.
		dryShapes = {
			{
				type = "bar",
				x1 = 0.540,
				y1 = 0.680,
				x2 = 0.540,
				y2 = 0.820,
				thickness = 0.100,
				flatStart = true,
			},
		},
		grassShapes = {
			-- Parc allongé en haut à droite, avec un petit point détaché.
			{ type = "ellipse", x = 0.7905, y = 0.1976, rx = 0.0526, ry = 0.1187, rotation = 140.6 },
			{ type = "circle", x = 0.88, y = 0.28, r = 0.020 },
			-- Parc étroit qui longe la côte ouest.
			{ type = "ellipse", x = 0.2019, y = 0.3646, rx = 0.0275, ry = 0.1261, rotation = 145.9 },
			-- Parc de la presqu'île, en bas à gauche.
			{ type = "ellipse", x = 0.310, y = 0.700, rx = 0.080, ry = 0.120, rotation = 54 },
			{ type = "circle", x = 0.35, y = 0.72, r = 0.018 },
		},
	},
	{
		id = "beijing",
		name = "Pékin",
		mode = "Classique",
		description = "Construisez les routes qui permettent aux millions d'habitants de Pékin d'arriver au travail à l'heure.",
		header = Color3.fromHex("7AA09E"),
		accent = Color3.fromHex("5F8A88"),
		labels = {
			{ text = "PÉKIN", side = "right" },
			{ text = "HAIDIAN", side = "left" },
		},
		previewRoads = {
			{ 0.18, 0.34, 0.82, 0.34 },
			{ 0.55, 0.18, 0.55, 0.78 },
			{ 0.34, 0.56, 0.82, 0.56 },
			{ 0.18, 0.34, 0.18, 0.62 },
		},
		waterShapes = {
			{ type = "rect", x = -0.10, y = -0.12, w = 1.20, h = 0.20, radius = 0.06 },
			{ type = "bar", x1 = -0.05, y1 = 0.085, x2 = 0.45, y2 = 0.060, thickness = 0.050 },
			{ type = "bar", x1 = 0.45, y1 = 0.060, x2 = 1.05, y2 = 0.085, thickness = 0.050 },
			{ type = "ellipse", x = 0.73, y = 0.28, rx = 0.075, ry = 0.055 },
			{ type = "ellipse", x = 0.22, y = 0.72, rx = 0.045, ry = 0.060 },
			{ type = "bar", x1 = 0.47, y1 = 0.62, x2 = 0.47, y2 = 0.86, thickness = 0.032 },
		},
		grassShapes = {
			{ type = "ellipse", x = 0.33, y = 0.42, rx = 0.12, ry = 0.09 },
			{ type = "ellipse", x = 0.78, y = 0.72, rx = 0.10, ry = 0.07 },
		},
		isWater = function(nx, ny)
			if ny < 0.07 + 0.012 * math.sin(nx * 16) then
				return true
			end
			if circle(nx, ny, 0.73, 0.28, 0.075, 0.055) then
				return true
			end
			if circle(nx, ny, 0.22, 0.72, 0.045, 0.06) then
				return true
			end
			if math.abs(nx - 0.47) < 0.012 and ny > 0.62 and ny < 0.86 then
				return true
			end
			return false
		end,
	},
	{
		id = "tokyo",
		name = "Tokyo",
		mode = "Classique",
		description = "Reliez les quartiers de Tokyo, la plus grande métropole du monde.",
		header = Color3.fromHex("E9A7A0"),
		accent = Color3.fromHex("D98A82"),
		labels = {
			{ text = "TOKYO", side = "right" },
			{ text = "SHIBUYA", side = "left" },
		},
		previewRoads = {
			{ 0.20, 0.22, 0.70, 0.22 },
			{ 0.70, 0.22, 0.70, 0.60 },
			{ 0.30, 0.46, 0.74, 0.46 },
			{ 0.20, 0.22, 0.20, 0.52 },
		},
		waterShapes = {
			{ type = "ellipse", x = 0.88, y = 0.90, rx = 0.26, ry = 0.22 },
			{ type = "bar", x1 = 0.28, y1 = 0.83, x2 = 1.02, y2 = 0.18, thickness = 0.045 },
		},
		grassShapes = {
			{ type = "ellipse", x = 0.36, y = 0.28, rx = 0.10, ry = 0.07 },
			{ type = "ellipse", x = 0.55, y = 0.70, rx = 0.09, ry = 0.06 },
		},
		isWater = function(nx, ny)
			if circle(nx, ny, 0.88, 0.90, 0.26, 0.22) then
				return true
			end
			if math.abs(0.9 * nx + ny - 1.08) < 0.022 and nx > 0.28 and ny > 0.15 then
				return true
			end
			return false
		end,
	},
	{
		id = "dar_es_salam",
		name = "Dar es Salaam",
		mode = "Classique",
		description = "Développez votre réseau pour suivre la croissance rapide de Dar es Salaam.",
		header = Color3.fromHex("B5E0CE"),
		accent = Color3.fromHex("8FCBB4"),
		labels = {
			{ text = "DAR ES SALAAM", side = "right" },
			{ text = "KIGAMBONI", side = "left" },
		},
		previewRoads = {
			{ 0.14, 0.64, 0.58, 0.64 },
			{ 0.58, 0.64, 0.58, 0.32 },
			{ 0.30, 0.42, 0.76, 0.42 },
			{ 0.58, 0.32, 0.82, 0.32 },
		},
		waterShapes = {
			{ type = "rect", x = 0.82, y = -0.20, w = 0.25, h = 1.40, radius = 0.16 },
			{ type = "circle", x = 0.84, y = 0.06, r = 0.060 },
			{ type = "circle", x = 0.81, y = 0.18, r = 0.070 },
			{ type = "circle", x = 0.84, y = 0.31, r = 0.060 },
			{ type = "circle", x = 0.80, y = 0.44, r = 0.070 },
			{ type = "circle", x = 0.84, y = 0.57, r = 0.060 },
			{ type = "circle", x = 0.81, y = 0.70, r = 0.070 },
			{ type = "circle", x = 0.84, y = 0.83, r = 0.060 },
			{ type = "circle", x = 0.80, y = 0.94, r = 0.070 },
			{ type = "ellipse", x = 0.62, y = 0.18, rx = 0.10, ry = 0.07 },
			{ type = "bar", x1 = 0.45, y1 = 0.60, x2 = 0.72, y2 = 0.64, thickness = 0.032 },
			{ type = "bar", x1 = 0.72, y1 = 0.64, x2 = 1.05, y2 = 0.62, thickness = 0.032 },
		},
		grassShapes = {
			{ type = "ellipse", x = 0.32, y = 0.28, rx = 0.12, ry = 0.08 },
			{ type = "ellipse", x = 0.52, y = 0.76, rx = 0.10, ry = 0.07 },
		},
		isWater = function(nx, ny)
			local coast = 0.87 - 0.03 * math.sin(ny * 8)
			if nx > coast then
				return true
			end
			if circle(nx, ny, 0.62, 0.18, 0.10, 0.07) then
				return true
			end
			if math.abs(ny - (0.62 + 0.05 * math.sin(nx * 9))) < 0.016 and nx > 0.45 then
				return true
			end
			return false
		end,
	},
	{
		id = "london",
		name = "Londres",
		mode = "Classique",
		description = "Traversez la Tamise et redessinez les rues de la capitale britannique.",
		header = Color3.fromHex("C9D6D9"),
		accent = Color3.fromHex("A8B8C0"),
		labels = {
			{ text = "LONDRES", side = "right" },
			{ text = "SOUTH BANK", side = "left" },
		},
		previewRoads = {
			{ 0.20, 0.28, 0.80, 0.28 },
			{ 0.50, 0.24, 0.50, 0.72 },
			{ 0.25, 0.72, 0.75, 0.72 },
			{ 0.25, 0.72, 0.25, 0.86 },
		},
		waterShapes = {
			{ type = "bar", x1 = -0.05, y1 = 0.52, x2 = 0.25, y2 = 0.62, thickness = 0.100 },
			{ type = "bar", x1 = 0.25, y1 = 0.62, x2 = 0.50, y2 = 0.52, thickness = 0.100 },
			{ type = "bar", x1 = 0.50, y1 = 0.52, x2 = 0.75, y2 = 0.42, thickness = 0.100 },
			{ type = "bar", x1 = 0.75, y1 = 0.42, x2 = 1.05, y2 = 0.48, thickness = 0.100 },
			{ type = "ellipse", x = 0.18, y = 0.62, rx = 0.045, ry = 0.035 },
		},
		grassShapes = {
			{ type = "ellipse", x = 0.72, y = 0.72, rx = 0.12, ry = 0.08 },
			{ type = "ellipse", x = 0.30, y = 0.28, rx = 0.09, ry = 0.06 },
		},
		isWater = function(nx, ny)
			local riverY = 0.52 + 0.10 * math.sin(nx * 5.0)
			if math.abs(ny - riverY) < 0.05 then
				return true
			end
			if circle(nx, ny, 0.18, 0.62, 0.045, 0.035) then
				return true
			end
			return false
		end,
	},
}

-- Couleurs communes : le papier crème et l'eau menthe restent identiques
-- d'une carte à l'autre, seuls les en-têtes et accents changent.
for _, map in ipairs(list) do
	map.land = map.land or C.Land
	map.water = map.water or C.Water
	map.waterEdge = map.waterEdge or C.WaterEdge
	map.waterDeep = map.waterDeep or C.WaterDeep
	map.grass = map.grass or C.Grass
	map.mode = map.mode or "Classique"
	map.labels = map.labels or {}
	map.grassShapes = map.grassShapes or {}
	map.dryShapes = map.dryShapes or {}
	map.dryPatches = map.dryPatches or {}
end

function Maps.all()
	return list
end

function Maps.getById(id)
	for _, map in ipairs(list) do
		if map.id == id then
			return map
		end
	end
	return nil
end

-- Teste un point normalisé contre une forme d'eau / d'herbe.
-- Les mêmes formes servent à l'aperçu du menu et au rendu 3D du terrain.
local function pointInShape(shape, nx, ny)
	if shape.type == "rect" then
		return nx >= shape.x
			and nx <= shape.x + shape.w
			and ny >= shape.y
			and ny <= shape.y + shape.h
	end

	if shape.type == "circle" or shape.type == "ellipse" then
		local rx = shape.rx or shape.r or 0.05
		local ry = shape.ry or shape.r or rx
		local dx = nx - shape.x
		local dy = ny - shape.y
		local angle = math.rad(shape.rotation or 0)
		local cosA = math.cos(angle)
		local sinA = math.sin(angle)
		local localX = dx * cosA + dy * sinA
		local localY = -dx * sinA + dy * cosA
		return (localX / rx) * (localX / rx) + (localY / ry) * (localY / ry) <= 1
	end

	if shape.type == "bar" then
		local x1 = shape.x1
		local y1 = shape.y1
		local x2 = shape.x2
		local y2 = shape.y2
		local dx = x2 - x1
		local dy = y2 - y1
		local lengthSquared = dx * dx + dy * dy
		local t = 0
		if lengthSquared > 0 then
			t = ((nx - x1) * dx + (ny - y1) * dy) / lengthSquared
			t = math.clamp(t, 0, 1)
		end
		local px = x1 + dx * t
		local py = y1 + dy * t
		local ddx = nx - px
		local ddy = ny - py
		local radius = (shape.thickness or 0.04) * 0.5
		return ddx * ddx + ddy * ddy <= radius * radius
	end

	return false
end

function Maps.isWater(map, x, y)
	local size = Config.Grid.Size
	local nx = (x + 0.5) / size
	local ny = (y + 0.5) / size

	-- Les presqu'îles et raccords secs reprennent le dessus de l'eau.
	-- Ils doivent donc être considérés comme de la terre pour les routes.
	for _, shape in ipairs(map.dryShapes or {}) do
		if pointInShape(shape, nx, ny) then
			return false
		end
	end
	for _, shape in ipairs(map.dryPatches or {}) do
		if pointInShape(shape, nx, ny) then
			return false
		end
	end

	for _, shape in ipairs(map.waterShapes or {}) do
		if pointInShape(shape, nx, ny) then
			return true
		end
	end
	return false
end

function Maps.isGrass(map, x, y)
	local size = Config.Grid.Size
	local nx = (x + 0.5) / size
	local ny = (y + 0.5) / size
	for _, shape in ipairs(map.grassShapes or {}) do
		if pointInShape(shape, nx, ny) then
			return true
		end
	end
	return false
end

return Maps
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Pathfinding</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Pathfinding.luau
	A* sur la grille de routes, en 8 directions : les diagonales sont
	autorisées. On part d'une case de route et on vise un ensemble de cases
	(les cases de route adjacentes à la destination).
]]

local Grid = require(script.Parent.Grid)

local Pathfinding = {}

-- Une étape diagonale coûte 1 dans notre grille, donc l'heuristique
-- admissible est la distance de Chebyshev (max des deux écarts).
local function chebyshev(x1, y1, x2, y2)
	return math.max(math.abs(x1 - x2), math.abs(y1 - y2))
end

function Pathfinding.find(roads, size, startKey, goalSet)
	if type(startKey) ~= "string" or not roads[startKey] then
		return nil
	end
	if goalSet[startKey] then
		return { startKey }
	end

	local goalCells = {}
	for key in pairs(goalSet) do
		local gx, gy = Grid.parse(key)
		if gx then
			table.insert(goalCells, { gx, gy })
		end
	end
	if #goalCells == 0 then
		return nil
	end

	local open = { [startKey] = true }
	local gScore = { [startKey] = 0 }
	local fScore = { [startKey] = 0 }
	local cameFrom = {}
	local closed = {}

	local function heuristic(key)
		local x, y = Grid.parse(key)
		local best = math.huge
		for _, goal in ipairs(goalCells) do
			local d = chebyshev(x, y, goal[1], goal[2])
			if d < best then
				best = d
			end
		end
		return best
	end

	fScore[startKey] = heuristic(startKey)

	while next(open) ~= nil do
		local current = nil
		local bestF = math.huge
		for key in pairs(open) do
			local f = fScore[key] or math.huge
			if f < bestF then
				current = key
				bestF = f
			end
		end
		if not current then
			break
		end
		if goalSet[current] then
			local path = { current }
			local node = current
			while cameFrom[node] do
				node = cameFrom[node]
				table.insert(path, 1, node)
			end
			return path
		end

		open[current] = nil
		closed[current] = true

		local cx, cy = Grid.parse(current)
		for _, neighbor in ipairs(Grid.neighbors8(cx, cy)) do
			local nx, ny = neighbor[1], neighbor[2]
			if nx >= 0 and ny >= 0 and nx < size and ny < size then
				local nk = Grid.key(nx, ny)
				if roads[nk] and not closed[nk] then
					local tentative = (gScore[current] or math.huge) + 1
					if tentative < (gScore[nk] or math.huge) then
						cameFrom[nk] = current
						gScore[nk] = tentative
						fScore[nk] = tentative + heuristic(nk)
						open[nk] = true
					end
				end
			end
		end
	end

	return nil
end

return Pathfinding
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Remotes</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Remotes.luau
	Crée (côté serveur) et récupère les RemoteEvents partagés.
	Le client utilise WaitForChild pour être sûr qu'ils existent.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local FOLDER_NAME = "MMRemotes"

function Remotes.folder()
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	return folder
end

function Remotes.get(name)
	local folder = Remotes.folder()
	local event = folder:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = folder
	end
	return event
end

function Remotes.setup()
	local names = {
		"StartGame",
		"DrawRoad",
		"EraseRoad",
		"SetPaused",
		"SetSpeed",
		"PlaceRoundabout",
		"WeekChoice",
		"ChooseReward",
		"ReturnToLobby",
		"RequestProfile",
		"ResetRecords",
		"GameStarted",
		"State",
		"GameOver",
		"Toast",
		"Profile",
	}
	for _, name in ipairs(names) do
		Remotes.get(name)
	end
end

return Remotes
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">MiniMotorways</string>
      </Properties>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <ProtectedString name="Source"><![CDATA[--[[
	Bootstrap.server.luau
	Point d'entrée serveur : prépare le monde, les remotes, les profils,
	puis fait tourner une Session par joueur.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Maps = require(Shared.Maps)
local Remotes = require(Shared.Remotes)

local Session = require(script.Parent.Session)
local Profile = require(script.Parent.Profile)

Players.CharacterAutoLoads = false

-- Lumière plate mais nettement moins éblouissante : le plateau reste
-- crème sans virer au blanc, avec assez de contraste pour lire l'eau,
-- les routes et les bâtiments.
Lighting.Brightness = 0.8
Lighting.ClockTime = 12
Lighting.GeographicLatitude = 0
Lighting.Ambient = Color3.fromHex("D8D2C5")
Lighting.OutdoorAmbient = Color3.fromHex("E0D8C9")
Lighting.GlobalShadows = false
Lighting.ShadowSoftness = 0
Lighting.EnvironmentDiffuseScale = 0.45
Lighting.EnvironmentSpecularScale = 0
Lighting.ExposureCompensation = -0.35

local oldWorlds = Workspace:FindFirstChild("MMWorlds")
if oldWorlds then
	oldWorlds:Destroy()
end
local worlds = Instance.new("Folder")
worlds.Name = "MMWorlds"
worlds.Parent = Workspace

Remotes.setup()

local sessions = {}
local worldCounter = 0

local function sendProfile(player)
	local data = Profile.load(player)
	Remotes.get("Profile"):FireClient(player, data)
end

local function startGame(player, mapId)
	if type(mapId) ~= "string" or not Maps.getById(mapId) then
		mapId = Maps.all()[1].id
	end

	local previous = sessions[player]
	if previous then
		previous:destroy()
		sessions[player] = nil
	end

	worldCounter += 1
	local session = Session.new(player, mapId, worldCounter)
	sessions[player] = session
	session:start()
end

local function endSession(player)
	local session = sessions[player]
	if session then
		session:destroy()
		sessions[player] = nil
	end
end

Remotes.get("StartGame").OnServerEvent:Connect(function(player, mapId)
	startGame(player, mapId)
end)

Remotes.get("DrawRoad").OnServerEvent:Connect(function(player, cells)
	local session = sessions[player]
	if not session or type(cells) ~= "table" or #cells > 128 then
		return
	end
	session:drawRoad(cells)
end)

Remotes.get("EraseRoad").OnServerEvent:Connect(function(player, key)
	local session = sessions[player]
	if session and type(key) == "string" then
		session:eraseRoad(key)
	end
end)

Remotes.get("SetPaused").OnServerEvent:Connect(function(player, paused)
	local session = sessions[player]
	if session then
		session:setPaused(paused == true)
	end
end)

Remotes.get("SetSpeed").OnServerEvent:Connect(function(player, speed)
	local session = sessions[player]
	if session then
		session:setSpeed(speed)
	end
end)

Remotes.get("PlaceRoundabout").OnServerEvent:Connect(function(player, x, y)
	local session = sessions[player]
	if session then
		session:placeRoundabout(x, y)
	end
end)

Remotes.get("ChooseReward").OnServerEvent:Connect(function(player, optionId)
	local session = sessions[player]
	if session and type(optionId) == "string" then
		session:chooseReward(optionId)
	end
end)

Remotes.get("ReturnToLobby").OnServerEvent:Connect(function(player)
	endSession(player)
end)

Remotes.get("RequestProfile").OnServerEvent:Connect(function(player)
	sendProfile(player)
end)

Remotes.get("ResetRecords").OnServerEvent:Connect(function(player)
	Profile.reset(player)
	sendProfile(player)
end)

local function onPlayerAdded(player)
	task.spawn(function()
		Profile.load(player)
		sendProfile(player)
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	onPlayerAdded(player)
end

Players.PlayerRemoving:Connect(function(player)
	endSession(player)
	Profile.save(player)
	Profile.forget(player)
end)

RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 0.1)
	for _, session in pairs(sessions) do
		session:update(dt)
	end
end)

game:BindToClose(function()
	for player in pairs(sessions) do
		Profile.save(player)
	end
end)

warn("[MiniMotorways] Server ready — " .. Config.GameName .. " v" .. Config.Version)
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Profile</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Profile.luau
	Meilleurs scores par carte, sauvegardés dans un DataStore.
	En Studio sans API Services, tout fonctionne quand même :
	les scores restent en mémoire pour la session.
]]

local DataStoreService = game:GetService("DataStoreService")

local Profile = {}

local store = nil
local ok, result = pcall(function()
	return DataStoreService:GetDataStore("MiniMotorwaysV1")
end)
if ok then
	store = result
else
	warn("[MiniMotorways] DataStore unavailable: " .. tostring(result))
end

local cache = {}

local function keyFor(player)
	return "player_" .. tostring(player.UserId)
end

function Profile.load(player)
	if cache[player.UserId] then
		return cache[player.UserId]
	end

	local data = {}
	if store then
		local success, value = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if success and type(value) == "table" then
			data = value
		elseif not success then
			warn("[MiniMotorways] Could not load profile: " .. tostring(value))
		end
	end

	cache[player.UserId] = data
	return data
end

function Profile.save(player)
	local data = cache[player.UserId]
	if not data or not store then
		return
	end
	local success, err = pcall(function()
		store:SetAsync(keyFor(player), data)
	end)
	if not success then
		warn("[MiniMotorways] Could not save profile: " .. tostring(err))
	end
end

function Profile.submit(player, mapId, score)
	local data = Profile.load(player)
	local best = tonumber(data[mapId]) or 0
	if score > best then
		data[mapId] = score
		best = score
		Profile.save(player)
	end
	return best
end

function Profile.getBest(player, mapId)
	local data = Profile.load(player)
	return tonumber(data[mapId]) or 0
end

function Profile.reset(player)
	cache[player.UserId] = {}
	if store then
		local success, err = pcall(function()
			store:SetAsync(keyFor(player), {})
		end)
		if not success then
			warn("[MiniMotorways] Could not reset profile: " .. tostring(err))
		end
	end
end

function Profile.forget(player)
	cache[player.UserId] = nil
end

return Profile
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Session</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Session.luau
	Une partie = une ville. Tout est simulé côté serveur :
	  - génération des maisons / destinations
	  - routes et ponts (budget)
	  - trajets des voitures (A*)
	  - jauges de score, semaine, patience
	Le client ne fait qu'envoyer des demandes de routes et afficher l'état.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Maps = require(Shared.Maps)
local Grid = require(Shared.Grid)
local Pathfinding = require(Shared.Pathfinding)
local Remotes = require(Shared.Remotes)

local WorldBuilder = require(script.Parent.WorldBuilder)
local Profile = require(script.Parent.Profile)

local Session = {}
Session.__index = Session

local COLORS = Config.HouseColors

local function clamp(value, minValue, maxValue)
	if value < minValue then
		return minValue
	elseif value > maxValue then
		return maxValue
	end
	return value
end

local function makePart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth

	local parent = nil
	for key, value in pairs(props) do
		if key == "Parent" then
			parent = value
		else
			p[key] = value
		end
	end
	if parent then
		p.Parent = parent
	end
	return p
end

-- Carte plate à coins arrondis, construite avec des primitives : deux
-- traverses qui se croisent et quatre petits disques aux coins. Cela donne
-- l'aspect « icône vectorielle » des maisons de la référence, sans mesh.
local CARD_CYLINDER_ROTATION = CFrame.Angles(0, 0, math.rad(90))

local function addRoundedCard(model, name, center, width, depth, height, y, color, options)
	options = options or {}
	local radius = math.min(width, depth) * (options.radius or 0.16)
	local position = center * CFrame.Angles(0, options.angle or 0, 0) * CFrame.new(0, y, 0)
	if options.offset then
		position = position * CFrame.new(options.offset.X, 0, options.offset.Z)
	end

	local transparency = options.transparency or 0
	local firstPart = nil
	local function add(props)
		props.Name = name
		props.Parent = model
		props.Color = color
		props.Transparency = transparency
		props.CastShadow = false
		local p = makePart(props)
		firstPart = firstPart or p
		return p
	end

	-- Les deux traverses se recouvrent au centre. On rend la verticale très
	-- légèrement plus haute pour éviter un clignotement de faces coplanaires.
	if width - radius * 2 > 0.02 then
		add({
			Size = Vector3.new(width - radius * 2, height, depth),
			CFrame = position,
		})
	end
	if depth - radius * 2 > 0.02 then
		add({
			Size = Vector3.new(width, height + 0.004, depth - radius * 2),
			CFrame = position,
		})
	end

	local xs = { 0 }
	local zs = { 0 }
	if width - radius * 2 > 0.02 then
		xs = { -(width * 0.5 - radius), width * 0.5 - radius }
	end
	if depth - radius * 2 > 0.02 then
		zs = { -(depth * 0.5 - radius), depth * 0.5 - radius }
	end
	for _, sx in ipairs(xs) do
		for _, sz in ipairs(zs) do
			add({
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(height + 0.006, radius * 2, radius * 2),
				CFrame = position * CFrame.new(sx, 0, sz) * CARD_CYLINDER_ROTATION,
			})
		end
	end

	return firstPart
end

-- Petite apparition de la route : la pièce grandit et devient opaque.
-- Le délai permet de faire apparaître les cases l'une après l'autre quand
-- le joueur trace un trait continu.
local function animateRoadPart(part, finalSize, delay)
	local startSize = Vector3.new(
		math.max(0.04, finalSize.X * 0.52),
		math.max(0.04, finalSize.Y * 0.52),
		math.max(0.04, finalSize.Z * 0.52)
	)
	part.Size = startSize
	part.Transparency = 0.45

	TweenService:Create(part, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delay), {
		Size = finalSize,
		Transparency = 0,
	}):Play()
end

function Session.new(player, mapId, worldIndex)
	local map = Maps.getById(mapId) or Maps.all()[1]

	local self = setmetatable({}, Session)
	self.player = player
	self.mapId = map.id
	self.map = map
	self.worldIndex = worldIndex
	self.origin = Vector3.new(worldIndex * Config.World.OriginSpacing, Config.World.BaseY, 0)
	self.size = Config.Grid.Size
	self.tile = Config.Grid.TileSize

	self.roads = {}
	self.bridges = {}
	self.roadParts = {}
	self.roadRibbons = {}
	self.roadRibbonPaths = {}
	self.ribbonEdges = {}
	self.lastRibbonCell = nil
	self.roadRibbonsDirty = false
	self.roundaboutParts = {}
	self.buildings = {}
	self.buildingList = {}
	self.houses = {}
	self.destinations = {}
	self.cars = {}

	self.score = 0
	self.week = 1
	self.weekTime = 0
	self.satisfaction = Config.Traffic.SatisfactionStart
	self.budget = Config.Roads.StartBudget
	self.bridgesLeft = Config.Roads.StartBridges
	self.roundaboutsLeft = Config.Roads.StartRoundabouts
	self.speed = 1

	self.roadVersion = 0
	self.running = false
	self.paused = false
	self.over = false
	self.awaitingChoice = false
	self.choice = nil

	self.stateClock = 0
	self.pairClock = Config.Game.FirstPairDelay
	self.pairCount = 0
	self.nextBuildingId = 1

	self.world = WorldBuilder.build(self)
	self:seedBuildings()

	return self
end

function Session:seedBuildings()
	for _ = 1, Config.Game.StartPairs do
		self:spawnPair(true)
	end
end

function Session:isFreeCell(x, y)
	if not Grid.inBounds(x, y) then
		return false
	end
	local key = Grid.key(x, y)
	return not self.buildings[key] and not self.roads[key] and not Maps.isWater(self.map, x, y)
end

function Session:hasBuildableNeighbor(x, y)
	local count = 0
	for _, neighbor in ipairs(Grid.neighbors8(x, y)) do
		local nx, ny = neighbor[1], neighbor[2]
		if Grid.inBounds(nx, ny) then
			local key = Grid.key(nx, ny)
			if not self.buildings[key] and not Maps.isWater(self.map, nx, ny) then
				count += 1
			end
		end
	end
	return count >= 2
end

function Session:findBuildingSpot(exclude, minDistance)
	for _ = 1, 500 do
		local x = math.random(1, self.size - 2)
		local y = math.random(1, self.size - 2)
		if self:isFreeCell(x, y) and self:hasBuildableNeighbor(x, y) then
			local ok = true
			if exclude then
				local distance = math.abs(x - exclude[1]) + math.abs(y - exclude[2])
				if distance < (minDistance or 0) then
					ok = false
				end
			end
			if ok then
				for _, other in ipairs(self.buildingList) do
					if math.abs(x - other.x) + math.abs(y - other.y) < 2 then
						ok = false
						break
					end
				end
			end
			if ok then
				return x, y
			end
		end
	end
	return nil
end

function Session:spawnPair(initial)
	if #self.houses >= Config.Game.MaxPairs then
		return
	end

	for _ = 1, 8 do
		local colorIndex = (self.pairCount % #COLORS) + 1
		local destX, destY = self:findBuildingSpot(nil, 0)
		if destX then
			local houseX, houseY = self:findBuildingSpot({ destX, destY }, 5)
			if houseX then
				local destination = self:createBuilding("destination", destX, destY, colorIndex)
				local house = self:createBuilding("house", houseX, houseY, colorIndex)
				house.dest = self:findDestinationForHouse(house) or destination
				house.timer = initial
						and (Config.Game.FirstSpawnDelay + math.random() * 4)
					or (2 + math.random() * 3)
				self.pairCount += 1
				return
			end
		end
	end
end

function Session:createBuilding(kind, x, y, colorIndex)
	local id = self.nextBuildingId
	self.nextBuildingId += 1

	local palette = COLORS[colorIndex] or COLORS[1]
	local color = palette.color
	local baseColor = palette.base or color:Lerp(Config.Colors.Ink, 0.22)
	local ink = Config.Colors.Ink
	local white = Config.Colors.White
	local isHouse = kind == "house"

	local model = Instance.new("Model")
	model.Name = kind .. "_" .. tostring(id)

	-- Les icônes sont volontairement plus larges que la case occupée, comme
	-- dans la référence : elles débordent un peu sur la grille et sur la
	-- route, mais la validation reste sur une seule case.
	local width = isHouse and 5.2 or 6.4
	local depth = isHouse and 4.8 or 6.4
	-- Les couches sont des cartes très fines, empilées avec un pas de 0.05
	-- stud pour rester au-dessus des routes sans créer de faces coplanaires.
	local cardH = 0.05
	local baseY = 0.49
	local center = CFrame.new(Grid.center(self.origin, x, y, 0))

	-- Ombre douce décalée vers le bas-droite, en deux couches pour éviter
	-- un contour trop dur.
	addRoundedCard(model, "ShadowSoft", center, width + 1.00, depth + 1.00, cardH, baseY - 0.150, Config.Colors.BuildingShadow, {
		transparency = 0.82,
		offset = Vector3.new(0.52, 0, 0.52),
	})
	addRoundedCard(model, "Shadow", center, width + 0.50, depth + 0.50, cardH, baseY - 0.100, Config.Colors.BuildingShadow, {
		transparency = 0.68,
		offset = Vector3.new(0.34, 0, 0.34),
	})

	-- Petit chemin blanc arrondi qui dépasse de la maison, comme les
	-- allées dessinées autour des icônes de Mini Motorways.
	local directions = {
		{ angle = 0, dx = 0, dy = 1 },
		{ angle = math.pi, dx = 0, dy = -1 },
		{ angle = math.pi * 0.5, dx = 1, dy = 0 },
		{ angle = -math.pi * 0.5, dx = -1, dy = 0 },
	}
	local driveAngle = 0
	local driveIndex = id % 4
	for step = 0, 3 do
		local direction = directions[(driveIndex + step) % 4 + 1]
		local nx, ny = x + direction.dx, y + direction.dy
		if Grid.inBounds(nx, ny) and not Maps.isWater(self.map, nx, ny) then
			driveAngle = direction.angle
			break
		end
	end
	local driveWidth = width * 0.46
	local driveLength = width * 1.45
	addRoundedCard(model, "Driveway", center, driveWidth, driveLength, cardH, baseY - 0.050, white, {
		angle = driveAngle,
		offset = Vector3.new(0, 0, width * 0.52),
		radius = 0.5,
	})

	-- Liseré blanc extérieur puis décalage coloré sombre : le contour de
	-- l'icône reste net sur le sol crème.
	addRoundedCard(model, "Outline", center, width + 0.38, depth + 0.38, cardH, baseY, white, {
		radius = 0.17,
	})
	addRoundedCard(model, "Offset", center, width + 0.10, depth + 0.10, cardH, baseY + 0.050, baseColor:Lerp(ink, 0.30), {
		offset = Vector3.new(0.18, 0, 0.18),
		radius = 0.17,
	})

	local body
	if isHouse then
		body = addRoundedCard(model, "Body", center, width, depth, cardH, baseY + 0.100, baseColor)
	else
		body = addRoundedCard(model, "Body", center, width, depth, cardH, baseY + 0.100, color)
	end
	model.PrimaryPart = body

	if isHouse then
		-- Toit jaune/clair posé sur le socle corail, avec un petit décalage
		-- sombre pour retrouver l'empilement de la référence.
		local roofOffset = Vector3.new(0, 0, -depth * 0.10)
		addRoundedCard(model, "RoofOffset", center, width * 0.88, depth * 0.76, cardH, baseY + 0.150, baseColor:Lerp(ink, 0.32), {
			offset = roofOffset,
			radius = 0.17,
		})
		addRoundedCard(model, "Roof", center, width * 0.82, depth * 0.70, cardH, baseY + 0.200, color, {
			offset = roofOffset,
			radius = 0.17,
		})

		-- Trois petites cheminées carrées sur le bord supérieur du toit.
		local chimneyZ = center.Z - depth * 0.10 - depth * 0.30
		for i = -1, 1 do
			local cx = center.X + i * width * 0.14
			makePart({
				Name = "ChimneyShadow",
				Parent = model,
				Size = Vector3.new(width * 0.10 + 0.10, cardH, width * 0.12 + 0.10),
				CFrame = CFrame.new(cx, baseY + 0.250, chimneyZ),
				Color = baseColor:Lerp(ink, 0.32),
				CastShadow = false,
			})
			makePart({
				Name = "Chimney",
				Parent = model,
				Size = Vector3.new(width * 0.10, 0.06, width * 0.12),
				CFrame = CFrame.new(cx, baseY + 0.260, chimneyZ),
				Color = color,
				CastShadow = false,
			})
		end
	else
		-- Épingle blanche à pointe, posée au centre de la carte.
		local pinY = baseY + 0.170
		local pinRotation = CFrame.Angles(0, 0, math.rad(90))
		makePart({
			Name = "PinTailShadow",
			Parent = model,
			Size = Vector3.new(0.92, cardH, 0.92),
			CFrame = CFrame.new(center.X, pinY - 0.004, center.Z + 0.46) * CFrame.Angles(0, math.rad(45), 0),
			Color = ink,
			CastShadow = false,
		})
		makePart({
			Name = "PinOutline",
			Parent = model,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.06, 1.45, 1.45),
			CFrame = CFrame.new(center.X, pinY, center.Z) * pinRotation,
			Color = ink,
			CastShadow = false,
		})
		makePart({
			Name = "PinTail",
			Parent = model,
			Size = Vector3.new(0.70, cardH, 0.70),
			CFrame = CFrame.new(center.X, pinY + 0.006, center.Z + 0.42) * CFrame.Angles(0, math.rad(45), 0),
			Color = white,
			CastShadow = false,
		})
		makePart({
			Name = "Pin",
			Parent = model,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.06, 1.15, 1.15),
			CFrame = CFrame.new(center.X, pinY + 0.012, center.Z) * pinRotation,
			Color = white,
			CastShadow = false,
		})
		makePart({
			Name = "PinDot",
			Parent = model,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.06, 0.42, 0.42),
			CFrame = CFrame.new(center.X, pinY + 0.030, center.Z) * pinRotation,
			Color = ink,
			CastShadow = false,
		})
	end

	model.Parent = self.world.Buildings

	local building = {
		id = id,
		kind = kind,
		x = x,
		y = y,
		key = Grid.key(x, y),
		colorIndex = colorIndex,
		color = color,
		model = model,
	}

	self.buildings[building.key] = building
	table.insert(self.buildingList, building)
	if isHouse then
		table.insert(self.houses, building)
	else
		table.insert(self.destinations, building)
	end

	return building
end

function Session:findDestinationForHouse(house)
	local best = nil
	local bestDistance = math.huge
	for _, destination in ipairs(self.destinations) do
		if destination.colorIndex == house.colorIndex then
			local distance = math.abs(destination.x - house.x) + math.abs(destination.y - house.y)
			if distance < bestDistance then
				best = destination
				bestDistance = distance
			end
		end
	end
	return best
end

function Session:connectorCells(building)
	local cells = {}
	for _, neighbor in ipairs(Grid.neighbors8(building.x, building.y)) do
		local nx, ny = neighbor[1], neighbor[2]
		if Grid.inBounds(nx, ny) then
			local key = Grid.key(nx, ny)
			if self.roads[key] then
				table.insert(cells, key)
			end
		end
	end
	return cells
end

function Session:canDraw(x, y)
	if not Grid.inBounds(x, y) then
		return false, "Hors de la carte"
	end
	local key = Grid.key(x, y)
	if self.buildings[key] then
		return false, "Bâtiment"
	end
	if self.roads[key] then
		return false, "Route déjà construite"
	end
	local water = Maps.isWater(self.map, x, y)
	if water and self.bridgesLeft <= 0 then
		return false, "Plus de ponts disponibles"
	end
	if self.budget < 1 then
		return false, "Plus de routes disponibles"
	end
	return true, water and "bridge" or "road"
end

function Session:drawRoad(cells)
	-- La pause manuelle fige la simulation, pas l'édition des routes.
	-- En revanche, on bloque toute édition pendant le choix de semaine.
	if not self.running or self.over or self.awaitingChoice then
		return
	end
	if type(cells) ~= "table" then
		return
	end

	local placed = 0
	local newRoads = {}
	local newRoadSet = {}
	for _, cell in ipairs(cells) do
		if type(cell) == "table" then
			local x = tonumber(cell[1])
			local y = tonumber(cell[2])
			if x and y then
				x = math.floor(x)
				y = math.floor(y)
				local ok, kind = self:canDraw(x, y)
				if ok then
					local key = Grid.key(x, y)
					self.roads[key] = true
					if kind == "bridge" then
						self.bridges[key] = true
						self.bridgesLeft -= 1
					end
					self.budget -= 1
					table.insert(newRoads, { key = key, isBridge = kind == "bridge" })
					newRoadSet[key] = true
					placed += 1
				end
			end
		end
	end

	if placed > 0 then
		-- Toutes les cases sont posées avant de créer les visuels : les
		-- extrémités et les virages connaissent ainsi déjà leurs voisins.
		for index, road in ipairs(newRoads) do
			local delay = math.min((index - 1) * 0.022, 0.28)
			self:createRoadVisual(road.key, road.isBridge, delay, true)
		end

		-- Les routes déjà présentes autour du tracé doivent mettre à jour
		-- leurs capuchons (une ancienne extrémité peut devenir un virage).
		local refreshed = {}
		for _, road in ipairs(newRoads) do
			local x, y = Grid.parse(road.key)
			if x then
				for _, neighbor in ipairs(Grid.neighbors8(x, y)) do
					local neighborKey = Grid.key(neighbor[1], neighbor[2])
					if self.roads[neighborKey] and not newRoadSet[neighborKey] and not refreshed[neighborKey] then
						refreshed[neighborKey] = true
						self:refreshRoadVisual(neighborKey)
					end
				end
			end
		end

		-- Le ruban lissé est purement visuel : il recouvre les cases pour
		-- donner les courbes et les diagonales continues de la vidéo, tandis
		-- que la simulation continue de suivre la grille.
		self:addRoadRibbons(cells)

		self.roadVersion += 1
		self:refreshCarPaths()
		self:sendState()
	end
end

function Session:createRoadVisual(key, isBridge, delay, animate)
	local x, y = Grid.parse(key)
	if not x then
		return
	end

	delay = delay or 0
	animate = animate ~= false
	local function reveal(part, size)
		if animate then
			animateRoadPart(part, size, delay)
		end
	end

	local tile = self.tile
	local color = isBridge and Config.Colors.Bridge or Config.Colors.Road
	local edgeColor = isBridge and Config.Colors.BridgeEdge or Config.Colors.RoadEdge
	local contourColor = Config.Colors.RoadContour
	local outlineHeight = isBridge and 0.32 or 0.28
	local outlineCenterY = isBridge and 0.21 or 0.15
	local contourHeight = isBridge and 0.28 or 0.24
	local contourCenterY = isBridge and 0.255 or 0.18
	local topHeight = isBridge and 0.20 or 0.18
	local topCenterY = isBridge and 0.30 or 0.22
	local jointRotation = CFrame.Angles(0, 0, math.rad(90))
	-- Le liseré blanc reste visible tout autour du ruban graphite : les
	-- couches sont légèrement décalées pour éviter toute couture.
	local layerLift = 0.01
	local diagonalLift = 0.008

	local parts = {}
	local function addBox(name, size, center, partColor)
		local part = makePart({
			Name = name,
			Parent = self.world.Roads,
			Size = size,
			CFrame = CFrame.new(center),
			Color = partColor,
		})
		reveal(part, size)
		table.insert(parts, part)
		return part
	end

	local function addCylinder(name, size, center, partColor)
		local part = makePart({
			Name = name,
			Parent = self.world.Roads,
			Shape = Enum.PartType.Cylinder,
			Size = size,
			CFrame = CFrame.new(center) * jointRotation,
			Color = partColor,
		})
		reveal(part, size)
		table.insert(parts, part)
		return part
	end

	-- Segment orienté librement, réservé aux liaisons diagonales. Il est
	-- volontairement placé très légèrement sous la forme arrondie centrale :
	-- la forme ovale recouvre le raccord et il ne reste aucun triangle.
	local function addRotatedBox(name, size, center, direction, partColor)
		local part = makePart({
			Name = name,
			Parent = self.world.Roads,
			Size = size,
			CFrame = CFrame.lookAt(center, center + direction),
			Color = partColor,
		})
		reveal(part, size)
		table.insert(parts, part)
		return part
	end

	local function addDiagonalSegment(name, width, height, centerY, partColor, dx, dz)
		local from = Grid.center(self.origin, x, y, 0)
		local to = Grid.center(self.origin, x + dx, y + dz, 0)
		local midpoint = (from + to) * 0.5
		local direction = (to - from).Unit
		local center = midpoint + Vector3.new(0, centerY, 0)
		addRotatedBox(
			name,
			Vector3.new(width, height, (to - from).Magnitude),
			center,
			direction,
			partColor
		)
	end

	-- Les directions orthogonales gardent exactement l'ancien rendu : cases
	-- droites, virages en arc et extrémités arrondies. Les directions
	-- diagonales sont collectées séparément et ajoutées sous ces formes.
	local neighborDirs = {}
	local diagonalDirs = {}
	for _, neighbor in ipairs(Grid.neighbors8(x, y)) do
		local nx, ny = neighbor[1], neighbor[2]
		if Grid.inBounds(nx, ny) and self.roads[Grid.key(nx, ny)] then
			local dx, dy = nx - x, ny - y
			if dx == 0 or dy == 0 then
				table.insert(neighborDirs, { dx, dy })
			else
				table.insert(diagonalDirs, { dx, dy, nx, ny })
			end
		end
	end

	-- Une diagonale droite ne doit pas avoir de tuile centrale plus large :
	-- sinon le ruban paraît bosselé à chaque case. On la laisse filer comme
	-- une route horizontale et on ne garde les formes centrales qu'aux
	-- virages, aux extrémités et aux jonctions.
	local isStraightDiagonal = false
	if #neighborDirs == 0 and #diagonalDirs == 2 then
		local a, b = diagonalDirs[1], diagonalDirs[2]
		if a[1] == -b[1] and a[2] == -b[2] then
			isStraightDiagonal = true
			local cellIsBridge = self.bridges[key] == true
			for _, diagonal in ipairs(diagonalDirs) do
				local neighborBridge = self.bridges[Grid.key(x + diagonal[1], y + diagonal[2])] == true
				if (cellIsBridge or neighborBridge) ~= cellIsBridge then
					isStraightDiagonal = false
					break
				end
			end
		end
	end

	-- Les lignes droites gardent des bords parfaitement droits. Un virage
	-- est un arc d'anneau : une suite de disques qui se chevauchent dessine
	-- l'extérieur et l'intérieur arrondis, avec une largeur constante.
	local isTurn = false
	local turnDirs = nil
	local rounded = nil
	if #neighborDirs == 0 then
		rounded = { NE = true, NW = true, SE = true, SW = true }
	elseif #neighborDirs == 2 then
		local a, b = neighborDirs[1], neighborDirs[2]
		if a[1] * b[1] + a[2] * b[2] == 0 then
			isTurn = true
			turnDirs = { a, b }
		end
	end

	local center = Grid.center(self.origin, x, y, 0)
	local function addLayer(name, width, height, centerY, radius, layerColor)
		local layerCenter = center + Vector3.new(0, centerY, 0)
		if not rounded then
			addBox(name, Vector3.new(width, height, width), layerCenter, layerColor)
			return
		end

		local r = math.min(radius, width * 0.5)
		local inner = width * 0.5 - r
		addBox(name .. "H", Vector3.new(width, height, width - 2 * r), layerCenter, layerColor)
		addBox(name .. "V", Vector3.new(width - 2 * r, height, width), layerCenter, layerColor)

		local corners = {
			{ key = "NE", sx = 1, sz = -1 },
			{ key = "NW", sx = -1, sz = -1 },
			{ key = "SE", sx = 1, sz = 1 },
			{ key = "SW", sx = -1, sz = 1 },
		}
		for _, corner in ipairs(corners) do
			if rounded[corner.key] then
				addCylinder(
					name .. corner.key,
					Vector3.new(height, 2 * r, 2 * r),
					layerCenter + Vector3.new(corner.sx * inner, 0, corner.sz * inner),
					layerColor
				)
			else
				addBox(
					name .. corner.key,
					Vector3.new(r, height, r),
					layerCenter + Vector3.new(corner.sx * (inner + r * 0.5), 0, corner.sz * (inner + r * 0.5)),
					layerColor
				)
			end
		end
	end

	local roadWidth = tile * 0.72
	local contourWidth = tile * 0.78
	local edgeWidth = tile * 0.84
	local cornerRadius = roadWidth * 0.42

	local function addArcLayer(name, width, height, centerY, layerColor, dirs)
		local d1, d2 = dirs[1], dirs[2]
		local outer = Vector3.new(-(d1[1] + d2[1]), 0, -(d1[2] + d2[2])).Unit
		local function perpTowardOuter(dir)
			local a = Vector3.new(dir[2], 0, -dir[1])
			local b = Vector3.new(-dir[2], 0, dir[1])
			if a:Dot(outer) >= b:Dot(outer) then
				return a
			end
			return b
		end

		local p1 = perpTowardOuter(d1)
		local p2 = perpTowardOuter(d2)
		local arcCenter = center
			+ Vector3.new((d1[1] + d2[1]) * tile * 0.5, centerY, (d1[2] + d2[2]) * tile * 0.5)
		local arcRadius = tile * 0.5
		local steps = 6
		for index = 0, steps do
			local t = index / steps
			local direction = (p1 * (1 - t) + p2 * t).Unit
			local circleCenter = arcCenter + direction * arcRadius
			addCylinder(
				name .. tostring(index),
				Vector3.new(height, width, width),
				circleCenter,
				layerColor
			)
		end
	end

	local function addTileLayer(name, width, height, centerY, layerColor)
		if isTurn then
			addArcLayer(name, width, height, centerY, layerColor, turnDirs)
			return
		end

		if #neighborDirs == 0 then
			-- Une diagonale droite est déjà couverte par le ruban et son
			-- disque de jonction. Une tuile plus large ferait une bosse.
			if not isStraightDiagonal then
				local offset = (width - roadWidth) * 0.5
				addLayer(name, width, height, centerY, cornerRadius + offset, layerColor)
			end
			return
		end

		local layerCenter = center + Vector3.new(0, centerY, 0)
		-- Une case qui a une seule route orthogonale et une diagonale n'est pas
		-- une extrémité : on ne dessine que la branche utile et le disque
		-- central, au lieu du grand capuchon historique qui créerait un ergot.
		if #neighborDirs == 1 and #diagonalDirs > 0 then
			local axis = neighborDirs[1]
			if axis[1] ~= 0 then
				addBox(
					name,
					Vector3.new(tile * 0.5, height, width),
					layerCenter + Vector3.new(axis[1] * tile * 0.25, 0, 0),
					layerColor
				)
			else
				addBox(
					name,
					Vector3.new(width, height, tile * 0.5),
					layerCenter + Vector3.new(0, 0, axis[2] * tile * 0.25),
					layerColor
				)
			end
			return
		end

		if #neighborDirs <= 2 then
			local axis = neighborDirs[1]
			if axis[1] ~= 0 then
				addBox(name, Vector3.new(tile, height, width), layerCenter, layerColor)
			else
				addBox(name, Vector3.new(width, height, tile), layerCenter, layerColor)
			end
			return
		end

		-- T et croisement : une branche par voisin, depuis le centre.
		for _, dir in ipairs(neighborDirs) do
			if dir[1] ~= 0 then
				addBox(
					name .. (dir[1] > 0 and "E" or "W"),
					Vector3.new(tile * 0.5, height, width),
					layerCenter + Vector3.new(dir[1] * tile * 0.25, 0, 0),
					layerColor
				)
			else
				addBox(
					name .. (dir[2] > 0 and "S" or "N"),
					Vector3.new(width, height, tile * 0.5),
					layerCenter + Vector3.new(0, 0, dir[2] * tile * 0.25),
					layerColor
				)
			end
		end
	end

	-- Les diagonales passent d'abord, sous les formes arrondies. On ne les
	-- dessine qu'une fois par arête (clé la plus petite) pour éviter les
	-- surfaces coplanaires qui clignotent.
	local diagonalLayers = {
		{
			name = "RoadOutline",
			width = edgeWidth,
			height = outlineHeight,
			centerY = outlineCenterY,
			color = edgeColor,
			bridgeHeight = 0.32,
			bridgeCenterY = 0.21,
			bridgeColor = Config.Colors.BridgeEdge,
		},
		{
			name = "RoadContour",
			width = contourWidth,
			height = contourHeight,
			centerY = contourCenterY,
			color = contourColor,
			bridgeHeight = 0.28,
			bridgeCenterY = 0.255,
			bridgeColor = contourColor,
		},
		{
			name = "Road",
			width = roadWidth,
			height = topHeight,
			centerY = topCenterY,
			color = color,
			bridgeHeight = 0.20,
			bridgeCenterY = 0.30,
			bridgeColor = Config.Colors.Bridge,
		},
	}
	for _, layer in ipairs(diagonalLayers) do
		for _, diagonal in ipairs(diagonalDirs) do
			local nx, ny = diagonal[1], diagonal[2]
			local neighborKey = Grid.key(nx, ny)
			if key < neighborKey then
				local edgeIsBridge = self.bridges[key] == true or self.bridges[neighborKey] == true
				addDiagonalSegment(
					layer.name .. "_" .. neighborKey,
					layer.width,
					edgeIsBridge and layer.bridgeHeight or layer.height,
					(edgeIsBridge and layer.bridgeCenterY or layer.centerY) - diagonalLift,
					edgeIsBridge and layer.bridgeColor or layer.color,
					diagonal[1],
					diagonal[2]
				)
			end
		end
	end

	-- Un disque central recouvre l'extrémité carrée de chaque segment diagonal.
	-- Il est placé entre les segments et les formes orthogonales : le raccord
	-- reste rond, sans coin ni triangle qui dépasse, même sur un T ou un
	-- croisement qui n'a pas de forme centrale arrondie.
	if #diagonalDirs > 0 and not isStraightDiagonal then
		for _, layer in ipairs(diagonalLayers) do
			local capHeight = isBridge and layer.bridgeHeight or layer.height
			local capCenterY = isBridge and layer.bridgeCenterY or layer.centerY
			addCylinder(
				layer.name .. "_Center",
				Vector3.new(capHeight, layer.width, layer.width),
				center + Vector3.new(0, capCenterY - diagonalLift * 0.5, 0),
				isBridge and layer.bridgeColor or layer.color
			)
		end
	end

	addTileLayer("RoadOutline", edgeWidth, outlineHeight, outlineCenterY, edgeColor)
	addTileLayer("RoadContour", contourWidth, contourHeight, contourCenterY, contourColor)
	addTileLayer("Road", roadWidth, topHeight, topCenterY, color)

	-- Extrémité : on prolonge la route jusqu'au bord de la case avec une
	-- coupe droite. Pas de disque ni de demi-cercle : l'utilisateur veut des
	-- fins de route plates, sans gros « ronds » aux extrémités.
	if #neighborDirs == 1 and #diagonalDirs == 0 then
		local dir = neighborDirs[1]
		local direction = Vector3.new(dir[1], 0, dir[2])
		local capLength = tile * 0.5
		local capCenter = center
			+ direction * (capLength * 0.5)
		addRotatedBox(
			"RoadOutlineEnd",
			Vector3.new(edgeWidth, outlineHeight, capLength),
			capCenter + Vector3.new(0, outlineCenterY + layerLift, 0),
			direction,
			edgeColor
		)
		addRotatedBox(
			"RoadContourEnd",
			Vector3.new(contourWidth, contourHeight, capLength),
			capCenter + Vector3.new(0, contourCenterY + layerLift, 0),
			direction,
			contourColor
		)
		addRotatedBox(
			"RoadEnd",
			Vector3.new(roadWidth, topHeight, capLength),
			capCenter + Vector3.new(0, topCenterY + layerLift, 0),
			direction,
			color
		)
	end

	self.roadParts[key] = parts
end

function Session:refreshRoadVisual(key)
	local parts = self.roadParts[key]
	if parts then
		for _, part in pairs(parts) do
			if part then
				part:Destroy()
			end
		end
		self.roadParts[key] = nil
	end
	if self.roads[key] then
		self:createRoadVisual(key, self.bridges[key] == true, 0, false)
	end
end

--[[
	Ruban de route lissé.

	La simulation reste sur la grille : les voitures suivent les centres des
	cases et le pathfinding ne change pas. Pour l'affichage, on ajoute un ruban
	noir continu au-dessus des cases, tracé avec une spline de Catmull-Rom qui
	passe par leurs centres. Les virages et les diagonales sont donc arrondis
	comme dans la vidéo, sans modifier les règles ni le budget.
]]

local function ribbonEdgeKey(a, b)
	if a < b then
		return a .. "|" .. b
	end
	return b .. "|" .. a
end

local function isAdjacentKey(a, b)
	local ax, ay = Grid.parse(a)
	local bx, by = Grid.parse(b)
	if not ax or not bx then
		return false
	end
	local dx, dy = bx - ax, by - ay
	return math.abs(dx) <= 1 and math.abs(dy) <= 1 and (dx ~= 0 or dy ~= 0)
end

local function catmullRom(p0, p1, p2, p3, t)
	local t2 = t * t
	local t3 = t2 * t
	return (p1 * 2
		+ (p2 - p0) * t
		+ (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2
		+ (p1 * 3 - p0 - p2 * 3 + p3) * t3) * 0.5
end

function Session:clearRoadRibbons()
	for _, part in ipairs(self.roadRibbons) do
		if part and part.Parent then
			part:Destroy()
		end
	end
	self.roadRibbons = {}
end

function Session:addRibbonPart(name, size, center, direction, color)
	if not direction or direction.Magnitude < 0.001 then
		return
	end
	local part = makePart({
		Name = name,
		Parent = self.world.Roads,
		Size = size,
		CFrame = CFrame.lookAt(center, center + direction.Unit),
		Color = color,
		CastShadow = false,
	})
	table.insert(self.roadRibbons, part)
end

function Session:addRibbonDisk(name, size, center, color)
	local part = makePart({
		Name = name,
		Parent = self.world.Roads,
		Shape = Enum.PartType.Cylinder,
		Size = size,
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		CastShadow = false,
	})
	table.insert(self.roadRibbons, part)
end

function Session:hasOtherRoadNeighbor(key, exceptKey)
	local x, y = Grid.parse(key)
	if not x then
		return false
	end
	for _, neighbor in ipairs(Grid.neighbors8(x, y)) do
		local neighborKey = Grid.key(neighbor[1], neighbor[2])
		if neighborKey ~= exceptKey and self.roads[neighborKey] then
			return true
		end
	end
	return false
end

function Session:splitRibbonPath(cells)
	local result = {}
	local current = {}
	for _, key in ipairs(cells) do
		if self.roads[key] then
			if #current == 0 or isAdjacentKey(current[#current], key) then
				if #current == 0 or current[#current] ~= key then
					table.insert(current, key)
				end
			else
				if #current >= 2 then
					table.insert(result, current)
				end
				current = { key }
			end
		else
			if #current >= 2 then
				table.insert(result, current)
			end
			current = {}
		end
	end
	if #current >= 2 then
		table.insert(result, current)
	end
	return result
end

function Session:createRibbonForPath(path, pathIndex)
	if #path < 2 then
		return false
	end

	-- On ne redessine pas une arête déjà couverte par un ruban existant.
	local hasNewEdge = false
	for i = 1, #path - 1 do
		local edge = ribbonEdgeKey(path[i], path[i + 1])
		if not self.ribbonEdges[edge] then
			hasNewEdge = true
			break
		end
	end
	if not hasNewEdge then
		return false
	end
	for i = 1, #path - 1 do
		self.ribbonEdges[ribbonEdgeKey(path[i], path[i + 1])] = true
	end

	local points = {}
	for _, key in ipairs(path) do
		local x, y = Grid.parse(key)
		if x then
			points[#points + 1] = Grid.center(self.origin, x, y, 0)
		end
	end
	if #points < 2 then
		return false
	end

	local yOffset = (pathIndex % 10) * 0.0015
	local ribbonLift = 0.003
	local edgeWidth = self.tile * 0.86
	local topWidth = self.tile * 0.74
	local samplesPerSegment = 3
	local samples = {}

	for i = 1, #points - 1 do
		local p0 = points[math.max(i - 1, 1)]
		local p1 = points[i]
		local p2 = points[i + 1]
		local p3 = points[math.min(i + 2, #points)]
		local bridge = self.bridges[path[i]] == true or self.bridges[path[i + 1]] == true
		for s = 0, samplesPerSegment - 1 do
			local t = s / samplesPerSegment
			samples[#samples + 1] = {
				pos = catmullRom(p0, p1, p2, p3, t),
				bridge = bridge,
			}
		end
	end
	samples[#samples + 1] = {
		pos = points[#points],
		bridge = self.bridges[path[#path]] == true,
	}

	for i = 1, #samples - 1 do
		local a = samples[i]
		local b = samples[i + 1]
		local delta = b.pos - a.pos
		local length = delta.Magnitude
		if length > 0.001 then
			local mid = (a.pos + b.pos) * 0.5
			local direction = delta.Unit
			local bridge = a.bridge or b.bridge
			local edgeColor = bridge and Config.Colors.BridgeEdge or Config.Colors.RoadEdge
			local topColor = bridge and Config.Colors.Bridge or Config.Colors.Road
			local edgeHeight = bridge and 0.30 or 0.26
			local edgeY = bridge and 0.23 or 0.17
			local topHeight = bridge and 0.22 or 0.20
			local topY = bridge and 0.32 or 0.24
			-- Très léger décalage entre segments voisins : ils se chevauchent
			-- un peu pour éviter les trous, sans scintillement de faces.
			local segmentLift = (i % 4) * 0.0005

			self:addRibbonPart(
				"RoadRibbonEdge" .. pathIndex .. "_" .. i,
				Vector3.new(edgeWidth, edgeHeight, length + 0.06),
				mid + Vector3.new(0, edgeY + yOffset + segmentLift, 0),
				direction,
				edgeColor
			)
			self:addRibbonPart(
				"RoadRibbonTop" .. pathIndex .. "_" .. i,
				Vector3.new(topWidth, topHeight, length + 0.04),
				mid + Vector3.new(0, topY + yOffset + segmentLift, 0),
				direction,
				topColor
			)
		end
	end

	for i, point in ipairs(points) do
		local key = path[i]
		local bridge = self.bridges[key] == true
		local edgeColor = bridge and Config.Colors.BridgeEdge or Config.Colors.RoadEdge
		local topColor = bridge and Config.Colors.Bridge or Config.Colors.Road
		local edgeHeight = bridge and 0.30 or 0.26
		local edgeY = bridge and 0.23 or 0.17
		local topHeight = bridge and 0.22 or 0.20
		local topY = bridge and 0.32 or 0.24

		self:addRibbonDisk(
			"RoadRibbonEdgeJoint" .. pathIndex .. "_" .. i,
			Vector3.new(edgeHeight - 0.02, edgeWidth, edgeWidth),
			point + Vector3.new(0, edgeY + yOffset + ribbonLift, 0),
			edgeColor
		)
		self:addRibbonDisk(
			"RoadRibbonTopJoint" .. pathIndex .. "_" .. i,
			Vector3.new(topHeight - 0.02, topWidth, topWidth),
			point + Vector3.new(0, topY + yOffset + ribbonLift, 0),
			topColor
		)
	end

	-- Extrémités du ruban : on prolonge le dernier segment jusqu'au bord de
	-- la case avec une coupe droite, au lieu d'un gros disque rond. On omet
	-- cette extension quand la case est déjà reliée à une autre route.
	local function addCap(point, direction, bridge, suffix)
		if not direction or direction.Magnitude < 0.001 then
			return
		end
		local unit = direction.Unit
		-- On va jusqu'au bord de la case dans la direction de la route :
		-- 0,5 case pour un axe, ~0,707 case pour une diagonale (le coin).
		local capLength = (self.tile * 0.5) / math.max(math.abs(unit.X), math.abs(unit.Z))
		local capCenter = point + unit * (capLength * 0.5)
		local edgeColor = bridge and Config.Colors.BridgeEdge or Config.Colors.RoadEdge
		local topColor = bridge and Config.Colors.Bridge or Config.Colors.Road
		local edgeHeight = bridge and 0.30 or 0.26
		local edgeY = bridge and 0.23 or 0.17
		local topHeight = bridge and 0.22 or 0.20
		local topY = bridge and 0.32 or 0.24

		self:addRibbonPart(
			"RoadRibbonEdgeEnd" .. pathIndex .. suffix,
			Vector3.new(edgeWidth, edgeHeight, capLength),
			capCenter + Vector3.new(0, edgeY + yOffset + ribbonLift, 0),
			unit,
			edgeColor
		)
		self:addRibbonPart(
			"RoadRibbonTopEnd" .. pathIndex .. suffix,
			Vector3.new(topWidth, topHeight, capLength),
			capCenter + Vector3.new(0, topY + yOffset + ribbonLift, 0),
			unit,
			topColor
		)
	end

	if not self:hasOtherRoadNeighbor(path[1], path[2]) then
		addCap(points[1], points[1] - points[2], self.bridges[path[1]] == true, "Start")
	end
	if not self:hasOtherRoadNeighbor(path[#path], path[#path - 1]) then
		addCap(points[#points], points[#points] - points[#points - 1], self.bridges[path[#path]] == true, "End")
	end

	return true
end

function Session:addRoadRibbons(cells)
	if type(cells) ~= "table" or not self.world or not self.world.Roads then
		return
	end
	-- Si un effacement attend sa reconstruction, on le solde d'abord pour
	-- que le nouveau tracé ne soit pas considéré comme déjà couvert.
	if self.roadRibbonsDirty then
		self.roadRibbonsDirty = false
		self:rebuildRoadRibbons()
	end
	local ordered = {}
	local firstKey = nil

	for _, cell in ipairs(cells) do
		if type(cell) == "table" then
			local x, y = tonumber(cell[1]), tonumber(cell[2])
			if x and y then
				local key = Grid.key(math.floor(x), math.floor(y))
				if self.roads[key] then
					firstKey = key
					break
				end
			end
		end
	end

	-- Le lot suivant commence souvent par la dernière case du lot précédent.
	-- On la reprend pour que le ruban soit continu d'un envoi à l'autre.
	if self.lastRibbonCell
		and self.roads[self.lastRibbonCell]
		and firstKey
		and isAdjacentKey(self.lastRibbonCell, firstKey)
	then
		table.insert(ordered, self.lastRibbonCell)
	end

	for _, cell in ipairs(cells) do
		if type(cell) == "table" then
			local x, y = tonumber(cell[1]), tonumber(cell[2])
			if x and y then
				local key = Grid.key(math.floor(x), math.floor(y))
				if self.roads[key] and (#ordered == 0 or ordered[#ordered] ~= key) then
					table.insert(ordered, key)
				end
			end
		end
	end

	for i = #cells, 1, -1 do
		local cell = cells[i]
		if type(cell) == "table" then
			local x, y = tonumber(cell[1]), tonumber(cell[2])
			if x and y then
				local key = Grid.key(math.floor(x), math.floor(y))
				if self.roads[key] then
					self.lastRibbonCell = key
					break
				end
			end
		end
	end

	if #ordered < 2 then
		return
	end

	for _, path in ipairs(self:splitRibbonPath(ordered)) do
		if self:createRibbonForPath(path, #self.roadRibbonPaths + 1) then
			table.insert(self.roadRibbonPaths, path)
		end
	end
end

function Session:rebuildRoadRibbons()
	if not self.world or not self.world.Roads then
		return
	end
	self:clearRoadRibbons()
	self.ribbonEdges = {}
	local newPaths = {}
	for _, path in ipairs(self.roadRibbonPaths) do
		for _, subPath in ipairs(self:splitRibbonPath(path)) do
			if self:createRibbonForPath(subPath, #newPaths + 1) then
				table.insert(newPaths, subPath)
			end
		end
	end
	self.roadRibbonPaths = newPaths
end

function Session:createRoundaboutVisual(key)
	local x, y = Grid.parse(key)
	if not x then
		return
	end
	local tile = self.tile
	local model = Instance.new("Model")
	model.Name = "Roundabout"

	local rotation = CFrame.Angles(0, 0, math.rad(90))
	-- Même liseré blanc fin que les routes, autour du rond-point graphite.
	makePart({
		Name = "RoundaboutContour",
		Parent = model,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.20, tile * 1.02, tile * 1.02),
		CFrame = CFrame.new(Grid.center(self.origin, x, y, 0.32)) * rotation,
		Color = Config.Colors.RoadContour,
	})
	makePart({
		Name = "RoundaboutOuter",
		Parent = model,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.18, tile * 0.92, tile * 0.92),
		CFrame = CFrame.new(Grid.center(self.origin, x, y, 0.34)) * rotation,
		Color = Config.Colors.Road,
	})
	makePart({
		Name = "RoundaboutInner",
		Parent = model,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.20, tile * 0.44, tile * 0.44),
		CFrame = CFrame.new(Grid.center(self.origin, x, y, 0.36)) * rotation,
		Color = Config.Colors.White,
	})
	makePart({
		Name = "RoundaboutDot",
		Parent = model,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.22, tile * 0.16, tile * 0.16),
		CFrame = CFrame.new(Grid.center(self.origin, x, y, 0.38)) * rotation,
		Color = Config.Colors.Ink,
	})

	model.Parent = self.world.FX
	self.roundaboutParts[key] = model
end

function Session:placeRoundabout(x, y)
	if not self.running or self.over or self.awaitingChoice then
		return
	end
	x = tonumber(x)
	y = tonumber(y)
	if not x or not y then
		return
	end
	x = math.floor(x)
	y = math.floor(y)
	if not Grid.inBounds(x, y) then
		self:toast("Placez le rond-point sur la carte.")
		return
	end
	if self.roundaboutsLeft <= 0 then
		self:toast("Plus de ronds-points disponibles.")
		return
	end
	local key = Grid.key(x, y)
	if not self.roads[key] then
		self:toast("Placez le rond-point sur une route.")
		return
	end
	if self.roundaboutParts[key] then
		self:toast("Il y a déjà un rond-point ici.")
		return
	end
	if self.bridges[key] then
		self:toast("Un rond-point ne peut pas être posé sur un pont.")
		return
	end

	self.roundaboutsLeft -= 1
	self:createRoundaboutVisual(key)
	self:sendState()
	self:toast("Rond-point placé.")
end

function Session:eraseRoad(key)
	if not self.running or self.over or self.awaitingChoice then
		return
	end
	if type(key) ~= "string" or not self.roads[key] then
		return
	end

	local x, y = Grid.parse(key)
	if not x then
		return
	end

	local roundabout = self.roundaboutParts[key]
	if roundabout then
		roundabout:Destroy()
		self.roundaboutParts[key] = nil
		self.roundaboutsLeft = math.min(Config.Roads.MaxRoundabouts, self.roundaboutsLeft + 1)
	end

	self.roads[key] = nil
	if self.bridges[key] then
		self.bridges[key] = nil
		self.bridgesLeft = math.min(Config.Roads.MaxBridges, self.bridgesLeft + 1)
	end
	self.budget = math.min(Config.Roads.MaxBudget, self.budget + 1)

	local parts = self.roadParts[key]
	if parts then
		for _, part in pairs(parts) do
			if part then
				part:Destroy()
			end
		end
		self.roadParts[key] = nil
	end

	-- Une route voisine peut redevenir une extrémité : on lui redonne
	-- immédiatement son capuchon arrondi.
	for _, neighbor in ipairs(Grid.neighbors8(x, y)) do
		local neighborKey = Grid.key(neighbor[1], neighbor[2])
		if self.roads[neighborKey] then
			self:refreshRoadVisual(neighborKey)
		end
	end

	-- On regroupe les reconstructions de rubans : un effacement au clic
	-- droit peut envoyer plusieurs cases d'affilée. Le ruban est reconstruit
	-- une seule fois à la prochaine frame.
	self.roadRibbonsDirty = true

	self.roadVersion += 1
	self:refreshCarPaths()
	self:sendState()
end

function Session:refreshCarPaths()
	for _, car in ipairs(self.cars) do
		car.retry = 0
		car.roadVersion = -1
	end
end

function Session:parkingSpot(house)
	local base = Grid.center(self.origin, house.x, house.y, 0.5)
	for _, neighbor in ipairs(Grid.neighbors8(house.x, house.y)) do
		local nx, ny = neighbor[1], neighbor[2]
		if Grid.inBounds(nx, ny)
			and not self.buildings[Grid.key(nx, ny)]
			and not Maps.isWater(self.map, nx, ny)
		then
			local target = Grid.center(self.origin, nx, ny, 0.5)
			return base:Lerp(target, 0.42)
		end
	end
	return base + Vector3.new(1.1, 0, 0)
end

function Session:createCarVisual(house, spot)
	local palette = COLORS[house.colorIndex]
	local bodyCFrame = CFrame.new(spot)

	local model = Instance.new("Model")
	model.Name = "Car"

	-- Contour sombre sous la carrosserie.
	makePart({
		Name = "Outline",
		Parent = model,
		Size = Vector3.new(1.55, 0.28, 2.50),
		CFrame = bodyCFrame * CFrame.new(0, -0.10, 0),
		Color = Config.Colors.Ink,
	})

	local body = makePart({
		Name = "Body",
		Parent = model,
		Size = Vector3.new(1.35, 0.45, 2.30),
		CFrame = bodyCFrame,
		Color = palette.color,
	})
	model.PrimaryPart = body

	-- Toit clair, avec un liseré sombre.
	makePart({
		Name = "CabinOutline",
		Parent = model,
		Size = Vector3.new(1.02, 0.10, 1.18),
		CFrame = bodyCFrame * CFrame.new(0, 0.25, -0.15),
		Color = Config.Colors.Ink,
	})
	makePart({
		Name = "Cabin",
		Parent = model,
		Size = Vector3.new(0.84, 0.18, 0.98),
		CFrame = bodyCFrame * CFrame.new(0, 0.33, -0.15),
		Color = Config.Colors.White,
	})

	model:PivotTo(CFrame.new(spot))
	model.Parent = self.world.Cars
	return model
end

function Session:trySpawnCar(house)
	if house.car or self.over then
		return
	end

	local destination = house.dest
	if not destination then
		destination = self:findDestinationForHouse(house)
		house.dest = destination
	end
	if not destination then
		house.timer = 2
		return
	end

	local spot = self:parkingSpot(house)
	local car = {
		house = house,
		dest = destination,
		state = "out",
		path = nil,
		index = 2,
		t = 0,
		pos = spot,
		blocked = true,
		waitTime = 0,
		retry = 0,
		roadVersion = -1,
		part = self:createCarVisual(house, spot),
	}

	table.insert(self.cars, car)
	house.car = car

	local path = self:findPath(car)
	if path then
		self:setCarPath(car, path)
	end
end

function Session:findPath(car)
	local from = car.state == "out" and car.house or car.dest
	local to = car.state == "out" and car.dest or car.house

	local goalSet = {}
	for _, key in ipairs(self:connectorCells(to)) do
		goalSet[key] = true
	end
	if next(goalSet) == nil then
		return nil
	end

	local starts = self:connectorCells(from)
	if car.currentKey and self.roads[car.currentKey] then
		starts = { car.currentKey }
	end
	if #starts == 0 then
		return nil
	end

	local bestPath = nil
	for _, startKey in ipairs(starts) do
		local path = Pathfinding.find(self.roads, self.size, startKey, goalSet)
		if path and (not bestPath or #path < #bestPath) then
			bestPath = path
		end
	end
	return bestPath
end

function Session:setCarPath(car, path)
	if not path or #path == 0 then
		return
	end
	car.path = path
	car.index = 2
	car.t = 0
	car.currentKey = path[1]
	car.waitTime = 0
	car.retry = 0
	car.blocked = false
	car.roadVersion = self.roadVersion

	local x, y = Grid.parse(path[1])
	if x then
		car.pos = Grid.center(self.origin, x, y, 0.5)
		if car.part then
			car.part:PivotTo(CFrame.new(car.pos))
		end
	end
end

function Session:isBlockedAhead(car, direction)
	for _, other in ipairs(self.cars) do
		if other ~= car and other.pos then
			local delta = other.pos - car.pos
			local along = delta:Dot(direction)
			if along > 0 and along < Config.Traffic.CarSpacing then
				local lateral = (delta - direction * along).Magnitude
				if lateral < 0.9 then
					return true
				end
			end
		end
	end
	return false
end

function Session:completeLeg(car)
	if car.state == "out" then
		self.score += Config.Game.DeliveryScore
		self.satisfaction = math.min(
			Config.Traffic.SatisfactionMax,
			self.satisfaction + Config.Game.DeliverySatisfaction
		)
		car.state = "back"

		local reversed = {}
		for i = #car.path, 1, -1 do
			reversed[#reversed + 1] = car.path[i]
		end
		car.path = reversed
		car.index = 2
		car.t = 0
		car.currentKey = reversed[1]
		car.waitTime = 0
		car.retry = 0
		car.roadVersion = self.roadVersion

		self:destinationPulse(car.dest)
		return false
	end

	return true
end

function Session:updateCar(car, dt)
	if not car.path then
		car.retry -= dt
		if car.retry <= 0 then
			car.retry = Config.Traffic.RetryPathInterval
			local path = self:findPath(car)
			if path then
				self:setCarPath(car, path)
			end
		end
		car.blocked = true
		car.waitTime += dt
		return false
	end

	if car.index > #car.path then
		return self:completeLeg(car)
	end

	local fromKey = car.path[car.index - 1]
	local toKey = car.path[car.index]
	if not self.roads[toKey] then
		local path = self:findPath(car)
		if path then
			self:setCarPath(car, path)
		else
			car.path = nil
			car.retry = Config.Traffic.RetryPathInterval
		end
		return false
	end

	local fx, fy = Grid.parse(fromKey)
	local tx, ty = Grid.parse(toKey)
	if not fx or not tx then
		car.path = nil
		return false
	end

	local fromPos = Grid.center(self.origin, fx, fy, 0.5)
	local toPos = Grid.center(self.origin, tx, ty, 0.5)
	local direction = (toPos - fromPos).Unit
	-- La vitesse doit rester en studs/seconde réels : une diagonale est
	-- plus longue qu'une case orthogonale, donc on divise par la longueur
	-- du segment et non par la taille de la case.
	local segmentLength = math.max((toPos - fromPos).Magnitude, 0.001)

	local blocked = self:isBlockedAhead(car, direction)
	if blocked then
		car.blocked = true
		car.waitTime += dt
	else
		car.blocked = false
		car.waitTime = math.max(0, car.waitTime - dt * 2)
		car.t += (Config.Traffic.CarSpeed * dt) / segmentLength
	end

	if car.t >= 1 then
		car.t = 0
		car.index += 1
		car.currentKey = toKey
		car.pos = toPos
		if car.part then
			car.part:PivotTo(CFrame.new(toPos))
		end
		if car.index > #car.path then
			return self:completeLeg(car)
		end
		return false
	end

	car.pos = fromPos:Lerp(toPos, car.t) + Vector3.new(-direction.Z, 0, direction.X) * 0.55
	if car.part then
		car.part:PivotTo(CFrame.lookAt(car.pos, car.pos + direction))
	end
	return false
end

function Session:retireCar(car)
	if car.part then
		car.part:Destroy()
		car.part = nil
	end
	local house = car.house
	if house then
		house.car = nil
		house.timer = Config.Game.SpawnInterval
	end
end

function Session:destinationPulse(destination)
	if not destination or not self.world then
		return
	end

	local ring = Instance.new("Part")
	ring.Name = "Delivery"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = destination.color
	ring.Transparency = 0.35
	ring.Size = Vector3.new(0.1, 3.2, 3.2)
	ring.CFrame = CFrame.new(Grid.center(self.origin, destination.x, destination.y, 0.35))
		* CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = self.world.FX

	TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.1, 7.5, 7.5),
		Transparency = 1,
	}):Play()

	task.delay(0.6, function()
		if ring.Parent then
			ring:Destroy()
		end
	end)
end

function Session:updateSatisfaction(dt)
	local drain = 0
	for _, car in ipairs(self.cars) do
		-- Une voiture sans trajet n'est pas encore "dans le trafic" :
		-- on ne pénalise que les voitures réellement bloquées sur un chemin.
		if car.path and car.waitTime >= Config.Traffic.StuckAfter then
			drain += Config.Traffic.DrainPerStuckCar
		end
	end

	if drain > 0 then
		self.satisfaction -= drain * dt
	else
		self.satisfaction = math.min(
			Config.Traffic.SatisfactionMax,
			self.satisfaction + Config.Traffic.RegenPerSecond * dt
		)
	end

	if self.satisfaction <= 0 then
		self.satisfaction = 0
		self:gameOver()
	end
end

function Session:pickWeekChoices()
	local roadReward = math.random() < 0.35 and Config.Rewards.RoadsSmall or Config.Rewards.Roads
	local secondReward = math.random() < 0.5 and Config.Rewards.Bridge or Config.Rewards.Roundabout
	local options = { roadReward, secondReward }
	if math.random() < 0.5 then
		options[1], options[2] = options[2], options[1]
	end
	return options
end

function Session:offerWeekChoice()
	self.awaitingChoice = true
	self.paused = true
	self.choice = {
		week = self.week,
		options = self:pickWeekChoices(),
	}
	Remotes.get("WeekChoice"):FireClient(self.player, self.choice)
	self:sendState()
end

function Session:chooseReward(optionId)
	if not self.awaitingChoice or not self.choice then
		return
	end
	local selected = nil
	for _, option in ipairs(self.choice.options or {}) do
		if option.id == optionId then
			selected = option
			break
		end
	end
	if not selected then
		return
	end

	if selected.kind == "roads" then
		self.budget = math.min(Config.Roads.MaxBudget, self.budget + selected.amount)
	elseif selected.kind == "bridges" then
		self.bridgesLeft = math.min(Config.Roads.MaxBridges, self.bridgesLeft + selected.amount)
	elseif selected.kind == "roundabouts" then
		self.roundaboutsLeft = math.min(Config.Roads.MaxRoundabouts, self.roundaboutsLeft + selected.amount)
	end

	self.awaitingChoice = false
	self.choice = nil
	self.paused = false
	self:sendState()
	self:toast("Amélioration choisie : " .. selected.title .. ".")
end

function Session:setSpeed(value)
	value = tonumber(value) or 1
	self.speed = clamp(math.floor(value), 1, 3)
	self:sendState()
end

function Session:update(dt)
	-- Même en pause, on peut effacer des routes : le ruban visuel doit se
	-- mettre à jour sans attendre la reprise de la simulation.
	if self.roadRibbonsDirty then
		self.roadRibbonsDirty = false
		self:rebuildRoadRibbons()
	end

	if not self.running or self.paused or self.over or self.awaitingChoice then
		return
	end

	dt = dt * self.speed

	self.weekTime += dt
	if self.weekTime >= Config.Game.WeekDuration then
		self.weekTime -= Config.Game.WeekDuration
		self.week += 1
		self:offerWeekChoice()
		return
	end

	self.pairClock -= dt
	if self.pairClock <= 0 and #self.houses < Config.Game.MaxPairs then
		self.pairClock = Config.Game.PairInterval
		self:spawnPair(false)
	end

	for _, house in ipairs(self.houses) do
		if not house.car then
			house.timer -= dt
			if house.timer <= 0 then
				house.timer = 0
				self:trySpawnCar(house)
			end
		end
	end

	for i = #self.cars, 1, -1 do
		local car = self.cars[i]
		if self:updateCar(car, dt) then
			table.remove(self.cars, i)
			self:retireCar(car)
		end
	end

	self:updateSatisfaction(dt)

	self.stateClock += dt
	if self.stateClock >= 0.2 then
		self.stateClock = 0
		self:sendState()
	end
end

function Session:sendState()
	Remotes.get("State"):FireClient(self.player, {
		score = self.score,
		week = self.week,
		weekProgress = clamp(self.weekTime / Config.Game.WeekDuration, 0, 1),
		budget = self.budget,
		bridges = self.bridgesLeft,
		roundabouts = self.roundaboutsLeft,
		satisfaction = self.satisfaction,
		speed = self.speed,
		paused = self.paused,
		awaitingChoice = self.awaitingChoice,
		choice = self.choice,
		over = self.over,
		houses = #self.houses,
		destinations = #self.destinations,
		cars = #self.cars,
	})
end

function Session:start()
	self.running = true
	self.paused = false
	self.over = false
	self.awaitingChoice = false
	self.choice = nil
	self.speed = 1

	Remotes.get("GameStarted"):FireClient(self.player, {
		mapId = self.mapId,
		origin = self.origin,
		size = self.size,
		tile = self.tile,
		weekDuration = Config.Game.WeekDuration,
	})

	self:sendState()
	self:toast("Tracez des routes entre les maisons et les bâtiments de la même couleur.")
end

function Session:setPaused(value)
	if self.over or self.awaitingChoice then
		return
	end
	self.paused = value == true
	self:sendState()
end

function Session:toast(text)
	Remotes.get("Toast"):FireClient(self.player, text)
end

function Session:gameOver()
	if self.over then
		return
	end
	self.over = true
	self.running = false
	self.paused = false
	self.awaitingChoice = false
	self.choice = nil

	local best = Profile.submit(self.player, self.mapId, self.score)
	Remotes.get("GameOver"):FireClient(self.player, {
		mapId = self.mapId,
		score = self.score,
		best = best,
		week = self.week,
	})
	self:sendState()
end

function Session:destroy()
	self.running = false
	self.over = true
	self.paused = false
	if self.world and self.world.folder then
		self.world.folder:Destroy()
	end
	self.world = nil
	self.cars = {}
	self.houses = {}
	self.destinations = {}
	self.buildings = {}
	self.buildingList = {}
	self.roundaboutParts = {}
	self.roadRibbons = {}
	self.roadRibbonPaths = {}
	self.ribbonEdges = {}
	self.lastRibbonCell = nil
	self.choice = nil
end

return Session
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <ProtectedString name="Source"><![CDATA[--[[
	WorldBuilder.luau
	Construit le décor 3D d'une ville : sol, eau lissée, lignes de grille,
	puis les dossiers qui recevront routes, bâtiments et voitures.
	L'eau est dessinée avec les mêmes formes que l'aperçu du menu :
	rectangles, ellipses et capsules, avec une ombre d'eau et un liseré de
	côte blanc autour du remplissage menthe.
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local WorldBuilder = {}

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth

	local parent = nil
	for key, value in pairs(props) do
		if key == "Parent" then
			parent = value
		else
			p[key] = value
		end
	end
	if parent then
		p.Parent = parent
	end
	return p
end

-- Important : une Part de type Ball garde toujours un diamètre rond
-- (le minimum de ses trois axes). Pour obtenir une vraie ellipse d'eau
-- aplatie, on utilise un SpecialMesh sphère, qui suit les proportions
-- de la Part.
local function addSphereMesh(p)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1, 1)
	mesh.Parent = p
	return p
end

-- Dessine une forme d'eau normalisée (0..1) à l'échelle de la carte.
-- padding agrandit la forme pour créer l'ombre ou le liseré de côte.
local function drawWaterShape(parent, shape, origin, mapSize, color, height, centerY, padding)
	local kind = shape.type
	padding = padding or 0

	if kind == "rect" then
		local center = Vector3.new(
			origin.X + (shape.x + shape.w * 0.5) * mapSize,
			centerY,
			origin.Z + (shape.y + shape.h * 0.5) * mapSize
		)
		part({
			Name = "Water",
			Parent = parent,
			Size = Vector3.new(
				shape.w * mapSize + padding * 2,
				height,
				shape.h * mapSize + padding * 2
			),
			CFrame = CFrame.new(center),
			Color = color,
		})
		return
	end

	if kind == "circle" or kind == "ellipse" then
		local rx = shape.rx or shape.r or 0.05
		local ry = shape.ry or shape.r or rx
		local center = Vector3.new(
			origin.X + shape.x * mapSize,
			centerY,
			origin.Z + shape.y * mapSize
		)
		-- La rotation de l'aperçu est horaire à l'écran ; en 3D, l'axe Z
		-- descend et l'axe Y tourne dans le sens inverse.
		local rotation = CFrame.Angles(0, math.rad(-(shape.rotation or 0)), 0)
		local p = part({
			Name = "Water",
			Parent = parent,
			Size = Vector3.new(
				rx * 2 * mapSize + padding * 2,
				height,
				ry * 2 * mapSize + padding * 2
			),
			CFrame = CFrame.new(center) * rotation,
			Color = color,
		})
		addSphereMesh(p)
		return
	end

	if kind == "bar" then
		local thickness = (shape.thickness or 0.04) * mapSize
		local radius = thickness * 0.5 + padding
		local x1 = shape.x1 * mapSize
		local z1 = shape.y1 * mapSize
		local x2 = shape.x2 * mapSize
		local z2 = shape.y2 * mapSize
		local dx = x2 - x1
		local dz = z2 - z1
		local length = math.sqrt(dx * dx + dz * dz)
		if length <= 0 then
			return
		end

		if shape.flatStart then
			-- Presqu'île : le côté terre est coupé net, seul le côté eau
			-- garde un bout arrondi. Cela évite le gros capuchon blanc qui
			-- dépassait sur le continent.
			local from = Vector3.new(origin.X + x1, centerY, origin.Z + z1)
			local to = Vector3.new(origin.X + x2, centerY, origin.Z + z2)
			local direction = (to - from).Unit
			part({
				Name = "Water",
				Parent = parent,
				Size = Vector3.new(radius * 2, height, length),
				CFrame = CFrame.lookAt((from + to) * 0.5, (from + to) * 0.5 + direction),
				Color = color,
			})
			local cap = part({
				Name = "Water",
				Parent = parent,
				Size = Vector3.new(radius * 2, height, radius * 2),
				CFrame = CFrame.new(to),
				Color = color,
			})
			addSphereMesh(cap)
			return
		end

		local step = math.max(0.35, radius * 0.35)
		local count = math.max(1, math.ceil(length / step))
		for i = 0, count do
			local t = i / count
			local p = part({
				Name = "Water",
				Parent = parent,
				Size = Vector3.new(radius * 2, height, radius * 2),
				CFrame = CFrame.new(
					origin.X + x1 + dx * t,
					centerY,
					origin.Z + z1 + dz * t
				),
				Color = color,
			})
			addSphereMesh(p)
		end
	end
end

-- Cache l'eau qui dépasserait de la carte, pour garder un bord net.
local function addWaterMasks(parent, origin, mapSize, border)
	local y = 0.17
	local thickness = 0.06
	local outer = mapSize + border * 2

	part({
		Name = "WaterMaskTop",
		Parent = parent,
		Size = Vector3.new(outer, thickness, border),
		CFrame = CFrame.new(origin.X + mapSize * 0.5, y, origin.Z - border * 0.5),
		Color = Config.Colors.Paper,
	})
	part({
		Name = "WaterMaskBottom",
		Parent = parent,
		Size = Vector3.new(outer, thickness, border),
		CFrame = CFrame.new(origin.X + mapSize * 0.5, y, origin.Z + mapSize + border * 0.5),
		Color = Config.Colors.Paper,
	})
	part({
		Name = "WaterMaskLeft",
		Parent = parent,
		Size = Vector3.new(border, thickness, mapSize),
		CFrame = CFrame.new(origin.X - border * 0.5, y, origin.Z + mapSize * 0.5),
		Color = Config.Colors.Paper,
	})
	part({
		Name = "WaterMaskRight",
		Parent = parent,
		Size = Vector3.new(border, thickness, mapSize),
		CFrame = CFrame.new(origin.X + mapSize + border * 0.5, y, origin.Z + mapSize * 0.5),
		Color = Config.Colors.Paper,
	})
end

-- Étiquette verticale sur la bordure, comme « LOS ANGELES » dans la vidéo.
local function addMapLabel(parent, origin, mapSize, border, label)
	local side = label.side or "right"
	local strip
	if side == "left" then
		strip = part({
			Name = "MapLabelStrip",
			Parent = parent,
			Size = Vector3.new(border * 0.42, 0.06, mapSize * 0.64),
			CFrame = CFrame.new(origin.X - border * 0.5, 0.255, origin.Z + mapSize * 0.5),
			Color = Config.Colors.Teal,
			Transparency = 0.08,
		})
	else
		strip = part({
			Name = "MapLabelStrip",
			Parent = parent,
			Size = Vector3.new(border * 0.42, 0.06, mapSize * 0.64),
			CFrame = CFrame.new(origin.X + mapSize + border * 0.5, 0.255, origin.Z + mapSize * 0.5),
			Color = Config.Colors.Teal,
			Transparency = 0.08,
		})
	end

	local surface = Instance.new("SurfaceGui")
	surface.Name = "Label"
	surface.Face = Enum.NormalId.Top
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 24
	surface.LightInfluence = 0
	surface.Parent = strip

	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.BorderSizePixel = 0
	text.Text = string.upper(label.text)
	text.Font = Enum.Font.GothamBold
	text.TextColor3 = Config.Colors.White
	text.TextScaled = true
	text.Rotation = side == "left" and 270 or 90
	text.ZIndex = 2
	text.Parent = surface

	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 20
	constraint.MinTextSize = 8
	constraint.Parent = text
end

-- Diagonal hatching around the playable map, like the reference PC build.
-- A SurfaceGui with clipped diagonal bars keeps the part count low.
local function addHatchStrip(parent, center, size)
	local base = part({
		Name = "BorderHatch",
		Parent = parent,
		Size = size,
		CFrame = CFrame.new(center),
		Color = Config.Colors.Border,
	})

	local surface = Instance.new("SurfaceGui")
	surface.Name = "Hatch"
	surface.Face = Enum.NormalId.Top
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 16
	surface.LightInfluence = 0
	surface.Parent = base

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Config.Colors.Border
	frame.BorderSizePixel = 0
	frame.ClipsDescendants = true
	frame.Parent = surface

	for index = -4, 28 do
		local stripe = Instance.new("Frame")
		stripe.AnchorPoint = Vector2.new(0.5, 0.5)
		stripe.Position = UDim2.fromScale(index / 16, 0.5)
		stripe.Size = UDim2.new(0, 9, 2, 0)
		stripe.Rotation = 45
		stripe.BackgroundColor3 = Config.Colors.BorderStripe
		stripe.BorderSizePixel = 0
		stripe.Parent = frame
	end
end

local function addHatchedBorder(parent, origin, mapSize, border)
	local y = 0.21
	local thickness = 0.06
	local outer = mapSize + border * 2

	addHatchStrip(
		parent,
		Vector3.new(origin.X + mapSize * 0.5, y, origin.Z - border * 0.5),
		Vector3.new(outer, thickness, border)
	)
	addHatchStrip(
		parent,
		Vector3.new(origin.X + mapSize * 0.5, y, origin.Z + mapSize + border * 0.5),
		Vector3.new(outer, thickness, border)
	)
	addHatchStrip(
		parent,
		Vector3.new(origin.X - border * 0.5, y, origin.Z + mapSize * 0.5),
		Vector3.new(border, thickness, mapSize)
	)
	addHatchStrip(
		parent,
		Vector3.new(origin.X + mapSize + border * 0.5, y, origin.Z + mapSize * 0.5),
		Vector3.new(border, thickness, mapSize)
	)

	-- Thin dark lip so the hatching never bleeds onto the playable grid.
	local lipColor = Config.Colors.Border
	part({
		Name = "MapLipTop",
		Parent = parent,
		Size = Vector3.new(mapSize + 0.8, 0.05, 0.4),
		CFrame = CFrame.new(origin.X + mapSize * 0.5, 0.235, origin.Z + 0.2),
		Color = lipColor,
	})
	part({
		Name = "MapLipBottom",
		Parent = parent,
		Size = Vector3.new(mapSize + 0.8, 0.05, 0.4),
		CFrame = CFrame.new(origin.X + mapSize * 0.5, 0.235, origin.Z + mapSize - 0.2),
		Color = lipColor,
	})
	part({
		Name = "MapLipLeft",
		Parent = parent,
		Size = Vector3.new(0.4, 0.05, mapSize + 0.8),
		CFrame = CFrame.new(origin.X + 0.2, 0.235, origin.Z + mapSize * 0.5),
		Color = lipColor,
	})
	part({
		Name = "MapLipRight",
		Parent = parent,
		Size = Vector3.new(0.4, 0.05, mapSize + 0.8),
		CFrame = CFrame.new(origin.X + mapSize - 0.2, 0.235, origin.Z + mapSize * 0.5),
		Color = lipColor,
	})
end

function WorldBuilder.build(session)
	local origin = session.origin
	local size = session.size
	local tile = session.tile
	local map = session.map

	local mapSize = size * tile
	local center = origin + Vector3.new(mapSize / 2, 0, mapSize / 2)
	local border = 24

	local worlds = Workspace:FindFirstChild("MMWorlds")
	if not worlds then
		worlds = Instance.new("Folder")
		worlds.Name = "MMWorlds"
		worlds.Parent = Workspace
	end

	local root = Instance.new("Folder")
	root.Name = "City_" .. session.worldIndex

	local buildings = Instance.new("Folder")
	buildings.Name = "Buildings"
	buildings.Parent = root

	local roads = Instance.new("Folder")
	roads.Name = "Roads"
	roads.Parent = root

	local cars = Instance.new("Folder")
	cars.Name = "Cars"
	cars.Parent = root

	local fx = Instance.new("Folder")
	fx.Name = "FX"
	fx.Parent = root

	local water = Instance.new("Folder")
	water.Name = "Water"
	water.Parent = root

	local grass = Instance.new("Folder")
	grass.Name = "Grass"
	grass.Parent = root

	-- Fond clair, papier crème : la carte ressemble à une feuille posée sur un bureau.
	local backdrop = part({
		Name = "Backdrop",
		Size = Vector3.new(mapSize + 240, 1.0, mapSize + 240),
		CFrame = CFrame.new(center + Vector3.new(0, -2.2, 0)),
		Color = Config.Colors.Background,
	})
	backdrop.Parent = root

	local paper = part({
		Name = "Paper",
		Size = Vector3.new(mapSize + border * 2, 1.6, mapSize + border * 2),
		CFrame = CFrame.new(center + Vector3.new(0, -1.5, 0)),
		Color = Config.Colors.Paper,
	})
	paper.Parent = root

	-- Sol crème.
	local ground = part({
		Name = "Ground",
		Size = Vector3.new(mapSize, 1, mapSize),
		CFrame = CFrame.new(center + Vector3.new(0, -0.5, 0)),
		Color = map.land,
		CanQuery = true,
	})
	ground.Parent = root

	-- Parcs jaune-vert, dessinés sous la grille et sous l'eau.
	for _, shape in ipairs(map.grassShapes or {}) do
		drawWaterShape(grass, shape, origin, mapSize, map.grass or Config.Colors.Grass, 0.02, 0.005, 0)
	end

	-- Petits arbres plats dans les parcs : deux disques superposés, un sombre
	-- et un clair, pour retrouver les taches végétales de la référence.
	local treeRotation = CFrame.Angles(0, 0, math.rad(90))
	local function addTreeCluster(cx, cz, scale)
		local dark = part({
			Name = "Tree",
			Parent = grass,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, 1.45 * scale, 1.45 * scale),
			CFrame = CFrame.new(cx, 0.032, cz) * treeRotation,
			Color = Config.Colors.TreeDark,
			CastShadow = false,
		})
		part({
			Name = "TreeLeaf",
			Parent = grass,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, 1.02 * scale, 1.02 * scale),
			CFrame = CFrame.new(cx - 0.12 * scale, 0.042, cz - 0.12 * scale) * treeRotation,
			Color = Config.Colors.TreeLight,
			CastShadow = false,
		})
		return dark
	end

	for index, shape in ipairs(map.grassShapes or {}) do
		local cx, cz
		if shape.type == "ellipse" then
			cx, cz = shape.x, shape.y
		elseif shape.type == "rect" then
			cx, cz = shape.x + shape.w * 0.5, shape.y + shape.h * 0.5
		elseif shape.type == "bar" then
			cx, cz = (shape.x1 + shape.x2) * 0.5, (shape.y1 + shape.y2) * 0.5
		end
		if cx then
			local x = origin.X + cx * mapSize
			local z = origin.Z + cz * mapSize
			local spread = mapSize * 0.045 + (index % 2) * mapSize * 0.012
			addTreeCluster(x, z, 1.0)
			addTreeCluster(x - spread, z + spread * 0.35, 0.82)
			addTreeCluster(x + spread * 0.72, z - spread * 0.55, 0.72)
		end
	end

	-- Lignes de grille, dessinées avant l'eau pour être recouvertes par elle.
	local lineColor = Config.Colors.GridLine
	for i = 1, size - 1 do
		local offset = i * tile
		local vertical = part({
			Name = "GridV",
			Parent = root,
			Size = Vector3.new(0.10, 0.035, mapSize),
			CFrame = CFrame.new(origin + Vector3.new(offset, 0.02, mapSize / 2)),
			Color = lineColor,
			Transparency = 0.05,
		})
		vertical.Parent = root

		local horizontal = part({
			Name = "GridH",
			Parent = root,
			Size = Vector3.new(mapSize, 0.035, 0.10),
			CFrame = CFrame.new(origin + Vector3.new(mapSize / 2, 0.02, offset)),
			Color = lineColor,
			Transparency = 0.05,
		})
		horizontal.Parent = root
	end

	-- Eau en trois couches : ombre extérieure, liseré de côte blanc, puis
	-- remplissage. Le liseré blanc rend la côte lisible sur le sol crème,
	-- comme sur l'aperçu du menu.
	local outlinePadding = math.max(0.45, tile * 0.20)
	local shadowColor = map.waterDeep or Config.Colors.WaterDeep
	local coastColor = Config.Colors.Coast or Config.Colors.White
	local shapes = map.waterShapes or {}

	for _, shape in ipairs(shapes) do
		drawWaterShape(water, shape, origin, mapSize, shadowColor, 0.08, 0.06, outlinePadding * 1.8)
	end
	for _, shape in ipairs(shapes) do
		drawWaterShape(water, shape, origin, mapSize, coastColor, 0.10, 0.11, outlinePadding * 0.95)
	end
	for _, shape in ipairs(shapes) do
		drawWaterShape(water, shape, origin, mapSize, map.water, 0.10, 0.13, 0)
	end

	-- Presqu'îles sèches : elles recouvrent l'eau, avec le même liseré de
	-- côte blanc. Le raccord terre est posé au-dessus pour souder la
	-- presqu'île au continent sans laisser de trait blanc en travers.
	for _, shape in ipairs(map.dryShapes or {}) do
		drawWaterShape(water, shape, origin, mapSize, coastColor, 0.04, 0.19, outlinePadding * 0.95)
	end
	for _, shape in ipairs(map.dryShapes or {}) do
		drawWaterShape(water, shape, origin, mapSize, map.land, 0.03, 0.20, 0)
	end
	for _, shape in ipairs(map.dryPatches or {}) do
		drawWaterShape(water, shape, origin, mapSize, map.land, 0.03, 0.215, 0)
	end

	addWaterMasks(root, origin, mapSize, border)
	addHatchedBorder(root, origin, mapSize, border)
	for _, label in ipairs(map.labels or {}) do
		addMapLabel(root, origin, mapSize, border, label)
	end

	root.Parent = worlds

	return {
		folder = root,
		Buildings = buildings,
		Roads = roads,
		Cars = cars,
		FX = fx,
		Water = water,
		Grass = grass,
	}
end

return WorldBuilder
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="15">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">MiniMotorwaysClient</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">CameraController</string>
            <ProtectedString name="Source"><![CDATA[--[[
	CameraController.luau
	Caméra au-dessus de la ville, recadrée automatiquement selon l'écran.
	La molette zoome, le clic milieu (ou deux doigts) déplace la vue.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local CameraController = {}

local currentOrigin = nil
local currentSize = nil
local currentTile = nil
local activeTween = nil
local zoom = 1
local panX = 0
local panZ = 0
local active = false

local function clamp(value, minValue, maxValue)
	if value < minValue then
		return minValue
	elseif value > maxValue then
		return maxValue
	end
	return value
end

local function computeTarget(origin, size, tile)
	local camera = Workspace.CurrentCamera
	local mapSize = size * tile
	local center = origin + Vector3.new(mapSize / 2 + panX, 0, mapSize / 2 + panZ)

	local viewport = camera.ViewportSize
	local aspect = viewport.X / math.max(viewport.Y, 1)
	local halfFov = math.tan(math.rad(Config.Camera.FOV) * 0.5)
	local needed = (mapSize * (Config.Camera.Fit or 1.18)) / zoom
	local distanceByHeight = (needed * 0.5) / halfFov
	local distanceByWidth = (needed * 0.5) / (halfFov * math.max(aspect, 0.1))
	local distance = math.max(distanceByHeight, distanceByWidth)

	-- Vue quasi orthographique : la ville reste bien droite, comme dans la vidéo.
	local height = distance
	local back = distance * (Config.Camera.BackRatio or 0.035)

	return CFrame.lookAt(center + Vector3.new(0, height, back), center)
end

local function apply(instant)
	if not active or not currentOrigin or not currentSize or not currentTile then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = Config.Camera.FOV

	local target = computeTarget(currentOrigin, currentSize, currentTile)
	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	if instant then
		camera.CFrame = target
	else
		activeTween = TweenService:Create(
			camera,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ CFrame = target }
		)
		activeTween:Play()
	end
end

local function clampPan()
	if not currentSize or not currentTile then
		panX = 0
		panZ = 0
		return
	end
	local mapSize = currentSize * currentTile
	local maxPan = mapSize * math.max(0, 1 - 1 / zoom) * 0.5
	panX = clamp(panX, -maxPan, maxPan)
	panZ = clamp(panZ, -maxPan, maxPan)
end

function CameraController.focus(origin, size, tile, instant)
	currentOrigin = origin
	currentSize = size
	currentTile = tile
	active = true
	zoom = 1
	panX = 0
	panZ = 0

	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = Config.Camera.FOV
	apply(instant)
end

function CameraController.refresh(instant)
	apply(instant)
end

function CameraController.lobby()
	currentOrigin = nil
	currentSize = nil
	currentTile = nil
	active = false
	zoom = 1
	panX = 0
	panZ = 0
	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 60
	camera.CFrame = CFrame.new(0, 400, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
end

function CameraController.zoomBy(delta)
	if not active then
		return
	end
	zoom = clamp(zoom + delta, 1, 2.8)
	clampPan()
	apply(false)
end

function CameraController.setZoom(value)
	if not active then
		return
	end
	zoom = clamp(value, 1, 2.8)
	clampPan()
	apply(false)
end

function CameraController.pan(deltaX, deltaZ)
	if not active then
		return
	end
	panX += deltaX
	panZ += deltaZ
	clampPan()
	apply(false)
end

function CameraController.getZoom()
	return zoom
end

function CameraController.getMapSize()
	if not currentSize or not currentTile then
		return 0
	end
	return currentSize * currentTile
end

local camera = Workspace.CurrentCamera
if camera then
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		if active then
			CameraController.refresh(true)
		end
	end)
end

return CameraController
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">InputController</string>
            <ProtectedString name="Source"><![CDATA[--[[
	InputController.luau
	Dessin des routes à la souris / au doigt.
	Le client envoie des lots de cases au serveur ; le serveur valide.
	Un seul "fantôme" carré montre la case survolée. La carte garde sa taille,
	mais le carré de visée est agrandi et la détection favorise les diagonales.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local InputController = {}
InputController.__index = InputController

-- Le carré de visée déborde légèrement de la case : il est plus facile à
-- repérer et à poser, sans changer la taille réelle de la carte.
local GHOST_SCALE = 1.20
local DIAGONAL_CORNER = 0.32
local DIAGONAL_REACH = 0.95

local function isMouseInput(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.MouseButton2
end

-- GetMouseLocation est la référence écran pour ViewportPointToRay. Pour le
-- tactile, on garde la position de l'InputObject.
local function pointerFrom(input)
	if isMouseInput(input) then
		local location = UserInputService:GetMouseLocation()
		return Vector2.new(location.X, location.Y)
	end
	return Vector2.new(input.Position.X, input.Position.Y)
end

function InputController.new(callbacks)
	local self = setmetatable({}, InputController)
	self.callbacks = callbacks or {}
	self.enabled = false
	self.tool = "build"
	self.origin = Vector3.zero
	self.size = Config.Grid.Size
	self.tile = Config.Grid.TileSize
	self.dragging = false
	self.dragTool = nil
	self.lastCell = nil
	self.diagonalIntent = false
	self.pending = {}
	self.pendingSet = {}
	self.erasePending = {}
	self.eraseSet = {}
	self.sendClock = 0
	self.pointer = nil
	self.ghost = nil
	self:createGhost()
	self:bind()
	return self
end

local function makeGhostPart(name, size)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = Config.Colors.Teal
	part.Transparency = 1
	part.Size = size
	part.Parent = Workspace
	return part
end

function InputController:createGhost()
	-- Un seul carré, fin et presque à plat. Il est volontairement un peu
	-- plus large que la case pour offrir une cible de visée confortable.
	local size = Vector3.new(self.tile * GHOST_SCALE, 0.04, self.tile * GHOST_SCALE)
	self.ghost = makeGhostPart("MM_Ghost", size)
end

function InputController:bind()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not self.enabled then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			local pointer = pointerFrom(input)
			self.pointer = pointer
			if self.tool == "erase" then
				self:startErase(pointer)
			elseif self.tool == "roundabout" then
				self:startRoundabout(pointer)
			else
				self:startBuild(pointer)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			local pointer = pointerFrom(input)
			self.pointer = pointer
			self:startErase(pointer)
		elseif input.KeyCode == Enum.KeyCode.One then
			self:setTool("build")
			if self.callbacks.onToolChanged then
				self.callbacks.onToolChanged("build")
			end
		elseif input.KeyCode == Enum.KeyCode.Two then
			self:setTool("erase")
			if self.callbacks.onToolChanged then
				self.callbacks.onToolChanged("erase")
			end
		elseif input.KeyCode == Enum.KeyCode.Three then
			self:setTool("roundabout")
			if self.callbacks.onToolChanged then
				self.callbacks.onToolChanged("roundabout")
			end
		elseif input.KeyCode == Enum.KeyCode.P then
			if self.callbacks.onPauseRequest then
				self.callbacks.onPauseRequest()
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			local previous = self.pointer
			local nextPointer = pointerFrom(input)
			self.pointer = nextPointer

			-- On mémorise si le geste est réellement en biais. La position
			-- seule ne suffit pas : une ligne horizontale tracée près du bas
			-- d'une case ne doit pas se transformer en diagonale.
			local delta = input.Delta
			local adx = math.abs(delta.X)
			local ady = math.abs(delta.Y)
			if adx < 0.01 and ady < 0.01 and previous then
				adx = math.abs(nextPointer.X - previous.X)
				ady = math.abs(nextPointer.Y - previous.Y)
			end
			local biggest = math.max(adx, ady)
			self.diagonalIntent = biggest >= 1
				and math.min(adx, ady) >= biggest * 0.45
		end

		if processed or not self.enabled or not self.dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			local cell = self:cellAt(pointerFrom(input))
			if cell then
				self:handleCell(cell[1], cell[2])
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if not self.dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.Touch
		then
			self:endDrag()
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		self.sendClock += dt
		if self.sendClock >= 0.05 then
			self.sendClock = 0
			if self.dragging then
				self:flush()
			end
		end
		self:updateGhost()
	end)
end

function InputController:setWorld(origin, size, tile)
	self.origin = origin
	self.size = size or Config.Grid.Size
	self.tile = tile or Config.Grid.TileSize
	self.ghost.Size = Vector3.new(self.tile * GHOST_SCALE, 0.04, self.tile * GHOST_SCALE)
end

function InputController:setEnabled(value)
	self.enabled = value == true
	if not self.enabled then
		self.dragging = false
		self.dragTool = nil
		self.lastCell = nil
		self.diagonalIntent = false
		self.pending = {}
		self.pendingSet = {}
		self.erasePending = {}
		self.eraseSet = {}
		self.ghost.Transparency = 1
	end
end

function InputController:setTool(tool)
	self.tool = tool
	self.ghost.Color = tool == "erase" and Config.Colors.Danger or Config.Colors.Teal
end

function InputController:cellAt(position)
	local camera = Workspace.CurrentCamera
	if not camera then
		return nil
	end

	local x2, y2
	if typeof(position) == "Vector3" then
		x2, y2 = position.X, position.Y
	elseif typeof(position) == "Vector2" then
		x2, y2 = position.X, position.Y
	else
		local mouse = UserInputService:GetMouseLocation()
		x2, y2 = mouse.X, mouse.Y
	end

	local ray = camera:ViewportPointToRay(x2, y2)
	if math.abs(ray.Direction.Y) < 0.0001 then
		return nil
	end

	local distance = (self.origin.Y - ray.Origin.Y) / ray.Direction.Y
	if distance <= 0 then
		return nil
	end

	local hit = ray.Origin + ray.Direction * distance
	-- On utilise self.tile plutôt que la constante globale : la sélection
	-- reste exacte même si la carte fournit une taille de case différente.
	local u = (hit.X - self.origin.X) / self.tile
	local v = (hit.Z - self.origin.Z) / self.tile
	local cellX = math.floor(u)
	local cellY = math.floor(v)
	if not Grid.inBounds(cellX, cellY) then
		return nil
	end

	-- Détection diagonale plus tolérante : quand le curseur approche du coin
	-- partagé avec la dernière case, on privilégie la case diagonale. Un geste
	-- en biais ne fabrique donc plus un escalier en passant par la case
	-- horizontale ou verticale voisine.
	if self.dragging and self.diagonalIntent and self.lastCell then
		local lx, ly = self.lastCell[1], self.lastCell[2]
		local dx = u - (lx + 0.5)
		local dy = v - (ly + 0.5)
		local nearLast = dx * dx + dy * dy <= 1.45 * 1.45
		local leftLast = cellX ~= lx or cellY ~= ly
		if leftLast
			and nearLast
			and math.abs(dx) >= DIAGONAL_CORNER
			and math.abs(dy) >= DIAGONAL_CORNER
		then
			local sx = dx > 0 and 1 or -1
			local sy = dy > 0 and 1 or -1
			local nx, ny = lx + sx, ly + sy
			if Grid.inBounds(nx, ny) then
				local ddx = u - (nx + 0.5)
				local ddy = v - (ny + 0.5)
				if ddx * ddx + ddy * ddy <= DIAGONAL_REACH * DIAGONAL_REACH then
					return { nx, ny }
				end
			end
		end
	end

	return { cellX, cellY }
end

function InputController:startBuild(position)
	local cell = self:cellAt(position)
	if not cell then
		return
	end
	self.dragging = true
	self.dragTool = "build"
	self.lastCell = cell
	self.diagonalIntent = false
	self:addBuild(cell[1], cell[2])
end

function InputController:startErase(position)
	local cell = self:cellAt(position)
	if not cell then
		return
	end
	self.dragging = true
	self.dragTool = "erase"
	self.lastCell = cell
	self.diagonalIntent = false
	self:addErase(cell[1], cell[2])
end

function InputController:startRoundabout(position)
	local cell = self:cellAt(position)
	if not cell then
		return
	end
	self.dragging = false
	self.dragTool = nil
	self.lastCell = nil
	if self.callbacks.onRoundabout then
		self.callbacks.onRoundabout(cell[1], cell[2])
	end
end

function InputController:handleCell(x, y)
	if not self.lastCell then
		self.lastCell = { x, y }
	end

	local lastX, lastY = self.lastCell[1], self.lastCell[2]
	local cx, cy = lastX, lastY
	local guard = 0

	-- On avance simultanément sur X et Y : un geste en diagonale dessine
	-- donc une vraie ligne à 45°, puis termine tout droit si les deux axes
	-- n'ont pas la même longueur. Sans cela, le client fabriquait un escalier
	-- de cases horizontales/verticales et le serveur ne voyait jamais de
	-- diagonale.
	while (cx ~= x or cy ~= y) and guard < 128 do
		local stepX = 0
		local stepY = 0
		if cx ~= x then
			stepX = x > cx and 1 or -1
		end
		if cy ~= y then
			stepY = y > cy and 1 or -1
		end
		cx += stepX
		cy += stepY
		if self.dragTool == "erase" then
			self:addErase(cx, cy)
		else
			self:addBuild(cx, cy)
		end
		guard += 1
	end

	self.lastCell = { x, y }
end

function InputController:addBuild(x, y)
	local key = Grid.key(x, y)
	if self.pendingSet[key] then
		return
	end
	self.pendingSet[key] = true
	table.insert(self.pending, { x, y })
end

function InputController:addErase(x, y)
	local key = Grid.key(x, y)
	if self.eraseSet[key] then
		return
	end
	self.eraseSet[key] = true
	table.insert(self.erasePending, key)
end

function InputController:flush()
	if #self.pending > 0 then
		local batch = self.pending
		self.pending = {}
		self.pendingSet = {}
		if self.callbacks.onDraw then
			self.callbacks.onDraw(batch)
		end
	end

	if #self.erasePending > 0 then
		local batch = self.erasePending
		self.erasePending = {}
		self.eraseSet = {}
		if self.callbacks.onErase then
			for _, key in ipairs(batch) do
				self.callbacks.onErase(key)
			end
		end
	end
end

function InputController:endDrag()
	self:flush()
	self.dragging = false
	self.dragTool = nil
	self.lastCell = nil
	self.diagonalIntent = false
end

function InputController:updateGhost()
	if not self.enabled then
		self.ghost.Transparency = 1
		return
	end

	local cell = self.pointer and self:cellAt(self.pointer) or nil
	if not cell then
		self.ghost.Transparency = 1
		return
	end

	self.ghost.CFrame = CFrame.new(Grid.center(self.origin, cell[1], cell[2], 0.44))
	self.ghost.Color = self.tool == "erase" and Config.Colors.Danger or Config.Colors.Teal
	self.ghost.Transparency = 0.5
end

return InputController
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="21">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Main.client.luau
	Câble le lobby, le HUD, la caméra et les contrôles.
	Le client n'a aucune autorité : il demande, le serveur décide.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Maps = require(Shared.Maps)

local remotesFolder = ReplicatedStorage:WaitForChild("MMRemotes")
local function remote(name)
	return remotesFolder:WaitForChild(name)
end

local CameraController = require(script.Parent.CameraController)
local InputController = require(script.Parent.InputController)
local Lobby = require(script.Parent.UI.Lobby)
local HUD = require(script.Parent.UI.HUD)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
end)

CameraController.lobby()

local lobby
local hud
local input
local currentMapId = nil
local inGame = false

local function playMap(mapId)
	if not mapId then
		return
	end
	currentMapId = mapId
	remote("StartGame"):FireServer(mapId)
end

local function pauseGame()
	if not inGame then
		return
	end
	remote("SetPaused"):FireServer(true)
	-- La pause fige le temps, mais on garde l'outil de construction actif :
	-- le joueur peut continuer à tracer ou effacer des routes.
end

local function resumeGame()
	remote("SetPaused"):FireServer(false)
	if hud then
		hud:hidePause()
	end
	if input then
		input:setEnabled(true)
	end
end

local function goToLobby()
	remote("ReturnToLobby"):FireServer()
	inGame = false
	if input then
		input:setEnabled(false)
	end
	if hud then
		hud:hide()
	end
	if lobby then
		lobby:show()
		lobby:showMaps()
	end
	CameraController.lobby()
end

lobby = Lobby.new({
	onPlay = function()
		lobby:showMaps()
	end,
	onQuit = function()
		player:Kick("Merci d'avoir joué à " .. Config.GameName .. " !")
	end,
	onStartMap = playMap,
	onResetRecords = function()
		remote("ResetRecords"):FireServer()
		lobby:toast("Records réinitialisés")
	end,
})

-- Affiche le menu immédiatement : même si un autre module échoue plus tard,
-- les boutons du lobby restent visibles et réactifs.
lobby:show()

hud = HUD.new({
	onPause = pauseGame,
	onResume = resumeGame,
	onRestart = function()
		if currentMapId then
			hud:hideModals()
			playMap(currentMapId)
		end
	end,
	onMenu = goToLobby,
	onToolChange = function(tool)
		if input then
			input:setTool(tool)
		end
	end,
	onSpeed = function(value)
		remote("SetSpeed"):FireServer(value)
	end,
	onChooseReward = function(optionId)
		remote("ChooseReward"):FireServer(optionId)
		if input then
			input:setEnabled(true)
		end
	end,
})

input = InputController.new({
	onDraw = function(cells)
		remote("DrawRoad"):FireServer(cells)
	end,
	onErase = function(key)
		remote("EraseRoad"):FireServer(key)
	end,
	onRoundabout = function(x, y)
		remote("PlaceRoundabout"):FireServer(x, y)
	end,
	onToolChanged = function(tool)
		if hud then
			hud:setTool(tool)
		end
	end,
	onPauseRequest = pauseGame,
})

local panning = false
UserInputService.InputChanged:Connect(function(input)
	if not inGame then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		CameraController.zoomBy(-input.Position.Z * 0.14)
	elseif input.UserInputType == Enum.UserInputType.MouseMovement and panning then
		local camera = Workspace.CurrentCamera
		local mapSize = CameraController.getMapSize()
		if camera and mapSize > 0 then
			local scale = mapSize / math.max(camera.ViewportSize.Y, 1) / CameraController.getZoom()
			CameraController.pan(-input.Delta.X * scale, -input.Delta.Y * scale)
		end
	end
end)

UserInputService.InputBegan:Connect(function(input)
	if inGame and input.UserInputType == Enum.UserInputType.MouseButton3 then
		panning = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton3 then
		panning = false
	end
end)

remote("GameStarted").OnClientEvent:Connect(function(data)
	currentMapId = data.mapId
	inGame = true

	lobby:hide()
	hud:showGame(data, Maps.getById(data.mapId))

	CameraController.focus(data.origin, data.size, data.tile)
	input:setWorld(data.origin, data.size, data.tile)
	input:setEnabled(true)
	input:setTool("build")
	hud:setTool("build")
end)

remote("State").OnClientEvent:Connect(function(state)
	hud:setState(state)
	if state.over then
		input:setEnabled(false)
	end
end)

remote("WeekChoice").OnClientEvent:Connect(function(data)
	hud:showWeekChoice(data)
	if input then
		input:setEnabled(false)
	end
end)

remote("GameOver").OnClientEvent:Connect(function(data)
	hud:showGameOver(data)
	input:setEnabled(false)
end)

remote("Toast").OnClientEvent:Connect(function(text)
	if inGame then
		hud:toast(text)
	else
		lobby:toast(text)
	end
end)

remote("Profile").OnClientEvent:Connect(function(profile)
	lobby:setProfile(profile)
end)

lobby:show()

task.delay(1, function()
	remote("RequestProfile"):FireServer()
end)
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="22">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">HUD</string>
              <ProtectedString name="Source"><![CDATA[--[[
	HUD.luau
	Interface de jeu claire et minimaliste, inspirée de la vidéo :
	flèche retour, score / jour / horloge, pause / lecture / avance rapide,
	outils à droite, compteurs rond-point / routes / ponts, choix hebdomadaire.
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Theme = require(script.Parent.Theme)

local HUD = {}
HUD.__index = HUD

local DAYS = { "LUN", "MAR", "MER", "JEU", "VEN", "SAM", "DIM" }
local BRIDGE_CHIP = Color3.fromHex("7F8A7C")

local function clamp01(value)
	if value < 0 then
		return 0
	elseif value > 1 then
		return 1
	end
	return value
end

function HUD.new(callbacks)
	local self = setmetatable({}, HUD)
	self.callbacks = callbacks or {}
	self.tool = "build"
	self.toolButtons = {}
	self.mapName = ""
	self.toastToken = 0
	self.hintToken = 0
	self.speed = 1
	self.roundabouts = 0
	self.choiceWeek = nil
	self.choiceDismissedWeek = nil
	self:build()
	return self
end

function HUD:iconPen(parent)
	local holder = Theme.new("Frame", {
		Parent = parent,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	Theme.new("Frame", {
		Parent = holder,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(22, 6),
		BackgroundColor3 = Theme.White,
		BorderSizePixel = 0,
		Rotation = 45,
	})
	Theme.circle(holder, 7, Theme.White, {
		Position = UDim2.fromScale(0.30, 0.68),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	return holder
end

function HUD:iconTrash(parent)
	local holder = Theme.new("Frame", {
		Parent = parent,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	Theme.new("Frame", {
		Parent = holder,
		Position = UDim2.fromScale(0.5, 0.27),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(20, 4),
		BackgroundColor3 = Theme.White,
		BorderSizePixel = 0,
	})
	Theme.new("Frame", {
		Parent = holder,
		Position = UDim2.fromScale(0.5, 0.60),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(15, 17),
		BackgroundColor3 = Theme.White,
		BorderSizePixel = 0,
	})
	for index = 1, 2 do
		Theme.new("Frame", {
			Parent = holder,
			Position = UDim2.fromScale(0.42 + (index - 1) * 0.16, 0.60),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(2, 10),
			BackgroundColor3 = Theme.PanelDark,
			BorderSizePixel = 0,
		})
	end
	return holder
end

function HUD:iconRoundabout(parent)
	local holder = Theme.new("Frame", {
		Parent = parent,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	local outer = Theme.circle(holder, 22, Theme.White, {
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	Theme.circle(outer, 13, Theme.Teal, {
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	for _, offset in ipairs({
		{ 0.5, 0.14 },
		{ 0.5, 0.86 },
		{ 0.14, 0.5 },
		{ 0.86, 0.5 },
	}) do
		Theme.new("Frame", {
			Parent = holder,
			Position = UDim2.fromScale(offset[1], offset[2]),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(4, 10),
			BackgroundColor3 = Theme.White,
			BorderSizePixel = 0,
			Rotation = (offset[1] == 0.5) and 0 or 90,
		})
	end
	return holder
end

function HUD:iconRoad(parent)
	local holder = Theme.new("Frame", {
		Parent = parent,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	for index = 1, 3 do
		Theme.new("Frame", {
			Parent = holder,
			Position = UDim2.fromOffset(9, 12 + (index - 1) * 7),
			Size = UDim2.fromOffset(24, 4),
			BackgroundColor3 = Theme.White,
			BorderSizePixel = 0,
			Rotation = -18,
		})
	end
	return holder
end

function HUD:iconBridge(parent)
	local holder = Theme.new("Frame", {
		Parent = parent,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	Theme.circle(holder, 8, Theme.White, {
		Position = UDim2.fromScale(0.28, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	Theme.circle(holder, 8, Theme.White, {
		Position = UDim2.fromScale(0.72, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	Theme.new("Frame", {
		Parent = holder,
		Position = UDim2.fromScale(0.5, 0.56),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(26, 3),
		BackgroundColor3 = Theme.White,
		BorderSizePixel = 0,
	})
	return holder
end

function HUD:build()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "MM_HUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 30
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false
	gui.Parent = playerGui
	self.gui = gui

	-- Barre de progression de semaine, très discrète (masquée par défaut).
	local weekBg = Theme.new("Frame", {
		Parent = gui,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		ZIndex = 41,
		Visible = false,
	})
	self.weekFill = Theme.new("Frame", {
		Parent = weekBg,
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Teal,
		BorderSizePixel = 0,
		ZIndex = 42,
	})

	-- Flèche retour, en haut à gauche.
	self.backButton = Theme.new("TextButton", {
		Parent = gui,
		Position = UDim2.fromScale(0.018, 0.020),
		Size = UDim2.fromOffset(52, 52),
		BackgroundTransparency = 1,
		Text = "←",
		Font = Theme.FontBlack,
		TextSize = 34,
		TextColor3 = Theme.Ink,
		Active = true,
		Selectable = true,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		ZIndex = 48,
	})
	self.backButton.MouseEnter:Connect(function()
		self.backButton.TextColor3 = Theme.TealDark
	end)
	self.backButton.MouseLeave:Connect(function()
		self.backButton.TextColor3 = Theme.Ink
	end)
	self.backButton.Activated:Connect(function()
		if self.callbacks.onMenu then
			self.callbacks.onMenu()
		end
	end)

	-- Jauge de trafic : discrète, visible seulement quand le trafic se dégrade.
	local circulation = Theme.new("Frame", {
		Parent = gui,
		Position = UDim2.fromScale(0.022, 0.082),
		Size = UDim2.fromOffset(176, 38),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 42,
	})
	self.circulation = circulation
	Theme.label(circulation, "TRAFIC", {
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(90, 14),
		TextSize = 9,
		Font = Theme.FontBold,
		TextColor3 = Theme.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 43,
	})
	self.satisfactionText = Theme.label(circulation, "100%", {
		Position = UDim2.fromOffset(100, 0),
		Size = UDim2.fromOffset(76, 14),
		TextSize = 9,
		Font = Theme.FontBold,
		TextColor3 = Theme.TealDark,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 43,
	})
	local barBg = Theme.new("Frame", {
		Parent = circulation,
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.fromOffset(176, 8),
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		ZIndex = 43,
	})
	Theme.corner(barBg, 4)
	self.satisfactionFill = Theme.new("Frame", {
		Parent = barBg,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Teal,
		BorderSizePixel = 0,
		ZIndex = 44,
	})
	Theme.corner(self.satisfactionFill, 4)

	-- Score, jour et horloge, en haut à droite.
	local scorePanel = Theme.new("Frame", {
		Parent = gui,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.975, 0.020),
		Size = UDim2.fromOffset(286, 62),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 42,
	})
	self.scorePanel = scorePanel
	self.scoreValue = Theme.label(scorePanel, "0", {
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(126, 56),
		TextSize = 42,
		Font = Theme.FontBlack,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 43,
	})
	Theme.textScaled(self.scoreValue, 42, 18)

	local pin = Theme.circle(scorePanel, 20, Theme.PanelDark, {
		Position = UDim2.fromOffset(136, 14),
		ZIndex = 43,
	})
	Theme.circle(pin, 7, Theme.White, {
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 44,
	})

	self.dayLabel = Theme.label(scorePanel, "LUN", {
		Position = UDim2.fromOffset(164, 12),
		Size = UDim2.fromOffset(54, 24),
		TextSize = 15,
		Font = Theme.FontBold,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 43,
	})
	Theme.textScaled(self.dayLabel, 15, 9)

	local clock = Theme.circle(scorePanel, 42, Theme.PanelDark, {
		Position = UDim2.fromOffset(224, 2),
		ZIndex = 43,
	})
	self.clock = clock

	-- Les aiguilles tournent autour d'un pivot placé au centre de l'horloge :
	-- Rotation pivote toujours autour du centre d'un GuiObject, pas de son
	-- AnchorPoint. Un pivot vide au centre évite donc une horloge bancale.
	local function makeClockHand(length, thickness)
		local pivot = Theme.new("Frame", {
			Parent = clock,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 44,
		})
		local hand = Theme.new("Frame", {
			Parent = pivot,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(thickness, length),
			BackgroundColor3 = Theme.White,
			BorderSizePixel = 0,
			ZIndex = 44,
		})
		return pivot, hand
	end

	self.clockHourPivot, self.clockHour = makeClockHand(10, 2)
	self.clockMinutePivot, self.clockMinute = makeClockHand(14, 2)
	Theme.circle(clock, 5, Theme.White, {
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 45,
	})

	-- L'horloge ouvre les contrôles de temps ; ils restent cachés autrement.
	self.clockButton = Theme.new("TextButton", {
		Parent = scorePanel,
		Position = UDim2.fromOffset(224, 2),
		Size = UDim2.fromOffset(42, 42),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		Active = true,
		Selectable = true,
		AutoButtonColor = false,
		ZIndex = 46,
	})
	self.clockButton.Activated:Connect(function()
		self.controls.Visible = not self.controls.Visible
	end)
	self.clockButton.MouseEnter:Connect(function()
		clock.BackgroundColor3 = Theme.TealDark
	end)
	self.clockButton.MouseLeave:Connect(function()
		clock.BackgroundColor3 = Theme.PanelDark
	end)

	self.weekLabel = Theme.label(scorePanel, "SEMAINE 1", {
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.fromOffset(274, 18),
		TextSize = 10,
		Font = Theme.FontBold,
		TextColor3 = Theme.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = false,
		ZIndex = 43,
	})

	-- Pause / lecture / avance rapide, sous l'horloge.
	local controls = Theme.new("Frame", {
		Parent = gui,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.982, 0.105),
		Size = UDim2.fromOffset(46, 160),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 42,
	})
	self.controls = controls
	controls.Visible = false
	local controlLayout = Instance.new("UIListLayout")
	controlLayout.FillDirection = Enum.FillDirection.Vertical
	controlLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	controlLayout.Padding = UDim.new(0, 6)
	controlLayout.SortOrder = Enum.SortOrder.LayoutOrder
	controlLayout.Parent = controls

	local function makeControl(text, order, onClick)
		local button = Theme.new("TextButton", {
			Parent = controls,
			Size = UDim2.fromOffset(38, 38),
			LayoutOrder = order,
			BackgroundTransparency = 1,
			Text = text,
			Font = Theme.FontBlack,
			TextSize = 18,
			TextColor3 = Theme.Ink,
			Active = true,
			Selectable = true,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			ZIndex = 43,
		})
		button.MouseEnter:Connect(function()
			button.TextColor3 = Theme.TealDark
		end)
		button.MouseLeave:Connect(function()
			if button == self.speedButton and self.speed > 1 then
				button.TextColor3 = Theme.TealDark
			else
				button.TextColor3 = Theme.Ink
			end
		end)
		button.Activated:Connect(onClick)
		return button
	end

	self.pauseButton = makeControl("II", 1, function()
		if self.callbacks.onPause then
			self.callbacks.onPause()
		end
	end)
	self.playButton = makeControl("▶", 2, function()
		if self.callbacks.onResume then
			self.callbacks.onResume()
		end
	end)
	self.speedButton = makeControl("▶▶", 3, function()
		local nextSpeed = 1
		if self.speed == 1 then
			nextSpeed = 2
		elseif self.speed == 2 then
			nextSpeed = 3
		end
		self:setSpeed(nextSpeed)
		if self.callbacks.onSpeed then
			self.callbacks.onSpeed(nextSpeed)
		end
	end)
	self.speedLabel = Theme.label(controls, "x1", {
		LayoutOrder = 4,
		Size = UDim2.fromOffset(40, 14),
		TextSize = 10,
		Font = Theme.FontBold,
		TextColor3 = Theme.InkSoft,
		ZIndex = 43,
