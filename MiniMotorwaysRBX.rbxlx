end

function Lobby:buildGarage()
	local overlay, card = self:makeModal("Garage", 520, 430)
	self.garageOverlay = overlay

	Theme.label(card, "Votre collection de voitures", {
		Position = UDim2.fromOffset(30, 82),
		Size = UDim2.fromOffset(460, 26),
		TextSize = 16,
		Font = Theme.FontBold,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 52,
	})

	local colors = Config.HouseColors
	for index = 1, #colors do
		local col = (index - 1) % 4
		local row = math.floor((index - 1) / 4)
		local x = 38 + col * 115
		local y = 128 + row * 96
		local slot = Theme.new("Frame", {
			Parent = card,
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(96, 76),
			BackgroundColor3 = Theme.PanelSoft,
			BorderSizePixel = 0,
			ZIndex = 52,
		})
		Theme.corner(slot, 8)
		local body = Theme.new("Frame", {
			Parent = slot,
			Position = UDim2.fromScale(0.5, 0.42),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(42, 24),
			BackgroundColor3 = colors[index].color,
			BorderSizePixel = 0,
			ZIndex = 53,
		})
		Theme.corner(body, 5)
		Theme.new("Frame", {
			Parent = body,
			Position = UDim2.fromScale(0.5, 0.36),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromScale(0.62, 0.42),
			BackgroundColor3 = Theme.White,
			BorderSizePixel = 0,
			ZIndex = 54,
		})
		Theme.label(slot, colors[index].name, {
			Position = UDim2.fromScale(0, 0.78),
			Size = UDim2.fromScale(1, 0.18),
			TextSize = 10,
			Font = Theme.FontBold,
			TextColor3 = Theme.InkSoft,
			ZIndex = 53,
		})
	end

	Theme.button(card, "Fermer", {
		Position = UDim2.fromOffset(30, 360),
		Size = UDim2.fromOffset(460, 48),
		BackgroundColor3 = Theme.Teal,
		TextColor3 = Theme.White,
		TextSize = 18,
		CornerRadius = 4,
		ZIndex = 52,
	}, function()
		overlay.Visible = false
	end)
end

function Lobby:buildStats()
	local overlay, card = self:makeModal("Statistiques", 500, 430)
	self.statsOverlay = overlay

	local stats = {
		{ label = "Meilleur score total", value = "0" },
		{ label = "Villes jouées", value = "0" },
		{ label = "Meilleure ville", value = "—" },
		{ label = "Moyenne des records", value = "—" },
	}
	self.statsLabels = {}
	for index, stat in ipairs(stats) do
		local y = 88 + (index - 1) * 64
		Theme.label(card, stat.label, {
			Position = UDim2.fromOffset(30, y),
			Size = UDim2.fromOffset(250, 26),
			TextSize = 15,
			TextColor3 = Theme.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 52,
		})
		self.statsLabels[index] = Theme.label(card, stat.value, {
			Position = UDim2.fromOffset(280, y - 4),
			Size = UDim2.fromOffset(190, 34),
			TextSize = 22,
			Font = Theme.FontBlack,
			TextColor3 = Theme.Ink,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 52,
		})
		Theme.new("Frame", {
			Parent = card,
			Position = UDim2.fromOffset(30, y + 38),
			Size = UDim2.fromOffset(440, 1),
			BackgroundColor3 = Theme.Border,
			BorderSizePixel = 0,
			ZIndex = 52,
		})
	end

	Theme.button(card, "Fermer", {
		Position = UDim2.fromOffset(30, 360),
		Size = UDim2.fromOffset(440, 48),
		BackgroundColor3 = Theme.Teal,
		TextColor3 = Theme.White,
		TextSize = 18,
		CornerRadius = 4,
		ZIndex = 52,
	}, function()
		overlay.Visible = false
	end)
end

function Lobby:buildAbout()
	local overlay, card = self:makeModal("À propos", 520, 380)
	self.aboutOverlay = overlay

	Theme.label(
		card,
		Config.GameName .. " — prototype Roblox\n\n"
			.. "Inspiré du jeu de gestion de trafic Mini Motorways.\n"
			.. "Tous les visuels (villes, routes, voitures, interface)\n"
			.. "sont générés en code dans Roblox Studio : aucune image importée.\n\n"
			.. "Tracez des routes entre les maisons et les bâtiments de la même couleur.\n"
			.. "Livrez le plus de trajets possible, semaine après semaine, sans\n"
			.. "laisser le trafic s'effondrer.",
		{
			Position = UDim2.fromOffset(30, 82),
			Size = UDim2.fromOffset(460, 210),
			TextSize = 15,
			TextColor3 = Theme.InkSoft,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 52,
		}
	)

	Theme.button(card, "Fermer", {
		Position = UDim2.fromOffset(30, 310),
		Size = UDim2.fromOffset(460, 48),
		BackgroundColor3 = Theme.Teal,
		TextColor3 = Theme.White,
		TextSize = 18,
		CornerRadius = 4,
		ZIndex = 52,
	}, function()
		overlay.Visible = false
	end)
end

function Lobby:buildToast()
	self.toastLabel = Theme.label(self.gui, "", {
		Position = UDim2.fromScale(0.5, 0.025),
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0.8, 0, 0, 38),
		BackgroundColor3 = Theme.PanelDark,
		BackgroundTransparency = 0.08,
		TextSize = 14,
		TextColor3 = Theme.White,
		Visible = false,
		ZIndex = 60,
	})
	Theme.corner(self.toastLabel, 19)
	Theme.textScaled(self.toastLabel, 14, 8)
	Theme.maxSize(self.toastLabel, 420, 38)
end

function Lobby:makeModal(titleText, width, height)
	local overlay = Theme.new("Frame", {
		Parent = self.gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 0.22,
		BorderSizePixel = 0,
		Visible = false,
		Active = true,
		ZIndex = 50,
	})

	local card = Theme.new("Frame", {
		Parent = overlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		ZIndex = 51,
	})
	Theme.corner(card, 10)
	Theme.stroke(card, Theme.Border, 2, 0.1)

	local scale = Instance.new("UIScale")
	scale.Parent = card
	table.insert(self.modalScales, { scale = scale, width = width, height = height })

	local title = Theme.label(card, titleText, {
		Position = UDim2.fromOffset(30, 22),
		Size = UDim2.new(1, -60, 0, 42),
		Font = Theme.FontBlack,
		TextSize = 30,
		TextColor3 = Theme.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 52,
	})
	Theme.textScaled(title, 30, 14)

	return overlay, card
end

function Lobby:refreshLobbyGrid(width, height)
	local grid = self.lobbyGrid
	if not grid then
		return
	end
	local key = tostring(math.floor(width)) .. ":" .. tostring(math.floor(height))
	if self.lobbyGridKey == key then
		return
	end
	self.lobbyGridKey = key
	grid:ClearAllChildren()

	-- Cases carrées : la grille reste identique à la capture, même quand
	-- la fenêtre change de proportions.
	local step = math.max(90, width / 10)
	for x = step, width, step do
		Theme.new("Frame", {
			Parent = grid,
			Position = UDim2.fromOffset(math.floor(x), 0),
			Size = UDim2.new(0, 1, 1, 0),
			BackgroundColor3 = Theme.LobbyGrid,
			BackgroundTransparency = 0.58,
			BorderSizePixel = 0,
			ZIndex = 0,
		})
	end
	for y = step, height, step do
		Theme.new("Frame", {
			Parent = grid,
			Position = UDim2.fromOffset(0, math.floor(y)),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = Theme.LobbyGrid,
			BackgroundTransparency = 0.58,
			BorderSizePixel = 0,
			ZIndex = 0,
		})
	end
end

function Lobby:updateResponsive()
	local viewport = self.gui.AbsoluteSize
	local width = viewport.X
	local height = viewport.Y
	if width < 2 or height < 2 then
		return
	end

	local portrait = width < 760 or width < height * 0.9
	local short = height < 700

	self:refreshLobbyGrid(width, height)

	if self.decoration then
		self.decoration.Visible = not portrait
		if not portrait then
			self:updateDecorationLayout()
		end
	end
	if self.rail then
		self.rail.Visible = not portrait
	end
	if self.titleHolder then
		self.titleHolder.Position = UDim2.fromScale(
			portrait and 0.08 or 0.21,
			portrait and 0.115 or 0.165
		)
	end
	if self.titleScale then
		local base = portrait and width / 720 or width / 1600
		self.titleScale.Scale = math.clamp(base, 0.42, 1)
	end

	if self.menuButtons then
		self.menuButtons.Position = UDim2.fromScale(
			portrait and 0.08 or 0.21,
			portrait and 0.36 or 0.43
		)
		self.menuButtons.Size = UDim2.fromScale(
			portrait and 0.84 or 0.19,
			portrait and (short and 0.34 or 0.32) or 0.30
		)
	end

	if self.decorDestination then
		local size = math.clamp(height * 0.16, 100, 190)
		self.decorDestination.Size = UDim2.fromOffset(size, size)
	end
	if self.decorHouse then
		local size = math.clamp(height * 0.095, 66, 112)
		self.decorHouse.Size = UDim2.fromOffset(size, size)
	end

	if self.infoButton then
		local size = portrait and 60 or math.clamp(height * 0.068, 52, 74)
		local x = portrait and 0.94 or 0.955
		local y = portrait and 0.94 or 0.925
		self.infoButton.Size = UDim2.fromOffset(size, size)
		self.infoButton.Position = UDim2.fromScale(x, y)
		if self.infoDot then
			self.infoDot.Position = UDim2.fromOffset(
				x * width - size - 8,
				y * height - size - 6
			)
		end
	end

	if self.mapTitle then
		self.mapTitle.Position = UDim2.fromScale(
			0.5,
			portrait and 0.090 or 0.040
		)
		self.mapTitle.Size = UDim2.fromScale(portrait and 0.72 or 0.5, 0.06)
	end
	if self.mapSubtitle then
		self.mapSubtitle.Position = UDim2.fromScale(0.5, portrait and 0.150 or 0.103)
		self.mapSubtitle.Size = UDim2.fromScale(portrait and 0.8 or 0.62, 0.028)
	end

	if self.backButton then
		self.backButton.Position = UDim2.fromScale(0.03, portrait and 0.028 or 0.048)
		self.backButton.Size = UDim2.fromOffset(
			portrait and math.min(96, width * 0.28) or 118,
			portrait and 34 or 42
		)
	end

	if self.scroller then
		self.scroller.Position = UDim2.fromScale(portrait and 0.06 or 0.09, portrait and 0.190 or 0.145)
		self.scroller.Size = UDim2.fromScale(
			portrait and 0.90 or 0.86,
			portrait and (short and 0.56 or 0.60) or 0.665
		)
	end

	if self.playButton then
		self.playButton.Position = UDim2.fromScale(
			0.5,
			short and 0.79 or (portrait and 0.83 or 0.855)
		)
	end

	if self.mapHint then
		self.mapHint.Visible = not short
	end

	for _, entry in ipairs(self.modalScales) do
		local fit = math.min(1, (width * 0.92) / entry.width, (height * 0.9) / entry.height)
		entry.scale.Scale = math.max(0.35, fit)
	end
end

function Lobby:select(mapId)
	if not mapId or not self.cards[mapId] then
		return
	end
	self.selectedId = mapId

	for id, card in pairs(self.cards) do
		local selected = id == mapId
		card.stroke.Transparency = selected and 0 or 1
		card.shadow.BackgroundColor3 = Theme.CardShadow
		card.shadow.BackgroundTransparency = selected and 0.02 or 0.08
		if card.selectedBadge then
			card.selectedBadge.Visible = selected
		end
	end

	local map = Maps.getById(mapId)
	if map and self.playButton then
		self.playButton.Text = "Jouer  ·  " .. map.name
	end
end

function Lobby:startSelected()
	if self.callbacks.onStartMap then
		self.callbacks.onStartMap(self.selectedId)
	end
end

function Lobby:show()
	self.gui.Enabled = true
	self.mainPage.Visible = true
	self.mapPage.Visible = false
	self.optionsOverlay.Visible = false
	self.recordsOverlay.Visible = false
	self.garageOverlay.Visible = false
	self.statsOverlay.Visible = false
	self.aboutOverlay.Visible = false
	self:updateResponsive()
end

function Lobby:hide()
	self.gui.Enabled = false
end

function Lobby:showMaps()
	self.mainPage.Visible = false
	self.mapPage.Visible = true
	self:select(self.selectedId)
	self:updateResponsive()
end

function Lobby:showMain()
	self.mapPage.Visible = false
	self.mainPage.Visible = true
end

function Lobby:showRecords()
	self.recordsOverlay.Visible = true
end

function Lobby:showGarage()
	if self.garageOverlay then
		self.garageOverlay.Visible = true
	end
end

function Lobby:showStats()
	if self.statsOverlay then
		self.statsOverlay.Visible = true
	end
end

function Lobby:setProfile(profile)
	self.profile = profile or {}
	local total = 0
	local played = 0
	local bestMap = nil
	local bestScore = 0
	for id, card in pairs(self.cards) do
		local best = tonumber(self.profile[id]) or 0
		total += best
		if best > 0 then
			played += 1
		end
		if best > bestScore then
			bestScore = best
			bestMap = card.map
		end
		card.bestLabel.Text = "Meilleur : " .. (best > 0 and tostring(best) or "—")
	end
	for id, label in pairs(self.recordLabels) do
		local best = tonumber(self.profile[id]) or 0
		label.Text = best > 0 and tostring(best) or "—"
	end
	if self.statsLabels then
		self.statsLabels[1].Text = tostring(total)
		self.statsLabels[2].Text = tostring(played)
		self.statsLabels[3].Text = bestMap and bestMap.name or "—"
		self.statsLabels[4].Text = played > 0
				and string.format("%.1f", total / played)
			or "—"
	end
end

function Lobby:toast(text)
	if not self.toastLabel then
		return
	end
	self.toastToken += 1
	local token = self.toastToken
	self.toastLabel.Text = text
	self.toastLabel.Visible = true
	task.delay(2.4, function()
		if self.toastToken == token then
			self.toastLabel.Visible = false
		end
	end)
end

return Lobby
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">MapPreview</string>
              <ProtectedString name="Source"><![CDATA[--[[
	MapPreview.luau
	Dessine l'aperçu circulaire d'une carte dans le menu :
	une géographie d'eau lissée + quelques routes + des points colorés.
	Aucune image nécessaire.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Theme = require(script.Parent.Theme)

local MapPreview = {}

-- Dessine une forme d'eau sans passer par une grille de gros pixels.
-- Les formes sont volontairement simples : rectangles arrondis, disques,
-- ellipses et barres. Elles se superposent pour donner une côte ou une
-- rivière continue, puis le cercle de l'aperçu les découpe.
local function drawWaterShape(circle, shape, diameter, color, padding, zIndex)
	padding = padding or 0
	zIndex = zIndex or 1
	local kind = shape.type

	if kind == "rect" then
		local frame = Theme.new("Frame", {
			Parent = circle,
			Position = UDim2.fromOffset(
				shape.x * diameter - padding,
				shape.y * diameter - padding
			),
			Size = UDim2.fromOffset(
				shape.w * diameter + padding * 2,
				shape.h * diameter + padding * 2
			),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = zIndex,
		})
		Theme.corner(frame, (shape.radius or 0) * diameter + padding)
		return
	end

	if kind == "circle" or kind == "ellipse" then
		local baseRx = shape.rx or shape.r or 0.05
		local baseRy = shape.ry or shape.r or baseRx
		local rx = baseRx * diameter + padding
		local ry = baseRy * diameter + padding

		-- Un Frame avec UICorner donne une capsule, pas une vraie ellipse.
		-- On approche donc l'ellipse par une chaîne de cercles dont le rayon
		-- suit la largeur de l'ellipse le long de son grand axe.
		if math.abs(rx - ry) <= math.max(0.35, math.min(rx, ry) * 0.04) then
			local blob = Theme.new("Frame", {
				Parent = circle,
				Position = UDim2.fromScale(shape.x, shape.y),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(rx * 2, ry * 2),
				Rotation = shape.rotation or 0,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = zIndex,
			})
			Theme.corner(blob, math.min(rx, ry))
			return
		end

		local baseMajor = math.max(baseRx, baseRy) * diameter
		local baseMinor = math.min(baseRx, baseRy) * diameter
		local angle = math.rad(shape.rotation or 0)
		if baseRy > baseRx then
			angle += math.pi / 2
		end
		local axisX = math.cos(angle)
		local axisY = math.sin(angle)
		local count = math.clamp(math.ceil(baseMajor / 1.6), 5, 32)
		local centerX = shape.x * diameter
		local centerY = shape.y * diameter

		for i = 0, count - 1 do
			local theta = -math.pi / 2 + math.pi * (i / (count - 1))
			local offset = baseMajor * math.sin(theta)
			local radius = baseMinor * math.cos(theta)
			if radius < 0.35 then
				radius = 0.35
			end
			local size = (radius + padding) * 2
			local dot = Theme.new("Frame", {
				Parent = circle,
				Position = UDim2.fromOffset(
					centerX + offset * axisX - size * 0.5,
					centerY + offset * axisY - size * 0.5
				),
				Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = zIndex,
			})
			Theme.corner(dot, size * 0.5)
		end
		return
	end

	if kind == "bar" then
		local dx = (shape.x2 - shape.x1) * diameter
		local dy = (shape.y2 - shape.y1) * diameter
		local length = math.sqrt(dx * dx + dy * dy)
		local angle = math.deg(math.atan2(dy, dx))
		local thickness = (shape.thickness or 0.04) * diameter + padding * 2
		local centerX = (shape.x1 + shape.x2) * 0.5 * diameter
		local centerY = (shape.y1 + shape.y2) * 0.5 * diameter

		if shape.flatStart then
			-- Coupure nette côté terre : un rectangle jusqu'au bout, puis
			-- un seul capuchon rond côté eau. Même principe que la 3D.
			Theme.new("Frame", {
				Parent = circle,
				Position = UDim2.fromOffset(centerX, centerY),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(length, thickness),
				Rotation = angle,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = zIndex,
			})
			local cap = Theme.new("Frame", {
				Parent = circle,
				Position = UDim2.fromOffset(shape.x2 * diameter, shape.y2 * diameter),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(thickness, thickness),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = zIndex,
			})
			Theme.corner(cap, thickness / 2)
			return
		end

		local bar = Theme.new("Frame", {
			Parent = circle,
			Position = UDim2.fromOffset(centerX, centerY),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(length + thickness * 0.5, thickness),
			Rotation = angle,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = zIndex,
		})
		Theme.corner(bar, thickness / 2)
	end
end

function MapPreview.create(parent, map, diameter, position, anchorPoint)
	-- Le cercle est posé sur un anneau beige, avec un liseré menthe foncé :
	-- on retrouve le cadre de la référence, sans image.
	local wrapper = Theme.new("Frame", {
		Name = "PreviewFrame_" .. map.id,
		Parent = parent,
		Position = position or UDim2.fromScale(0.5, 0),
		AnchorPoint = anchorPoint or Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(diameter + 8, diameter + 8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 1,
	})
	Theme.circle(wrapper, diameter + 8, Config.Colors.RingShadow or Color3.fromHex("D3CDB8"), {
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 1,
	})

	-- CanvasGroup, et non Frame : contrairement à ClipsDescendants seul, il
	-- découpe réellement les enfants selon les coins arrondis. L'eau ne peut
	-- donc plus déborder dans les angles du cercle.
	local circle = Theme.new("CanvasGroup", {
		Name = "Preview_" .. map.id,
		Parent = wrapper,
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundColor3 = map.land,
		BorderSizePixel = 0,
		ZIndex = 2,
	})
	Theme.corner(circle, diameter / 2)
	Theme.stroke(circle, Config.Colors.Ring or Color3.fromHex("88B5A7"), math.max(4, diameter * 0.03), 0)

	-- Zones vertes douces, comme les parcs de la vidéo.
	for _, shape in ipairs(map.grassShapes or {}) do
		drawWaterShape(circle, shape, diameter, map.grass or Config.Colors.Grass, 0, 1)
	end

	-- Eau lissée : chaque carte fournit ses formes dans Maps.luau.
	-- Ombre extérieure, liseré de côte blanc, puis remplissage menthe.
	local waterShapes = map.waterShapes
	local outline = math.max(1.8, diameter * 0.015)
	local coastColor = Config.Colors.Coast or Color3.fromHex("FFFFF7")
	if waterShapes and #waterShapes > 0 then
		local shadowColor = map.waterDeep or Config.Colors.WaterDeep
		for _, shape in ipairs(waterShapes) do
			drawWaterShape(circle, shape, diameter, shadowColor, outline * 1.8, 1)
		end
		for _, shape in ipairs(waterShapes) do
			drawWaterShape(circle, shape, diameter, coastColor, outline * 0.95, 2)
		end
		for _, shape in ipairs(waterShapes) do
			drawWaterShape(circle, shape, diameter, map.water, 0, 3)
		end
	else
		-- Filet de sécurité si une carte n'a pas encore de waterShapes.
		local cells = 24
		local cell = diameter / cells
		for gx = 0, cells - 1 do
			for gy = 0, cells - 1 do
				local nx = (gx + 0.5) / cells
				local ny = (gy + 0.5) / cells
				if map.isWater(nx, ny) then
					Theme.new("Frame", {
						Parent = circle,
						Position = UDim2.fromOffset(gx * cell, gy * cell),
						Size = UDim2.fromOffset(cell + 0.5, cell + 0.5),
						BackgroundColor3 = map.water,
						BorderSizePixel = 0,
						ZIndex = 1,
					})
				end
			end
		end
	end

	-- Presqu'îles sèches dessinées par-dessus l'eau : liseré de côte blanc,
	-- puis terre crème. Le petit raccord terre masque le liseré côté continent.
	for _, shape in ipairs(map.dryShapes or {}) do
		drawWaterShape(circle, shape, diameter, coastColor, outline * 0.95, 4)
	end
	for _, shape in ipairs(map.dryShapes or {}) do
		drawWaterShape(circle, shape, diameter, map.land, 0, 5)
	end
	for _, shape in ipairs(map.dryPatches or {}) do
		drawWaterShape(circle, shape, diameter, map.land, 0, 6)
	end

	-- Petit réseau routier et pastilles de bâtiments : l'aperçu ressemble
	-- davantage à une carte jouable, sans surcharger le cercle.
	local roads = map.previewRoads or {}
	local roadWidth = math.max(5, diameter * 0.030)
	local roadColor = Config.Colors.LobbyRoad or Config.Colors.White
	local roadShadow = Config.Colors.LobbyRoadShadow or Config.Colors.CardShadow

	local function drawPreviewRoad(road, color, width, offsetX, offsetY, zIndex)
		local ax = road[1] * diameter + offsetX
		local ay = road[2] * diameter + offsetY
		local bx = road[3] * diameter + offsetX
		local by = road[4] * diameter + offsetY
		local dx = bx - ax
		local dy = by - ay
		local length = math.sqrt(dx * dx + dy * dy)
		if length <= 0 then
			return
		end
		local bar = Theme.new("Frame", {
			Parent = circle,
			Position = UDim2.fromOffset((ax + bx) * 0.5, (ay + by) * 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(length + width * 0.5, width),
			Rotation = math.deg(math.atan2(dy, dx)),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = zIndex,
		})
		Theme.corner(bar, width / 2)
	end

	for _, road in ipairs(roads) do
		drawPreviewRoad(road, roadShadow, roadWidth + 3, 1.5, 2, 6)
	end
	for _, road in ipairs(roads) do
		drawPreviewRoad(road, roadColor, roadWidth, 0, 0, 7)
	end

	local endpoints = {}
	local seen = {}
	local buildingSize = math.max(14, diameter * 0.075)
	for index, road in ipairs(roads) do
		for pointIndex = 1, 2 do
			local nx = road[pointIndex == 1 and 1 or 3]
			local ny = road[pointIndex == 1 and 2 or 4]
			local key = string.format("%.3f:%.3f", nx, ny)
			if not seen[key]
				and nx > 0.02
				and nx < 0.98
				and ny > 0.02
				and ny < 0.98
				and not (map.isWater and map.isWater(nx, ny))
			then
				seen[key] = true
				table.insert(endpoints, { x = nx, y = ny, index = index + pointIndex })
			end
		end
	end

	for _, endpoint in ipairs(endpoints) do
		local x = endpoint.x * diameter
		local y = endpoint.y * diameter
		local palette = Config.HouseColors[(endpoint.index - 1) % #Config.HouseColors + 1]
		local shadow = Theme.new("Frame", {
			Parent = circle,
			Position = UDim2.fromOffset(x - buildingSize * 0.5 + 1.5, y - buildingSize * 0.5 + 2),
			Size = UDim2.fromOffset(buildingSize, buildingSize),
			BackgroundColor3 = roadShadow,
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			ZIndex = 8,
		})
		Theme.corner(shadow, 4)
		local building = Theme.new("Frame", {
			Parent = circle,
			Position = UDim2.fromOffset(x - buildingSize * 0.5, y - buildingSize * 0.5),
			Size = UDim2.fromOffset(buildingSize, buildingSize),
			BackgroundColor3 = palette.color,
			BorderSizePixel = 0,
			ZIndex = 9,
		})
		Theme.corner(building, 4)
		Theme.stroke(building, roadColor, 1.5, 0)
	end

	return circle
end

return MapPreview
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">Theme</string>
              <ProtectedString name="Source"><![CDATA[--[[
	Theme.luau
	Petits constructeurs d'interface + palette commune.
	Tout est dessiné en code : aucun asset à importer.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local C = Config.Colors

local Theme = {}

Theme.Ink = C.Ink
Theme.InkSoft = C.InkSoft
Theme.Teal = C.Teal
Theme.TealDark = C.TealDark
Theme.Orange = C.Orange
Theme.White = C.White
Theme.Cream = C.Cream
Theme.Background = C.Background
Theme.GridLine = C.GridLine
Theme.LobbyBackground = C.LobbyBackground or C.Background
Theme.LobbyGrid = C.LobbyGrid or C.GridLine
Theme.LobbyButton = C.LobbyButton or C.Teal
Theme.LobbyButtonDark = C.LobbyButtonDark or C.TealDark
Theme.LobbyOrange = C.LobbyOrange or C.Orange
Theme.LobbyRoad = C.LobbyRoad or C.White
Theme.LobbyRoadShadow = C.LobbyRoadShadow or C.CardShadow
Theme.CardShadow = C.CardShadow
Theme.Danger = C.Danger
Theme.Panel = C.Panel
Theme.PanelSoft = C.PanelSoft
Theme.PanelDark = C.PanelDark
Theme.Border = C.Border
Theme.BorderStripe = C.BorderStripe
Theme.Paper = C.Paper
Theme.Water = C.Water
Theme.Grass = C.Grass
Theme.Land = C.Land
Theme.Road = C.Road

Theme.Font = Enum.Font.Gotham
Theme.FontBold = Enum.Font.GothamBold
Theme.FontBlack = Enum.Font.GothamBlack

function Theme.new(className, props)
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				instance[key] = value
			end
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Theme.corner(instance, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = instance
	return corner
end

function Theme.stroke(instance, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Theme.Ink
	stroke.Thickness = thickness or 2
	stroke.Transparency = transparency or 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = instance
	return stroke
end

function Theme.padding(instance, top, right, bottom, left)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, top)
	padding.PaddingRight = UDim.new(0, right)
	padding.PaddingBottom = UDim.new(0, bottom)
	padding.PaddingLeft = UDim.new(0, left)
	padding.Parent = instance
	return padding
end

function Theme.textScaled(instance, maxTextSize, minTextSize)
	instance.TextScaled = true
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = maxTextSize
	limit.MinTextSize = minTextSize or 8
	limit.Parent = instance
	return limit
end

function Theme.maxSize(instance, maxX, maxY)
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(maxX, maxY)
	limit.Parent = instance
	return limit
end

function Theme.label(parent, text, props)
	local p = props or {}
	p.Parent = parent
	p.Text = text
	p.BackgroundTransparency = p.BackgroundTransparency or 1
	p.BorderSizePixel = 0
	p.Font = p.Font or Theme.Font
	p.TextColor3 = p.TextColor3 or Theme.Ink
	p.TextSize = p.TextSize or 16
	return Theme.new("TextLabel", p)
end

function Theme.button(parent, text, props, onClick)
	local p = props or {}
	local cornerRadius = p.CornerRadius
	p.CornerRadius = nil
	p.Parent = parent
	p.Text = text
	p.Active = true
	p.Selectable = true
	p.AutoButtonColor = false
	p.BorderSizePixel = 0
	p.Font = p.Font or Theme.FontBold
	p.TextColor3 = p.TextColor3 or Theme.White
	p.TextSize = p.TextSize or 24
	p.BackgroundColor3 = p.BackgroundColor3 or Theme.Teal

	local maxTextSize = p.TextSize or 24
	local button = Theme.new("TextButton", p)
	Theme.corner(button, cornerRadius or 4)

	button.TextScaled = true
	local textLimit = Instance.new("UITextSizeConstraint")
	textLimit.MaxTextSize = maxTextSize
	textLimit.MinTextSize = 9
	textLimit.Parent = button

	local baseColor = button.BackgroundColor3
	button:SetAttribute("BaseColor", baseColor)

	local function currentBaseColor()
		return button:GetAttribute("BaseColor") or baseColor
	end

	button.MouseEnter:Connect(function()
		if button.Active then
			TweenService:Create(button, TweenInfo.new(0.14), {
				BackgroundColor3 = currentBaseColor():Lerp(Color3.new(0, 0, 0), 0.09),
			}):Play()
		end
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.14), {
			BackgroundColor3 = currentBaseColor(),
		}):Play()
	end)
	-- Activated couvre souris / tactile / manette. MouseButton1Click sert de
	-- filet de sécurité sur certaines versions de Studio ; le debounce évite
	-- qu'un même clic déclenche deux fois l'action.
	local lastActivation = 0
	local function activate()
		local now = os.clock()
		if now - lastActivation < 0.12 then
			return
		end
		lastActivation = now
		if onClick then
			onClick()
		end
	end
	button.Activated:Connect(activate)
	button.MouseButton1Click:Connect(activate)

	return button
end

function Theme.circle(parent, diameter, color, props)
	local p = props or {}
	p.Parent = parent
	p.BackgroundColor3 = color
	p.Size = p.Size or UDim2.fromOffset(diameter, diameter)
	p.BorderSizePixel = 0
	local circle = Theme.new("Frame", p)
	Theme.corner(circle, diameter / 2)
	return circle
end

function Theme.grid(parent, step, color, transparency)
	local container = Theme.new("Frame", {
		Name = "GridPattern",
		Parent = parent,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	})
	for i = 1, math.floor(1 / step) - 1 do
		Theme.new("Frame", {
			Parent = container,
			Position = UDim2.fromScale(i * step, 0),
			Size = UDim2.new(0, 1, 1, 0),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency or 0.4,
			BorderSizePixel = 0,
		})
		Theme.new("Frame", {
			Parent = container,
			Position = UDim2.fromScale(0, i * step),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency or 0.4,
			BorderSizePixel = 0,
		})
	end
	return container
end

return Theme
]]></ProtectedString>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="27">
