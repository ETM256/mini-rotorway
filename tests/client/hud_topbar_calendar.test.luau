return function(T, H)
	local function newHud()
		H.asClient()
		return H.load("HUD").new({})
	end

	T.test("the day label shows the server day, the month and the week", function()
		local hud = newHud()
		hud:setState({ week = 3, day = 17, dayOfWeek = 3, monthName = "Mars", score = 0 })
		T.eq(hud.dayLabel.Text, "Jour 17")
		T.eq(hud.monthLabel.Text, "Mars")
		T.eq(hud.weekLabel.Text, "Sem. 3", "the week label is part of the top bar")
		hud:setState({ week = 4, day = 22, dayOfWeek = 1, monthName = "Avril", score = 0 })
		T.eq(hud.dayLabel.Text, "Jour 22")
		T.eq(hud.monthLabel.Text, "Avril")
		T.eq(hud.weekLabel.Text, "Sem. 4")
	end)

	T.test("the day falls back to the week when the day is missing", function()
		local hud = newHud()
		hud:setState({ week = 3, score = 0 })
		-- Semaine 3, jour 3 de la semaine : 2 x 7 + 3.
		T.eq(hud.dayLabel.Text, "Jour 17", "no day: derived from the week")
		hud:setState({ week = 3, dayOfWeek = 9, score = 0 })
		T.eq(hud.dayLabel.Text, "Jour 17", "dayOfWeek out of range: derived from the week")
		T.eq(hud.monthLabel.Text, "", "no month name: nothing shown")
	end)

	T.test("the month progress line and the clock follow the payload", function()
		local hud = newHud()
		hud:setState({ week = 1, dayOfWeek = 1, dayProgress = 0.5, monthProgress = 0.25, score = 0 })
		H.advance(0.5)
		T.near(hud.monthFill.Size.X.Scale, 0.25, 1e-6, "month progress")
		T.near(hud.clockMinutePivot.Rotation, 180, 1e-6, "minute hand follows the day progress")
		hud:setState({ week = 1, dayOfWeek = 1, dayProgress = 0.5, monthProgress = 2, score = 0 })
		H.advance(0.5)
		T.near(hud.monthFill.Size.X.Scale, 1, 1e-6, "progress is clamped to the line")
	end)

	T.test("the time controls highlight the speed and the pause state", function()
		local calls = {}
		H.asClient()
		local hud = H.load("HUD").new({
			onSpeed = function(value)
				table.insert(calls, value)
			end,
			onPause = function()
				table.insert(calls, "pause")
			end,
		})
		hud:setState({ speed = 2, paused = false, score = 0 })
		H.advance(0.5)
		local selected = hud.speedButtons[2]:FindFirstChild("SelectionRing")
		T.eq(selected.Transparency, 0, "x2 is selected")
		T.eq(hud.speedButtons[1]:FindFirstChild("SelectionRing").Transparency, 1, "x1 is not")
		H.click(hud.speedButtons[3])
		H.click(hud.pauseButton)
		T.deepEq(calls, { 3, "pause" })
		hud:setState({ speed = 3, paused = true, score = 0 })
		H.advance(0.5)
		T.eq(hud.pauseButton:FindFirstChild("SelectionRing").Transparency, 0, "the pause button shows the pause")
		hud:setState({ speed = 3, paused = true, awaitingChoice = true, score = 0 })
		H.advance(0.5)
		T.eq(hud.pauseButton:FindFirstChild("SelectionRing").Transparency, 1, "the week choice is not shown as a pause")
	end)
end
