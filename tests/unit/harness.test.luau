return function(T, H)
	-- Auto-tests du harnais : si le mock se trompe, tous les autres tests mentent.

	T.test("Enum is strict", function()
		T.eq(Enum.Material.SmoothPlastic.Name, "SmoothPlastic")
		T.eq(tostring(Enum.Material.Plastic), "Enum.Material.Plastic")
		T.throws(function() return Enum.Material.Nope end, "not a valid member of Enum.Material")
		T.throws(function() return Enum.ScrollDirection end, "not a valid member of Enum")
		T.ok(#Enum.UserInputType:GetEnumItems() > 5)
		T.eq(Enum.EasingStyle:FromName("Back"), Enum.EasingStyle.Back)
	end)

	T.test("value types are immutable and typed", function()
		local v = Vector3.new(1, 2, 3)
		T.throws(function() v.X = 5 end)
		T.eq(typeof(v), "Vector3")
		T.eq(typeof(Color3.new()), "Color3")
		T.eq(typeof(UDim2.new()), "UDim2")
		T.eq(typeof(CFrame.new()), "CFrame")
		T.eq(typeof(Enum.Material.Plastic), "EnumItem")
		T.eq(typeof(Instance.new("Part")), "Instance")
	end)

	T.test("Vector3 math", function()
		local a, b = Vector3.new(1, 0, 0), Vector3.new(0, 1, 0)
		T.eq(a:Cross(b), Vector3.new(0, 0, 1))
		T.near(a:Dot(b), 0)
		T.near(Vector3.new(3, 4, 0).Magnitude, 5)
		T.eq(Vector3.new(3, 4, 0).Unit, Vector3.new(0.6, 0.8, 0))
		T.eq(a * 2 + b, Vector3.new(2, 1, 0))
		T.eq(2 * a, Vector3.new(2, 0, 0))
		T.eq(a:Lerp(b, 0.5), Vector3.new(0.5, 0.5, 0))
		T.eq(-a, Vector3.new(-1, 0, 0))
	end)

	T.test("Color3 hex and HSV", function()
		T.eq(Color3.fromHex("FF0000"), Color3.new(1, 0, 0))
		T.eq(Color3.fromHex("#00ff00"), Color3.new(0, 1, 0))
		T.eq(Color3.fromHex("FF8800"):ToHex(), "FF8800")
		T.throws(function() Color3.fromHex("zzz") end)
		local h, s, v = Color3.new(1, 0, 0):ToHSV()
		T.near(h, 0)
		T.near(s, 1)
		T.near(v, 1)
	end)

	T.test("UDim2 constructors", function()
		local u = UDim2.new(0.5, 10, 1, -4)
		T.eq(u.X.Scale, 0.5)
		T.eq(u.X.Offset, 10)
		T.eq(u.Y.Offset, -4)
		T.eq(UDim2.fromScale(1, 2), UDim2.new(1, 0, 2, 0))
		T.eq(UDim2.fromOffset(3, 4), UDim2.new(0, 3, 0, 4))
		T.eq(UDim2.new(UDim.new(1, 2), UDim.new(3, 4)), UDim2.new(1, 2, 3, 4))
	end)

	T.test("CFrame composition, inverse and lookAt", function()
		local cf = CFrame.new(10, 0, 0) * CFrame.Angles(0, math.rad(90), 0)
		local p = cf * Vector3.new(0, 0, -1)
		T.near(p.X, 9, 1e-9)
		T.near(p.Z, 0, 1e-9)
		T.ok((cf:Inverse() * cf):FuzzyEq(CFrame.new()))
		local look = CFrame.lookAt(Vector3.new(0, 0, 0), Vector3.new(0, 0, -5))
		T.ok(look.LookVector:FuzzyEq(Vector3.new(0, 0, -1)))
		local down = CFrame.lookAt(Vector3.new(0, 10, 0), Vector3.new(0, 0, 0))
		T.ok(down.LookVector:FuzzyEq(Vector3.new(0, -1, 0)))
		T.eq(CFrame.new(1, 2, 3).Position, Vector3.new(1, 2, 3))
		local rx, ry, rz = CFrame.Angles(0.1, 0.2, 0.3):ToEulerAnglesXYZ()
		T.near(rx, 0.1, 1e-9)
		T.near(ry, 0.2, 1e-9)
		T.near(rz, 0.3, 1e-9)
	end)

	T.test("TweenInfo validates its enums", function()
		T.throws(function() TweenInfo.new(1, "Quad") end)
		local info = TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		T.eq(info.Time, 0.2)
	end)

	T.test("sequences validate keypoints", function()
		T.throws(function()
			ColorSequence.new({ ColorSequenceKeypoint.new(0.2, Color3.new()), ColorSequenceKeypoint.new(1, Color3.new()) })
		end, "time=0")
		T.ok(ColorSequence.new(Color3.new(1, 0, 0), Color3.new(0, 0, 1)))
		T.ok(NumberSequence.new(0.5))
	end)

	T.test("Instance: property validation", function()
		local p = Instance.new("Part")
		T.throws(function() p.Material = "Plastic" end, "Unable to assign property Material")
		T.throws(function() p.Size = 5 end, "Vector3 expected")
		T.throws(function() p.Transparency = "x" end, "number expected")
		T.throws(function() p.Anchored = 1 end, "boolean expected")
		T.throws(function() p.NoSuchProperty = 1 end, "not a valid member of Part")
		T.throws(function() return p.NoSuchProperty end, "not a valid member of Part")
		T.throws(function() p.ClassName = "x" end, "read only")
		p.Material = Enum.Material.SmoothPlastic
		T.eq(p.Material, Enum.Material.SmoothPlastic)
		T.throws(function() Instance.new("Nope") end, "Unable to create")
		T.throws(function() Instance.new("Workspace") end, "Unable to create")
	end)

	T.test("Instance: valid GUI members only", function()
		local f = Instance.new("Frame")
		f.Size = UDim2.fromScale(1, 1)
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		T.throws(function() f.Text = "x" end, "not a valid member of Frame")
		local l = Instance.new("TextLabel")
		l.Text = "hi"
		l.Font = Enum.Font.GothamBold
		T.throws(function() l.Font = "Gotham" end)
		T.throws(function() l.TextSize = "big" end)
		T.eq(l.TextSize, 14)
	end)

	T.test("Instance: tree, names and lookups", function()
		local root = Instance.new("Folder")
		root.Name = "Root"
		local a = Instance.new("Part", root)
		a.Name = "A"
		local b = Instance.new("Model")
		b.Name = "B"
		b.Parent = root
		local c = Instance.new("Part")
		c.Name = "C"
		c.Parent = b
		T.eq(root:FindFirstChild("A"), a)
		T.eq(root.B.C, c)
		T.eq(root:FindFirstChild("C"), nil)
		T.eq(root:FindFirstChild("C", true), c)
		T.eq(#root:GetChildren(), 2)
		T.eq(#root:GetDescendants(), 3)
		T.eq(c:GetFullName(), "Root.B.C")
		T.ok(c:IsDescendantOf(root))
		T.ok(root:IsAncestorOf(c))
		T.ok(c:IsA("BasePart"))
		T.ok(c:IsA("Instance"))
		T.falsy(c:IsA("Model"))
		T.eq(root:FindFirstChildOfClass("Model"), b)
		T.eq(root:FindFirstChildWhichIsA("BasePart"), a)
		T.eq(c:FindFirstAncestor("Root"), root)
		T.eq(c:FindFirstAncestorOfClass("Model"), b)
	end)

	T.test("Instance: parent cycles and destroyed parents", function()
		local a, b = Instance.new("Folder"), Instance.new("Folder")
		b.Parent = a
		T.throws(function() a.Parent = b end, "circular")
		local p = Instance.new("Part")
		p:Destroy()
		T.throws(function() p.Parent = workspace end, "locked")
	end)

	T.test("Instance: Destroy fires events, clears children, disconnects", function()
		local folder = Instance.new("Folder")
		local child = Instance.new("Part", folder)
		local destroyed, removed = 0, 0
		child.Destroying:Connect(function()
			destroyed += 1
		end)
		folder.ChildRemoved:Connect(function()
			removed += 1
		end)
		local n = H.connectionCount()
		folder:Destroy()
		T.eq(destroyed, 1)
		T.eq(removed, 1)
		T.eq(#folder:GetChildren(), 0)
		T.lt(H.connectionCount(), n)
	end)

	T.test("Instance: ChildAdded / DescendantAdded / Changed / property signals", function()
		local folder = Instance.new("Folder")
		local added, descendants, changed, propChanged = {}, 0, {}, 0
		folder.ChildAdded:Connect(function(c)
			table.insert(added, c.Name)
		end)
		folder.DescendantAdded:Connect(function()
			descendants += 1
		end)
		local part = Instance.new("Part")
		part.Name = "P"
		part.Changed:Connect(function(prop)
			table.insert(changed, prop)
		end)
		part:GetPropertyChangedSignal("Transparency"):Connect(function()
			propChanged += 1
		end)
		part.Parent = folder
		Instance.new("Part", part)
		part.Transparency = 0.5
		part.Transparency = 0.5
		T.deepEq(added, { "P" })
		T.eq(descendants, 2)
		T.contains(changed, "Transparency")
		T.eq(propChanged, 1, "no signal when the value does not change")
	end)

	T.test("NumberValue.Changed passes the value (not the property name)", function()
		local v = Instance.new("NumberValue")
		local got = {}
		v.Changed:Connect(function(x)
			table.insert(got, x)
		end)
		v.Name = "Renamed"
		v.Value = 3
		T.deepEq(got, { 3 })
	end)

	T.test("signals: Connect / Once / Disconnect", function()
		local part = Instance.new("Part")
		local n = 0
		local conn = part.Changed:Connect(function()
			n += 1
		end)
		local once = 0
		part.Changed:Once(function()
			once += 1
		end)
		part.Transparency = 0.1
		part.Transparency = 0.2
		T.eq(n, 2)
		T.eq(once, 1)
		conn:Disconnect()
		T.falsy(conn.Connected)
		part.Transparency = 0.3
		T.eq(n, 2)
		T.throws(function() part.Changed:Connect(5) end)
	end)

	T.test("errors inside signal handlers are captured, not swallowed", function()
		local part = Instance.new("Part")
		part.Changed:Connect(function()
			error("boom")
		end)
		part.Transparency = 0.5
		T.eq(#H.handlerErrors, 1)
		T.contains(H.handlerErrors[1].message, "boom")
		H.allowHandlerErrors()
	end)

	T.test("attributes and tags", function()
		local p = Instance.new("Part")
		p:SetAttribute("k", 5)
		T.eq(p:GetAttribute("k"), 5)
		local seen = 0
		p:GetAttributeChangedSignal("k"):Connect(function()
			seen += 1
		end)
		p:SetAttribute("k", 6)
		T.eq(seen, 1)
		p:AddTag("road")
		T.ok(p:HasTag("road"))
		T.deepEq(p:GetTags(), { "road" })
	end)

	T.test("Clone deep-copies and remaps PrimaryPart", function()
		local model = Instance.new("Model")
		local body = Instance.new("Part", model)
		body.Name = "Body"
		body.Size = Vector3.new(2, 2, 2)
		model.PrimaryPart = body
		local copy = model:Clone()
		T.eq(copy.Parent, nil)
		T.ne(copy, model)
		T.eq(copy.PrimaryPart, copy.Body)
		T.eq(copy.Body.Size, Vector3.new(2, 2, 2))
		T.ne(copy.Body, body)
	end)

	T.test("BasePart: Position and CFrame stay in sync", function()
		local p = Instance.new("Part")
		p.CFrame = CFrame.new(1, 2, 3) * CFrame.Angles(0, math.rad(90), 0)
		T.eq(p.Position, Vector3.new(1, 2, 3))
		p.Position = Vector3.new(5, 5, 5)
		T.eq(p.CFrame.Position, Vector3.new(5, 5, 5))
		T.ok(p.CFrame.LookVector:FuzzyEq(Vector3.new(-1, 0, 0)))
	end)

	T.test("Model: PivotTo moves every part, ScaleTo scales around the pivot", function()
		local model = Instance.new("Model")
		local a = Instance.new("Part", model)
		a.Size = Vector3.new(2, 2, 2)
		a.Position = Vector3.new(0, 0, 0)
		local b = Instance.new("Part", model)
		b.Size = Vector3.new(2, 2, 2)
		b.Position = Vector3.new(4, 0, 0)
		model.WorldPivot = CFrame.new(0, 0, 0)
		model:PivotTo(CFrame.new(10, 0, 0))
		T.eq(a.Position, Vector3.new(10, 0, 0))
		T.eq(b.Position, Vector3.new(14, 0, 0))
		model:ScaleTo(2)
		T.eq(model:GetScale(), 2)
		T.eq(a.Size, Vector3.new(4, 4, 4))
		T.eq(b.Position, Vector3.new(18, 0, 0))
		T.throws(function() model:ScaleTo(0) end)
		local _, size = model:GetBoundingBox()
		T.gt(size.X, 4)
	end)

	T.test("WaitForChild: existing child, timeout, and infinite-yield detection", function()
		local folder = Instance.new("Folder")
		local child = Instance.new("Part", folder)
		T.eq(folder:WaitForChild(child.Name), child)
		T.eq(folder:WaitForChild("Missing", 1), nil)
		T.throws(function() folder:WaitForChild("Missing") end, "Infinite yield")
	end)

	T.test("WaitForChild resumes a task when the child appears", function()
		local folder = Instance.new("Folder")
		local got
		task.spawn(function()
			got = folder:WaitForChild("Late")
		end)
		T.eq(got, nil)
		local late = Instance.new("Part")
		late.Name = "Late"
		late.Parent = folder
		H.advance(0.1)
		T.eq(got, late)
	end)

	T.test("scheduler: task.delay / task.wait / task.defer on the virtual clock", function()
		local log = {}
		task.delay(1, function()
			table.insert(log, "delay1")
		end)
		task.spawn(function()
			table.insert(log, "spawn")
			task.wait(2)
			table.insert(log, "waited2")
		end)
		task.defer(function()
			table.insert(log, "defer")
		end)
		T.deepEq(log, { "spawn" })
		H.advance(0.5)
		T.deepEq(log, { "spawn", "defer" })
		H.advance(0.6)
		T.deepEq(log, { "spawn", "defer", "delay1" })
		H.advance(1)
		T.deepEq(log, { "spawn", "defer", "delay1", "waited2" })
		T.near(H.now(), 2.1, 1e-9)
		T.near(task.wait(3), 3)
		T.near(H.now(), 5.1, 1e-9)
	end)

	T.test("TweenService applies the goal when it completes, and fires Completed", function()
		local part = Instance.new("Part")
		local tween = game:GetService("TweenService"):Create(part, TweenInfo.new(0.5), { Transparency = 1 })
		local done = false
		tween.Completed:Connect(function()
			done = true
		end)
		tween:Play()
		H.advance(0.4)
		T.eq(part.Transparency, 0)
		H.advance(0.2)
		T.eq(part.Transparency, 1)
		T.ok(done)
		T.throws(function()
			game:GetService("TweenService"):Create(part, TweenInfo.new(1), { NotAProperty = 1 })
		end, "not a valid property")
		T.throws(function()
			game:GetService("TweenService"):Create(part, TweenInfo.new(1), { Transparency = "x" })
		end)
	end)

	T.test("a cancelled tween never applies its goal", function()
		local part = Instance.new("Part")
		local tween = game:GetService("TweenService"):Create(part, TweenInfo.new(0.5), { Transparency = 1 })
		tween:Play()
		tween:Cancel()
		H.advance(2)
		T.eq(part.Transparency, 0)
	end)

	T.test("services: GetService, game.Workspace, unknown services", function()
		T.eq(game:GetService("Workspace"), workspace)
		T.eq(game.Workspace, workspace)
		T.eq(game.ReplicatedStorage, game:GetService("ReplicatedStorage"))
		T.throws(function() game:GetService("NotAService") end, "not a valid Service")
		T.ok(game:GetService("RunService"):IsServer())
	end)

	T.test("RunService frames: Heartbeat/RenderStepped/BindToRenderStep fire on advance", function()
		local run = game:GetService("RunService")
		local beats, rendered, bound = 0, 0, 0
		local lastDt = 0
		run.Heartbeat:Connect(function(dt)
			beats += 1
			lastDt = dt
		end)
		run.RenderStepped:Connect(function()
			rendered += 1
		end)
		run:BindToRenderStep("test", 100, function()
			bound += 1
		end)
		H.advance(1)
		T.eq(beats, 30)
		T.near(lastDt, 1 / 30, 1e-9)
		T.eq(rendered, 30)
		T.eq(bound, 30)
		run:UnbindFromRenderStep("test")
		H.fireHeartbeat(0.1)
		T.eq(beats, 31)
		T.near(lastDt, 0.1, 1e-9)
		T.eq(bound, 30)
	end)

	T.test("DataStore is an in-memory copy store", function()
		local store = game:GetService("DataStoreService"):GetDataStore("T")
		local data = { best = { a = 1 } }
		store:SetAsync("k", data)
		data.best.a = 99
		T.eq(store:GetAsync("k").best.a, 1)
		H.W.dataStoreError = "503"
		T.throws(function() store:GetAsync("k") end, "503")
	end)

	T.test("Players / Player / PlayerGui", function()
		local p = H.newPlayer("Alice", 42)
		T.eq(p.Name, "Alice")
		T.eq(p.UserId, 42)
		T.ok(p:FindFirstChild("PlayerGui"))
		T.eq(game.Players.LocalPlayer, nil)
		T.eq(#game.Players:GetPlayers(), 1)
		H.asClient("Bob")
		T.eq(game.Players.LocalPlayer.Name, "Bob")
		T.falsy(game:GetService("RunService"):IsServer())
	end)

	T.test("camera rays hit the ground plane where WorldToViewportPoint says", function()
		local camera = workspace.CurrentCamera
		camera.CFrame = CFrame.lookAt(Vector3.new(36, 200, 36), Vector3.new(36, 0, 36))
		camera.FieldOfView = 20
		local target = Vector3.new(30, 0, 40)
		local screen, onScreen = camera:WorldToViewportPoint(target)
		T.ok(onScreen)
		local ray = camera:ViewportPointToRay(screen.X, screen.Y)
		local t = -ray.Origin.Y / ray.Direction.Y
		local hit = ray.Origin + ray.Direction * t
		T.near(hit.X, 30, 1e-6)
		T.near(hit.Z, 40, 1e-6)
	end)

	T.test("GuiObject.AbsoluteSize follows Size, parents and the viewport", function()
		local gui = Instance.new("ScreenGui")
		local frame = Instance.new("Frame", gui)
		frame.Size = UDim2.new(0.5, 10, 1, -20)
		T.eq(frame.AbsoluteSize, Vector2.new(970, 1060))
		local child = Instance.new("Frame", frame)
		child.Size = UDim2.fromScale(0.5, 0.5)
		T.eq(child.AbsoluteSize, Vector2.new(485, 530))
		H.setViewport(1280, 720)
		T.eq(frame.AbsoluteSize, Vector2.new(650, 700))
		T.throws(function() frame.AbsoluteSize = Vector2.new(1, 1) end, "read only")
	end)

	T.test("modules: require cache, per-module script, cyclic detection", function()
		local a = H.load("Config")
		T.eq(H.load("Config"), a)
		H.reset()
		T.ne(H.load("Config"), a, "H.reset drops module caches")
		T.throws(function() H.load("NoSuchModule") end, "no module matching")
		T.throws(function() H.load("Bootstrap").x = 1 end)
	end)

	T.test("module environments expose Roblox globals but not the harness", function()
		local Remotes = H.load("Remotes")
		T.ok(Remotes.folder())
		T.eq(rawget(H.G, "H"), nil)
	end)
end
